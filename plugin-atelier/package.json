{
  "name": "@atelier/plugin-atelier",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Exigences, preuves, relectures, porte déterministe et vues marketing de l'Atelier Marketing IA.",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "modele": "node ./scripts/telecharger-modele.mjs",
    "installer": "ONNXRUNTIME_NODE_INSTALL=skip pnpm install --frozen-lockfile",
    "dev": "node ./esbuild.config.mjs --watch",
    "dev:ui": "paperclip-plugin-dev-server --root . --ui-dir dist/ui --port 4177",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "automation",
    "marketing"
  ],
  "author": "Atelier Marketing IA (local)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@9.15.4",
  "//": "Installation : utiliser `pnpm run installer` (ONNXRUNTIME_NODE_INSTALL=skip), sinon le postinstall d'onnxruntime-node télécharge 272 Mo de fournisseurs CUDA inutiles (vectorisation sur processeur seul). Le modèle bge-m3 (560 Mo) se télécharge par `pnpm run modele` vers .modeles/ (ignoré par git).",
  "pnpm": {
    "overrides": {
      "@paperclipai/shared": "file:.paperclip-sdk/paperclipai-shared-0.3.1.tgz"
    }
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "mammoth": "1.13.0",
    "onnxruntime-node": "1.30.0",
    "pdfjs-dist": "6.4.299",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "file:.paperclip-sdk/paperclipai-plugin-sdk-1.0.0.tgz",
    "@paperclipai/shared": "file:.paperclip-sdk/paperclipai-shared-0.3.1.tgz",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "jszip": "3.10.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}

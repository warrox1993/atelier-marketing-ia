# Surcharge FACULTATIVE de l'instance 3100 pour l'accès depuis le téléphone, via `tailscale serve`.
# Copiez ce fichier vers config/atelier-distant.env (ignoré par git) puis remplacez les <...>.
# Chargé par scripts/lancer-instance.sh APRÈS config/atelier.env, jamais par instance-essai.sh (démonstration 3580).
# Validé par scripts/verifier-config.sh --distant config/atelier-distant.env.
# AUCUN secret ici : jetons et clés d'API vont dans le coffre de Paperclip ou l'environnement du shell.

# Mode authentifié : connexion par compte (au lieu de local_trusted), exposition privée (réseau Tailscale seulement).
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
# Le serveur n'écoute que la boucle locale ; seul `tailscale serve` le publie sur le tailnet.
PAPERCLIP_BIND=loopback
# Adresse que le téléphone utilise (https, nom .ts.net donné par `tailscale status`).
PAPERCLIP_PUBLIC_URL=https://<machine>.<tailnet>.ts.net
# Adresse interne de l'API, utilisée par les scripts et le plugin sur cette machine.
PAPERCLIP_API_URL=http://127.0.0.1:3100
# Noms d'hôte acceptés par le serveur (protection contre le détournement de nom d'hôte).
PAPERCLIP_ALLOWED_HOSTNAMES=<machine>.<tailnet>.ts.net,localhost
# Après création du compte administrateur, fermer les inscriptions en décommentant :
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=true

# Passerelle WhatsApp de l'Atelier (docs/whatsapp.md).
# Copier vers ~/.config/atelier/whatsapp.env, remplir, puis : chmod 600 ~/.config/atelier/whatsapp.env
# Ce fichier d'exemple ne contient AUCUNE valeur réelle ; le vrai fichier ne va jamais dans git.

# --- Meta (application « WhatsApp » du compte Meta Business, voir docs/whatsapp.md) ---
# Jeton d'accès permanent de l'utilisateur système, avec la SEULE permission whatsapp_business_messaging
# (pas whatsapp_business_management : les modèles se gèrent à la main dans le gestionnaire Meta).
WHATSAPP_JETON_ACCES=
# Secret de l'application (Paramètres de l'application > Général > Clé secrète) : vérifie X-Hub-Signature-256.
WHATSAPP_SECRET_APPLICATION=
# Jeton de vérification choisi par vous (longue chaîne aléatoire, ex. : openssl rand -hex 32),
# recopié tel quel dans la configuration du webhook chez Meta.
WHATSAPP_JETON_VERIFICATION=
# Identifiant du numéro WhatsApp Business (« Phone number ID », chiffres seuls).
WHATSAPP_ID_NUMERO=
# Liste blanche : votre numéro personnel, format international sans « + » ni espace (ex. 32470123456).
# Tout autre expéditeur est ignoré (journalisé sans contenu).
WHATSAPP_NUMEROS_AUTORISES=

# --- Atelier ---
# Entreprise Direction du client (coordinateur général) : identifiant UUID visible dans l'adresse de Paperclip.
ATELIER_ENTREPRISE=
# Instance locale (boucle locale obligatoire : l'instance n'est JAMAIS publiée).
ATELIER_API=http://127.0.0.1:3100/api
ATELIER_PLUGIN=atelier.marketing-ia
# Seulement si l'instance quitte le mode local_trusted : clé « board » de Paperclip.
# ATELIER_CLE_BOARD=

# --- Écoute (Tailscale Funnel publie CE port, et lui seul) ---
WHATSAPP_HOTE=127.0.0.1
WHATSAPP_PORT=3195

# --- Alertes hors fenêtre de 24 h ---
# Nom et langue du modèle UTILITAIRE approuvé par Meta (docs/whatsapp.md, étape 6).
WHATSAPP_MODELE_NOM=alerte_atelier
WHATSAPP_MODELE_LANGUE=fr
# « oui » = envoyer ce modèle quand la fenêtre de 24 h est fermée. ATTENTION : Meta FACTURE chaque modèle
# utilitaire envoyé hors fenêtre de service client. « non » (défaut, gratuit) : les alertes attendent votre
# prochain message WhatsApp.
WHATSAPP_MODELE_HORS_FENETRE=non

# --- Confidentialité (docs/whatsapp.md) ---
# L'API Cloud est hébergée par Meta. « non » (défaut) : le contenu des livrables et liaisons des services sensibles
# (juridique, ressources humaines, fiscalité, HSE, conformité, sinistres) n'est pas envoyé : « à lire dans l'atelier ».
# « oui » : décision du client (sous-traitance RGPD), à consigner avant de changer.
WHATSAPP_CONTENU_SENSIBLE=non

# --- Divers (valeurs par défaut) ---
# WHATSAPP_GRAPH_VERSION=v26.0
# WHATSAPP_INTERVALLE_ALERTES_S=60
# WHATSAPP_INTERVALLE_DISCUSSION_S=10
# WHATSAPP_DEBIT_PAR_MINUTE=20
# WHATSAPP_ETAT=~/.local/state/atelier/whatsapp/etat.json
# WHATSAPP_JOURNAL=~/.local/state/atelier/whatsapp/decisions.jsonl

# Atelier Marketing IA : environnement de l'instance Paperclip locale.
# Copier en config/atelier.env (non suivi par git) puis adapter si besoin.
# Toutes les variables ci-dessous sont documentées par Paperclip v2026.1012.0 :
#   docs/deploy/environment-variables.md, README.md (section Telemetry),
#   doc/ANNOUNCEMENTS.md. Aucune variable inventée.
# Ce fichier ne doit JAMAIS contenir de secret (clé API, jeton OAuth) : les
# secrets vont dans le coffre de Paperclip (company_secrets, local_encrypted).

# Données isolées de ~/.paperclip : base embarquée, clé maîtresse, journaux.
# Remplacer par le chemin absolu réel du dossier instance/ de votre copie du dépôt.
PAPERCLIP_HOME=/chemin/absolu/vers/atelier-marketing-ia/instance
PAPERCLIP_INSTANCE_ID=atelier

# Mode local de confiance, écoute sur la boucle locale uniquement.
PAPERCLIP_DEPLOYMENT_MODE=local_trusted
PAPERCLIP_BIND=loopback
PORT=3100

# Télémétrie d'usage de Paperclip désactivée (README.md, « Telemetry »,
# lu par packages/shared/src/telemetry/config.ts).
PAPERCLIP_TELEMETRY_DISABLED=1

# Pas de récupération du flux d'annonces public (doc/ANNOUNCEMENTS.md).
PAPERCLIP_ANNOUNCEMENTS_ENABLED=false

# Partage des traces de retour (feedback) refusé par défaut au lieu de
# « prompt » (docs/deploy/environment-variables.md, Operator setting defaults).
PAPERCLIP_SETTING_DEFAULTS='{"feedbackDataSharingPreference":"not_allowed"}'

# Contournement d'un défaut amont (constaté le 15/10/2026) : Paperclip reconnaît
# « not a git repository » uniquement en anglais
# (packages/adapter-utils/src/git-workspace-sync.ts:354-372). Avec la locale
# française du poste de développement, 25 tests de l'adaptateur claude-local échouent ; ils
# passent tous avec des messages en anglais. Variable POSIX standard : seuls
# les messages des outils lancés par le serveur passent en anglais.
LC_MESSAGES=C.UTF-8

# Atelier (patch local) : plafond de runs actifs par entreprise si le plugin
# n a pas de réglage pour l entreprise (serveur/src/atelier/regulateur-runs.ts).
ATELIER_MAX_RUNS_ACTIFS_PAR_ENTREPRISE=3

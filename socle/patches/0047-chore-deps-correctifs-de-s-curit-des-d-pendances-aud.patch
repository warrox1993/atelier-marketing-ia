@@ -13,12 +13,32 @@ import { dirname, isAbsolute, join, resolve } from "node:path";
 import { parse, type TomlTable } from "smol-toml";
 import { isDeepStrictEqual } from "node:util";
 
+/** smol-toml >= 1.9 returns null-prototype tables while the expected value
+ * mixes them with object literals. Give every table a null prototype on both
+ * sides so the strict comparison still checks every key and value (dates,
+ * arrays, nested tables) and only ignores the prototype difference. */
+function nullPrototypeTables(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(nullPrototypeTables);
+  if (value !== null && typeof value === "object") {
+    const proto = Object.getPrototypeOf(value);
+    if (proto === null || proto === Object.prototype) {
+      // Assigning on a null-prototype object keeps "__proto__" an own key.
+      const table: Record<string, unknown> = Object.create(null);
+      for (const key of Object.keys(value))
+        table[key] = nullPrototypeTables((value as Record<string, unknown>)[key]);
+      return table;
+    }
+  }
+  return value;
+}
+
 /** Keep managed-region comments and all unrelated bytes. The parser validates
  * every candidate against the exact intended semantic change; text inside a
  * comment or multiline string can never qualify as the target assignment. */
 function editTrust(source: string, root: string, expected: TomlTable): string {
+  const wanted = nullPrototypeTables(expected);
   const matches = (candidate: string) => {
-    try { return isDeepStrictEqual(parse(candidate), expected); }
+    try { return isDeepStrictEqual(nullPrototypeTables(parse(candidate)), wanted); }
     catch { return false; }
   };
   if (matches(source)) return source;

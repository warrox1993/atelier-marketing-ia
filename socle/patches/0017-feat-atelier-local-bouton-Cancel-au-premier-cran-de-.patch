diff --git a/ui/src/components/OnboardingWizard.test.tsx b/ui/src/components/OnboardingWizard.test.tsx
index c82482c5f..09310bf37 100644
--- a/ui/src/components/OnboardingWizard.test.tsx
+++ b/ui/src/components/OnboardingWizard.test.tsx
@@ -438,6 +438,18 @@ describe("OnboardingWizard restore-gate (stale localStorage across accounts)", (
       await flushReact();
     }
 
+    // Atelier (patch local 0016) : le premier écran a une sortie (« Cancel ») qui ferme l'assistant sans rien créer.
+    it("offers Cancel on the naming step, which closes the wizard without creating a company", async () => {
+      mockDialog.closeOnboarding.mockClear();
+      const { root } = await openStepOne();
+      await clickByText((t) => t.trim() === "Cancel");
+
+      expect(mockDialog.closeOnboarding).toHaveBeenCalled();
+      expect(mockCompaniesApi.create).not.toHaveBeenCalled();
+
+      await act(async () => root.unmount());
+    });
+
     it("creates the organization on Continue and lands on the agent step, no mission", async () => {
       mockCompaniesApi.create.mockResolvedValue({ id: "company-new", issuePrefix: "INI" });
       const { root } = await openStepOne();

@@ -0,0 +1,108 @@
+/**
+ * Atelier Marketing IA (patch local 0108) : aucun agent ne modifie une configuration, des consignes ou des skills
+ * (AFD-C1, N1, CV-1, CV-2, M3), ni ne lit la configuration d'un pair (AFA-SEC-2) ; le board garde ces gestes.
+ * Agents créés par le vrai cycle de vie, donc avec les grants par défaut (agents:configure, skills:create compris).
+ */
+import { randomUUID } from "node:crypto";
+import { eq } from "drizzle-orm";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { activityLog, agents, companies, companyMemberships, createDb, principalPermissionGrants } from "@paperclipai/db";
+import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
+import { createAgentLifecycle } from "../services/agent-lifecycle.js";
+import { accessService } from "../services/access.js";
+import { authorizationService } from "../services/authorization.js";
+
+const support = await getEmbeddedPostgresTestSupport();
+const decrireAvecBase = support.supported ? describe : describe.skip;
+
+decrireAvecBase("atelier : configuration des agents réservée aux humains", () => {
+  let db!: ReturnType<typeof createDb>;
+  let cleanup: (() => Promise<void>) | undefined;
+  const companyId = randomUUID();
+  let soi = "";
+  let pair = "";
+  let ceo = "";
+
+  beforeAll(async () => {
+    const started = await startEmbeddedPostgresTestDatabase("atelier-config-agents");
+    db = createDb(started.connectionString);
+    cleanup = started.cleanup;
+    await db.insert(companies).values({ id: companyId, name: "Atelier config", issuePrefix: `AC${companyId.slice(0, 6).toUpperCase()}` });
+    const embaucher = async (name: string, role: string) => {
+      const agent = await createAgentLifecycle(db).requestHire(companyId, {
+        name, role, adapterType: "process", adapterConfig: {}, runtimeConfig: {},
+      });
+      await accessService(db).ensureMembership(companyId, "agent", agent.id, "member", "active");
+      return agent.id;
+    };
+    soi = await embaucher("Spécialiste", "general");
+    pair = await embaucher("Pair", "general");
+    ceo = await embaucher("Coordinateur", "ceo");
+  }, 30_000);
+
+  afterAll(async () => {
+    await db.delete(principalPermissionGrants).where(eq(principalPermissionGrants.companyId, companyId));
+    await db.delete(companyMemberships).where(eq(companyMemberships.companyId, companyId));
+    await db.delete(agents).where(eq(agents.companyId, companyId));
+    await db.delete(activityLog).where(eq(activityLog.companyId, companyId));
+    await db.delete(companies).where(eq(companies.id, companyId));
+    await cleanup?.();
+  });
+
+  const parAgent = (agentId: string) => ({ type: "agent" as const, agentId, companyId, source: "agent_key" as const });
+  const surAgent = (agentId: string) => ({ type: "agent" as const, companyId, agentId });
+
+  it("les grants par défaut sont bien là (sinon le test ne prouverait rien)", async () => {
+    const cles = (await db.select().from(principalPermissionGrants).where(eq(principalPermissionGrants.principalId, soi)))
+      .map((g) => g.permissionKey);
+    expect(cles).toEqual(expect.arrayContaining(["agents:configure", "skills:create", "agents:suggest-changes"]));
+  });
+
+  it("refuse à tout agent la modification de sa configuration, de celle d'un pair, des consignes et des skills", async () => {
+    const authz = authorizationService(db);
+    const cas = [
+      { acteur: soi, action: "agent_config:update" as const, resource: surAgent(soi), scope: undefined },
+      { acteur: soi, action: "agent_config:update" as const, resource: surAgent(pair), scope: { requiresChangeGrant: true } },
+      { acteur: soi, action: "agent_config:update" as const, resource: surAgent(pair), scope: { requiresChangeGrant: true, consentedChange: true } },
+      { acteur: ceo, action: "agent_config:update" as const, resource: surAgent(pair), scope: { requiresChangeGrant: true } },
+      { acteur: soi, action: "agent_instructions:update" as const, resource: surAgent(soi), scope: undefined },
+      { acteur: ceo, action: "agent_instructions:update" as const, resource: surAgent(pair), scope: undefined },
+      { acteur: soi, action: "skill_config:update" as const, resource: surAgent(soi), scope: undefined },
+      { acteur: soi, action: "skill_config:update" as const, resource: { type: "company" as const, companyId }, scope: undefined },

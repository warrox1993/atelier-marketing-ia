diff --git a/server/src/__tests__/atelier-assignation.test.ts b/server/src/__tests__/atelier-assignation.test.ts
new file mode 100644
index 0000000000..3278cd2c08
--- /dev/null
+++ b/server/src/__tests__/atelier-assignation.test.ts
@@ -0,0 +1,95 @@
+/**
+ * Atelier Marketing IA (patch local 0108, N3) : le coordinateur (ceo) assigne à tout agent ; tout autre agent
+ * seulement à son sous-arbre (grant par défaut tasks:assign_scope) et aux destinataires déclarés que le board pose
+ * dans ce même grant. Le grant large tasks:assign, posé sur chaque agent importé, ne suffit plus hors ceo.
+ */
+import { randomUUID } from "node:crypto";
+import { eq } from "drizzle-orm";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { activityLog, agents, companies, companyMemberships, createDb, principalPermissionGrants } from "@paperclipai/db";
+import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
+import { createAgentLifecycle } from "../services/agent-lifecycle.js";
+import { accessService } from "../services/access.js";
+import { authorizationService } from "../services/authorization.js";
+
+const support = await getEmbeddedPostgresTestSupport();
+const decrireAvecBase = support.supported ? describe : describe.skip;
+
+decrireAvecBase("atelier : assignation bornée (N3)", () => {
+  let db!: ReturnType<typeof createDb>;
+  let cleanup: (() => Promise<void>) | undefined;
+  const companyId = randomUUID();
+  const ids: Record<string, string> = {};
+
+  beforeAll(async () => {
+    const started = await startEmbeddedPostgresTestDatabase("atelier-assignation");
+    db = createDb(started.connectionString);
+    cleanup = started.cleanup;
+    await db.insert(companies).values({ id: companyId, name: "Atelier assignation", issuePrefix: `AA${companyId.slice(0, 6).toUpperCase()}` });
+    const embaucher = async (cle: string, role: string, chef?: string) => {
+      const agent = await createAgentLifecycle(db).requestHire(companyId, {
+        name: cle, role, reportsTo: chef ? ids[chef] : null, adapterType: "process", adapterConfig: {}, runtimeConfig: {},
+      });
+      const acces = accessService(db);
+      await acces.ensureMembership(companyId, "agent", agent.id, "member", "active");
+      // Comme l'import de l'atelier (company-portability) : grant large tasks:assign sur chaque agent.
+      await acces.setPrincipalPermission(companyId, "agent", agent.id, "tasks:assign", true, null);
+      ids[cle] = agent.id;
+    };
+    await embaucher("coordinateur", "ceo");
+    await embaucher("analyste", "general", "coordinateur");
+    await embaucher("redacteur", "general", "coordinateur");
+    await embaucher("relecteur", "qa", "coordinateur");
+    await embaucher("exigences", "qa", "relecteur");
+  }, 30_000);
+
+  afterAll(async () => {
+    await db.delete(principalPermissionGrants).where(eq(principalPermissionGrants.companyId, companyId));
+    await db.delete(companyMemberships).where(eq(companyMemberships.companyId, companyId));
+    await db.delete(agents).where(eq(agents.companyId, companyId));
+    await db.delete(activityLog).where(eq(activityLog.companyId, companyId));
+    await db.delete(companies).where(eq(companies.id, companyId));
+    await cleanup?.();
+  });
+
+  const assigner = (acteur: string, cible: string) => authorizationService(db).decide({
+    actor: { type: "agent", agentId: ids[acteur]!, companyId, source: "agent_key" },
+    action: "tasks:assign",
+    resource: { type: "issue", companyId, issueId: null, projectId: null, parentIssueId: null, assigneeAgentId: ids[cible]!, assigneeUserId: null },
+    scope: { assigneeAgentId: ids[cible]! },
+  });
+  const refuse = { allowed: false, reason: "deny_policy_restricted" };
+
+  it("le coordinateur (ceo) assigne à tout agent", async () => {
+    for (const cible of ["analyste", "redacteur", "relecteur", "exigences", "coordinateur"]) {
+      await expect(assigner("coordinateur", cible)).resolves.toMatchObject({ allowed: true });
+    }
+  });
+
+  it("un spécialiste avec les grants par défaut n'assigne qu'à lui-même : ni au coordinateur ni à un pair", async () => {
+    await expect(assigner("analyste", "analyste")).resolves.toMatchObject({ allowed: true });
+    await expect(assigner("analyste", "coordinateur")).resolves.toMatchObject(refuse);
+    await expect(assigner("analyste", "redacteur")).resolves.toMatchObject(refuse);
+  });
+
+  it("un agent qui a des subordonnés (rôle non ceo) assigne dans son sous-arbre seulement", async () => {
+    await expect(assigner("relecteur", "exigences")).resolves.toMatchObject({ allowed: true });
+    await expect(assigner("relecteur", "analyste")).resolves.toMatchObject(refuse);
+    await expect(assigner("exigences", "relecteur")).resolves.toMatchObject(refuse);
+  });
+
+  it("les destinataires déclarés posés par le board ouvrent ces transferts-là et pas d'autres", async () => {
+    await accessService(db).setPrincipalPermission(companyId, "agent", ids.analyste!, "tasks:assign_scope", true, null,
+      { assigneeAgentIds: [ids.analyste!, ids.redacteur!] });
+    await expect(assigner("analyste", "redacteur")).resolves.toMatchObject({ allowed: true });
+    await expect(assigner("analyste", "analyste")).resolves.toMatchObject({ allowed: true });
+    await expect(assigner("analyste", "coordinateur")).resolves.toMatchObject(refuse);
+    await expect(assigner("analyste", "relecteur")).resolves.toMatchObject(refuse);
+  });
+
+  it("sans grant à portée, un agent non ceo n'assigne à personne, même avec le grant large", async () => {
+    await accessService(db).setPrincipalPermission(companyId, "agent", ids.redacteur!, "tasks:assign_scope", false, null);
+    await expect(assigner("redacteur", "redacteur")).resolves.toMatchObject(refuse);
+    await expect(assigner("redacteur", "analyste")).resolves.toMatchObject(refuse);
+  });
+});

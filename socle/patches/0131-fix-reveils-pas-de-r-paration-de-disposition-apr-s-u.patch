+  it("Atelier AFB-9 : le commentaire d'un autre agent ne réveille l'assigné que s'il rouvre, relance ou casse le chemin de revue", () => {
+    const base = {
+      selfComment: false,
+      authorIsAgent: true,
+      resumeRequested: false,
+      issueAtCommentStart: {},
+      reopened: false,
+      currentStatus: "in_progress",
+    };
+    expect(shouldWakeAssigneeForIssueComment(base)).toBe(false);
+    expect(shouldWakeAssigneeForIssueComment({ ...base, currentStatus: "backlog" })).toBe(false);
+    expect(shouldWakeAssigneeForIssueComment({ ...base, resumeRequested: true })).toBe(true);
+    expect(shouldWakeAssigneeForIssueComment({ ...base, reviewPathLost: true })).toBe(true);
+    expect(shouldWakeAssigneeForIssueComment({ ...base, currentStatus: "done", reopened: true })).toBe(true);
+    // Un commentaire humain réveille toujours.
+    expect(shouldWakeAssigneeForIssueComment({ ...base, authorIsAgent: false })).toBe(true);
+  });

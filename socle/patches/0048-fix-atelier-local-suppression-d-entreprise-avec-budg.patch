Patch local de l'Atelier Marketing IA, non destiné à l'amont.
- companies.remove : incidents puis politiques de budget supprimés avant
  les approbations et l'entreprise (budget_policies sans cascade : 500,
  contrainte budget_policies_company_id_companies_id_fk, constaté lors de
  la validation réelle de « purger » le 16/10/2026).
- Test : atelier-suppression-entreprise.test.ts (échoue sans le correctif).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DP85vPq2MHkZg8VNtRvCzB
---
 .../__tests__/atelier-suppression-entreprise.test.ts   | 10 +++++++++-
 server/src/services/companies.ts                       |  8 ++++++++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/server/src/__tests__/atelier-suppression-entreprise.test.ts b/server/src/__tests__/atelier-suppression-entreprise.test.ts
index 1d9ecd87d..76725ae10 100644
--- a/server/src/__tests__/atelier-suppression-entreprise.test.ts
+++ b/server/src/__tests__/atelier-suppression-entreprise.test.ts
@@ -5,7 +5,7 @@
 import { randomUUID } from "node:crypto";
 import { eq } from "drizzle-orm";
 import { afterAll, beforeAll, describe, expect, it } from "vitest";
-import { companies, createDb, goals, projects } from "@paperclipai/db";
+import { budgetPolicies, companies, createDb, goals, projects } from "@paperclipai/db";
 import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
 import { companyService } from "../services/companies.js";
 
@@ -36,4 +36,12 @@ decrire("atelier : suppression d'entreprise avec projet lié à un objectif", ()
     expect(await db.select().from(goals).where(eq(goals.companyId, companyId))).toEqual([]);
     expect(await db.select().from(projects).where(eq(projects.companyId, companyId))).toEqual([]);
   });
+  it("supprime une entreprise dont le budget mensuel est posé (politique de budget sans cascade)", async () => {
+    const companyId = randomUUID();
+    await db.insert(companies).values({ id: companyId, name: "Suppression budget", issuePrefix: `B${companyId.slice(0, 6).toUpperCase().replace(/-/g, "")}`, requireBoardApprovalForNewAgents: false });
+    await db.insert(budgetPolicies).values({ companyId, scopeType: "company", scopeId: companyId, metric: "billed_cents", windowKind: "calendar_month_utc", amount: 5000 });
+    const supprimee = await companyService(db).remove(companyId);
+    expect(supprimee?.id).toBe(companyId);
+    expect(await db.select().from(budgetPolicies).where(eq(budgetPolicies.companyId, companyId))).toEqual([]);
+  });
 });

diff --git a/server/src/__tests__/atelier-suppression-entreprise.test.ts b/server/src/__tests__/atelier-suppression-entreprise.test.ts
index 76725ae10..d7895ed25 100644
--- a/server/src/__tests__/atelier-suppression-entreprise.test.ts
+++ b/server/src/__tests__/atelier-suppression-entreprise.test.ts
@@ -5,7 +5,7 @@
 import { randomUUID } from "node:crypto";
 import { eq } from "drizzle-orm";
 import { afterAll, beforeAll, describe, expect, it } from "vitest";
-import { budgetPolicies, companies, createDb, goals, projects } from "@paperclipai/db";
+import { agents, budgetPolicies, companies, costEvents, createDb, goals, heartbeatRuns, projects } from "@paperclipai/db";
 import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
 import { companyService } from "../services/companies.js";
 
@@ -44,4 +44,18 @@ decrire("atelier : suppression d'entreprise avec projet lié à un objectif", ()
     expect(supprimee?.id).toBe(companyId);
     expect(await db.select().from(budgetPolicies).where(eq(budgetPolicies.companyId, companyId))).toEqual([]);
   });
+  it("supprime une entreprise dont un run d'agent a des coûts enregistrés (cost_events avant heartbeat_runs)", async () => {
+    const companyId = randomUUID();
+    await db.insert(companies).values({ id: companyId, name: "Suppression coûts", issuePrefix: `C${companyId.slice(0, 6).toUpperCase().replace(/-/g, "")}`, requireBoardApprovalForNewAgents: false });
+    const agentId = randomUUID();
+    await db.insert(agents).values({ id: agentId, companyId, name: "Agent coûts", role: "general", adapterType: "process", adapterConfig: {} });
+    const runId = randomUUID();
+    await db.insert(heartbeatRuns).values({ id: runId, companyId, agentId, status: "succeeded" });
+    await db.insert(costEvents).values({ companyId, agentId, heartbeatRunId: runId, provider: "anthropic", model: "test", costCents: 12, occurredAt: new Date() });
+    const supprimee = await companyService(db).remove(companyId);
+    expect(supprimee?.id).toBe(companyId);
+    expect(await db.select().from(costEvents).where(eq(costEvents.companyId, companyId))).toEqual([]);
+    expect(await db.select().from(heartbeatRuns).where(eq(heartbeatRuns.companyId, companyId))).toEqual([]);
+    expect(await db.select().from(agents).where(eq(agents.companyId, companyId))).toEqual([]);
+  });
 });

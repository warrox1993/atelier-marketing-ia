+import { describe, expect, it } from "vitest";
+import { execute } from "../adapters/process/execute.js";
+
+// Lance un vrai processus enfant qui renvoie sur stdout les variables du réveil
+// (atelier : l'adaptateur « process » doit injecter la tâche et le motif du réveil).
+async function lancer(context: Record<string, unknown>, env: Record<string, string> = {}) {
+  const ctx = {
+    runId: "11111111-1111-4111-8111-111111111111",
+    agent: { id: "22222222-2222-4222-8222-222222222222", companyId: "33333333-3333-4333-8333-333333333333", name: "Agent essai" },
+    runtime: {},
+    config: {
+      command: process.execPath,
+      args: [
+        "-e",
+        "console.log(JSON.stringify({task: process.env.PAPERCLIP_TASK_ID ?? null, motif: process.env.PAPERCLIP_WAKE_REASON ?? null}))",
+      ],
+      env,
+    },
+    context,
+    onLog: async () => {},
+    onMeta: async () => {},
+    authToken: "jeton-essai",
+  };
+  const res = await execute(ctx as never);
+  expect(res.exitCode).toBe(0);
+  const stdout = String((res.resultJson as { stdout?: string } | undefined)?.stdout ?? "");
+  return JSON.parse(stdout.trim().split("\n").pop() ?? "{}") as { task: string | null; motif: string | null };
+}
+
+describe("adaptateur process : variables du réveil", () => {
+  it("injecte PAPERCLIP_TASK_ID (taskId) et PAPERCLIP_WAKE_REASON", async () => {
+    const sortie = await lancer({ taskId: "tache-1", issueId: "tache-2", wakeReason: "issue_assigned" });
+    expect(sortie).toEqual({ task: "tache-1", motif: "issue_assigned" });
+  });
+
+  it("retombe sur issueId quand taskId est absent", async () => {
+    const sortie = await lancer({ issueId: "tache-2", wakeReason: "issue_children_completed" });
+    expect(sortie).toEqual({ task: "tache-2", motif: "issue_children_completed" });
+  });
+
+  it("n'injecte rien sans contexte de tâche", async () => {
+    const sortie = await lancer({});
+    expect(sortie).toEqual({ task: null, motif: null });
+  });
+
+  it("la valeur du réveil l'emporte sur la configuration de l'agent", async () => {
+    const sortie = await lancer({ issueId: "tache-2" }, { PAPERCLIP_TASK_ID: "forcee" });
+    expect(sortie.task).toBe("tache-2");
+  });
+});

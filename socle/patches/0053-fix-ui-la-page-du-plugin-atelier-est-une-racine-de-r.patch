diff --git a/ui/src/lib/company-routes.test.ts b/ui/src/lib/company-routes.test.ts
index f478aaf59..33d2922be 100644
--- a/ui/src/lib/company-routes.test.ts
+++ b/ui/src/lib/company-routes.test.ts
@@ -7,6 +7,15 @@ import {
 } from "./company-routes";
 
 describe("company routes", () => {
+  it("prefixe les adresses de la page du plugin Atelier marketing au lieu de les lire comme un préfixe d'entreprise", () => {
+    expect(isBoardPathWithoutPrefix("/atelier")).toBe(true);
+    expect(extractCompanyPrefixFromPath("/atelier/discussion")).toBeNull();
+    expect(applyCompanyPrefix("/atelier", "RNO")).toBe("/RNO/atelier");
+    expect(applyCompanyPrefix("/atelier/discussion", "RNO")).toBe("/RNO/atelier/discussion");
+    expect(applyCompanyPrefix("/RNO/atelier/discussion", "RNO")).toBe("/RNO/atelier/discussion");
+    expect(toCompanyRelativePath("/RNO/atelier/prospects")).toBe("/atelier/prospects");
+  });
+
   it("treats the task-list alias as an unprefixed board route", () => {
     expect(isBoardPathWithoutPrefix("/tasks")).toBe(true);
     expect(extractCompanyPrefixFromPath("/tasks")).toBeNull();
diff --git a/ui/src/lib/company-routes.ts b/ui/src/lib/company-routes.ts
index e42b1e7f1..013a2e18d 100644
--- a/ui/src/lib/company-routes.ts
+++ b/ui/src/lib/company-routes.ts
@@ -31,6 +31,9 @@ const BOARD_ROUTE_ROOTS = new Set([
   "search",
   "settings",
   "timeline",
+  // Page du plugin « Atelier marketing » (routePath « atelier ») : sans cette racine, « /atelier » était lu comme
+  // le préfixe d'entreprise « ATELIER » et les liens de la barre du bas renvoyaient « Organization not found ».
+  "atelier",
 ]);
 
 const GLOBAL_ROUTE_ROOTS = new Set(["auth", "invite", "board-claim", "cli-auth", "mcp-connect", "assistant-connections", "docs", "instance"]);

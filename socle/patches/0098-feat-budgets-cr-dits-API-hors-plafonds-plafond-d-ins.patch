+/** Cycle des crédits API : minuit UTC du jour `jourDebut`; un jour absent du mois (29 à 31) devient le dernier jour. */
+export function fenetreCycleCredits(maintenant: Date, jourDebut: number): { start: Date; end: Date } {
+  const borne = (annee: number, mois: number) =>
+    new Date(Date.UTC(annee, mois, Math.min(jourDebut, new Date(Date.UTC(annee, mois + 1, 0)).getUTCDate())));
+  const annee = maintenant.getUTCFullYear(), mois = maintenant.getUTCMonth();
+  const ceMois = borne(annee, mois);
+  if (maintenant >= ceMois) return { start: ceMois, end: borne(annee, mois + 1) };
+  return { start: borne(annee, mois - 1), end: ceMois };
+}
+
+/** Dépense en crédits API de toute l'instance (toutes entreprises) sur la fenêtre, en centimes. */
+export async function depenseCreditsInstance(db: Db, fenetre: { start: Date; end: Date }): Promise<number> {
+  const [ligne] = await db.select({ total: sql<string>`coalesce(sum(${costEvents.costCents}), 0)::text` }).from(costEvents)
+    .where(and(eq(costEvents.billingType, "credits"), gte(costEvents.occurredAt, fenetre.start), lt(costEvents.occurredAt, fenetre.end)));
+  return Number(ligne?.total ?? 0);
+}
+
+const PLAFOND_CREDITS_DEFAUT_CENTIMES = 20000;
+const JOUR_CYCLE_CREDITS_DEFAUT = 12;
+
+function entierEnv(valeur: string | undefined, defaut: number, min: number, max: number) {
+  const n = Number(valeur);
+  return valeur !== undefined && Number.isInteger(n) && n >= min && n <= max ? n : defaut;
+}
+
+/** Plafond d'instance des crédits API : atteint quand la dépense du cycle courant >= plafond. */
+export async function plafondCreditsClaude(db: Db, maintenant: Date = new Date(), env: NodeJS.ProcessEnv = process.env) {
+  const plafondCentimes = entierEnv(env.PAPERCLIP_CLAUDE_CREDITS_PLAFOND_CENTIMES, PLAFOND_CREDITS_DEFAUT_CENTIMES, 1, Number.MAX_SAFE_INTEGER);
+  const jour = entierEnv(env.PAPERCLIP_CLAUDE_CREDITS_JOUR_CYCLE, JOUR_CYCLE_CREDITS_DEFAUT, 1, 31);
+  const depenseCentimes = await depenseCreditsInstance(db, fenetreCycleCredits(maintenant, jour));
+  return { atteint: depenseCentimes >= plafondCentimes, depenseCentimes, plafondCentimes };
+}
+
 function observedBlocks(policy: PolicyRow, observed: Awaited<ReturnType<typeof computeObservedSpend>>) {
   if (!policy.isActive || !policy.hardStopEnabled || policy.amount <= 0) return false;
   return compareCents(observed.totalExact, policy.amount) >= 0 || (observed.pendingRunCount - observed.recoveringRunCount) > 0 || (policy.unpricedUsagePolicy !== "allow" && observed.unpricedEventCount > 0);

+import { randomUUID } from "node:crypto";
+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import {
+  agents,
+  budgetIncidents,
+  budgetPolicies,
+  approvals,
+  companies,
+  costEvents,
+  createDb,
+  projects,
+} from "@paperclipai/db";
+import { usdToCents } from "@paperclipai/shared";
+import { computeObservedSpend, depenseCreditsInstance, fenetreCycleCredits, plafondCreditsClaude } from "../services/budgets.ts";
+import { costService } from "../services/costs.ts";
+import {
+  getEmbeddedPostgresTestSupport,
+  startEmbeddedPostgresTestDatabase,
+} from "./helpers/embedded-postgres.js";
+
+vi.mock("../services/activity-log.js", () => ({ logActivity: vi.fn() }));
+
+const embeddedPostgresSupport = await getEmbeddedPostgresTestSupport();
+const describeEmbeddedPostgres = embeddedPostgresSupport.supported ? describe : describe.skip;
+
+describe("fenetreCycleCredits", () => {
+  it("fenetreCycleCredits: 2026-10-27 -> 2026-10-12T00:00Z .. 2026-11-12T00:00Z", () => {
+    const { start, end } = fenetreCycleCredits(new Date("2026-10-27T10:00:00Z"), 12);
+    expect(start.toISOString()).toBe("2026-10-12T00:00:00.000Z");
+    expect(end.toISOString()).toBe("2026-11-12T00:00:00.000Z");
+  });
+
+  it("fenetreCycleCredits: 2026-11-05 -> 2026-10-12 .. 2026-11-12", () => {
+    const { start, end } = fenetreCycleCredits(new Date("2026-11-05T23:59:59Z"), 12);
+    expect(start.toISOString()).toBe("2026-10-12T00:00:00.000Z");
+    expect(end.toISOString()).toBe("2026-11-12T00:00:00.000Z");
+  });
+
+  it("fenetreCycleCredits: exactly 2026-11-12T00:00Z starts the new cycle", () => {
+    const { start, end } = fenetreCycleCredits(new Date("2026-11-12T00:00:00Z"), 12);
+    expect(start.toISOString()).toBe("2026-11-12T00:00:00.000Z");
+    expect(end.toISOString()).toBe("2026-12-12T00:00:00.000Z");
+  });
+
+  it("fenetreCycleCredits: day 31 in February ends on the last day", () => {
+    const { start, end } = fenetreCycleCredits(new Date("2026-02-15T00:00:00Z"), 31);
+    expect(start.toISOString()).toBe("2026-01-31T00:00:00.000Z");
+    expect(end.toISOString()).toBe("2026-02-28T00:00:00.000Z");
+  });
+});
+
+describeEmbeddedPostgres("les credits API hors des totaux de budget", () => {
+  let db!: ReturnType<typeof createDb>;
+  let tempDb: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>> | null = null;
+
+  beforeAll(async () => {
+    tempDb = await startEmbeddedPostgresTestDatabase("paperclip-budgets-credits-");
+    db = createDb(tempDb.connectionString);
+  }, 20_000);
+
+  afterEach(async () => {
+    await db.delete(budgetIncidents);
+    await db.delete(approvals);
+    await db.delete(budgetPolicies);
+    await db.delete(costEvents);
+    await db.delete(projects);
+    await db.delete(agents);
+    await db.delete(companies);
+  });
+
+  afterAll(async () => {
+    await tempDb?.cleanup();
+  });
+
+  async function amorcer() {
+    const companyId = randomUUID();
+    const agentId = randomUUID();
+    const projectId = randomUUID();
+    await db.insert(companies).values({
+      id: companyId, name: "Paperclip", issuePrefix: `C${companyId.replace(/-/g, "").slice(0, 6).toUpperCase()}`,
+      requireBoardApprovalForNewAgents: false,
+    });
+    await db.insert(agents).values({
+      id: agentId, companyId, name: "Agent credits", role: "engineer", status: "active",
+      adapterType: "claude_local", adapterConfig: {}, runtimeConfig: {}, permissions: {},
+    });
+    await db.insert(projects).values({ id: projectId, companyId, name: "Projet credits", status: "in_progress" });
+    return { companyId, agentId, projectId };
+  }
+
+  async function evenement(f: { companyId: string; agentId: string; projectId?: string | null }, o: {
+    billingType: string; costCents: number; costStatus?: string; occurredAt?: Date;
+  }) {
+    await db.insert(costEvents).values({
+      companyId: f.companyId, agentId: f.agentId, projectId: f.projectId ?? null,
+      provider: "anthropic", biller: "anthropic", billingType: o.billingType, model: "claude-test",
+      inputTokens: 1, cachedInputTokens: 0, outputTokens: 1, costCents: o.costCents,
+      costStatus: o.costStatus ?? "reported", occurredAt: o.occurredAt ?? new Date(),
+    });
+  }
+
+  const politique = (companyId: string, scopeType: "company" | "agent" | "project", scopeId: string) =>
+    ({ companyId, scopeType, scopeId, windowKind: "lifetime", metric: "billed_cents" }) as const;
+
+  it("a credits event is excluded from a company policy total; a metered_api event is included", async () => {
+    const f = await amorcer();
+    await evenement(f, { billingType: "credits", costCents: 5000 });
+    await evenement(f, { billingType: "metered_api", costCents: 300 });
+    const observe = await computeObservedSpend(db, politique(f.companyId, "company", f.companyId));
+    expect(observe.total).toBe(300);
+  });
+
+  it("same exclusion for agent and project policies", async () => {
+    const f = await amorcer();
+    await evenement(f, { ...f, billingType: "credits", costCents: 5000 });
+    await evenement(f, { ...f, billingType: "metered_api", costCents: 300 });
+    expect((await computeObservedSpend(db, politique(f.companyId, "agent", f.agentId))).total).toBe(300);
+    expect((await computeObservedSpend(db, politique(f.companyId, "project", f.projectId))).total).toBe(300);
+  });
+
+  it("an unpriced credits event still counts in unpricedEventCount", async () => {
+    const f = await amorcer();
+    await evenement(f, { billingType: "credits", costCents: 0, costStatus: "unpriced" });
+    const observe = await computeObservedSpend(db, politique(f.companyId, "company", f.companyId));
+    expect(observe.unpricedEventCount).toBe(1);
+  });
+
+  it("a 2.00 USD credits receipt is stored as 200 cost_cents", async () => {
+    // Le reçu passe par le service de coûts avec la conversion du socle (usdToCents), sans cycle de heartbeat.
+    const f = await amorcer();
+    const recu = await costService(db).createEvent(f.companyId, {
+      agentId: f.agentId, provider: "anthropic", biller: "anthropic", billingType: "credits", model: "claude-test",
+      inputTokens: 1, cachedInputTokens: 0, outputTokens: 1, costCents: usdToCents("2.00"), occurredAt: new Date(),
+    });
+    expect(Number(recu.costCents)).toBe(200);
+  });
+
+  const cycle = fenetreCycleCredits(new Date("2026-10-27T10:00:00Z"), 12);
+  const dansLeCycle = new Date("2026-10-20T00:00:00Z");
+
+  it("depenseCreditsInstance sums credits events of all companies inside the cycle only", async () => {
+    const a = await amorcer();
+    const b = await amorcer();
+    await evenement(a, { billingType: "credits", costCents: 1000, occurredAt: dansLeCycle });
+    await evenement(b, { billingType: "credits", costCents: 2500, occurredAt: dansLeCycle });
+    await evenement(a, { billingType: "credits", costCents: 9999, occurredAt: new Date("2026-10-11T23:59:59Z") });
+    await evenement(a, { billingType: "metered_api", costCents: 700, occurredAt: dansLeCycle });
+    expect(await depenseCreditsInstance(db, cycle)).toBe(3500);
+  });
+
+  it("plafondCreditsClaude: atteint at 20000 cents by default, not at 19999", async () => {
+    const f = await amorcer();
+    const maintenant = new Date("2026-10-27T10:00:00Z");
+    await evenement(f, { billingType: "credits", costCents: 19999, occurredAt: dansLeCycle });
+    expect(await plafondCreditsClaude(db, maintenant, {})).toEqual({ atteint: false, depenseCentimes: 19999, plafondCentimes: 20000 });
+    await evenement(f, { billingType: "credits", costCents: 1, occurredAt: dansLeCycle });
+    expect(await plafondCreditsClaude(db, maintenant, {})).toEqual({ atteint: true, depenseCentimes: 20000, plafondCentimes: 20000 });
+  });
+
+  it("plafondCreditsClaude honours PAPERCLIP_CLAUDE_CREDITS_PLAFOND_CENTIMES and PAPERCLIP_CLAUDE_CREDITS_JOUR_CYCLE", async () => {
+    const f = await amorcer();
+    await evenement(f, { billingType: "credits", costCents: 500, occurredAt: new Date("2026-10-25T00:00:00Z") });
+    const maintenant = new Date("2026-10-27T10:00:00Z");
+    // Cycle du 1er : l'événement du 25 est dans le cycle ; plafond abaissé à 500.
+    const env = { PAPERCLIP_CLAUDE_CREDITS_PLAFOND_CENTIMES: "500", PAPERCLIP_CLAUDE_CREDITS_JOUR_CYCLE: "1" };
+    expect(await plafondCreditsClaude(db, maintenant, env)).toEqual({ atteint: true, depenseCentimes: 500, plafondCentimes: 500 });
+    // Cycle du 26 : l'événement du 25 sort de la fenêtre.
+    expect((await plafondCreditsClaude(db, maintenant, { ...env, PAPERCLIP_CLAUDE_CREDITS_JOUR_CYCLE: "26" })).depenseCentimes).toBe(0);
+  });
+});

 import { randomUUID } from "node:crypto";
-import { eq } from "drizzle-orm";
+import { eq, sql } from "drizzle-orm";
 import { afterAll, beforeAll, describe, expect, it } from "vitest";
 import { agents, budgetPolicies, companies, costEvents, createDb, goals, heartbeatRuns, projects } from "@paperclipai/db";
 import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
@@ -58,4 +58,186 @@ decrire("atelier : suppression d'entreprise avec projet lié à un objectif", ()
     expect(await db.select().from(heartbeatRuns).where(eq(heartbeatRuns.companyId, companyId))).toEqual([]);
     expect(await db.select().from(agents).where(eq(agents.companyId, companyId))).toEqual([]);
   });
+
+  it("supprime une entreprise ayant une ligne dans CHAQUE table qui porte une colonne company_id, sans ligne orpheline", async () => {
+    const companyId = randomUUID();
+    await db.insert(companies).values({ id: companyId, name: "Suppression totale", issuePrefix: `T${companyId.slice(0, 6).toUpperCase().replace(/-/g, "")}`, requireBoardApprovalForNewAgents: false });
+
+    const lignes = async (requete: string): Promise<Record<string, any>[]> => {
+      const r: any = await db.execute(sql.raw(requete));
+      return (r.rows ?? r) as Record<string, any>[];
+    };
+    const litteral = (v: unknown) => (v === null || v === undefined ? "NULL" : `'${String(v).replace(/'/g, "''")}'`);
+
+    const colonnes = await lignes(`select table_name, column_name, is_nullable, column_default, data_type, udt_name, is_identity
+      from information_schema.columns where table_schema = 'public' order by table_name, ordinal_position`);
+    const parTable = new Map<string, typeof colonnes>();
+    for (const c of colonnes) parTable.set(c.table_name, [...(parTable.get(c.table_name) ?? []), c]);
+
+    // Clés étrangères : une entrée par contrainte, avec ses colonnes locales et distantes.
+    const fks = await lignes(`select c.conrelid::regclass::text as t, c.confrelid::regclass::text as ref,
+        (select array_agg(a.attname order by k.ord) from unnest(c.conkey) with ordinality k(attnum, ord) join pg_attribute a on a.attrelid = c.conrelid and a.attnum = k.attnum) as cols,
+        (select array_agg(a.attname order by k.ord) from unnest(c.confkey) with ordinality k(attnum, ord) join pg_attribute a on a.attrelid = c.confrelid and a.attnum = k.attnum) as refcols
+      from pg_constraint c where c.contype = 'f' and c.connamespace = 'public'::regnamespace`);
+    const nettoyer = (n: string) => n.replace(/"/g, "");
+    const fksParTable = new Map<string, { ref: string; cols: string[]; refcols: string[] }[]>();
+    for (const f of fks) {
+      const t = nettoyer(f.t);
+      const cols = Array.isArray(f.cols) ? f.cols : String(f.cols).replace(/[{}]/g, "").split(",");
+      const refcols = Array.isArray(f.refcols) ? f.refcols : String(f.refcols).replace(/[{}]/g, "").split(",");
+      fksParTable.set(t, [...(fksParTable.get(t) ?? []), { ref: nettoyer(f.ref), cols, refcols }]);
+    }
+
+    const valeursEnum = new Map<string, string>();
+    for (const e of await lignes(`select t.typname, (array_agg(e.enumlabel order by e.enumsortorder))[1] as premiere
+        from pg_type t join pg_enum e on e.enumtypid = t.oid group by t.typname`)) valeursEnum.set(e.typname, e.premiere);
+
+    // Contraintes CHECK simples : on en déduit une valeur valide pour les colonnes concernées
+    // (énumérations textuelles `col = ANY (ARRAY['a', ...])`, égalités `col = 'a'`, empreintes hexadécimales).
+    const valeursCheck = new Map<string, string>();
+    for (const c of await lignes(`select conrelid::regclass::text as t, pg_get_constraintdef(oid) as def
+        from pg_constraint where contype = 'c' and connamespace = 'public'::regnamespace`)) {
+      const table = nettoyer(c.t);
+      for (const m of String(c.def).matchAll(/\(?"?(\w+)"?\)?(?:::text)? = ANY \(\(?ARRAY\['([^']+)'/g)) {
+        if (!valeursCheck.has(`${table}.${m[1]}`)) valeursCheck.set(`${table}.${m[1]}`, m[2]!);
+      }
+      for (const m of String(c.def).matchAll(/\(\(?"?(\w+)"?(?:::text)? = '([^']+)'::text\)/g)) {
+        if (!valeursCheck.has(`${table}.${m[1]}`)) valeursCheck.set(`${table}.${m[1]}`, m[2]!);
+      }
+      for (const m of String(c.def).matchAll(/"?(\w+)"? ~ '\^\[a-f0-9\]\{64\}\$'/g)) {
+        valeursCheck.set(`${table}.${m[1]}`, "a".repeat(64));
+      }
+    }
+
+    // Cas où le schéma impose, hors clés étrangères évidentes, une forme précise de ligne :
+    // colonnes facultatives qu'une contrainte CHECK rend obligatoires, et valeurs fixes.
+    const colonnesForcees: Record<string, string[]> = {
+      decision_queues: ["created_by_agent_id"],
+      decision_queue_items: ["added_by_agent_id"],
+      decision_triage: ["set_by_agent_id"],
+      decision_triage_events: ["actor_agent_id"],
+      document_annotation_threads: ["issue_id"],
+      document_annotation_comments: ["issue_id"],
+    };
+    const valeursFixes: Record<string, Record<string, string>> = {
+      chat_discord_command_owners: { application_id: "12345678901234567" },
+      company_secret_proposals: { proposed_name: "secret-test", proposed_key: "SECRET_TEST" },
+    };
+
+    const creees = new Map<string, Record<string, any>>();
+    const enCours = new Set<string>();
+    const valeurPourType = (c: Record<string, any>): string => {
+      const t = c.data_type as string;
+      if (t === "uuid") return randomUUID();
+      if (t === "boolean") return "false";
+      if (["integer", "bigint", "smallint", "numeric", "real", "double precision"].includes(t)) return "1";
+      if (t === "jsonb" || t === "json") return "{}";
+      if (t === "ARRAY") return "{}";
+      if (t.startsWith("timestamp") || t === "date") return "2026-01-01T00:00:00Z";
+      if (t === "USER-DEFINED") return valeursEnum.get(c.udt_name) ?? "x";
+      if (t === "bytea") return "\\x00";
+      return `x-${randomUUID()}`;
+    };
+    const renseignerColonne = async (table: string, ligne: Record<string, any>, colonne: string): Promise<void> => {
+      const lien = (fksParTable.get(table) ?? []).find((f) => f.cols.length === 1 && f.cols[0] === colonne);
+      if (!lien) {
+        // Colonne uuid sans clé étrangère déclarée (ex. heartbeat_runs.native_issue_id) : on y met une demande réelle.
+        const cible = colonne.endsWith("issue_id") ? "issues" : colonne.endsWith("completion_contract_id") ? "completion_contracts" : null;
+        if (!cible) throw new Error(`colonne ${table}.${colonne} nulle et sans clé étrangère simple`);
+        const demande = await creer(cible);
+        ligne[colonne] = demande.id;
+        await lignes(`update "${table}" set "${colonne}" = '${demande.id}' where id = '${ligne.id}'`);
+        return;
+      }
+      const parent = await creer(lien.ref);
+      ligne[colonne] = parent[lien.refcols[0]!];
+      await lignes(`update "${table}" set "${colonne}" = '${ligne[colonne]}' where id = '${ligne.id}'`);
+    };
+    const creer = async (table: string, nouvelle = false): Promise<Record<string, any>> => {
+      const deja = creees.get(table);
+      if (deja && !nouvelle) return deja;
+      if (enCours.has(table)) throw new Error(`cycle de clés étrangères obligatoires sur ${table}`);
+      const cols = parTable.get(table) ?? [];
+      if (!cols.some((c) => c.column_name === "company_id")) {
+        // Table globale (sans entreprise) : on réutilise une ligne existante, sinon on en crée une.
+        const existante = (await lignes(`select * from "${table}" limit 1`))[0];
+        if (existante) {
+          creees.set(table, existante);
+          return existante;
+        }
+      }
+      enCours.add(table);
+      const nomsColonnes = new Set(cols.map((c) => c.column_name as string));
+      const valeurs = new Map<string, string>();
+      const liens = fksParTable.get(table) ?? [];
+      for (const f of liens) {
+        const obligatoire = f.cols.every((nom) => nom === "company_id" || cols.find((c) => c.column_name === nom)?.is_nullable === "NO" || colonnesForcees[table]?.includes(nom));
+        if (!obligatoire || f.cols.every((nom) => nom === "company_id")) continue;
+        const parent = f.ref === "companies" ? { id: companyId } : await creer(f.ref);
+        for (const nomRef of f.refcols) {
+          // Colonne nullable de la ligne parente qu'une clé composite exige : on la renseigne d'abord.
+          if (f.ref !== "companies" && parent[nomRef] === null) await renseignerColonne(f.ref, parent, nomRef);
+        }
+        f.cols.forEach((nom, i) => valeurs.set(nom, f.ref === "companies" ? companyId : String(parent[f.refcols[i]!])));
+      }
+      if (table === "pipeline_case_blockers") {
+        // La contrainte interdit qu'un dossier se bloque lui-même : deux dossiers distincts.
+        valeurs.set("case_id", String((await creer("pipeline_cases")).id));
+        valeurs.set("blocked_by_case_id", String((await creer("pipeline_cases", true)).id));
+      }
+      for (const [nom, valeur] of Object.entries(valeursFixes[table] ?? {})) valeurs.set(nom, valeur);
+      if (nomsColonnes.has("company_id")) valeurs.set("company_id", companyId);
+      for (const c of cols) {
+        if (valeurs.has(c.column_name)) continue;
+        if (c.is_nullable === "YES" || c.column_default !== null || c.is_identity === "YES") continue;
+        valeurs.set(c.column_name, valeursCheck.get(`${table}.${c.column_name}`) ?? valeurPourType(c));
+      }
+      const noms = [...valeurs.keys()];
+      const requete = noms.length === 0
+        ? `insert into "${table}" default values returning *`
+        : `insert into "${table}" (${noms.map((n) => `"${n}"`).join(", ")}) values (${noms.map((n) => litteral(valeurs.get(n))).join(", ")}) returning *`;
+      let ligne: Record<string, any>;
+      try {
+        ligne = (await lignes(requete))[0]!;
+      } catch (e) {
+        throw new Error(`insertion impossible dans ${table} : ${(e as Error).message} ${String((e as { cause?: unknown }).cause)}`);
+      }
+      enCours.delete(table);
+      if (!nouvelle) creees.set(table, ligne);
+      return ligne;
+    };
+
+    const tablesEntreprise = [...parTable.entries()]
+      .filter(([nom, cols]) => nom !== "companies" && cols.some((c) => c.column_name === "company_id"))
+      .map(([nom]) => nom)
+      .sort();
+    const echecs: string[] = [];
+    for (const table of tablesEntreprise) {
+      try {
+        await creer(table);
+      } catch (e) {
+        enCours.clear();
+        echecs.push((e as Error).message.replace(/Failed query: insert into "(\w+)".*?params:/s, "$1 :"));
+      }
+    }
+    expect(echecs, "tables impossibles à remplir").toEqual([]);
+    // Garde-fou : on a bien une ligne dans chaque table à risque.
+    for (const table of tablesEntreprise) {
+      const r = await lignes(`select count(*)::int as n from "${table}" where company_id = '${companyId}'`);
+      expect(r[0]!.n, `ligne de départ absente dans ${table}`).toBeGreaterThan(0);
+    }
+    expect(tablesEntreprise.length).toBeGreaterThan(50);
+
+    const supprimee = await companyService(db).remove(companyId);
+    expect(supprimee?.id).toBe(companyId);
+    // Pierre tombale volontaire, sans clé étrangère : elle survit à l'entreprise pour empêcher qu'un autre
+    // point d'accès ne revendique la même application Discord (voir schema/chat_discord_command_owners.ts).
+    const survivantesVoulues = new Set(["chat_discord_command_owners"]);
+    const orphelines: string[] = [];
+    for (const table of tablesEntreprise.filter((t) => !survivantesVoulues.has(t))) {
+      const r = await lignes(`select count(*)::int as n from "${table}" where company_id = '${companyId}'`);
+      if (r[0]!.n !== 0) orphelines.push(table);
+    }
+    expect(orphelines, "tables où des lignes de l'entreprise subsistent").toEqual([]);
+  }, 120_000);
 });

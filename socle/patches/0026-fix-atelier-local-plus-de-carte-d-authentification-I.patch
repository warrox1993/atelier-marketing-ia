diff --git a/packages/adapters/claude-local/src/server/parse.ts b/packages/adapters/claude-local/src/server/parse.ts
index 8004885c7..558a0c3ef 100644
--- a/packages/adapters/claude-local/src/server/parse.ts
+++ b/packages/adapters/claude-local/src/server/parse.ts
@@ -265,8 +265,14 @@ export function detectClaudeLoginRequired(input: {
     claudeResultIndicatesAuthFailure(parsed) &&
     CLAUDE_AUTH_TOKEN_FAILURE_RE.test(collectClaudeTerminalText(parsed));
 
+  // A run that reached its turn limit made authenticated provider calls on
+  // every turn. Login-prompt words seen in that run's stdout come from loaded
+  // skills or tool output (for example "unauthorized recipients"), never from
+  // the CLI asking for a login, so the run is never an authentication failure.
+  const reachedMaxTurns = isClaudeMaxTurnsResult(parsed);
+
   return {
-    requiresLogin: loginPrompt || tokenFailure,
+    requiresLogin: !reachedMaxTurns && (loginPrompt || tokenFailure),
     loginUrl: extractClaudeLoginUrl([input.stdout, input.stderr].join("\n")),
   };
 }

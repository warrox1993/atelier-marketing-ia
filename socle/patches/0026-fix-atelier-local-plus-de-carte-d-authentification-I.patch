+    // The same stdout without the turn-limit result still reads as a login prompt.
+    expect(
+      detectClaudeLoginRequired({ parsed: { is_error: true, subtype: "error_during_execution" }, stdout, stderr: "" }).requiresLogin,
+    ).toBe(true);
+  });

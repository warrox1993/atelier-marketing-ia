+++ b/packages/adapter-utils/src/local-process-sandbox.api-protegee.test.ts
@@ -0,0 +1,205 @@
+import http from "node:http";
+import net from "node:net";
+import { afterEach, describe, expect, it } from "vitest";
+import { buildLocalProcessSandboxSpawnTarget } from "./local-process-sandbox.js";
+
+// Tests de l'origine protégée : l'API Paperclip n'est joignable depuis le bac à sable
+// qu'avec un en-tête Authorization: Bearer, par HTTP direct comme à travers CONNECT.
+
+const aNettoyer: Array<() => Promise<void>> = [];
+afterEach(async () => {
+  for (const nettoyer of aNettoyer.splice(0)) await nettoyer();
+});
+
+interface Banc {
+  socketPath: string;
+  apiPort: number;
+  autrePort: number;
+  appelsApi: Array<{ authorization: string | string[] | undefined; url: string | undefined }>;
+  appelsAutre: number;
+}
+
+async function ecouter(serveur: http.Server): Promise<number> {
+  await new Promise<void>((resolve) => serveur.listen(0, "127.0.0.1", resolve));
+  const adresse = serveur.address();
+  if (!adresse || typeof adresse === "string") throw new Error("Adresse TCP attendue.");
+  aNettoyer.push(() => new Promise<void>((resolve) => {
+    serveur.closeAllConnections?.();
+    serveur.close(() => resolve());
+  }));
+  return adresse.port;
+}
+
+async function monterBanc(): Promise<Banc> {
+  const banc = { appelsApi: [], appelsAutre: 0 } as unknown as Banc;
+  banc.appelsApi = [];
+  banc.appelsAutre = 0;
+  const api = http.createServer((requete, reponse) => {
+    banc.appelsApi.push({ authorization: requete.headers.authorization, url: requete.url });
+    reponse.end("reponse-api");
+  });
+  const autre = http.createServer((_requete, reponse) => {
+    banc.appelsAutre += 1;
+    reponse.end("reponse-autre");
+  });
+  banc.apiPort = await ecouter(api);
+  banc.autrePort = await ecouter(autre);
+  const cible = await buildLocalProcessSandboxSpawnTarget({
+    executable: process.execPath,
+    args: ["-e", "process.exit(0)"],
+    cwd: "/tmp",
+    options: {
+      workspaceDir: "/tmp",
+      networkScope: "allowlist",
+      networkAllowlist: [`127.0.0.1:${banc.autrePort}`],
+      networkTrustedUrls: [`http://127.0.0.1:${banc.apiPort}/api`],
+      networkProtectedOrigins: [`http://127.0.0.1:${banc.apiPort}/api`],
+    },
+  });
+  aNettoyer.push(async () => { await cible.cleanup?.(); });
+  banc.socketPath = cible.args[cible.args.indexOf("--") + 3]!;
+  return banc;
+}
+
+interface Reponse { statut: number; corps: string }
+
+/** Requête HTTP brute sur la socket du mandataire (permet de forcer des en-têtes en double). */
+function requeteBrute(socketPath: string, texte: string, attendreFin = true): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const socket = net.createConnection(socketPath, () => socket.write(texte));
+    let recu = "";
+    socket.setEncoding("utf8");
+    socket.on("data", (morceau) => { recu += morceau; });
+    socket.on("end", () => resolve(recu));
+    socket.on("error", reject);
+    if (!attendreFin) setTimeout(() => { socket.destroy(); resolve(recu); }, 300);
+  });
+}
+
+function analyser(brut: string): Reponse {
+  const statut = Number(/^HTTP\/1\.1 (\d+)/.exec(brut)?.[1] ?? 0);
+  return { statut, corps: brut.split("\r\n\r\n").slice(1).join("\r\n\r\n") };
+}
+
+function httpDirect(banc: Banc, entetes: string[]): Promise<Reponse> {
+  const url = `http://127.0.0.1:${banc.apiPort}/api/issues/1`;
+  const texte = [`GET ${url} HTTP/1.1`, `Host: 127.0.0.1:${banc.apiPort}`, ...entetes, "Connection: close", "", ""].join("\r\n");
+  return requeteBrute(banc.socketPath, texte).then(analyser);
+}
+
+/** CONNECT vers `cible`, puis une requête relative à travers le tunnel (Connection: close pour finir proprement). */
+function viaConnect(banc: Banc, cible: string, entetes: string[]): Promise<{ connect: string; reponse: Reponse }> {
+  return new Promise((resolve, reject) => {
+    const socket = net.createConnection(banc.socketPath, () => {
+      socket.write(`CONNECT ${cible} HTTP/1.1\r\nHost: ${cible}\r\n\r\n`);
+    });
+    let recu = "";
+    let ligneConnect: string | null = null;
+    let requeteEnvoyee = false;
+    socket.setEncoding("utf8");
+    socket.on("data", (morceau) => {
+      recu += morceau;
+      if (!requeteEnvoyee && recu.includes("\r\n\r\n")) {
+        if (!recu.startsWith("HTTP/1.1 200")) return;
+        ligneConnect = recu.split("\r\n")[0]!;
+        recu = recu.slice(recu.indexOf("\r\n\r\n") + 4);
+        requeteEnvoyee = true;
+        socket.write(["GET /api/issues/1 HTTP/1.1", `Host: ${cible}`, ...entetes, "Connection: close", "", ""].join("\r\n"));
+      }
+    });
+    socket.on("end", () => {
+      if (ligneConnect === null) resolve({ connect: recu.split("\r\n")[0] ?? "", reponse: analyser(recu) });
+      else resolve({ connect: ligneConnect, reponse: analyser(recu) });
+    });
+    socket.on("error", reject);
+  });
+}
+
+describe.runIf(process.platform === "linux")("origine protégée du mandataire de bac à sable", () => {
+  it("refuse en 403 une requête HTTP sans Authorization, sans contacter le serveur", async () => {
+    const banc = await monterBanc();
+    const reponse = await httpDirect(banc, []);
+    expect(reponse.statut).toBe(403);
+    expect(JSON.parse(reponse.corps)).toEqual({ error: "sandbox_api_token_required" });
+    expect(banc.appelsApi).toHaveLength(0);
+  });
+
+  it.each([
+    ["schéma Basic", ["Authorization: Basic x"]],
+    ["valeur vide", ["Authorization:"]],
+    ["schéma Token", ["Authorization: Token abc"]],
+    ["Bearer sans jeton", ["Authorization: Bearer"]],
+    ["liste de valeurs", ["Authorization: Bearer abc, Bearer def"]],
+    ["deux en-têtes", ["Authorization: Bearer abc", "Authorization: Bearer def"]],
+    ["deux en-têtes (casse mixte)", ["Authorization: Bearer abc", "authorization: Bearer def"]],
+  ])("refuse en 403 : %s", async (_nom, entetes) => {
+    const banc = await monterBanc();
+    const reponse = await httpDirect(banc, entetes);
+    expect(reponse.statut).toBe(403);
+    expect(JSON.parse(reponse.corps)).toEqual({ error: "sandbox_api_token_required" });
+    expect(banc.appelsApi).toHaveLength(0);
+  });
+
+  it("relaie une requête HTTP avec Bearer, en-tête transmis intact", async () => {
+    const banc = await monterBanc();
+    const reponse = await httpDirect(banc, ["Authorization: Bearer abc"]);
+    expect(reponse.statut).toBe(200);
+    expect(reponse.corps).toBe("reponse-api");
+    expect(banc.appelsApi).toEqual([{ authorization: "Bearer abc", url: "/api/issues/1" }]);
+  });
+
+  it("CONNECT vers l'API puis requête sans jeton : 403, serveur non contacté", async () => {
+    const banc = await monterBanc();
+    const { connect, reponse } = await viaConnect(banc, `127.0.0.1:${banc.apiPort}`, []);
+    expect(connect).toBe("HTTP/1.1 200 Connection established");
+    expect(reponse.statut).toBe(403);
+    expect(JSON.parse(reponse.corps)).toEqual({ error: "sandbox_api_token_required" });
+    expect(banc.appelsApi).toHaveLength(0);
+  });
+
+  it("CONNECT vers l'API puis deux en-têtes Authorization : 403", async () => {
+    const banc = await monterBanc();
+    const { reponse } = await viaConnect(banc, `127.0.0.1:${banc.apiPort}`, ["Authorization: Bearer a", "Authorization: Bearer b"]);
+    expect(reponse.statut).toBe(403);
+    expect(banc.appelsApi).toHaveLength(0);
+  });
+
+  it("CONNECT vers l'API puis requête avec Bearer : 200, en-tête transmis intact", async () => {
+    const banc = await monterBanc();
+    const { connect, reponse } = await viaConnect(banc, `127.0.0.1:${banc.apiPort}`, ["Authorization: Bearer abc"]);
+    expect(connect).toBe("HTTP/1.1 200 Connection established");
+    expect(reponse.statut).toBe(200);
+    expect(reponse.corps).toBe("reponse-api");
+    expect(banc.appelsApi).toEqual([{ authorization: "Bearer abc", url: "/api/issues/1" }]);
+  });
+
+  it("dans le tunnel, l'en-tête Host n'oriente pas la requête vers une autre origine", async () => {
+    const banc = await monterBanc();
+    const { reponse } = await viaConnect(banc, `127.0.0.1:${banc.apiPort}`, [`Host: 127.0.0.1:${banc.autrePort}`, "Authorization: Bearer abc"]);
+    expect(reponse.statut).toBe(200);
+    expect(banc.appelsApi).toHaveLength(1);
+    expect(banc.appelsAutre).toBe(0);
+  });
+
+  it("CONNECT vers un autre hôte de confiance : tunnel brut inchangé, sans contrôle du jeton", async () => {
+    const banc = await monterBanc();
+    const { connect, reponse } = await viaConnect(banc, `127.0.0.1:${banc.autrePort}`, []);
+    expect(connect).toBe("HTTP/1.1 200 Connection Established");
+    expect(reponse.statut).toBe(200);
+    expect(reponse.corps).toBe("reponse-autre");
+    expect(banc.appelsAutre).toBe(1);
+  });
+
+  it("hôte non autorisé : refus inchangé (HTTP et CONNECT)", async () => {
+    const banc = await monterBanc();
+    const http403 = analyser(await requeteBrute(
+      banc.socketPath,
+      "GET http://example.com/ HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n",
+    ));
+    expect(http403.statut).toBe(403);
+    expect(http403.corps).toContain("network_target_denied");
+    const connect = analyser(await requeteBrute(banc.socketPath, "CONNECT example.com:443 HTTP/1.1\r\nHost: example.com:443\r\n\r\n"));
+    expect(connect.statut).toBe(403);
+    expect(connect.corps).toContain("network_target_denied");
+  });
+});

+const BEARER_AUTHORIZATION = /^Bearer\s+\S+$/i;
+
+function writeSandboxTokenRequired(response: http.ServerResponse): void {
+  const body = `${JSON.stringify({ error: "sandbox_api_token_required" })}\n`;
+  response.writeHead(403, {
+    "Content-Type": "application/json; charset=utf-8",
+    "Content-Length": Buffer.byteLength(body),
+    Connection: "close",
+  }).end(body);
+}
+
+/** Exige exactement un en-tête `authorization` de la forme `Bearer <jeton>` (rawHeaders : Node écarte les doublons). */
+function hasSingleBearerAuthorization(request: http.IncomingMessage): boolean {
+  let count = 0;
+  let value = "";
+  for (let index = 0; index < request.rawHeaders.length; index += 2) {
+    if (request.rawHeaders[index]!.toLowerCase() === "authorization") {
+      count += 1;
+      value = request.rawHeaders[index + 1] ?? "";
+    }
+  }
+  return count === 1 && BEARER_AUTHORIZATION.test(value.trim());
+}
+
 async function startNetworkAllowlistProxy(

diff --git a/server/src/services/atelier-gateway.ts b/server/src/services/atelier-gateway.ts
new file mode 100644
index 000000000..7eba198a1
--- /dev/null
+++ b/server/src/services/atelier-gateway.ts
@@ -0,0 +1,216 @@
+/**
+ * Atelier Marketing IA (local patch 0004): curated gallery cards for the local
+ * marketing gateway ("passerelle marketing", one MCP server per path
+ * `/mcp/<service>`).
+ *
+ * The definitions in `packages/shared/src/app-definitions/atelier-*.json` ship
+ * the default address `http://127.0.0.1:3190`. The operator moves the gateway
+ * with `PAPERCLIP_ATELIER_GATEWAY_URL`; this module rewrites the endpoint and
+ * URL pattern of those definitions in place so that every server path reading
+ * `method.defaults.serverUrl` (setup, OAuth, health, catalog) sees the same
+ * address. It never touches another definition.
+ *
+ * The gateway reports its mode on `GET /sante` (`demonstration` or `reel`).
+ * In demonstration mode the gateway's own authorization server only grants its
+ * demonstration scope, so the provider scopes declared by the definitions are
+ * withheld (no `scope` parameter) and restored in real mode. Cards and new
+ * connections are labelled "(démonstration)" while that mode is reported.
+ */
+import type { AppDefinition } from "@paperclipai/shared";
+import { APP_DEFINITIONS } from "@paperclipai/shared";
+
+export const ATELIER_GATEWAY_URL_ENV = "PAPERCLIP_ATELIER_GATEWAY_URL";
+export const ATELIER_GATEWAY_DEFAULT_URL = "http://127.0.0.1:3190";
+export const ATELIER_APP_SLUG_PREFIX = "atelier-";
+const STATUS_TTL_MS = 15_000;
+const PROBE_TIMEOUT_MS = 2_000;
+
+export type AtelierGatewayMode = "demonstration" | "reel";
+export type AtelierGatewayStatus =
+  | { reachable: true; baseUrl: string; mode: AtelierGatewayMode; services: string[] }
+  | { reachable: false; baseUrl: string; reason: string };
+
+type Fetcher = (url: string, init: RequestInit) => Promise<Response>;
+
+interface PristineMethod {
+  servicePath: string;
+  scopesHint: string[] | undefined;
+}
+
+const pristine = new WeakMap<object, PristineMethod>();
+let cachedStatus: { at: number; status: AtelierGatewayStatus } | null = null;
+
+export function isAtelierAppSlug(slug: string | null | undefined): boolean {
+  return typeof slug === "string" && slug.startsWith(ATELIER_APP_SLUG_PREFIX);
+}
+
+export function atelierAppDefinitions(
+  definitions: readonly AppDefinition[] = APP_DEFINITIONS,
+): AppDefinition[] {
+  return definitions.filter((app) => isAtelierAppSlug(app.slug));
+}
+
+/** Operator-configured gateway origin (no trailing slash). Throws on an invalid value. */
+export function atelierGatewayBaseUrl(env: NodeJS.ProcessEnv = process.env): string {
+  const raw = env[ATELIER_GATEWAY_URL_ENV]?.trim() || ATELIER_GATEWAY_DEFAULT_URL;
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    throw new Error(`${ATELIER_GATEWAY_URL_ENV} must be an absolute http(s) URL, got "${raw}"`);
+  }
+  if (url.protocol !== "http:" && url.protocol !== "https:") {
+    throw new Error(`${ATELIER_GATEWAY_URL_ENV} must use http or https, got "${raw}"`);
+  }
+  if (url.username || url.password || url.search || url.hash) {
+    throw new Error(`${ATELIER_GATEWAY_URL_ENV} must not contain credentials, a query or a fragment`);
+  }
+  return url.toString().replace(/\/+$/, "");
+}
+
+const LOOPBACK_HOSTS = new Set(["127.0.0.1", "[::1]", "localhost"]);
+
+/**
+ * Curated definitions must use HTTPS. The one exception is the operator's own
+ * gateway on the loopback interface (the default), mirroring the loopback
+ * allowance of the generic remote MCP route. Any other http URL stays refused.
+ */
+export function isAtelierLoopbackGatewayUrl(url: URL, env: NodeJS.ProcessEnv = process.env): boolean {
+  if (url.protocol !== "http:" || !LOOPBACK_HOSTS.has(url.hostname)) return false;
+  let base: string;
+  try {
+    base = atelierGatewayBaseUrl(env);
+  } catch {
+    return false;
+  }
+  return url.toString().startsWith(`${base}/mcp/`);
+}
+
+/** The `/mcp/<service>` path a definition was authored with. */
+export function atelierServicePath(app: AppDefinition): string {
+  const method = app.methods[0];
+  const remembered = method ? pristine.get(method)?.servicePath : undefined;
+  if (remembered) return remembered;
+  const serverUrl = method?.defaults?.serverUrl;
+  if (!serverUrl) throw new Error(`Atelier app ${app.slug} has no serverUrl`);
+  return new URL(serverUrl).pathname;
+}
+
+export function atelierServiceId(app: AppDefinition): string {
+  return atelierServicePath(app).replace(/^\/mcp\//, "");
+}
+
+/**
+ * Point every atelier definition at `baseUrl` and apply the scope policy of
+ * `mode` (`null` = mode unknown: keep the declared provider scopes).
+ * Idempotent; the authored values are remembered on first call.
+ */
+export function configureAtelierAppDefinitions(
+  baseUrl: string,
+  mode: AtelierGatewayMode | null,
+  definitions: readonly AppDefinition[] = APP_DEFINITIONS,
+): void {
+  for (const app of atelierAppDefinitions(definitions)) {
+    const urls: string[] = [];
+    for (const method of app.methods) {
+      let original = pristine.get(method);
+      if (!original) {
+        const serverUrl = method.defaults?.serverUrl;
+        if (!serverUrl) throw new Error(`Atelier app ${app.slug}/${method.key} has no serverUrl`);
+        original = {
+          servicePath: new URL(serverUrl).pathname,
+          scopesHint: method.defaults?.scopesHint ? [...method.defaults.scopesHint] : undefined,
+        };
+        pristine.set(method, original);
+      }
+      const url = `${baseUrl}${original.servicePath}`;
+      const defaults = (method.defaults ??= {});
+      defaults.serverUrl = url;
+      if (mode === "demonstration" || !original.scopesHint) delete defaults.scopesHint;
+      else defaults.scopesHint = [...original.scopesHint];
+      urls.push(url);
+    }
+    app.urlPatterns = [...new Set(urls)];
+  }
+}
+
+export function resetAtelierGatewayCache(): void {
+  cachedStatus = null;
+}
+
+/** Reads `GET <gateway>/sante` (cached 15 s) and re-points the definitions accordingly. */
+export async function syncAtelierGateway(
+  fetcher: Fetcher = (url, init) => fetch(url, init),
+  now: number = Date.now(),
+): Promise<AtelierGatewayStatus> {
+  const baseUrl = atelierGatewayBaseUrl();
+  if (cachedStatus && cachedStatus.status.baseUrl === baseUrl && now - cachedStatus.at < STATUS_TTL_MS) {
+    return cachedStatus.status;
+  }
+  let status: AtelierGatewayStatus;
+  try {
+    const response = await fetcher(`${baseUrl}/sante`, {
+      method: "GET",
+      headers: { accept: "application/json" },
+      signal: AbortSignal.timeout(PROBE_TIMEOUT_MS),
+    });
+    const body = (response.ok ? await response.json() : null) as {
+      mode?: unknown;
+      services?: unknown;
+    } | null;
+    if (body && (body.mode === "demonstration" || body.mode === "reel")) {
+      status = {
+        reachable: true,
+        baseUrl,
+        mode: body.mode,
+        services: Array.isArray(body.services)
+          ? body.services.filter((entry): entry is string => typeof entry === "string")
+          : [],
+      };
+    } else {
+      status = { reachable: false, baseUrl, reason: `réponse inattendue de ${baseUrl}/sante` };
+    }
+  } catch {
+    status = { reachable: false, baseUrl, reason: `aucune réponse de ${baseUrl}/sante` };
+  }
+  configureAtelierAppDefinitions(baseUrl, status.reachable ? status.mode : null);
+  cachedStatus = { at: now, status };
+  return status;
+}
+
+export const ATELIER_DEMONSTRATION_SUFFIX = " (démonstration)";
+
+/**
+ * Gallery and setup view of an atelier definition for the current gateway
+ * status: "(démonstration)" label, or an explicit unavailable state (no dead
+ * Connect button) when the gateway is unreachable or does not serve the service.
+ */
+export function atelierAppForStatus(app: AppDefinition, status: AtelierGatewayStatus): AppDefinition {
+  if (!isAtelierAppSlug(app.slug)) return app;
+  if (!status.reachable) {
+    return {
+      ...app,
+      availability: {
+        available: false,
+        reason: `Passerelle marketing injoignable (${status.reason}). Démarrez-la ou réglez ${ATELIER_GATEWAY_URL_ENV}.`,
+      },
+    };
+  }
+  if (!status.services.includes(atelierServiceId(app))) {
+    return {
+      ...app,
+      availability: {
+        available: false,
+        reason: `La passerelle marketing (mode ${status.mode}) ne sert pas ce service.`,
+      },
+    };
+  }
+  if (status.mode === "demonstration") {
+    return {
+      ...app,
+      name: `${app.name}${ATELIER_DEMONSTRATION_SUFFIX}`,
+      description: `Démonstration : données fictives, aucune activité réelle. ${app.description}`,
+    };
+  }
+  return app;
+}

diff --git a/packages/shared/src/atelier-app-definitions.test.ts b/packages/shared/src/atelier-app-definitions.test.ts
new file mode 100644
index 000000000..370f3eb98
--- /dev/null
+++ b/packages/shared/src/atelier-app-definitions.test.ts
@@ -0,0 +1,74 @@
+// Atelier Marketing IA (local patch 0004): marketing gateway gallery cards.
+import { describe, expect, it } from "vitest";
+import { APP_DEFINITIONS } from "./app-definitions.generated.js";
+import {
+  APP_STORE_DEFINITIONS,
+  appSupportsAutomaticOAuth,
+  getAppDefinitionForUrl,
+  getRecommendedConnectionMethod,
+  getAvailableConnectionMethods,
+} from "./app-definitions.js";
+import { GOOGLE_WORKSPACE_CONNECTOR_PROFILES } from "./google-workspace-connectors.js";
+import { appDefinitionSchema } from "./validators/app-definition.js";
+
+const EXPECTED: Record<string, { service: string; name: string; read: string[]; write: string[] }> = {
+  "atelier-google-search-console": { service: "gsc", name: "Google Search Console", read: ["https://www.googleapis.com/auth/webmasters.readonly"], write: ["https://www.googleapis.com/auth/webmasters"] },
+  "atelier-google-analytics": { service: "ga4", name: "Google Analytics 4", read: ["https://www.googleapis.com/auth/analytics.readonly"], write: ["https://www.googleapis.com/auth/analytics.readonly", "https://www.googleapis.com/auth/analytics.edit"] },
+  "atelier-google-ads": { service: "ads", name: "Google Ads", read: ["https://www.googleapis.com/auth/adwords"], write: ["https://www.googleapis.com/auth/adwords"] },
+  "atelier-google-business-profile": { service: "gbp", name: "Fiche d'établissement Google", read: ["https://www.googleapis.com/auth/business.manage"], write: ["https://www.googleapis.com/auth/business.manage"] },
+  "atelier-facebook": { service: "facebook", name: "Facebook (pages)", read: ["pages_show_list", "pages_read_engagement", "pages_read_user_engagement"], write: ["pages_show_list", "pages_read_engagement", "pages_read_user_engagement", "pages_manage_posts", "pages_manage_engagement"] },
+  "atelier-instagram": { service: "instagram", name: "Instagram professionnel", read: ["instagram_business_basic"], write: ["instagram_business_basic", "instagram_business_content_publish"] },
+  "atelier-linkedin": { service: "linkedin", name: "LinkedIn (pages)", read: ["r_organization_social"], write: ["r_organization_social", "w_organization_social"] },
+  "atelier-hubspot": { service: "crm", name: "HubSpot", read: ["crm.objects.contacts.read", "crm.objects.deals.read"], write: ["crm.objects.contacts.read", "crm.objects.deals.read", "crm.objects.contacts.write", "crm.objects.deals.write"] },
+  "atelier-pipedrive": { service: "pipedrive", name: "Pipedrive", read: ["contacts:read", "deals:read"], write: ["contacts:full", "deals:full"] },
+  "atelier-odoo": { service: "odoo", name: "Odoo CRM", read: [], write: [] },
+  "atelier-teamleader": { service: "teamleader", name: "Teamleader Focus", read: [], write: [] },
+};
+
+const atelier = APP_DEFINITIONS.filter((app) => app.slug.startsWith("atelier-"));
+
+describe("atelier marketing gateway cards", () => {
+  it("ships exactly the eleven gateway services, all visible in the store", () => {
+    expect(atelier.map((app) => app.slug).sort()).toEqual(Object.keys(EXPECTED).sort());
+    const store = new Set(APP_STORE_DEFINITIONS.map((app) => app.slug));
+    for (const app of atelier) expect(store.has(app.slug), app.slug).toBe(true);
+  });
+
+  it.each(Object.entries(EXPECTED))("%s points at its gateway path with separate read and write methods", (slug, expected) => {
+    const app = atelier.find((entry) => entry.slug === slug)!;
+    expect(() => appDefinitionSchema.parse(app)).not.toThrow();
+    expect(app.name).toBe(expected.name);
+    expect(app.categories).toContain("marketing");
+    expect(app.description.length).toBeLessThanOrEqual(120);
+    expect(app.branding.logoUrl).toMatch(/^\/brands\/apps\/atelier-[a-z-]+\.svg$/);
+    expect(app.agentInstructions?.text).toContain("atelier_identite");
+    expect(app.methods.map((method) => method.key)).toEqual(["lecture", "publication"]);
+    for (const method of app.methods) {
+      expect(method).toMatchObject({ transport: "mcp_remote", auth: "oauth" });
+      expect(method.ownershipModes).toEqual(["dcr", "customer"]);
+      expect(method.defaults?.serverUrl).toBe(`http://127.0.0.1:3190/mcp/${expected.service}`);
+    }
+    const [read, write] = app.methods;
+    expect(read.defaults?.scopesHint ?? []).toEqual(expected.read);
+    expect(write.defaults?.scopesHint ?? []).toEqual(expected.write);
+    expect(app.urlPatterns).toEqual([`http://127.0.0.1:3190/mcp/${expected.service}`]);
+    expect(getAppDefinitionForUrl(`http://127.0.0.1:3190/mcp/${expected.service}`)?.slug).toBe(slug);
+    expect(appSupportsAutomaticOAuth(app)).toBe(true);
+  });
+
+  it("defaults a click to the read-only method", () => {
+    for (const app of atelier)
+      expect(getRecommendedConnectionMethod(getAvailableConnectionMethods(app))?.key, app.slug).toBe("lecture");
+  });
+
+  it("is not caught by the temporary Google Workspace visibility hold of the Connections page", () => {
+    // Browse.tsx hides exactly the app slugs of GOOGLE_WORKSPACE_CONNECTOR_PROFILES.
+    const held = new Set(Object.values(GOOGLE_WORKSPACE_CONNECTOR_PROFILES).map((profile) => profile.appSlug));

+++ b/server/src/__tests__/atelier-marketing-apps.test.ts
@@ -0,0 +1,238 @@
+// Atelier Marketing IA (local patch 0004): gallery cards backed by the local
+// marketing gateway. A fixture gateway answers /sante, RFC 9728/8414 metadata,
+// DCR, token and MCP requests; no real provider is contacted.
+import { randomUUID } from "node:crypto";
+import express from "express";
+import request from "supertest";
+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import { getConnectableAppDefinition } from "@paperclipai/shared";
+import { companies, companyMemberships, createDb, toolConnections } from "@paperclipai/db";
+import { eq } from "drizzle-orm";
+import { errorHandler } from "../middleware/index.js";
+import { toolAccessRoutes } from "../routes/tool-access.js";
+import { toolAccessService } from "../services/tool-access.js";
+import {
+  ATELIER_GATEWAY_URL_ENV,
+  atelierGatewayBaseUrl,
+  configureAtelierAppDefinitions,
+  isAtelierLoopbackGatewayUrl,
+  resetAtelierGatewayCache,
+} from "../services/atelier-gateway.js";
+import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
+
+const support = await getEmbeddedPostgresTestSupport();
+const BASE = "https://passerelle.example";
+const actor = { actorType: "user" as const, actorId: "atelier-reviewer" };
+const redirectUri = "http://localhost:3100/api/tools/oauth/callback";
+const ACCESS_TOKEN = "atelier-fixture-access-token";
+
+function fixtureGateway(mode: "demonstration" | "reel", services = ["gsc", "ga4", "ads", "gbp", "facebook", "instagram", "linkedin", "crm", "pipedrive", "odoo", "teamleader"]) {
+  return vi.fn(async (url: string, init: RequestInit = {}) => {
+    const u = new URL(url);
+    if (u.origin !== BASE) return new Response("", { status: 404 });
+    if (u.pathname === "/sante") return Response.json({ ok: true, mode, services });
+    const resource = /^\/\.well-known\/oauth-protected-resource\/mcp\/([a-z0-9]+)$/.exec(u.pathname);
+    if (resource) {
+      return Response.json({
+        resource: `${BASE}/mcp/${resource[1]}`,
+        authorization_servers: [BASE],
+        bearer_methods_supported: ["header"],
+        scopes_supported: ["demonstration"],
+      });
+    }
+    if (u.pathname.startsWith("/.well-known/oauth-authorization-server")) {
+      return Response.json({
+        issuer: BASE,
+        authorization_endpoint: `${BASE}/oauth/authorize`,
+        token_endpoint: `${BASE}/oauth/token`,
+        registration_endpoint: `${BASE}/oauth/register`,
+        response_types_supported: ["code"],
+        grant_types_supported: ["authorization_code", "refresh_token"],
+        code_challenge_methods_supported: ["S256"],
+        token_endpoint_auth_methods_supported: ["none"],
+        scopes_supported: ["demonstration"],
+      });
+    }
+    if (u.pathname === "/oauth/register") return Response.json({ ...JSON.parse(String(init.body)), client_id: "atelier-fixture-client" }, { status: 201 });
+    if (u.pathname === "/oauth/token") return Response.json({ access_token: ACCESS_TOKEN, refresh_token: "atelier-fixture-refresh", expires_in: 3600, token_type: "Bearer" });
+    if (u.pathname.startsWith("/mcp/") && init.method === "POST") {
+      if (new Headers(init.headers).get("authorization") !== `Bearer ${ACCESS_TOKEN}`) {
+        return new Response("", { status: 401, headers: { "www-authenticate": `Bearer resource_metadata="${BASE}/.well-known/oauth-protected-resource${u.pathname}"` } });
+      }
+      const body = JSON.parse(String(init.body)) as { id?: unknown; method?: string };
+      if (body.method === "initialize") {
+        return Response.json({ jsonrpc: "2.0", id: body.id, result: { protocolVersion: "2025-06-18", capabilities: { tools: {} }, serverInfo: { name: "passerelle", version: "test" } } });
+      }
+      return Response.json({ jsonrpc: "2.0", id: body.id, result: { tools: [
+        { name: "atelier_identite", description: "Mode de la passerelle", inputSchema: { type: "object", properties: {} }, annotations: { readOnlyHint: true } },
+        { name: "gsc_requete_performances", description: "searchanalytics.query", inputSchema: { type: "object", properties: {} }, annotations: { readOnlyHint: true } },
+      ] } });
+    }
+    return new Response("", { status: 404 });
+  });
+}
+
+const lookup = async () => [{ address: "8.8.8.8", family: 4 as const }];
+
+describe("atelier gateway address", () => {
+  const saved = process.env[ATELIER_GATEWAY_URL_ENV];
+  afterEach(() => {
+    if (saved === undefined) delete process.env[ATELIER_GATEWAY_URL_ENV];
+    else process.env[ATELIER_GATEWAY_URL_ENV] = saved;
+    configureAtelierAppDefinitions(atelierGatewayBaseUrl(), null);
+  });
+
+  it("defaults to the loopback gateway and follows PAPERCLIP_ATELIER_GATEWAY_URL", () => {
+    delete process.env[ATELIER_GATEWAY_URL_ENV];
+    expect(atelierGatewayBaseUrl()).toBe("http://127.0.0.1:3190");
+    process.env[ATELIER_GATEWAY_URL_ENV] = "http://127.0.0.1:3291/";
+    configureAtelierAppDefinitions(atelierGatewayBaseUrl(), null);
+    const gsc = getConnectableAppDefinition("atelier-google-search-console")!;
+    expect(gsc.methods.map((method) => method.defaults?.serverUrl)).toEqual([
+      "http://127.0.0.1:3291/mcp/gsc",
+      "http://127.0.0.1:3291/mcp/gsc",
+    ]);
+    expect(gsc.urlPatterns).toEqual(["http://127.0.0.1:3291/mcp/gsc"]);
+    // Another definition is never rewritten.
+    expect(getConnectableAppDefinition("notion")!.methods[0]!.defaults?.serverUrl).toMatch(/^https:\/\/mcp\.notion\.com/);
+  });
+
+  it("rejects an unusable address instead of guessing", () => {
+    for (const value of ["passerelle", "ftp://127.0.0.1", "http://user:pw@127.0.0.1:3190", "http://127.0.0.1:3190/?x=1"]) {
+      process.env[ATELIER_GATEWAY_URL_ENV] = value;
+      expect(() => atelierGatewayBaseUrl(), value).toThrow(ATELIER_GATEWAY_URL_ENV);
+    }
+  });
+
+  it("exempts only the configured loopback gateway from the HTTPS rule of curated definitions", () => {
+    const env = { [ATELIER_GATEWAY_URL_ENV]: "http://127.0.0.1:3190" };
+    expect(isAtelierLoopbackGatewayUrl(new URL("http://127.0.0.1:3190/mcp/gsc"), env)).toBe(true);
+    expect(isAtelierLoopbackGatewayUrl(new URL("http://127.0.0.1:3191/mcp/gsc"), env)).toBe(false);
+    expect(isAtelierLoopbackGatewayUrl(new URL("http://127.0.0.1:3190/autre"), env)).toBe(false);
+    expect(isAtelierLoopbackGatewayUrl(new URL("http://10.0.0.5:3190/mcp/gsc"), { [ATELIER_GATEWAY_URL_ENV]: "http://10.0.0.5:3190" })).toBe(false);
+    expect(isAtelierLoopbackGatewayUrl(new URL("http://[::1]:3190/mcp/gsc"), { [ATELIER_GATEWAY_URL_ENV]: "http://[::1]:3190" })).toBe(true);
+  });
+
+  it("restores the declared provider scopes outside demonstration mode", () => {
+    const gsc = getConnectableAppDefinition("atelier-google-search-console")!;
+    configureAtelierAppDefinitions(BASE, "demonstration");
+    expect(gsc.methods.map((method) => method.defaults?.scopesHint)).toEqual([undefined, undefined]);
+    configureAtelierAppDefinitions(BASE, "reel");
+    expect(gsc.methods[0]!.defaults?.scopesHint).toEqual(["https://www.googleapis.com/auth/webmasters.readonly"]);
+    expect(gsc.methods[1]!.defaults?.scopesHint).toEqual(["https://www.googleapis.com/auth/webmasters"]);
+  });
+});
+
+(support.supported ? describe : describe.skip)("atelier gateway gallery and one-click connection", () => {
+  let db: ReturnType<typeof createDb>;
+  let temp: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>>;
+  const saved = process.env[ATELIER_GATEWAY_URL_ENV];
+  beforeAll(async () => {
+    temp = await startEmbeddedPostgresTestDatabase("paperclip-atelier-apps-");
+    db = createDb(temp.connectionString);
+    process.env[ATELIER_GATEWAY_URL_ENV] = BASE;
+  }, 20000);
+  afterAll(async () => {
+    if (saved === undefined) delete process.env[ATELIER_GATEWAY_URL_ENV];
+    else process.env[ATELIER_GATEWAY_URL_ENV] = saved;
+    resetAtelierGatewayCache();
+    configureAtelierAppDefinitions(atelierGatewayBaseUrl(), null);
+    await temp?.cleanup();
+  });
+  afterEach(() => resetAtelierGatewayCache());
+
+  async function company() {
+    const [row] = await db.insert(companies).values({ name: "Atelier fixture", issuePrefix: `AT${randomUUID().slice(0, 6)}` }).returning();
+    await db.insert(companyMemberships).values({ companyId: row.id, principalType: "user", principalId: actor.actorId, status: "active", membershipRole: "admin" });
+    return row;
+  }
+
+  function routeApp(remoteHttpRequest: ReturnType<typeof fixtureGateway>) {
+    const app = express();
+    app.use(express.json());
+    app.use((req, _res, next) => {
+      req.actor = { type: "board", userId: "board-user", userName: "Board User", userEmail: null, isInstanceAdmin: true, source: "local_implicit" };
+      next();
+    });
+    app.use("/api", toolAccessRoutes(db, { remoteHttpRequest, remoteHttpEndpointLookup: lookup }));
+    app.use(errorHandler);
+    return app;
+  }
+
+  it("labels every card « (démonstration) » while the gateway reports demonstration mode", async () => {
+    const c = await company();
+    const response = await request(routeApp(fixtureGateway("demonstration"))).get(`/api/companies/${c.id}/tools/gallery`).expect(200);
+    const atelier = (response.body.apps as Array<{ slug: string; name: string; description: string; availability?: { available: boolean }; methods: Array<{ defaults?: { serverUrl?: string } }> }>)
+      .filter((app) => app.slug.startsWith("atelier-"));
+    expect(atelier).toHaveLength(11);
+    for (const app of atelier) {
+      expect(app.name, app.slug).toMatch(/ \(démonstration\)$/);
+      expect(app.description).toMatch(/^Démonstration : données fictives/);
+      expect(app.availability?.available).not.toBe(false);
+      expect(app.methods[0]!.defaults?.serverUrl?.startsWith(`${BASE}/mcp/`)).toBe(true);
+    }
+    expect(atelier.find((app) => app.slug === "atelier-hubspot")?.methods[0]?.defaults?.serverUrl).toBe(`${BASE}/mcp/crm`);
+  });
+
+  it("shows real cards without the label, and unserved services as unavailable", async () => {
+    const c = await company();
+    const response = await request(routeApp(fixtureGateway("reel", ["gsc", "ga4"]))).get(`/api/companies/${c.id}/tools/gallery`).expect(200);
+    const bySlug = new Map((response.body.apps as Array<{ slug: string; name: string; availability?: { available: boolean; reason?: string } }>).map((app) => [app.slug, app]));
+    expect(bySlug.get("atelier-google-search-console")?.name).toBe("Google Search Console");
+    expect(bySlug.get("atelier-google-search-console")?.availability?.available).not.toBe(false);

 }
 
+const ATELIER_VERDICT_MIN_CHARS = 300;
+
 function hasScheduledMonitor(input: {
   existingMonitorNextCheckAt?: Date | null;
   patchMonitorNextCheckAt?: unknown;
@@ -10728,6 +10730,17 @@ export function issueRoutes(
         });
         return;
       }
+      // Atelier LIV-MK-5 : chaque révision de verdict réveille l'auteur ; un agent la dépose entière, jamais un essai.
+      if (
+        req.actor.type === "agent" &&
+        keyParsed.data === "verdict" &&
+        String(req.body.body ?? "").trim().length < ATELIER_VERDICT_MIN_CHARS
+      ) {
+        res.status(422).json({
+          error: `Atelier : un verdict se dépose une fois, entier (au moins ${ATELIER_VERDICT_MIN_CHARS} caractères) ; aucun dépôt d'essai ni test d'encodage.`,
+        });
+        return;
+      }
 
       const actor = getActorInfo(req);
       const sourceTrust = await sourceTrustForActorWrite(issue, actor);

+++ b/server/src/__tests__/issue-agent-mutation-ownership-routes.test.ts
@@ -1648,6 +1648,31 @@ describe("agent issue mutation checkout ownership", () => {
     expect(mockWorkProductService.update).toHaveBeenCalledWith("product-1", { title: "Updated product" });
   });
 
+  it("Atelier LIV-MK-5 : un agent ne dépose pas une révision de verdict de moins de 300 caractères (dépôt d'essai)", async () => {
+    const app = await createApp(ownerActor());
+    const essai = await request(app)
+      .put(`/api/issues/${issueId}/documents/verdict`)
+      .send({ format: "markdown", body: "Verdict : APPROVED\n\ntest d'encodage é + %" });
+    expect(essai.status).toBe(422);
+    expect(essai.body.error).toContain("300 caractères");
+    expect(mockDocumentService.upsertIssueDocument).not.toHaveBeenCalled();
+
+    // Un verdict entier passe, comme tout document court d'une autre clé.
+    await request(app)
+      .put(`/api/issues/${issueId}/documents/verdict`)
+      .send({ format: "markdown", body: `Verdict : APPROVED\n\n${"Constat vérifié contre la fiche. ".repeat(10)}` })
+      .expect(200);
+    await request(app).put(`/api/issues/${issueId}/documents/plan`).send({ format: "markdown", body: "# court" }).expect(200);
+    expect(mockDocumentService.upsertIssueDocument).toHaveBeenCalledTimes(2);
+  });
+
+  it("Atelier LIV-MK-5 : le board garde la main sur un verdict court", async () => {
+    await request(await createApp(boardActor()))
+      .put(`/api/issues/${issueId}/documents/verdict`)
+      .send({ format: "markdown", body: "Verdict : APPROVED" })
+      .expect(200);
+  });
+
   it("preserves board mutations on active checkouts", async () => {
     const app = await createApp(boardActor());
 

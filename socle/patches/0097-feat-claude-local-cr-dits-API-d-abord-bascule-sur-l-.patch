+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { classifyClaudeApiKeyFailure } from "./parse.js";
+
+const cli = JSON.parse(
+  readFileSync(new URL("./__fixtures__/credits-cli.json", import.meta.url), "utf8"),
+);
+
+describe("classifyClaudeApiKeyFailure", () => {
+  it('classifies the displayed "Credit balance is too low" result as credits_epuises', () => {
+    const parsed = { is_error: true, result: cli.creditsEpuises.affiche };
+    expect(classifyClaudeApiKeyFailure({ parsed })).toBe("credits_epuises");
+    const lien = { is_error: true, result: cli.creditsEpuises.afficheAvecLien };
+    expect(classifyClaudeApiKeyFailure({ parsed: lien })).toBe("credits_epuises");
+  });
+
+  it('classifies the raw API message "Your credit balance is too low…" as credits_epuises', () => {
+    expect(classifyClaudeApiKeyFailure({ stderr: cli.creditsEpuises.brutApi })).toBe("credits_epuises");
+    expect(classifyClaudeApiKeyFailure({ errorMessage: cli.creditsEpuises.brutApi })).toBe("credits_epuises");
+  });
+
+  it("classifies a billing_error assistant event as credits_epuises", () => {
+    const stdout = JSON.stringify(cli.creditsEpuises.evenement);
+    expect(classifyClaudeApiKeyFailure({ stdout })).toBe("credits_epuises");
+  });
+
+  it("classifies the spend-limit text captured from the CLI as plafond_depense", () => {
+    // A1 n'a pas trouve ce texte (null) : le classifieur ne doit rien deviner.
+    expect(cli.plafondDepense.texte).toBeNull();
+    const parsed = { is_error: true, api_error_status: 400, result: "Bad request" };
+    expect(classifyClaudeApiKeyFailure({ parsed })).toBeNull();
+    const abonnement = { is_error: true, result: "You've hit your monthly spend limit. resets Nov 1" };
+    expect(classifyClaudeApiKeyFailure({ parsed: abonnement })).toBeNull();
+  });
+
+  it("classifies authentication_failed / Invalid API key as cle_refusee", () => {
+    expect(classifyClaudeApiKeyFailure({ parsed: cli.cleRefusee.evenement })).toBe("cle_refusee");
+    const auth = { is_error: true, result: "authentication_failed" };
+    expect(classifyClaudeApiKeyFailure({ parsed: auth })).toBe("cle_refusee");
+  });
+
+  it("returns null for 529 overloaded_error", () => {
+    const parsed = { is_error: true, api_error_status: 529, result: "API Error: 529 overloaded_error" };
+    expect(classifyClaudeApiKeyFailure({ parsed })).toBeNull();
+  });
+
+  it("returns null for a 429 rate_limit_error with retry-after", () => {
+    const parsed = { is_error: true, api_error_status: 429, result: "rate_limit_error, retry-after: 30" };
+    expect(classifyClaudeApiKeyFailure({ parsed, stderr: "retry-after: 30" })).toBeNull();
+  });
+
+  it('returns null for subscription quota text ("You\'ve hit your limit … resets 5pm")', () => {
+    const parsed = { is_error: true, result: "You've hit your limit · resets 5pm (Europe/Brussels)" };
+    expect(classifyClaudeApiKeyFailure({ parsed })).toBeNull();
+  });
+
+  it('returns null when a successful run\'s assistant prose quotes "credit balance is too low"', () => {
+    const stdout = JSON.stringify({
+      type: "assistant",
+      message: { content: [{ type: "text", text: 'Le message "credit balance is too low" vient de l\'API.' }] },
+    });
+    const parsed = { is_error: false, subtype: "success", result: "Voici l'explication." };
+    expect(classifyClaudeApiKeyFailure({ parsed, stdout })).toBeNull();
+  });
+});
diff --git a/packages/adapters/claude-local/src/server/parse.ts b/packages/adapters/claude-local/src/server/parse.ts
index 558a0c3ef..a8f7cd214 100644
--- a/packages/adapters/claude-local/src/server/parse.ts
+++ b/packages/adapters/claude-local/src/server/parse.ts
@@ -600,3 +600,47 @@ export function isClaudeProviderQuotaError(input: {
   if (!haystack) return false;
   return CLAUDE_PROVIDER_QUOTA_RE.test(haystack);
 }
+
+// Textes de la clé d'API (relevés dans le binaire 2.1.308, voir __fixtures__/credits-cli.json).
+const CLAUDE_CREDIT_BALANCE_RE = /credit\s+balance\s+(?:is\s+)?too\s+low/i;
+const CLAUDE_KEY_REFUSED_RE = /invalid\s+api\s+key/i;
+
+export type ClaudeApiKeyFailure = "credits_epuises" | "facturation" | "plafond_depense" | "cle_refusee";
+
+// shortcut: plafond_depense n'est jamais renvoyé, son texte est introuvable dans le CLI (A1) ; à ajouter si relevé.
+export function classifyClaudeApiKeyFailure(input: {
+  parsed?: Record<string, unknown> | null;
+  stdout?: string | null;
+  stderr?: string | null;
+  errorMessage?: string | null;
+}): ClaudeApiKeyFailure | null {
+  const parsed = input.parsed ?? null;
+  // `subtype` vaut "success" même en erreur : on s'appuie sur is_error, le statut et le texte.
+  const failed = parsed !== null && claudeResultIndicatesAuthFailure(parsed);
+  const status = parsed ? asNumber(parsed.api_error_status, 0) || asNumber(parsed.error_status, 0) : 0;
+  // Champs terminaux seulement : jamais la prose des événements d'assistant.
+  const terminal = [
+    failed && parsed ? collectClaudeTerminalText(parsed) : "",
+    input.stderr ?? "",
+    input.errorMessage ?? "",
+  ].join("\n");
+  const eventErrors = new Set<string>();
+  for (const line of (input.stdout ?? "").split(/\r?\n/)) {
+    if (!line.startsWith("{")) continue;
+    const event = parseJson(line.trim());
+    const code = event?.error;
+    if (typeof code === "string") eventErrors.add(code);
+  }
+
+  if (CLAUDE_CREDIT_BALANCE_RE.test(terminal) || eventErrors.has("billing_error")) return "credits_epuises";
+  if (status === 402 || (failed && /\b402\b|payment\s+required/i.test(terminal))) return "facturation";
+  if (
+    status === 401 ||
+    eventErrors.has("authentication_failed") ||
+    CLAUDE_KEY_REFUSED_RE.test(terminal) ||
+    CLAUDE_AUTH_TOKEN_FAILURE_RE.test(terminal)
+  ) {
+    return "cle_refusee";
+  }
+  return null;
+}

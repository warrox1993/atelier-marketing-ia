+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import type { AdapterUsageCheckpoint } from "@paperclipai/adapter-utils";
+import {
+  empreinteCleApi,
+  execute,
+  lireCreditsEpuises,
+  marquerCreditsEpuises,
+  resetClaudeCliCapabilitiesCacheForTests,
+  resetClaudeCreditsMemoireForTests,
+} from "@paperclipai/adapter-claude-local/server";
+
+type OnKey = "succeed" | "credits" | "raw-credits" | "auth" | "overloaded" | "rate-limit";
+
+const CLE = "sk-ant-test-cle";
+const SESSION_CLE = "33333333-3333-4333-8333-333333333333";
+const SESSION_SANS_CLE = "22222222-2222-4222-8222-222222222222";
+
+// Faux binaire : avec clé, comportement `onKey` (code de sortie 1 pour les échecs) ; sans clé, succès,
+// ou échec de quota de l'abonnement si PAPERCLIP_TEST_SUB_QUOTA=1.
+async function writeCreditsClaudeCommand(commandPath: string, onKey: OnKey): Promise<void> {
+  const script = `#!/usr/bin/env node
+const fs = require("node:fs");
+const argv = process.argv.slice(2);
+fs.readFileSync(0, "utf8");
+const capturePath = process.env.PAPERCLIP_TEST_CAPTURE_PATH;
+if (capturePath) {
+  const entries = fs.existsSync(capturePath) ? JSON.parse(fs.readFileSync(capturePath, "utf8")) : [];
+  entries.push({
+    argv,
+    apiKey: process.env.ANTHROPIC_API_KEY ?? null,
+    oauth: process.env.CLAUDE_CODE_OAUTH_TOKEN ?? null,
+    resumed: argv.includes("--resume"),
+  });
+  fs.writeFileSync(capturePath, JSON.stringify(entries), "utf8");
+}
+const say = (event) => console.log(JSON.stringify(event));
+const failure = (sessionId, text, extra) => {
+  say({ type: "system", subtype: "init", session_id: sessionId, model: "claude-sonnet" });
+  say({ type: "result", subtype: "success", is_error: true, session_id: sessionId, result: text, ...extra });
+  process.exit(1);
+};
+if (process.env.ANTHROPIC_API_KEY) {
+  const onKey = ${JSON.stringify(onKey)};
+  if (onKey === "succeed") {
+    say({ type: "system", subtype: "init", session_id: ${JSON.stringify(SESSION_CLE)}, model: "claude-sonnet" });
+    say({ type: "result", subtype: "success", session_id: ${JSON.stringify(SESSION_CLE)}, result: "ok", total_cost_usd: 0.5, usage: { input_tokens: 10, output_tokens: 5 } });
+    process.exit(0);
+  }
+  if (onKey === "credits") {
+    say({ type: "system", subtype: "init", session_id: ${JSON.stringify(SESSION_CLE)}, model: "claude-sonnet" });
+    say({ type: "assistant", message: { role: "assistant", content: [{ type: "text", text: "Credit balance is too low" }] }, error: "billing_error" });
+    say({ type: "result", subtype: "success", is_error: true, session_id: ${JSON.stringify(SESSION_CLE)}, result: "Credit balance is too low", usage: { input_tokens: 0, output_tokens: 0 } });
+    process.exit(1);
+  }
+  if (onKey === "raw-credits") failure(${JSON.stringify(SESSION_CLE)}, "Your credit balance is too low to access the Anthropic API. Please go to Plans & Billing to upgrade or purchase credits.", { total_cost_usd: 0 });
+  if (onKey === "auth") failure(${JSON.stringify(SESSION_CLE)}, "Invalid API key · Fix external API key", { terminal_reason: "api_error", api_error_status: 401, api_error_origin: "first_party", total_cost_usd: 0 });
+  if (onKey === "overloaded") failure(${JSON.stringify(SESSION_CLE)}, "API Error: 529 overloaded_error", { api_error_status: 529 });
+  if (onKey === "rate-limit") failure(${JSON.stringify(SESSION_CLE)}, "API Error: 429 rate_limit_error. You've hit your limit · resets 4pm (UTC)", { api_error_status: 429 });
+}
+if (process.env.PAPERCLIP_TEST_SUB_QUOTA === "1") {
+  failure(${JSON.stringify(SESSION_SANS_CLE)}, "You've hit your limit · resets 4pm (UTC)", { total_cost_usd: 0 });
+}
+say({ type: "system", subtype: "init", session_id: ${JSON.stringify(SESSION_SANS_CLE)}, model: "claude-sonnet" });
+say({ type: "assistant", session_id: ${JSON.stringify(SESSION_SANS_CLE)}, message: { content: [{ type: "text", text: "hello" }] } });
+say({ type: "result", subtype: "success", session_id: ${JSON.stringify(SESSION_SANS_CLE)}, result: "hello", total_cost_usd: 0.1, usage: { input_tokens: 1, cache_read_input_tokens: 0, output_tokens: 1 } });
+`;
+  await fs.writeFile(commandPath, script, "utf8");
+  await fs.chmod(commandPath, 0o755);
+}
+
+type Capture = { argv: string[]; apiKey: string | null; oauth: string | null; resumed: boolean };
+
+async function lancer(
+  onKey: OnKey,
+  options: {
+    avecCle?: boolean;
+    credits?: boolean;
+    sessionId?: string | null;
+    subQuota?: boolean;
+    context?: Record<string, unknown>;
+    avant?: () => void;
+  } = {},
+) {
+  const { avecCle = true, credits = true, sessionId = null, subQuota = false, context = {} } = options;
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "paperclip-claude-credits-"));
+  const workspace = path.join(root, "workspace");
+  const binDir = path.join(root, "bin");
+  const commandPath = path.join(binDir, "claude");
+  const capturePath = path.join(root, "capture.json");
+  await fs.mkdir(workspace, { recursive: true });
+  await fs.mkdir(binDir, { recursive: true });
+  await writeCreditsClaudeCommand(commandPath, onKey);
+  const previousHome = process.env.HOME;
+  process.env.HOME = root;
+  options.avant?.();
+  const logs: string[] = [];
+  const receipts: AdapterUsageCheckpoint[] = [];
+  const env: Record<string, string> = {
+    CLAUDE_CODE_OAUTH_TOKEN: "jeton-test",
+    PAPERCLIP_TEST_CAPTURE_PATH: capturePath,
+  };
+  if (subQuota) env.PAPERCLIP_TEST_SUB_QUOTA = "1";
+  if (avecCle) env.ANTHROPIC_API_KEY = CLE;
+  if (avecCle && credits) env.PAPERCLIP_CLAUDE_CLE_API = "credits_inclus";
+  try {
+    const result = await execute({
+      runId: "run-credits",
+      agent: { id: "agent-1", companyId: "co-1", name: "Test", adapterType: "claude_local", adapterConfig: { engine: "cli" } },
+      runtime: { sessionId, sessionParams: null, sessionDisplayId: null, taskKey: null },
+      config: { engine: "cli", command: commandPath, cwd: workspace, env, promptTemplate: "Do work." },
+      context,
+      authToken: "tok",
+      onLog: async (_stream, chunk) => {
+        logs.push(chunk);
+      },
+      onUsage: async (receipt) => {
+        receipts.push(receipt);
+      },
+    });
+    const captured = (await fs.readFile(capturePath, "utf8").catch(() => "[]")) as string;
+    return { result, captured: JSON.parse(captured) as Capture[], logs: logs.join(""), receipts };
+  } finally {
+    if (previousHome === undefined) delete process.env.HOME;
+    else process.env.HOME = previousHome;
+    await fs.rm(root, { recursive: true, force: true });
+  }
+}
+
+describe("claude_local credits first, then subscription", () => {
+  let cleHote: string | undefined;
+
+  beforeEach(() => {
+    resetClaudeCreditsMemoireForTests();

+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  delaiReessaiCreditsHeures,
+  effacerCreditsEpuises,
+  empreinteCleApi,
+  lireCreditsEpuises,
+  marquerCreditsEpuises,
+  resetClaudeCreditsMemoireForTests,
+} from "./credits-memoire.js";
+
+const CLE_ESSAI = "sk-ant-api03-ZZtestfactice0123456789abcdef";
+const T0 = new Date("2026-10-27T10:00:00.000Z");
+
+afterEach(() => {
+  resetClaudeCreditsMemoireForTests();
+  vi.restoreAllMocks();
+});
+
+describe("credits-memoire", () => {
+  it("empreinteCleApi returns 8 lowercase hex chars and never the key", () => {
+    const empreinte = empreinteCleApi(CLE_ESSAI);
+    expect(empreinte).toMatch(/^[0-9a-f]{8}$/);
+    for (let i = 0; i + 8 <= CLE_ESSAI.length; i++) {
+      expect(empreinte).not.toBe(CLE_ESSAI.slice(i, i + 8));
+    }
+  });
+
+  it("marquerCreditsEpuises stores now + heures and lireCreditsEpuises returns it", () => {
+    vi.spyOn(console, "warn").mockImplementation(() => {});
+    const echeance = marquerCreditsEpuises("abcd1234", T0, 6);
+    expect(echeance.toISOString()).toBe("2026-10-27T16:00:00.000Z");
+    expect(lireCreditsEpuises("abcd1234")?.toISOString()).toBe("2026-10-27T16:00:00.000Z");
+    expect(lireCreditsEpuises("autre000")).toBeNull();
+  });
+
+  it("effacerCreditsEpuises returns true once then false", () => {
+    vi.spyOn(console, "warn").mockImplementation(() => {});
+    marquerCreditsEpuises("abcd1234", T0, 6);
+    expect(effacerCreditsEpuises("abcd1234")).toBe(true);
+    expect(effacerCreditsEpuises("abcd1234")).toBe(false);
+    expect(lireCreditsEpuises("abcd1234")).toBeNull();
+  });
+
+  it("delaiReessaiCreditsHeures defaults to 6 and ignores 0, negative or non-numeric values", () => {
+    const nom = "PAPERCLIP_CLAUDE_CREDITS_REESSAI_HEURES";
+    expect(delaiReessaiCreditsHeures({})).toBe(6);
+    expect(delaiReessaiCreditsHeures({ [nom]: "2" })).toBe(2);
+    for (const mauvais of ["0", "-3", "abc", ""]) {
+      expect(delaiReessaiCreditsHeures({ [nom]: mauvais })).toBe(6);
+    }
+  });
+
+  it("warns once per transition, not on a second marquer within the window", () => {
+    const avertir = vi.spyOn(console, "warn").mockImplementation(() => {});
+    marquerCreditsEpuises("abcd1234", T0, 6);
+    marquerCreditsEpuises("abcd1234", new Date(T0.getTime() + 60_000), 6);
+    expect(avertir).toHaveBeenCalledTimes(1);
+    expect(String(avertir.mock.calls[0]?.[0])).toContain("abcd1234");
+  });
+});

+import { createHash } from "node:crypto";
+
+// Mémoire du processus : empreinte de la clé d'API -> instant jusqu'auquel les crédits sont réputés épuisés.
+// La clé n'est jamais conservée, seule son empreinte (8 hexadécimaux du SHA-256) circule.
+const epuisesJusqua = new Map<string, Date>();
+
+const VARIABLE_DELAI = "PAPERCLIP_CLAUDE_CREDITS_REESSAI_HEURES";
+const DELAI_DEFAUT_HEURES = 6;
+
+export function empreinteCleApi(cle: string): string {
+  return createHash("sha256").update(cle).digest("hex").slice(0, 8);
+}
+
+export function lireCreditsEpuises(empreinte: string): Date | null {
+  return epuisesJusqua.get(empreinte) ?? null;
+}
+
+export function marquerCreditsEpuises(empreinte: string, maintenant: Date, heures: number): Date {
+  const precedent = epuisesJusqua.get(empreinte);
+  const echeance = new Date(maintenant.getTime() + heures * 3_600_000);
+  epuisesJusqua.set(empreinte, echeance);
+  if (!precedent || precedent.getTime() <= maintenant.getTime()) {
+    console.warn(
+      `[paperclip] Crédits API épuisés pour la clé ${empreinte} ; nouvel essai de l'API après ${echeance.toISOString()}.`,
+    );
+  }
+  return echeance;
+}
+
+export function effacerCreditsEpuises(empreinte: string): boolean {
+  const existait = epuisesJusqua.delete(empreinte);
+  if (existait) console.warn(`[paperclip] Crédits API de nouveau disponibles pour la clé ${empreinte}.`);
+  return existait;
+}
+
+export function delaiReessaiCreditsHeures(env: NodeJS.ProcessEnv = process.env): number {
+  const valeur = Number(env[VARIABLE_DELAI]);
+  return Number.isFinite(valeur) && valeur > 0 ? valeur : DELAI_DEFAUT_HEURES;
+}
+
+export function resetClaudeCreditsMemoireForTests(): void {
+  epuisesJusqua.clear();
+}

+  it("falls back to the server directory only when the agent sets none", () => {
+    expect(resolveSandboxClaudeConfigDir({
+      managedAiConnection: undefined,
+      configEnv: {},
+      env: { CLAUDE_CONFIG_DIR: "/srv/shared/claude" },
+    })).toBe("/srv/shared/claude");
+    expect(resolveSandboxClaudeConfigDir({
+      managedAiConnection: undefined,
+      configEnv: { CLAUDE_CONFIG_DIR: "   " },
+      env: {},
+    })).toBe(path.join(os.homedir(), ".claude"));
+  });
+
+  it("keeps the managed AI connection directory unchanged", () => {

+/**
+ * Claude config directory mounted read-write in a local filesystem sandbox (and
+ * exported as CLAUDE_CONFIG_DIR inside it). An agent that sets its own
+ * CLAUDE_CONFIG_DIR keeps it: falling back to the server's directory would hand
+ * the server user's ~/.claude (credentials, settings, hooks) to the confined CLI
+ * and silently drop the agent's own settings.
+ */
+export function resolveSandboxClaudeConfigDir(input: {
+  managedAiConnection: unknown;
+  configEnv: Record<string, unknown>;
+  env?: NodeJS.ProcessEnv;
+}): string {
+  const explicit = typeof input.configEnv.CLAUDE_CONFIG_DIR === "string" ? input.configEnv.CLAUDE_CONFIG_DIR : "";
+  if (input.managedAiConnection) return explicit;
+  if (explicit.trim()) return path.resolve(explicit.trim());
+  return resolveSharedClaudeConfigDir(input.env ?? process.env);
+}
+
 export function resolveManagedClaudeConfigSeedDir(

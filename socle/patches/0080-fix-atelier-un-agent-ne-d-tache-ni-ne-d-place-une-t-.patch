+/**
+ * Atelier Marketing IA (patch local, non amont) : un agent ne détache ni ne déplace une tâche issue du bureau de liaison.
+ *
+ * Le plugin Atelier dérive la chaîne d'une liaison (relais, cycle) et sa teinte (approbation humaine) de la tâche
+ * d'origine ET de ses ancêtres (`parentId`). Un agent qui met `parentId: null` sur une sous-tâche d'une tâche reçue
+ * par liaison, ou la rattache ailleurs, effacerait cette lignée (revue de f525e9b). Règle, limitée aux acteurs `agent`
+ * (le board, humain, n'est pas limité) : un PATCH qui CHANGE le parent (vers `null` ou une autre tâche) est refusé
+ * (403) si la tâche est d'origine liaison du plugin (`origin_kind` = {@link ORIGINE_LIAISON}) ou descend d'une telle
+ * tâche. La lignée lue est bornée à {@link ANCETRES_MAX} ancêtres ; au-delà, refus par prudence.
+ *
+ * Ce que le socle ne voit pas : la teinte d'une tâche SOURCE (réponse teintée reçue, en base du plugin). Le plugin la
+ * couvre lui-même par prudence (toute liaison sortante de l'entreprise est teintée tant que la réponse est récente ou
+ * sa tâche ouverte), sans dépendre de cette garde.
+ */
+import { and, eq } from "drizzle-orm";
+import type { Db } from "@paperclipai/db";
+import { issues } from "@paperclipai/db";
+import { forbidden } from "../errors.js";
+
+/** `origin_kind` des tâches créées par le bureau de liaison du plugin Atelier (`plugin:<id>:liaison`). */
+export const ORIGINE_LIAISON = "plugin:atelier.marketing-ia:liaison";
+/** Ancêtres lus au plus pour retrouver une origine liaison. */
+export const ANCETRES_MAX = 20;
+
+export const CODE_LIGNEE_LIAISON_FIGEE = "atelier_lignee_liaison_figee";
+export const MESSAGE_LIGNEE_LIAISON_FIGEE =
+  "Une tâche reçue par le bureau de liaison, ou une de ses sous-tâches, garde son parent : un agent ne peut ni la détacher ni la déplacer.";
+
+export type DonneesParentLiaison = {
+  /** L'acteur est-il un agent ? Sinon aucune règle ne s'applique. */
+  acteurAgent: boolean;
+  /** Le PATCH change-t-il le parent (vers `null` ou une autre tâche) ? */
+  parentChange: boolean;
+  /** `origin_kind` de la tâche puis de ses ancêtres, du plus proche au plus lointain. */
+  origines: readonly string[];
+  /** La lignée n'a pas pu être lue en entier (borne atteinte). */
+  ligneeTronquee: boolean;
+};
+
+export type DecisionParentLiaison = { autorise: true } | { autorise: false; statut: 403; code: string; message: string };
+
+/** Vrai si un PATCH change le parent : `parentId` présent et différent de l'actuel (`null` compris). Fonction pure. */
+export function changeLeParent(corps: { parentId?: string | null }, parentActuel: string | null | undefined): boolean {
+  if (!Object.prototype.hasOwnProperty.call(corps, "parentId") || corps.parentId === undefined) return false;
+  return (corps.parentId ?? null)?.toLowerCase() !== (parentActuel ?? null)?.toLowerCase();
+}
+
+/** Décision à partir des données lues. Fonction pure. */
+export function deciderParentLiaison(d: DonneesParentLiaison): DecisionParentLiaison {
+  if (!d.acteurAgent || !d.parentChange) return { autorise: true };
+  if (d.ligneeTronquee || d.origines.includes(ORIGINE_LIAISON)) {
+    return { autorise: false, statut: 403, code: CODE_LIGNEE_LIAISON_FIGEE, message: MESSAGE_LIGNEE_LIAISON_FIGEE };
+  }
+  return { autorise: true };
+}
+
+type ActeurRequete = { actor: { type: string } };
+
+/**
+ * Lit la lignée de la tâche (même entreprise) puis applique la règle. Sans effet, et sans lecture, pour un humain ou
+ * quand le parent ne change pas.
+ */
+export async function refuserChangementParentLiaisonParAgent(
+  db: Db,
+  req: ActeurRequete,
+  options: { companyId: string; issue: { id: string; parentId: string | null; originKind: string | null }; corps: { parentId?: string | null } },
+): Promise<void> {
+  if (req.actor.type !== "agent") return;
+  const parentChange = changeLeParent(options.corps, options.issue.parentId);
+  if (!parentChange) return;
+  const origines: string[] = [options.issue.originKind ?? ""];
+  const vus = new Set([options.issue.id.toLowerCase()]);
+  let ligneeTronquee = false;
+  let parentId = options.issue.parentId;
+  while (parentId && !origines.includes(ORIGINE_LIAISON)) {
+    if (vus.has(parentId.toLowerCase())) break;
+    if (vus.size > ANCETRES_MAX) {
+      ligneeTronquee = true;
+      break;
+    }
+    vus.add(parentId.toLowerCase());
+    const lignes = await db
+      .select({ parentId: issues.parentId, originKind: issues.originKind })
+      .from(issues)
+      .where(and(eq(issues.companyId, options.companyId), eq(issues.id, parentId)));
+    const parent = lignes[0];
+    if (!parent) break;
+    origines.push(parent.originKind ?? "");
+    parentId = parent.parentId ?? null;
+  }
+  const decision = deciderParentLiaison({ acteurAgent: true, parentChange, origines, ligneeTronquee });
+  if (!decision.autorise) throw forbidden(decision.message, { code: decision.code });
+}

+import { describe, expect, it } from "vitest";
+import {
+  ANCETRES_MAX,
+  CODE_LIGNEE_LIAISON_FIGEE,
+  ORIGINE_LIAISON,
+  changeLeParent,
+  deciderParentLiaison,
+  refuserChangementParentLiaisonParAgent,
+} from "../atelier/garde-parent-liaison.js";
+
+/** Faux `db` : chaque `select().from().where()` rend la ligne de la tâche suivante dans `lignee` (par id demandé). */
+function fauxDb(taches: Record<string, { parentId: string | null; originKind: string }>) {
+  const lectures: number[] = [];
+  let n = 0;
+  const db = {
+    select: () => ({
+      from: () => ({
+        where: (condition: unknown) => {
+          n += 1;
+          lectures.push(n);
+          // L'id demandé est le dernier paramètre de la condition drizzle ; on le retrouve en parcourant l'objet.
+          const id = trouverId(condition, Object.keys(taches));
+          return Promise.resolve(id ? [taches[id]] : []);
+        },
+      }),
+    }),
+  };
+  return { db: db as any, lectures };
+}
+
+function trouverId(v: unknown, ids: string[], vus = new Set<unknown>()): string | null {
+  if (typeof v === "string") return ids.includes(v) ? v : null;
+  if (!v || typeof v !== "object" || vus.has(v)) return null;
+  vus.add(v);
+  for (const cle of Object.keys(v as object)) {
+    if (cle === "table") continue;
+    const r = trouverId((v as Record<string, unknown>)[cle], ids, vus);
+    if (r) return r;
+  }
+  return null;
+}
+
+const agent = { actor: { type: "agent" } };
+const erreur = async (p: Promise<unknown>) => (await p.then(() => null, (e: unknown) => e)) as any;
+
+describe("atelier : un agent ne détache ni ne déplace une tâche issue du bureau de liaison", () => {
+  it("changeLeParent : null ou autre parent compte, absence ou même parent non", () => {
+    expect(changeLeParent({ parentId: null }, "p")).toBe(true);
+    expect(changeLeParent({ parentId: "q" }, "p")).toBe(true);
+    expect(changeLeParent({ parentId: "q" }, null)).toBe(true);
+    expect(changeLeParent({}, "p")).toBe(false);
+    expect(changeLeParent({ parentId: undefined }, "p")).toBe(false);
+    expect(changeLeParent({ parentId: "P" }, "p")).toBe(false);
+    expect(changeLeParent({ parentId: null }, null)).toBe(false);
+  });
+
+  it("deciderParentLiaison : refuse un agent sur une lignée liaison ou tronquée, jamais un humain", () => {
+    const base = { acteurAgent: true, parentChange: true, origines: ["manual", ORIGINE_LIAISON], ligneeTronquee: false };
+    expect(deciderParentLiaison(base)).toMatchObject({ autorise: false, statut: 403, code: CODE_LIGNEE_LIAISON_FIGEE });
+    expect(deciderParentLiaison({ ...base, origines: ["manual", "manual"] })).toEqual({ autorise: true });
+    expect(deciderParentLiaison({ ...base, origines: ["manual"], ligneeTronquee: true })).toMatchObject({ autorise: false });
+    expect(deciderParentLiaison({ ...base, acteurAgent: false })).toEqual({ autorise: true });
+    expect(deciderParentLiaison({ ...base, parentChange: false })).toEqual({ autorise: true });
+  });
+
+  it("scénario de la revue : un agent met parentId à null sur une sous-tâche d'une tâche reçue par liaison : 403", async () => {
+    const { db } = fauxDb({ recue: { parentId: null, originKind: ORIGINE_LIAISON } });
+    const e = await erreur(refuserChangementParentLiaisonParAgent(db, agent, { companyId: "c", issue: { id: "st", parentId: "recue", originKind: "manual" }, corps: { parentId: null } }));
+    expect(e?.status).toBe(403);
+    expect(e?.details?.code).toBe(CODE_LIGNEE_LIAISON_FIGEE);
+  });
+
+  it("une sous-sous-tâche aussi (ancêtre lointain), et le déplacement vers un autre parent", async () => {
+    const { db } = fauxDb({ st: { parentId: "recue", originKind: "manual" }, recue: { parentId: null, originKind: ORIGINE_LIAISON } });
+    expect((await erreur(refuserChangementParentLiaisonParAgent(db, agent, { companyId: "c", issue: { id: "sst", parentId: "st", originKind: "manual" }, corps: { parentId: null } })))?.status).toBe(403);
+    expect((await erreur(refuserChangementParentLiaisonParAgent(db, agent, { companyId: "c", issue: { id: "sst", parentId: "st", originKind: "manual" }, corps: { parentId: "autre" } })))?.status).toBe(403);
+  });
+
+  it("la tâche reçue elle-même ne peut pas être rattachée sous une autre tâche", async () => {
+    const { db, lectures } = fauxDb({});
+    const e = await erreur(refuserChangementParentLiaisonParAgent(db, agent, { companyId: "c", issue: { id: "recue", parentId: null, originKind: ORIGINE_LIAISON }, corps: { parentId: "x" } }));
+    expect(e?.status).toBe(403);
+    expect(lectures).toHaveLength(0);
+  });
+
+  it("une tâche ordinaire se détache librement ; un humain n'est jamais limité ; un parent inchangé ne lit rien", async () => {
+    const { db } = fauxDb({ mission: { parentId: null, originKind: "manual" }, recue: { parentId: null, originKind: ORIGINE_LIAISON } });
+    await expect(refuserChangementParentLiaisonParAgent(db, agent, { companyId: "c", issue: { id: "st", parentId: "mission", originKind: "manual" }, corps: { parentId: null } })).resolves.toBeUndefined();
+    const interdit = { select: () => { throw new Error("lecture inattendue"); } } as any;
+    await expect(refuserChangementParentLiaisonParAgent(interdit, { actor: { type: "board" } }, { companyId: "c", issue: { id: "st", parentId: "recue", originKind: "manual" }, corps: { parentId: null } })).resolves.toBeUndefined();
+    await expect(refuserChangementParentLiaisonParAgent(interdit, agent, { companyId: "c", issue: { id: "st", parentId: "recue", originKind: "manual" }, corps: { parentId: "recue" } })).resolves.toBeUndefined();
+    await expect(refuserChangementParentLiaisonParAgent(interdit, agent, { companyId: "c", issue: { id: "st", parentId: "recue", originKind: "manual" }, corps: { title: "x" } as any })).resolves.toBeUndefined();
+  });
+
+  it("lignée plus longue que la borne : refus par prudence", async () => {
+    const taches: Record<string, { parentId: string | null; originKind: string }> = {};
+    for (let i = 0; i <= ANCETRES_MAX + 2; i++) taches[`t${i}`] = { parentId: `t${i + 1}`, originKind: "manual" };
+    const { db } = fauxDb(taches);
+    const e = await erreur(refuserChangementParentLiaisonParAgent(db, agent, { companyId: "c", issue: { id: "depart", parentId: "t0", originKind: "manual" }, corps: { parentId: null } }));
+    expect(e?.status).toBe(403);
+  });
+});

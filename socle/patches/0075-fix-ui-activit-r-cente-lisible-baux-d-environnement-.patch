+import { describe, expect, it } from "vitest";
+import type { ActivityEvent } from "@paperclipai/shared";
+import { regrouperActivite } from "./activity-grouping";
+
+function evenement(id: string, action: string, actorId = "agent-1", actorType: ActivityEvent["actorType"] = "agent"): ActivityEvent {
+  return {
+    id,
+    companyId: "c-1",
+    actorType,
+    actorId,
+    action,
+    entityType: action.startsWith("environment.") ? "environment_lease" : "issue",
+    entityId: `e-${id}`,
+    details: null,
+    createdAt: new Date("2026-10-17T12:00:00Z"),
+  } as unknown as ActivityEvent;
+}
+
+describe("regrouperActivite", () => {
+  it("résume en une ligne les baux consécutifs d'un même agent et compte les ouvertures", () => {
+    const lignes = regrouperActivite([
+      evenement("1", "environment.lease_released"),
+      evenement("2", "environment.lease_acquired"),
+      evenement("3", "environment.lease_released"),
+      evenement("4", "environment.lease_acquired"),
+      evenement("5", "issue.created"),
+    ], 10);
+
+    expect(lignes.map((l) => [l.event.id, l.repetitions])).toEqual([["1", 2], ["5", 1]]);
+  });
+
+  it("ne mélange pas les baux de deux agents différents", () => {
+    const lignes = regrouperActivite([
+      evenement("1", "environment.lease_acquired", "agent-1"),
+      evenement("2", "environment.lease_acquired", "agent-2"),
+      evenement("3", "environment.lease_released", "agent-2"),
+    ], 10);
+
+    expect(lignes.map((l) => [l.event.id, l.repetitions])).toEqual([["1", 1], ["2", 1]]);
+  });
+
+  it("compte au moins une répétition pour un bail libéré seul", () => {
+    expect(regrouperActivite([evenement("1", "environment.lease_released")], 10)).toEqual([
+      { event: expect.objectContaining({ id: "1" }), repetitions: 1 },
+    ]);
+  });
+
+  it("garde les autres événements identiques séparés et respecte la limite", () => {
+    const lignes = regrouperActivite([
+      evenement("1", "issue.created"),
+      evenement("2", "issue.created"),
+      evenement("3", "environment.lease_acquired"),
+      evenement("4", "issue.created"),
+    ], 3);
+
+    expect(lignes.map((l) => l.event.id)).toEqual(["1", "2", "3"]);
+  });
+});

+import type { ActivityEvent } from "@paperclipai/shared";
+
+/** Une ligne du fil d'activité : un événement, ou une série répétée résumée par son plus récent. */
+export interface LigneActiviteGroupee {
+  event: ActivityEvent;
+  /** Nombre d'exécutions résumées (1 pour un événement isolé). */
+  repetitions: number;
+}
+
+const PREFIXE_BAIL_ENVIRONNEMENT = "environment.lease_";
+
+function estBailEnvironnement(event: ActivityEvent): boolean {
+  return event.action.startsWith(PREFIXE_BAIL_ENVIRONNEMENT);
+}
+
+/**
+ * Chaque battement planifié d'un agent ouvre puis libère un environnement d'exécution :
+ * deux lignes par battement noyaient le fil. Les baux consécutifs d'un même acteur sont
+ * regroupés en une ligne (l'événement le plus récent), qui compte les ouvertures.
+ * Les autres événements restent tels quels et l'ordre est conservé.
+ */
+export function regrouperActivite(events: readonly ActivityEvent[], limite: number): LigneActiviteGroupee[] {
+  const lignes: LigneActiviteGroupee[] = [];
+  let serie: { event: ActivityEvent; ouvertures: number } | null = null;
+
+  const fermerSerie = () => {
+    if (serie) lignes.push({ event: serie.event, repetitions: Math.max(1, serie.ouvertures) });
+    serie = null;
+  };
+
+  for (const event of events) {
+    if (lignes.length >= limite) break;
+    if (estBailEnvironnement(event)) {
+      const ouverture = event.action === "environment.lease_acquired" ? 1 : 0;
+      if (serie && serie.event.actorType === event.actorType && serie.event.actorId === event.actorId) {
+        serie.ouvertures += ouverture;
+        continue;
+      }
+      fermerSerie();
+      if (lignes.length >= limite) break;
+      serie = { event, ouvertures: ouverture };
+      continue;
+    }
+    fermerSerie();
+    if (lignes.length >= limite) break;
+    lignes.push({ event, repetitions: 1 });
+  }
+  fermerSerie();
+  return lignes.slice(0, limite);
+}

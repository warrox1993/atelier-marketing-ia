diff --git a/ui/src/lib/activity-format.ts b/ui/src/lib/activity-format.ts
index 80f4d551e..07ed45207 100644
--- a/ui/src/lib/activity-format.ts
+++ b/ui/src/lib/activity-format.ts
@@ -393,6 +393,46 @@ export const LIBELLES_STATUTS_PROJET_ROUTINE: Record<string, string> = {
   issue_created: "tâche créée",
 };
 
+/**
+ * Libellés français des types de cible d'une liaison de secret (onglet
+ * Utilisation). Les clés sont les valeurs stockées : on ne traduit que
+ * l'affichage.
+ */
+export const LIBELLES_TYPES_CIBLE_SECRET: Record<string, string> = {
+  agent: "Agent",
+  project: "Projet",
+  environment: "Environnement",
+  routine: "Routine",
+  plugin: "Extension",
+  issue: "Tâche",
+  run: "Exécution",
+  tool_connection: "Connexion d'outil",
+  system: "Système",
+};
+
+/** Libellés français des résultats d'accès à un secret (onglet Événements d'accès). */
+export const LIBELLES_RESULTATS_ACCES_SECRET: Record<string, string> = {
+  success: "réussi",
+  failure: "échec",
+  missing: "absent",
+  inactive: "inactif",
+  not_allowed: "non autorisé",
+  optional_omitted: "facultatif omis",
+  provider_error: "erreur du fournisseur",
+};
+
+/** Libellés français des niveaux d'un contrôle d'environnement. */
+export const LIBELLES_NIVEAUX_VERIFICATION: Record<string, string> = {
+  info: "info",
+  warn: "avertissement",
+  error: "erreur",
+};
+
+/** Affichage d'une valeur d'énumération : libellé français, repli lisible sinon. */
+export function libelleDepuisTable(table: Record<string, string>, value: string): string {
+  return table[value] ?? value.replace(/_/g, " ");
+}
+
 export function libelleStatutProjetRoutine(value: string): string {
   return LIBELLES_STATUTS_PROJET_ROUTINE[value] ?? value.replace(/_/g, " ");
 }

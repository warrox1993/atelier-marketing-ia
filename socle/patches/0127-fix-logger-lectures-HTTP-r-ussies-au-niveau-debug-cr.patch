+// Atelier EXP-C9 : les lectures réussies remplissaient le journal système (91 602 INFO sur 94 076 lignes le 29/10).
+describe("httpLogLevel", () => {
+  it("passe les lectures réussies au niveau debug", () => {
+    expect(httpLogLevel("GET", "/api/agents/a1", 200)).toBe("debug");
+    expect(httpLogLevel("HEAD", "/api/agents/a1", 204)).toBe("debug");
+  });
+
+  it("garde les écritures réussies au niveau info", () => {
+    expect(httpLogLevel("POST", "/api/issues/PAP-1/comments", 201)).toBe("info");
+    expect(httpLogLevel("PATCH", "/api/issues/PAP-1", 200)).toBe("info");
+  });
+
+  it("garde les échecs visibles et le silence des sondages", () => {
+    expect(httpLogLevel("GET", "/api/agents/a1", 404)).toBe("warn");
+    expect(httpLogLevel("GET", "/api/agents/a1", 500)).toBe("error");
+    expect(httpLogLevel("GET", "/api/agents/a1", 200, new Error("x"))).toBe("error");
+    expect(httpLogLevel("GET", "/api/health", 200)).toBe("silent");
+  });
+});

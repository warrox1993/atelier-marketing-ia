+/** Atelier EXP-C9 : une lecture réussie est du bruit au niveau info ; écritures et échecs restent visibles. */
+export function httpLogLevel(
+  method: string | undefined,
+  url: string | undefined,
+  statusCode: number,
+  err?: unknown,
+): "silent" | "debug" | "info" | "warn" | "error" {
+  if (shouldSilenceHttpSuccessLog(method, url, statusCode)) return "silent";
+  if (err || statusCode >= 500) return "error";
+  if (statusCode >= 400) return "warn";
+  if (method && SILENCED_SUCCESS_METHODS.has(method.toUpperCase())) return "debug";
+  return "info";
+}
+
 export function shouldSilenceHttpSuccessLog(
   method: string | undefined,
   url: string | undefined,

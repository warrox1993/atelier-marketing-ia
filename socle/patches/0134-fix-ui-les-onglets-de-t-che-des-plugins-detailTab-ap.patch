MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

En mode discussion, la barre d'onglets du centre est masquée : l'onglet de tâche
déclaré par un plugin (detailTab, entité issue) n'était jamais visible. Le panneau
de droite (Propriétés, Plan, Artefacts...) ajoute maintenant ces onglets, avec la
même valeur plugin:<clé>:<id> et le même libellé que la page de la tâche, et monte
leur contenu par PluginSlotMount avec la tâche pour entité.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EThpSSDGc5NRYwbgjNqoTJ
---
 ui/src/components/IssueProperties.test.tsx    | 56 +++++++++++++++++++
 .../issue-properties/IssueProperties.tsx      | 34 ++++++++++-
 2 files changed, 88 insertions(+), 2 deletions(-)

diff --git a/ui/src/components/IssueProperties.test.tsx b/ui/src/components/IssueProperties.test.tsx
index e542f473d8..42270ddee8 100644
--- a/ui/src/components/IssueProperties.test.tsx
+++ b/ui/src/components/IssueProperties.test.tsx
@@ -90,6 +90,20 @@ vi.mock("../api/issues", () => ({
   issuesApi: mockIssuesApi,
 }));
 
+const mockPluginSlots = vi.hoisted(() => ({ detailTabs: [] as Array<Record<string, unknown>> }));
+
+vi.mock("@/plugins/slots", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/plugins/slots")>()),
+  usePluginSlots: ({ slotTypes, entityType }: { slotTypes: string[]; entityType?: string }) => ({
+    slots: slotTypes.includes("detailTab") && entityType === "issue" ? mockPluginSlots.detailTabs : [],
+    isLoading: false,
+    errorMessage: null,
+  }),
+  PluginSlotMount: ({ slot, context }: { slot: { id: string }; context: { entityId?: string | null; entityType?: string | null } }) => (
+    <div data-testid="plugin-slot-mount">{`${slot.id}:${context.entityType}:${context.entityId}`}</div>
+  ),
+}));
+
 vi.mock("../api/auth", () => ({
   authApi: mockAuthApi,
 }));
@@ -1095,6 +1109,48 @@ describe("IssueProperties", () => {
     act(() => root.unmount());
   });
 
+  it("montre l'onglet de tâche d'un plugin dans le panneau du mode discussion et y monte son contenu (Atelier UI-4)", async () => {
+    mockInstanceSettingsApi.getExperimental.mockResolvedValue({ enableClassicTaskInterface: false });
+    mockPluginSlots.detailTabs = [
+      {
+        type: "detailTab",
+        id: "onglet-tache",
+        displayName: "Atelier",
+        exportName: "ContenuOngletTache",
+        entityTypes: ["issue"],
+        pluginId: "plugin-1",
+        pluginKey: "atelier",
+        pluginDisplayName: "Atelier",
+        pluginVersion: "1.0.0",
+      },
+    ];
+    try {
+      const { root } = renderPropertiesWithQueryClient(container, {
+        issue: createIssue(),
+        childIssues: [],
+        onUpdate: vi.fn(),
+        inline: true,
+      });
+      let atelierTab: HTMLButtonElement | undefined;
+      await waitForAssertion(() => {
+        atelierTab = Array.from(container.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
+          .find((button) => button.textContent === "Atelier");
+        expect(atelierTab).toBeDefined();
+      });
+      expect(container.querySelector('[data-testid="plugin-slot-mount"]')).toBeNull();
+      await act(async () => {
+        atelierTab!.dispatchEvent(new MouseEvent("mousedown", { bubbles: true, button: 0 }));
+        atelierTab!.click();
+      });
+      await waitForAssertion(() => {
+        expect(container.querySelector('[data-testid="plugin-slot-mount"]')?.textContent).toBe("onglet-tache:issue:issue-1");
+      });
+      act(() => root.unmount());
+    } finally {
+      mockPluginSlots.detailTabs = [];
+    }
+  });
+
   it("hides the Priority property row while priority UI is off (PAP-411)", async () => {
     const root = renderProperties(container, {
       issue: createIssue({ priority: "high" }),

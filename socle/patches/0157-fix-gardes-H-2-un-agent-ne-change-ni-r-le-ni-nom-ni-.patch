+
+/**
+ * Atelier (patch local 0157, revue de sécurité 2, H-2) : l'identité, le rôle, le rattachement, les
+ * métadonnées et le budget d'un agent restent un geste humain. Sans cette garde, un agent se
+ * donnait le rôle ceo (donc les pouvoirs du Coordinateur, dont M2) par un PATCH de lui-même
+ * mêlant `role` à un champ ordinaire, accordé par « allow_self ».
+ */
+export const CHAMPS_IDENTITE_AGENT = ["role", "name", "metadata", "reportsTo", "budgetMonthlyCents"] as const;
+
+/** 403 si un acteur agent change effectivement un champ d'identité ; un champ renvoyé à l'identique passe. */
+export function refuserIdentiteParAgent(
+  req: { actor: { type: string } },
+  existant: object,
+  apres: Record<string, unknown>,
+): void {
+  if (req.actor.type !== "agent") return;
+  const avant = existant as Record<string, unknown>;
+  const change = CHAMPS_IDENTITE_AGENT.find((cle) => Object.prototype.hasOwnProperty.call(apres, cle)
+    && JSON.stringify(apres[cle] ?? null) !== JSON.stringify(avant[cle] ?? null));
+  if (change) throw forbidden(`Atelier : un agent ne change pas « ${change} » d'un agent ; un humain le fait depuis le board.`);
+}

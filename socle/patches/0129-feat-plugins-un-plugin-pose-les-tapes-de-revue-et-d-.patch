+  // Atelier MK-01 : un plugin pose les étapes de revue et d'approbation, validées comme à la route.
+  // Surveillance et confinement de confiance ne passent jamais par un plugin : ceux de la tâche sont gardés.
+  const normalizePluginExecutionPolicy = (requested: unknown, existing: unknown) => {
+    const policy = normalizeIssueExecutionPolicy(requested);
+    if (policy?.monitor || policy?.reviewPreset || policy?.authorizationPolicy) {
+      throw new Error("Plugin may only set the review and approval stages of an execution policy");
+    }
+    const previous = normalizeIssueExecutionPolicy(existing ?? null);
+    const kept = {
+      ...(previous?.monitor ? { monitor: previous.monitor } : {}),
+      ...(previous?.reviewPreset ? { reviewPreset: previous.reviewPreset } : {}),
+      ...(previous?.authorizationPolicy ? { authorizationPolicy: previous.authorizationPolicy } : {}),
+    };
+    if (!policy && Object.keys(kept).length === 0) return null;
+    return { ...(policy ?? { mode: "normal" as const, commentRequired: true as const, stages: [] }), ...kept };
+  };

+  it("Atelier MK-01 : un plugin pose et relit une politique de revue puis d'approbation, validée comme à la route", async () => {
+    const { companyId, agentId } = await seedCompanyAndAgent();
+    const services = buildHostServices(db, "plugin-record-id", "paperclip.missions", createEventBusStub());
+    const politique = {
+      stages: [
+        { type: "review", participants: [{ type: "agent", agentId }] },
+        { type: "approval", participants: [{ type: "user", userId: "board-user" }] },
+      ],
+    };
+
+    const creee = await services.issues.create({ companyId, title: "Livrable public", executionPolicy: politique });
+    const relue = await services.issues.get({ issueId: creee.id, companyId });
+    expect((relue?.executionPolicy as { stages: Array<{ type: string; participants: unknown[] }> }).stages.map((e) => [e.type, e.participants])).toEqual([
+      ["review", [expect.objectContaining({ type: "agent", agentId })]],
+      ["approval", [expect.objectContaining({ type: "user", userId: "board-user" })]],
+    ]);
+
+    const tache = await services.issues.create({ companyId, title: "Sans porte" });
+    const posee = await services.issues.update({ issueId: tache.id, companyId, patch: { executionPolicy: politique } });
+    expect((posee.executionPolicy as { stages: unknown[] }).stages).toHaveLength(2);
+
+    // Politique malformée : refusée, la tâche garde la sienne.
+    await expect(services.issues.update({
+      issueId: tache.id, companyId, patch: { executionPolicy: { stages: [{ type: "porte", participants: [] }] } },
+    })).rejects.toThrow("Invalid execution policy");
+    await expect(services.issues.create({
+      companyId, title: "Malformée", executionPolicy: { stages: "review" },
+    })).rejects.toThrow("Invalid execution policy");
+
+    // Le confinement de confiance et la surveillance ne se posent pas par un plugin, et ceux de la tâche restent.
+    const confinement = { assignmentPolicy: { mode: "company_default" } };
+    await expect(services.issues.update({
+      issueId: tache.id, companyId, patch: { executionPolicy: { ...politique, authorizationPolicy: confinement } },
+    })).rejects.toThrow("Plugin may only set the review and approval stages of an execution policy");
+    await expect(services.issues.create({
+      companyId, title: "Surveillée", executionPolicy: { stages: [], monitor: { nextCheckAt: new Date(Date.now() + 3_600_000).toISOString() } },
+    })).rejects.toThrow("Plugin may only set the review and approval stages of an execution policy");
+    await db.update(issues).set({ executionPolicy: { mode: "normal", commentRequired: true, stages: [], authorizationPolicy: confinement } })
+      .where(eq(issues.id, tache.id));
+    const gardee = await services.issues.update({ issueId: tache.id, companyId, patch: { executionPolicy: politique } });
+    expect((gardee.executionPolicy as { authorizationPolicy?: unknown }).authorizationPolicy).toEqual(confinement);
+    expect((gardee.executionPolicy as { stages: unknown[] }).stages).toHaveLength(2);
+    const retiree = await services.issues.update({ issueId: tache.id, companyId, patch: { executionPolicy: null } });
+    expect(retiree.executionPolicy).toEqual(expect.objectContaining({ stages: [], authorizationPolicy: confinement }));
+  });
+

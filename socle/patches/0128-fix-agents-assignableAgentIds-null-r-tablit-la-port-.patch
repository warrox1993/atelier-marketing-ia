 import { listInvalidOrgChainDescendantIds } from "../services/agent-invokability.js";
 import { logger } from "../middleware/logger.js";
 import { replayInteractionWakesAfterResume } from "./issues.js";
@@ -4723,9 +4724,10 @@ export function agentRoutes(
       effectiveCanAssignTasks,
       req.actor.type === "board" ? (req.actor.userId ?? null) : null,
     );
-    if (assignableAgentIds) {
+    if (assignableAgentIds !== undefined) {
       await access.setPrincipalPermission(agent.companyId, "agent", agent.id, "tasks:assign_scope", true,
-        req.actor.userId ?? null, { assigneeAgentIds: assignableAgentIds });
+        req.actor.userId ?? null,
+        assignableAgentIds === null ? newStandardAgentGrantScope("tasks:assign_scope", agent.id) : { assigneeAgentIds: assignableAgentIds });
     }
 
     const actor = getActorInfo(req);

diff --git a/packages/shared/src/validators/agent.ts b/packages/shared/src/validators/agent.ts
index 5f33f56258..f5a402f545 100644
--- a/packages/shared/src/validators/agent.ts
+++ b/packages/shared/src/validators/agent.ts
@@ -294,7 +294,8 @@ export const updateAgentPermissionsSchema = z.object({
   trustPreset: trustPresetSchema.optional(),
   authorizationPolicy: trustAuthorizationPolicySchema.optional(),
   // Atelier (N3) : jamais vide (une portée vide ne contraindrait rien, voir scopeAllows).
-  assignableAgentIds: z.array(z.string().guid()).min(1).max(500).optional(),
+  // Atelier (P-PORTEE) : null rétablit la portée par défaut du socle, le sous-arbre de l'agent.
+  assignableAgentIds: z.array(z.string().guid()).min(1).max(500).nullable().optional(),
 });
 
 export type UpdateAgentPermissions = z.infer<typeof updateAgentPermissionsSchema>;
diff --git a/server/src/__tests__/agent-permissions-routes.test.ts b/server/src/__tests__/agent-permissions-routes.test.ts
index 62d86c2c6b..82176d5454 100644
--- a/server/src/__tests__/agent-permissions-routes.test.ts
+++ b/server/src/__tests__/agent-permissions-routes.test.ts
@@ -2139,6 +2139,23 @@ describe("agent permission routes", () => {
     expect(vide.status).toBe(400);
   });
 
+  it("Atelier P-PORTEE : assignableAgentIds null rétablit la portée par défaut du socle (sous-arbre dynamique de l'agent)", async () => {
+    const app = await createApp({ type: "board", userId: "board-user", source: "local_implicit", isInstanceAdmin: true, companyIds: [companyId] });
+    const res = await requestApp(app, (baseUrl) => request(baseUrl).patch(`/api/agents/${agentId}/permissions`)
+      .send({ canCreateAgents: false, canAssignTasks: false, assignableAgentIds: null }));
+    expect(res.status).toBe(200);
+    expect(mockAgentService.updatePermissions).toHaveBeenCalledWith(agentId, { canCreateAgents: false, canAssignTasks: false });
+    expect(mockAccessService.setPrincipalPermission).toHaveBeenCalledWith(
+      companyId, "agent", agentId, "tasks:assign_scope", true, "board-user", { subtreeRootAgentId: agentId });
+    // Un agent ne peut pas davantage rétablir sa portée lui-même (N4).
+    mockAccessService.setPrincipalPermission.mockClear();
+    const agentApp = await createApp({ type: "agent", agentId: "ceo-agent", companyId, runId: "run-1", source: "agent_key" });
+    const refus = await requestApp(agentApp, (baseUrl) => request(baseUrl).patch(`/api/agents/${agentId}/permissions`)
+      .send({ canCreateAgents: false, canAssignTasks: false, assignableAgentIds: null }));
+    expect(refus.status).toBe(403);
+    expect(mockAccessService.setPrincipalPermission).not.toHaveBeenCalled();
+  });
+
   it("rejects CEO permission updates outside the caller company scope", async () => {
     const app = await createApp({
       type: "agent",

+// @vitest-environment jsdom
+
+import type { ReactNode } from "react";
+import { flushSync } from "react-dom";
+import { createRoot } from "react-dom/client";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { PluginUiContribution } from "@/api/plugins";
+import { atelierDisponible, CompanyHomeRedirect } from "./CompanyHomeRedirect";
+
+const mockPluginsApi = vi.hoisted(() => ({ listUiContributions: vi.fn() }));
+
+vi.mock("@/api/plugins", () => ({ pluginsApi: mockPluginsApi }));
+vi.mock("@/lib/router", () => ({
+  Navigate: ({ to }: { to: string }) => <div>Navigate:{to}</div>,
+}));
+vi.mock("./AnimatedPaperclipIcon", () => ({ PaperclipLoading: () => <div>Chargement</div> }));
+
+function contribution(slots: PluginUiContribution["slots"]): PluginUiContribution {
+  return {
+    pluginId: "p1",
+    pluginKey: "atelier.marketing-ia",
+    displayName: "Atelier marketing",
+    version: "1.0.0",
+    uiEntryFile: "index.js",
+    slots,
+    launchers: [],
+  };
+}
+
+const pageAtelier = { type: "page", id: "atelier-page", displayName: "Atelier marketing", exportName: "Page", routePath: "atelier" };
+const autrePage = { type: "page", id: "autre", displayName: "Autre", exportName: "Autre", routePath: "autre" };
+
+async function rendre(node: ReactNode) {
+  const container = document.createElement("div");
+  document.body.appendChild(container);
+  const root = createRoot(container);
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  flushSync(() => {
+    root.render(<QueryClientProvider client={client}>{node}</QueryClientProvider>);
+  });
+  return { container, root };
+}
+
+afterEach(() => {
+  document.body.innerHTML = "";
+  vi.clearAllMocks();
+});
+
+describe("CompanyHomeRedirect", () => {
+  it("détecte la page de l'atelier seulement si un plugin la déclare", () => {
+    expect(atelierDisponible(undefined)).toBe(false);
+    expect(atelierDisponible([contribution([autrePage] as never)])).toBe(false);
+    expect(atelierDisponible([contribution([pageAtelier] as never)])).toBe(true);
+  });
+
+  it("redirige vers l'atelier quand le plugin est prêt", async () => {
+    mockPluginsApi.listUiContributions.mockResolvedValue([contribution([pageAtelier] as never)]);
+    const { container } = await rendre(<CompanyHomeRedirect />);
+    await vi.waitFor(() => expect(container.textContent).toBe("Navigate:atelier"));
+  });
+
+  it("redirige vers le tableau de bord sans plugin d'atelier", async () => {
+    mockPluginsApi.listUiContributions.mockResolvedValue([contribution([autrePage] as never)]);
+    const { container } = await rendre(<CompanyHomeRedirect />);
+    await vi.waitFor(() => expect(container.textContent).toBe("Navigate:dashboard"));
+  });
+
+  it("retombe sur le tableau de bord si la liste des plugins est en erreur", async () => {
+    mockPluginsApi.listUiContributions.mockRejectedValue(new Error("hors service"));
+    const { container } = await rendre(<CompanyHomeRedirect />);
+    await vi.waitFor(() => expect(container.textContent).toBe("Navigate:dashboard"));
+  });
+});

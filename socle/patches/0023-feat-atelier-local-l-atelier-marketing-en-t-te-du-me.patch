+import { useQuery } from "@tanstack/react-query";
+import { Navigate } from "@/lib/router";
+import { pluginsApi, type PluginUiContribution } from "@/api/plugins";
+import { queryKeys } from "@/lib/queryKeys";
+import { PaperclipLoading } from "./AnimatedPaperclipIcon";
+
+/**
+ * Chemin (relatif à l'entreprise) de la page principale de l'atelier marketing,
+ * déclarée par le plugin `atelier.marketing-ia` (créneau « page », routePath « atelier »).
+ */
+export const CHEMIN_PAGE_ATELIER = "atelier";
+
+/** Vrai si un plugin prêt déclare la page principale de l'atelier. */
+export function atelierDisponible(contributions: PluginUiContribution[] | undefined): boolean {
+  return (contributions ?? []).some((contribution) =>
+    contribution.slots.some((slot) => slot.type === "page" && slot.routePath === CHEMIN_PAGE_ATELIER),
+  );
+}
+
+/**
+ * Page d'accueil d'une entreprise (ouverture sans chemin précis) : l'atelier
+ * quand son plugin est prêt, sinon le tableau de bord. Le lien direct
+ * `/dashboard` n'est pas concerné et affiche toujours le tableau de bord.
+ */
+export function CompanyHomeRedirect() {
+  const { data, isLoading } = useQuery({
+    queryKey: queryKeys.plugins.uiContributions,
+    queryFn: () => pluginsApi.listUiContributions(),
+  });
+
+  if (isLoading) return <PaperclipLoading />;
+  return <Navigate to={atelierDisponible(data) ? CHEMIN_PAGE_ATELIER : "dashboard"} replace />;
+}

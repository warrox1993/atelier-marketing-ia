+  it("Atelier B2 (patch local 0154) : un plugin ne pose que des participants de l'entreprise, et ne retire ni ne change des étapes posées, avec ou sans acteur", async () => {
+    const { companyId, agentId } = await seedCompanyAndAgent();
+    const autre = await seedCompanyAndAgent();
+    const membre = `membre-${randomUUID()}`;
+    const etranger = `etranger-${randomUUID()}`;
+    await db.insert(companyMemberships).values([
+      { companyId, principalType: "user", principalId: membre, status: "active", membershipRole: "owner" },
+      { companyId: autre.companyId, principalType: "user", principalId: etranger, status: "active", membershipRole: "owner" },
+    ]);
+    const licencie = randomUUID();
+    await db.insert(agents).values({
+      id: licencie, companyId, name: "Ancien", role: "engineer", status: "terminated",
+      adapterType: "process", adapterConfig: { command: "true" }, runtimeConfig: {}, permissions: {},
+    });
+    const services = buildHostServices(db, "plugin-record-id", "paperclip.missions", createEventBusStub());
+    const avec = (relecteur: { type: "agent"; agentId: string } | { type: "user"; userId: string }, approbateur: { type: "user"; userId: string } = { type: "user", userId: membre }) => ({
+      stages: [
+        { type: "review", participants: [relecteur] },
+        { type: "approval", participants: [approbateur] },
+      ],
+    });
+
+    // Participant hors de l'entreprise, inconnu ou licencié : 422, à la création comme à la mise à jour.
+    for (const politique of [
+      avec({ type: "agent", agentId: autre.agentId }),
+      avec({ type: "agent", agentId: randomUUID() }),
+      avec({ type: "agent", agentId: licencie }),
+      avec({ type: "agent", agentId }, { type: "user", userId: etranger }),
+      avec({ type: "user", userId: `inconnu-${randomUUID()}` }),
+    ]) {
+      await expect(services.issues.create({ companyId, title: "Hors entreprise", executionPolicy: politique }))
+        .rejects.toMatchObject({ status: 422 });
+    }
+    const tache = await services.issues.create({ companyId, title: "Livrable" });
+    await expect(services.issues.update({ issueId: tache.id, companyId, patch: { executionPolicy: avec({ type: "agent", agentId: autre.agentId }) } }))
+      .rejects.toMatchObject({ status: 422 });
+    expect((await services.issues.get({ issueId: tache.id, companyId }))?.executionPolicy ?? null).toBeNull();
+
+    // Participants de l'entreprise : acceptés ; reposer la même politique sans acteur reste permis.
+    const politique = avec({ type: "agent", agentId });
+    await services.issues.update({ issueId: tache.id, companyId, patch: { executionPolicy: politique } });
+    const reposee = await services.issues.update({ issueId: tache.id, companyId, patch: { executionPolicy: politique } });
+    expect((reposee.executionPolicy as { stages: unknown[] }).stages).toHaveLength(2);
+
+    // Retrait, vidage ou changement des étapes par un plugin : refusé, sans acteur comme avec un humain annoncé.
+    for (const patch of [
+      { executionPolicy: null },
+      { executionPolicy: { stages: [] } },
+      { executionPolicy: { stages: [{ type: "review", participants: [{ type: "user", userId: membre }] }] } },
+      { executionPolicy: null, actorUserId: membre },
+    ]) {
+      await expect(services.issues.update({ issueId: tache.id, companyId, patch }))
+        .rejects.toMatchObject({ status: 403, details: { code: "atelier_politique_verrouillee" } });
+    }
+    const gardee = await services.issues.get({ issueId: tache.id, companyId });
+    expect((gardee?.executionPolicy as { stages: Array<{ participants: unknown[] }> }).stages.map((e) => e.participants)).toEqual([
+      [expect.objectContaining({ type: "agent", agentId })],
+      [expect.objectContaining({ type: "user", userId: membre })],
+    ]);
   });
 

-    if (!policy && Object.keys(kept).length === 0) return null;
-    return { ...(policy ?? { mode: "normal" as const, commentRequired: true as const, stages: [] }), ...kept };
+    const result = !policy && Object.keys(kept).length === 0
+      ? null
+      : { ...(policy ?? { mode: "normal" as const, commentRequired: true as const, stages: [] }), ...kept };
+    const posee = signaturePolitiqueRelecture(previous);
+    if (posee !== null) {

+  // P1 ne couvre que les agents, un humain passe par le board.
+  const normalizePluginExecutionPolicy = async (companyId: string, requested: unknown, existing: unknown) => {
     const policy = normalizeIssueExecutionPolicy(requested);
     if (policy?.monitor || policy?.reviewPreset || policy?.authorizationPolicy) {
       throw new Error("Plugin may only set the review and approval stages of an execution policy");
@@ -1200,8 +1205,37 @@ export function buildHostServices(
       ...(previous?.reviewPreset ? { reviewPreset: previous.reviewPreset } : {}),
       ...(previous?.authorizationPolicy ? { authorizationPolicy: previous.authorizationPolicy } : {}),

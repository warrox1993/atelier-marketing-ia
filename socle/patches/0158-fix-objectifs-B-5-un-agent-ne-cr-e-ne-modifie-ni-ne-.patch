+/**
+ * Atelier Marketing IA (patch local 0158, revue de sécurité 2, B-5) : les objectifs sont
+ * fixés par un humain ; un acteur agent ne les crée, ne les modifie ni ne les supprime.
+ */
+import express from "express";
+import request from "supertest";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mockGoalService = vi.hoisted(() => ({
+  list: vi.fn(),
+  getById: vi.fn(),
+  create: vi.fn(),
+  update: vi.fn(),
+  remove: vi.fn(),
+}));
+const mockLogActivity = vi.hoisted(() => vi.fn());
+
+vi.mock("../telemetry.js", () => ({ getTelemetryClient: () => null }));
+vi.mock("../services/index.js", () => ({
+  goalService: () => mockGoalService,
+  logActivity: mockLogActivity,
+}));
+
+const companyId = "company-1";
+const goal = { id: "goal-1", companyId, title: "Objectif", description: null, level: "company", status: "active" };
+const agentActor = { type: "agent", agentId: "agent-1", companyId, source: "agent_key", runId: "run-1" };
+const boardActor = { type: "board", userId: "board-user", companyIds: [companyId], source: "local_implicit", isInstanceAdmin: false };
+
+async function createApp(actor: Record<string, unknown>) {
+  const [{ errorHandler }, { goalRoutes }] = await Promise.all([
+    import("../middleware/index.js"),
+    import("../routes/goals.js"),
+  ]);
+  const app = express();
+  app.use(express.json());
+  app.use((req, _res, next) => {
+    (req as any).actor = actor;
+    next();
+  });
+  app.use("/api", goalRoutes({} as any));
+  app.use(errorHandler);
+  return app;
+}
+
+describe("atelier : objectifs réservés aux humains (B-5)", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mockGoalService.getById.mockResolvedValue(goal);
+    mockGoalService.create.mockResolvedValue(goal);
+    mockGoalService.update.mockResolvedValue(goal);
+    mockGoalService.remove.mockResolvedValue(goal);
+    mockLogActivity.mockResolvedValue(undefined);
+  });
+
+  it("refuse (403) qu'un agent crée, modifie ou supprime un objectif", async () => {
+    const app = await createApp(agentActor);
+    const creation = await request(app).post(`/api/companies/${companyId}/goals`).send({ title: "Cible inventée" });
+    const modification = await request(app).patch("/api/goals/goal-1").send({ description: "Cible : 1000 prospects" });
+    const suppression = await request(app).delete("/api/goals/goal-1");
+
+    for (const res of [creation, modification, suppression]) {
+      expect(res.status, JSON.stringify(res.body)).toBe(403);
+      expect(res.body.error).toContain("un humain le fait depuis le board");
+    }
+    expect(mockGoalService.create).not.toHaveBeenCalled();
+    expect(mockGoalService.update).not.toHaveBeenCalled();
+    expect(mockGoalService.remove).not.toHaveBeenCalled();
+  });
+
+  it("laisse un agent lire les objectifs", async () => {
+    mockGoalService.list.mockResolvedValue([goal]);
+    const app = await createApp(agentActor);
+    const res = await request(app).get(`/api/companies/${companyId}/goals`);
+
+    expect(res.status, JSON.stringify(res.body)).toBe(200);
+  });
+
+  it("laisse le board créer, modifier et supprimer un objectif", async () => {
+    const app = await createApp(boardActor);
+    const creation = await request(app).post(`/api/companies/${companyId}/goals`).send({ title: "Objectif" });
+    const modification = await request(app).patch("/api/goals/goal-1").send({ description: "Cible : 30 prospects" });
+    const suppression = await request(app).delete("/api/goals/goal-1");
+
+    expect(creation.status, JSON.stringify(creation.body)).toBe(201);
+    expect(modification.status, JSON.stringify(modification.body)).toBe(200);
+    expect(suppression.status, JSON.stringify(suppression.body)).toBe(200);
+  });
+});

diff --git a/ui/src/hooks/useIssuePlanDocument.test.tsx b/ui/src/hooks/useIssuePlanDocument.test.tsx
new file mode 100644
index 000000000..cf32e5f89
--- /dev/null
+++ b/ui/src/hooks/useIssuePlanDocument.test.tsx
@@ -0,0 +1,80 @@
+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ApiError } from "@/api/client";
+import { useIssuePlanDocument } from "./useIssuePlanDocument";
+
+const mockIssuesApi = vi.hoisted(() => ({
+  getDocument: vi.fn(),
+  getOptionalDocument: vi.fn(),
+}));
+vi.mock("@/api/issues", () => ({ issuesApi: mockIssuesApi }));
+
+(globalThis as any).IS_REACT_ACT_ENVIRONMENT = true;
+
+let result: ReturnType<typeof useIssuePlanDocument>;
+let root: Root;
+let host: HTMLDivElement;
+
+function Harness() {
+  result = useIssuePlanDocument("issue-1");
+  return null;
+}
+
+async function monter() {
+  // Les relances par défaut sont conservées : seule la correction doit les couper.
+  const queryClient = new QueryClient({
+    defaultOptions: { queries: { retryDelay: 1 } },
+  });
+  await act(async () => {
+    root.render(
+      <QueryClientProvider client={queryClient}>
+        <Harness />
+      </QueryClientProvider>,
+    );
+  });
+  for (let i = 0; i < 30; i++) {
+    await act(async () => {
+      await new Promise((r) => setTimeout(r, 5));
+    });
+  }
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  host = document.createElement("div");
+  root = createRoot(host);
+});
+afterEach(() => {
+  act(() => root.unmount());
+});
+
+describe("useIssuePlanDocument", () => {
+  it("un plan absent donne null, sans erreur et sans appel qui échoue", async () => {
+    mockIssuesApi.getOptionalDocument.mockResolvedValue(null);
+    mockIssuesApi.getDocument.mockRejectedValue(new ApiError("Document not found", 404, null));
+    await monter();
+    expect(result.isError).toBe(false);
+    expect(result.data).toBeNull();
+    // La lecture « optionnelle » ne produit pas de 404 côté réseau.
+    expect(mockIssuesApi.getDocument).not.toHaveBeenCalled();
+    expect(mockIssuesApi.getOptionalDocument).toHaveBeenCalledTimes(1);
+  });
+
+  it("un 404 résiduel reste traité comme « pas de plan »", async () => {
+    mockIssuesApi.getOptionalDocument.mockRejectedValue(new ApiError("Document not found", 404, null));
+    await monter();
+    expect(result.isError).toBe(false);
+    expect(result.data).toBeNull();
+    expect(mockIssuesApi.getOptionalDocument).toHaveBeenCalledTimes(1);
+  });
+
+  it("une vraie erreur (500) reste une erreur, sans relance en boucle", async () => {
+    mockIssuesApi.getOptionalDocument.mockRejectedValue(new ApiError("boom", 500, null));
+    await monter();
+    expect(result.isError).toBe(true);
+    expect(mockIssuesApi.getOptionalDocument).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/ui/src/hooks/useIssuePlanDocument.ts b/ui/src/hooks/useIssuePlanDocument.ts
index 9b0f0ed50..30011b69d 100644
--- a/ui/src/hooks/useIssuePlanDocument.ts
+++ b/ui/src/hooks/useIssuePlanDocument.ts
@@ -17,11 +17,14 @@ export function useIssuePlanDocument(issueId: string | null | undefined) {
     enabled: Boolean(issueId) && !issueId?.startsWith("chat:"),
     queryFn: async () => {
       try {
-        return await issuesApi.getDocument(issueId!, "plan");
+        // 200 null si le plan n'existe pas (aucune erreur 404 dans la console).
+        return await issuesApi.getOptionalDocument(issueId!, "plan");
       } catch (error) {
         if (error instanceof ApiError && error.status === 404) return null;
         throw error;
       }
     },
+    // Un plan absent n'est pas une panne : pas de relances automatiques.
+    retry: false,
   });
 }

@@ -9823,6 +9823,13 @@ export function issueRoutes(
       keyParsed.data,
     );
     if (!doc) {
+      // Lecture optionnelle (?optional=true) : « pas de document » est une
+      // réponse normale (200 null), pour ne pas polluer la console du navigateur
+      // d'une erreur 404 à chaque ouverture d'une tâche sans plan.
+      if (parseBooleanQuery(req.query.optional)) {
+        res.json(null);
+        return;
+      }
       res.status(404).json({ error: "Document not found" });
       return;
     }

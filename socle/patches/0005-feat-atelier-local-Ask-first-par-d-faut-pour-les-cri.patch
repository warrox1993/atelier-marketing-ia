+/** Atelier Marketing IA (local patch 0005): slug prefix of the marketing gateway cards. */
+export const ATELIER_APP_SLUG_PREFIX = "atelier-";
+
+/** Every risk level except `read`: what the gateway cards put behind "Ask first" by default. */
+export const ATELIER_ASK_FIRST_RISK_LEVELS: string[] = TOOL_RISK_LEVELS.filter((level) => level !== "read");

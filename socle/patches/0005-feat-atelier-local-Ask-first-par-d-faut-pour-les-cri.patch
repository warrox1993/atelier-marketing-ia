 export const CONNECTABLE_APP_SLUGS = new Set([
   "anthropic", "openai", "openrouter", "xai",
@@ -273,10 +274,26 @@ export function recommendedDefaultsForApp(app: AppDefinition, methodKey?: string
   // an operator-selected policy for any action after the connection is made.
   // The connect flow lands on the Permissions tab so that choice is the very
   // next screen (PAP-659: agents get full permissions unless someone narrows them).
-  void app;
   void methodKey;
+  // Atelier Marketing IA (local patch 0005): the marketing gateway cards keep
+  // every tool that is not a plain read behind "Ask first" by default
+  // (publishing, messages, CRM writes). The operator can still allow an action
+  // afterwards on the Permissions tab; the atelier's own human approval stays
+  // required in addition.
+  if (app.slug.startsWith(ATELIER_APP_SLUG_PREFIX)) {

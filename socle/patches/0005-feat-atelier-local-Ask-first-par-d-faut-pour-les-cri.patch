+/** Atelier Marketing IA (local patch 0005): French mutation verbs of the marketing gateway tools. */
+const ATELIER_DESTRUCTIVE_VERBS = "supprimer|effacer|retirer|desactiver|archiver";
+const ATELIER_WRITE_VERBS = "publier|envoyer|modifier|ecrire|creer|ajouter|repondre|programmer|planifier|mettre|lancer|activer|associer|changer|remplacer";
+
 export function classifyRisk(
   tool: McpToolDescriptor,
   sourceTemplateKey?: string | null,
@@ -2377,6 +2382,13 @@ export function classifyRisk(
   const annotations = tool.annotations ?? {};
   if (annotations.destructiveHint === true || annotations.destructive === true)
     return "destructive";
+  // Atelier Marketing IA (local patch 0005): the marketing gateway names its
+  // tools in French. A mutation verb is never a read, whatever the provider
+  // annotates, so a missing or wrong `readOnlyHint` cannot skip "Ask first".
+  if (sourceTemplateKey?.startsWith(ATELIER_APP_SLUG_PREFIX)) {
+    if (verbMatches(tool.name, ATELIER_DESTRUCTIVE_VERBS)) return "destructive";
+    if (verbMatches(tool.name, ATELIER_WRITE_VERBS)) return "write";
+  }
   const normalizedToolName = normalizedProviderToolName(tool.name);
   if (isMemoryConnectorId(sourceTemplateKey)) {
     if (verbMatches(tool.name, "delete|remove|destroy|forget|prune|reset")) return "destructive";

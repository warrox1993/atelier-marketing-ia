diff --git a/ui/src/pages/IssueDetail.test.tsx b/ui/src/pages/IssueDetail.test.tsx
index 1055e4be7..51eaabb11 100644
--- a/ui/src/pages/IssueDetail.test.tsx
+++ b/ui/src/pages/IssueDetail.test.tsx
@@ -2209,6 +2209,34 @@ describe("IssueDetail", () => {
     });
   });
 
+  it("la carte Plan ouvre le document et agrandit le panneau à chaque clic", async () => {
+    mockLocation.hash = "#document-plan";
+    mockIssuesApi.get.mockResolvedValue(createIssue());
+    await act(async () => {
+      root.render(<QueryClientProvider client={queryClient}><IssueDetail /></QueryClientProvider>);
+    });
+    await waitForAssertion(() => {
+      const panel = mockOpenPanel.mock.calls.at(-1)?.[0]?.props.children as
+        { props?: Record<string, unknown> } | undefined;
+      expect((panel?.props?.documentDeepLink as { requestId?: number } | null)?.requestId).toBe(1);
+    });
+    mockRequestPanelMaximize.mockClear();
+
+    const link = document.createElement("a");
+    link.href = "#document-plan";
+    link.setAttribute("data-plan-card-maximize", "");
+    container.appendChild(link);
+    await act(async () => link.click());
+    await waitForAssertion(() => expect(mockRequestPanelMaximize).toHaveBeenCalledTimes(1));
+    await act(async () => link.click());
+    await waitForAssertion(() => {
+      expect(mockRequestPanelMaximize).toHaveBeenCalledTimes(2);
+      const panel = mockOpenPanel.mock.calls.at(-1)?.[0]?.props.children as
+        { props?: Record<string, unknown> } | undefined;
+      expect((panel?.props?.documentDeepLink as { requestId?: number } | null)?.requestId).toBe(3);
+    });
+  });
+
   it("maximizes the desktop pane once per viewer=full deep link", async () => {
     mockPanelState.panelVisible = false;
     mockLocation.hash = "#document-qa-evidence&viewer=full";

index 000000000..2db1ccfcf
--- /dev/null
+++ b/ui/src/hooks/useDecisionsAtelier.ts
@@ -0,0 +1,23 @@
+import { useSyncExternalStore } from "react";
+
+/**
+ * Nombre de décisions humaines qui attendent dans les services de l'atelier (plans à valider, questions, accords),
+ * publié par le plugin Atelier (`window.__atelierDecisions` + événement `atelier:decisions`) : le menu du socle n'a pas
+ * accès aux données du plugin. Zéro tant que le plugin n'a rien publié.
+ */
+export const EVENEMENT_DECISIONS_ATELIER = "atelier:decisions";
+
+export function lireDecisionsAtelier(): number {
+  if (typeof window === "undefined") return 0;
+  const n = (window as unknown as { __atelierDecisions?: unknown }).__atelierDecisions;
+  return typeof n === "number" && Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
+}
+
+function abonner(fn: () => void): () => void {
+  window.addEventListener(EVENEMENT_DECISIONS_ATELIER, fn);
+  return () => window.removeEventListener(EVENEMENT_DECISIONS_ATELIER, fn);
+}
+
+export function useDecisionsAtelier(): number {
+  return useSyncExternalStore(abonner, lireDecisionsAtelier, () => 0);
+}

 (globalThis as any).IS_REACT_ACT_ENVIRONMENT = true;
 
@@ -58,6 +66,15 @@ describe("ContextualSidebarFrame", () => {
     act(() => root.unmount());
   });
 
+  it("expose le sélecteur d'entreprise dans l'en-tête, nom de l'entreprise visible", () => {
+    const root = render();
+    const switcher = container.querySelector('[data-testid="contextual-company-switcher"]');
+    expect(switcher).not.toBeNull();
+    const trigger = switcher?.querySelector<HTMLButtonElement>('button[aria-label*="organization switcher"]');
+    expect(trigger?.textContent).toContain("Paperclip");
+    act(() => root.unmount());
+  });
+

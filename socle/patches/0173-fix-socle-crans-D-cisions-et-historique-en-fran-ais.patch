+    expect(container.querySelector("table")?.getAttribute("aria-label")).toBe(ariaLabel);
+    expect(container.querySelector("p")?.textContent).toBe("Demandes récentes. Les entrées ne sont pas conservées.");
+    cleanup();
+  });
+});

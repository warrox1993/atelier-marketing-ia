+// @vitest-environment jsdom
+
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { MemoryRouter, Route, Routes } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { DecisionQueuePage } from "./DecisionQueuePage";
+import { WhatNeedsMe } from "./WhatNeedsMe";
+
+const setBreadcrumbsMock = vi.hoisted(() => vi.fn());
+const attentionListMock = vi.hoisted(() => vi.fn());
+vi.mock("../api/attention", () => ({ attentionApi: { list: attentionListMock } }));
+vi.mock("../api/agents", () => ({ agentsApi: { list: vi.fn().mockResolvedValue([]) } }));
+vi.mock("../api/auth", () => ({ authApi: { getSession: vi.fn().mockResolvedValue(null) } }));
+vi.mock("../api/decisions", () => ({ decisionsApi: { list: vi.fn().mockResolvedValue([]) } }));
+vi.mock("../api/decisionQueues", () => ({
+  decisionQueuesApi: { list: vi.fn().mockResolvedValue([{ key: "file-1", title: "File des urgences", seedRules: [], seedRulesEnabled: false }]) },
+}));
+vi.mock("../context/CompanyContext", () => ({ useCompany: () => ({ selectedCompanyId: "company-1" }) }));
+vi.mock("../context/BreadcrumbContext", () => ({ useBreadcrumbs: () => ({ setBreadcrumbs: setBreadcrumbsMock }) }));
+vi.mock("../context/ToastContext", () => ({ useToastActions: () => ({ pushToast: vi.fn() }) }));
+vi.mock("../hooks/useInboxBadge", () => ({
+  useInboxDismissals: () => ({ dismiss: vi.fn(), snooze: vi.fn(), restore: vi.fn() }),
+}));
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+(globalThis as any).IS_REACT_ACT_ENVIRONMENT = true;
+
+describe("écrans Décisions en français", () => {
+  let container: HTMLDivElement;
+  let root: Root;
+  let client: QueryClient;
+
+  beforeEach(() => {
+    container = document.createElement("div");
+    document.body.appendChild(container);
+    root = createRoot(container);
+    client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+    attentionListMock.mockResolvedValue({ items: [], counts: {}, total: 0 });
+    setBreadcrumbsMock.mockClear();
+  });
+
+  afterEach(() => {
+    act(() => root.unmount());
+    container.remove();
+    client.clear();
+  });
+
+  it("le bureau des décisions a pour titre et fil d'Ariane « Décisions »", async () => {
+    await act(async () => root.render(
+      <MemoryRouter><QueryClientProvider client={client}><WhatNeedsMe /></QueryClientProvider></MemoryRouter>,
+    ));
+    await act(async () => { await vi.waitFor(() => expect(container.querySelector("h1")?.textContent).toBe("Décisions")); });
+    expect(setBreadcrumbsMock).toHaveBeenCalledWith([{ label: "Décisions" }]);
+  });
+
+  it("une file de décisions a pour fil d'Ariane « Décisions » puis le titre de la file", async () => {
+    await act(async () => root.render(
+      <MemoryRouter initialEntries={["/file/file-1"]}>
+        <QueryClientProvider client={client}>
+          <Routes><Route path="/file/:key" element={<DecisionQueuePage />} /></Routes>
+        </QueryClientProvider>
+      </MemoryRouter>,
+    ));
+    await act(async () => { await vi.waitFor(() => expect(setBreadcrumbsMock).toHaveBeenLastCalledWith([
+      { label: "Décisions", href: "/decisions" }, { label: "File des urgences" },
+    ])); });
+  });
+});

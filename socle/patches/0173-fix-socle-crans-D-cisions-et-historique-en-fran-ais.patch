+describe("libellés français de l'historique", () => {
+  function render(entries: Parameters<typeof DecisionHistoryTable>[0]["entries"], fastResponse: boolean) {
+    const container = document.createElement("div");
+    const root = createRoot(container);
+    flushSync(() => root.render(
+      <MemoryRouter>
+        <DecisionHistoryTable entries={entries} fastResponse={fastResponse} />
+      </MemoryRouter>,
+    ));
+    return { container, cleanup: () => flushSync(() => root.unmount()) };
+  }
+
+  it.each([
+    [false, "Aucune demande de décision sur cette période.", "Configurer un modèle de décision"],
+    [true, "Aucune réponse rapide sur cette période.", "Configurer la réponse rapide"],
+  ] as const)("état vide avec réponse rapide %s", (fastResponse, vide, lien) => {
+    const { container, cleanup } = render([], fastResponse);
+    expect(container.textContent).toBe(`${vide} ${lien} pour lancer un essai.`);
+    cleanup();
+  });
+
+  it.each([
+    [false, "Demandes de décision"],
+    [true, "Réponses rapides"],
+  ] as const)("tableau avec réponse rapide %s : intitulé et aria-label", (fastResponse, ariaLabel) => {
+    const entry = { id: "e1", startedAt: "2026-11-01T10:00:00Z", feature: "x", actorType: "system", status: "succeeded", model: "m", durationMs: 1000, inputTokens: 1, outputTokens: 1, costCents: 1, costStatus: "unpriced" };

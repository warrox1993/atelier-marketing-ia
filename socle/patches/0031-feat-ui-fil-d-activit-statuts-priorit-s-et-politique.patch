     const details = { status: "in_review", externalConversationState: "waiting" };
     expect(formatActivityVerb("issue.updated", details)).toBe("a changé le statut en idle sur");
     expect(formatIssueActivityAction("issue.updated", details)).toBe("a changé le statut en idle");
-    expect(formatActivityVerb("issue.updated", { status: "in_review" })).toBe("a changé le statut en in review sur");

--- a/ui/src/lib/activity-format.ts
+++ b/ui/src/lib/activity-format.ts
@@ -353,9 +353,24 @@ function asRecord(value: unknown): Record<string, unknown> | null {
   return value as Record<string, unknown>;
 }
 
+/** Libellés français (en milieu de phrase) des statuts et priorités de tâche. */
+const LIBELLES_VALEURS: Record<string, string> = {
+  backlog: "en attente",
+  todo: "à faire",
+  in_progress: "en cours",
+  in_review: "en revue",
+  blocked: "bloquée",
+  done: "terminée",
+  cancelled: "annulée",
+  critical: "urgente",
+  high: "haute",
+  medium: "moyenne",
+  low: "basse",
+};
+
 function humanizeValue(value: unknown): string {
   if (typeof value !== "string") return String(value ?? "aucun");
-  return value.replace(/_/g, " ");
+  return LIBELLES_VALEURS[value] ?? value.replace(/_/g, " ");
 }
 
 function isActivityParticipant(value: unknown): value is ActivityParticipant {

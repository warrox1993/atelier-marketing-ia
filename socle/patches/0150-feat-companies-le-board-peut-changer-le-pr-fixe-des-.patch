+      const companyId = await seedCompanyWithWork("Acme Robotics", "XXX");
+
+      await expect(
+        companyService(db).update(companyId, { issuePrefix: "DIR" }, TEST_ACTOR),
+      ).rejects.toMatchObject({ status: 409 });

+// Atelier (AFD-C1, patchs 0108 et 0110) : un agent ne modifie plus la configuration d'un agent, la sienne comprise,
+// ni ne teste un environnement d'exécution avec elle. Le même geste, fait par le board, garde la même vérification
+// de connexion IA : chaque requête est d'abord refusée à l'agent (message exact, rien ne change), puis faite par le board.
+async function refuseeAlAgentPuisParLeBoard(f: Awaited<ReturnType<typeof fixture>>, envoyer: (app: express.Express) => request.Test) {
+  const refused = await envoyer(f.app);
+  expect(refused.status, JSON.stringify(refused.body)).toBe(403);
+  expect(refused.body).toEqual({
+    error: "Atelier : seul un humain modifie la configuration, les consignes ou les skills d'un agent.",
+    details: { reason: "deny_policy_restricted" },
+  });
+  return envoyer(f.boardApp);
 }
 

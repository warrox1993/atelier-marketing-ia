diff --git a/packages/adapters/claude-local/src/server/execute.ts b/packages/adapters/claude-local/src/server/execute.ts
index 3c03771f35..0d107ac972 100644
--- a/packages/adapters/claude-local/src/server/execute.ts
+++ b/packages/adapters/claude-local/src/server/execute.ts
@@ -527,11 +527,18 @@ export async function execute(ctx: AdapterExecutionContext): Promise<AdapterExec
   if (instructionsFilePath) {
     try {
       const instructionsContent = await fs.readFile(instructionsFilePath, "utf-8");
+      // Atelier Marketing IA (PARC-12) : ne citer que les fichiers frères présents (sinon ~10 lectures refusées par session).
+      const siblingFiles: string[] = [];
+      for (const name of ["HEARTBEAT.md", "SOUL.md", "TOOLS.md"]) {
+        if (await fs.access(path.join(instructionsFileDir, name)).then(() => true, () => false)) siblingFiles.push(`./${name}`);
+      }
       instructionsPathDirective =
         `Agent instructions for this run were loaded from ${instructionsFilePath}. ` +
         `Resolve any relative file references from ${instructionsFileDir}. ` +
-        `This base directory is authoritative for sibling instruction files such as ` +
-        `./HEARTBEAT.md, ./SOUL.md, and ./TOOLS.md; do not resolve those from the parent agent directory. ` +
+        (siblingFiles.length > 0
+          ? `This base directory is authoritative for sibling instruction files such as ` +
+            `${new Intl.ListFormat("en", { type: "conjunction" }).format(siblingFiles)}; do not resolve those from the parent agent directory. `
+          : "") +
         `This location replaces any instruction file location from earlier turns.`;
       combinedInstructionsContents = instructionsContent +
         "\nUse the agent instruction file location supplied in the current run prompt to resolve relative file references.";

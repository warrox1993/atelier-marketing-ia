@@ -638,6 +638,7 @@ describe("claude execute", () => {
     });
     const instructionsFile = path.join(root, "instructions.md");
     await fs.writeFile(instructionsFile, "# Agent instructions", "utf-8");
+    for (const sibling of ["HEARTBEAT.md", "SOUL.md", "TOOLS.md"]) await fs.writeFile(path.join(root, sibling), "# frère", "utf-8");
     const metaEvents: Array<{ commandArgs: string[]; commandNotes: string[] }> = [];
     const getFreshSessionHandoff = vi.fn(async () => "FRESH_HANDOFF: original goal and prior decisions");
     const prompts: string[] = [];
@@ -1989,3 +1990,42 @@ describe("claude execute : historique du réveil avec passation (Atelier PARC-9)
     expect(prompt).not.toContain("earlier messages are omitted");
   });
 });
+
+describe("claude execute : fichiers frères des instructions (Atelier PARC-12)", () => {
+  async function directive(freres: string[]): Promise<string> {
+    const root = await fs.mkdtemp(path.join(os.tmpdir(), "paperclip-claude-parc12-"));
+    const { workspace, commandPath, capturePath, restore } = await setupExecuteEnv(root);
+    const dossier = path.join(root, "agent");
+    await fs.mkdir(dossier, { recursive: true });
+    const instructionsFile = path.join(dossier, "AGENTS.md");
+    await fs.writeFile(instructionsFile, "# Consignes", "utf-8");
+    for (const frere of freres) await fs.writeFile(path.join(dossier, frere), "# frère", "utf-8");
+    try {
+      await execute({
+        runId: "run-parc12",
+        agent: { id: "agent-1", companyId: "company-1", name: "Claude", adapterType: "claude_local", adapterConfig: {} },
+        runtime: { sessionId: null, sessionParams: null, sessionDisplayId: null, taskKey: null },
+        config: { engine: "cli", command: commandPath, cwd: workspace, env: { PAPERCLIP_TEST_CAPTURE_PATH: capturePath }, promptTemplate: "Do work.", instructionsFilePath: instructionsFile },
+        context: {},
+        onLog: async () => {},
+      });
+      return (JSON.parse(await fs.readFile(capturePath, "utf8")) as CapturePayload).prompt;
+    } finally {
+      restore();
+      await fs.rm(root, { recursive: true, force: true });
+    }
+  }
+
+  it("aucun fichier frère présent : aucune mention", async () => {
+    const prompt = await directive([]);
+    expect(prompt).toContain("Agent instructions for this run were loaded from");
+    expect(prompt).not.toContain("sibling instruction files");
+    expect(prompt).not.toMatch(/HEARTBEAT\.md|SOUL\.md|TOOLS\.md/);
+  });
+
+  it("seuls les fichiers frères présents sont cités", async () => {
+    const prompt = await directive(["TOOLS.md"]);
+    expect(prompt).toContain("sibling instruction files such as ./TOOLS.md; do not resolve those from the parent agent directory.");
+    expect(prompt).not.toMatch(/HEARTBEAT\.md|SOUL\.md/);
+  });
+});

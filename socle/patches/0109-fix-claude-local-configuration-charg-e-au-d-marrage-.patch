+/**
+ * Atelier Marketing IA (patch local 0109, AFD-É1 et AFA-P1-1) : dans la cage locale, l'agent écrit dans son dossier de
+ * configuration (mémoire, transcriptions, état de Claude Code) mais pas dans ce que Claude Code charge au démarrage
+ * (réglages, hooks, règles...), et les skills voulues se lisent par les liens du paquet, en lecture seule.
+ */
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { runChildProcess } from "@paperclipai/adapter-utils/server-utils";
+import { CLAUDE_CONFIG_READ_ONLY_ENTRIES, claudeSandboxManagedPaths } from "./claude-config.js";
+
+const nettoyer: string[] = [];
+afterEach(async () => {
+  await Promise.all(nettoyer.splice(0).map((dossier) => fs.rm(dossier, { recursive: true, force: true })));
+});
+
+describe("atelier : montages de la cage d'un run Claude", () => {
+  it("monte le dossier de configuration en écriture puis, par-dessus, les entrées chargées au démarrage en lecture seule", () => {
+    const chemins = claudeSandboxManagedPaths({
+      sharedClaudeConfigDir: "/x/claude-config/c/agent",
+      promptBundleDir: "/x/paquet",
+      mcpConfigDir: "/x/mcp",
+      skillSources: ["/x/skills/a", "/x/skills/b"],
+    });
+    expect(chemins[0]).toEqual({ path: "/x/claude-config/c/agent", access: "rw" });
+    for (const entree of ["settings.json", "hooks", "rules", "skills", "agents", "commands", "CLAUDE.md"]) {
+      const i = chemins.findIndex((c) => c.path === `/x/claude-config/c/agent/${entree}`);
+      expect(i, entree).toBeGreaterThan(0);
+      expect(chemins[i]!.access).toBe("ro");
+    }
+    expect(chemins).toContainEqual({ path: "/x/claude-config/c/.claude.json", access: "rw" });
+    expect(chemins.slice(-2)).toEqual([{ path: "/x/skills/a", access: "ro" }, { path: "/x/skills/b", access: "ro" }]);
+    expect(CLAUDE_CONFIG_READ_ONLY_ENTRIES).not.toContain("memoire");
+    expect(CLAUDE_CONFIG_READ_ONLY_ENTRIES).not.toContain("projects");
+  });
+
+  it.runIf(Boolean(process.env.PAPERCLIP_TEST_BWRAP))(
+    "avec Bubblewrap : réglages, hooks et règles en lecture seule, mémoire et transcriptions en écriture, skill lue par le lien",
+    async () => {
+      const racine = await fs.realpath(await fs.mkdtemp(path.join(os.tmpdir(), "atelier-cage-config-")));
+      nettoyer.push(racine);
+      const config = path.join(racine, "claude-config", "agent");
+      const espace = path.join(racine, "espace");
+      const source = path.join(racine, "bibliotheque", "skill-a");
+      const paquet = path.join(racine, "paquet");
+      const mcp = path.join(racine, "mcp");
+      for (const d of [path.join(config, "hooks"), path.join(config, "rules"), path.join(config, "memoire"),
+        path.join(config, "projects"), espace, source, path.join(paquet, ".claude", "skills"), mcp]) {
+        await fs.mkdir(d, { recursive: true });
+      }
+      await fs.writeFile(path.join(config, "settings.json"), "{}\n");
+      await fs.writeFile(path.join(config, "hooks", "garde.sh"), "exit 2\n");
+      await fs.writeFile(path.join(source, "SKILL.md"), "contenu-skill");
+      await fs.symlink(source, path.join(paquet, ".claude", "skills", "skill-a"));
+
+      const etapes: Array<[string, string]> = [
+        ["ecrire-refuse", path.join(config, "settings.json")],
+        ["ecrire-refuse", path.join(config, "hooks", "garde.sh")],
+        ["ecrire-refuse", path.join(config, "rules", "injectee.md")],
+        ["ecrire-refuse", path.join(source, "SKILL.md")],
+        ["ecrire-ok", path.join(config, "memoire", "MEMORY.md")],
+        ["ecrire-ok", path.join(config, "projects", "session.jsonl")],
+        ["ecrire-ok", path.join(config, ".claude.json")],
+        ["lire-skill", path.join(paquet, ".claude", "skills", "skill-a", "SKILL.md")],
+      ];
+      const script = [
+        "const fs = require('node:fs');",
+        `const etapes = ${JSON.stringify(etapes)};`,
+        "etapes.forEach(([genre, chemin], i) => {",
+        "  if (genre === 'lire-skill') { if (fs.readFileSync(chemin, 'utf8') !== 'contenu-skill') process.exit(20 + i); return; }",
+        "  try { fs.writeFileSync(chemin, 'x'); if (genre === 'ecrire-refuse') process.exit(20 + i); }",
+        "  catch (e) { if (genre === 'ecrire-ok' || !['EROFS', 'EACCES', 'EPERM'].includes(e.code)) { console.error(chemin, e.code); process.exit(40 + i); } }",
+        "});",
+      ].join("\n");
+      const resultat = await runChildProcess("atelier-cage-config", process.execPath, ["-e", script], {
+        cwd: espace,
+        env: {},
+        timeoutSec: 10,
+        graceSec: 1,
+        onLog: async () => {},
+        localProcessSandbox: {
+          workspaceDir: espace,
+          filesystemScope: "workspace",
+          managedPaths: claudeSandboxManagedPaths({
+            sharedClaudeConfigDir: config, promptBundleDir: paquet, mcpConfigDir: mcp, skillSources: [source],
+          }),
+          command: process.env.PAPERCLIP_TEST_BWRAP,
+        },
+      });
+
+      expect(resultat.exitCode, resultat.stderr).toBe(0);
+      await expect(fs.readFile(path.join(config, "settings.json"), "utf8")).resolves.toBe("{}\n");
+      await expect(fs.readFile(path.join(config, "memoire", "MEMORY.md"), "utf8")).resolves.toBe("x");
+    },
+  );
+});

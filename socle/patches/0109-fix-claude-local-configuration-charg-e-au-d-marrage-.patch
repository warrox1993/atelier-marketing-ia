  */
+// Atelier (AFD-É1) : ce que Claude Code charge au démarrage depuis CLAUDE_CONFIG_DIR. Monté en lecture seule après le
+// dossier en écriture, pour qu'un agent ne réécrive ni ses réglages, ni ses hooks, ni ses règles (chargées comme
+// consignes de l'utilisateur). Le reste (memoire, projects, .claude.json, sessions...) reste en écriture.
+export const CLAUDE_CONFIG_READ_ONLY_ENTRIES = ["settings.json", "hooks", "rules", "skills", "agents", "commands", "CLAUDE.md"] as const;
+
+/** Montages de la cage locale d'un run Claude (l'ordre compte : un montage plus loin recouvre un plus large). */
+export function claudeSandboxManagedPaths(input: {
+  sharedClaudeConfigDir: string;
+  promptBundleDir: string;
+  mcpConfigDir: string;
+  skillSources: string[];
+}): LocalProcessSandboxPath[] {
+  return [
+    { path: input.sharedClaudeConfigDir, access: "rw" },
+    ...CLAUDE_CONFIG_READ_ONLY_ENTRIES.map((entry) => ({ path: path.join(input.sharedClaudeConfigDir, entry), access: "ro" as const })),
+    { path: path.join(path.dirname(input.sharedClaudeConfigDir), ".claude.json"), access: "rw" },
+    { path: input.promptBundleDir, access: "ro" },
+    { path: input.mcpConfigDir, access: "ro" },
+    // Atelier (AFA-P1-1) : sources des skills voulues, en lecture seule, pour que les liens du paquet se résolvent.
+    ...input.skillSources.map((source) => ({ path: source, access: "ro" as const })),
+  ];
+}

+        mockCompanyState.companies = clientFictif;
+        mockSidebarPreferencesApi.getCompanyOrder.mockResolvedValue({
+          orderedIds: clientFictif.map((c) => c.id),
+          updatedAt: null,
+        });
+        const { root } = renderMenu({ production });
+        await flushReact();
+        await flushReact();
+        await openMenu(production ? "Open Acme Labs company switcher" : "Open Acme Labs organization switcher");
+
+        const items = Array.from(document.body.querySelectorAll('[data-slot="dropdown-menu-item"]'))

+        expect(lignesClient[0]).not.toContain("Marketing");
+        expect(document.body.textContent).not.toContain("FICAB");
+        expect(items.some((texte) => texte.includes("Acme Labs") && texte.includes("PAP"))).toBe(true);
+
+        act(() => {
+          root.unmount();
+        });
+      });
+
+      it(`choisir le client ouvre son service Marketing sur le tableau des départements (${variante})`, async () => {
+        mockCompanyState.companies = clientFictif;
+        mockPluginsApi.listUiContributions.mockResolvedValue([contributionAtelier]);
+        const { root } = renderMenu({ production });
+        await flushReact();
+        await flushReact();
+        await openMenu(production ? "Open Acme Labs company switcher" : "Open Acme Labs organization switcher");
+
+        const ligne = Array.from(document.body.querySelectorAll('[data-slot="dropdown-menu-item"]'))
+          .find((element) => element.textContent?.includes("Fictive SA"));
+        expect(ligne).toBeTruthy();

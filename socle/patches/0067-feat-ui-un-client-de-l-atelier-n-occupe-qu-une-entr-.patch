+import { describe, expect, it } from "vitest";
+import { deplierOrdre, entreeDe, grouperEntreprises, lireMarqueurClient } from "./company-groups";
+
+const svc = (id: string, nom: string, client: string, service: string | null) => ({
+  id,
+  name: nom,
+  description: `Entreprise cliente de l'Atelier Marketing IA. Marqueur de périmètre : atelier-client:${client}${service ? `:${service}` : ""}.`,
+});
+
+describe("lireMarqueurClient", () => {
+  it("lit le client et le service", () => {
+    expect(lireMarqueurClient("… Marqueur de périmètre : atelier-client:fictive-sa:juridique.")).toEqual({ client: "fictive-sa", service: "juridique" });
+    expect(lireMarqueurClient("Marqueur : atelier-client:fictive-sa.")).toEqual({ client: "fictive-sa", service: null });
+  });
+
+  it("refuse un marqueur collé à un autre mot ou absent", () => {
+    expect(lireMarqueurClient("xatelier-client:fictive-sa")).toBeNull();
+    expect(lireMarqueurClient("Une entreprise ordinaire")).toBeNull();
+    expect(lireMarqueurClient(null)).toBeNull();
+  });
+});
+
+describe("grouperEntreprises", () => {
+  const isolee = { id: "i", name: "Boulangerie · Atelier", description: "Sans marqueur" };
+  const seule = svc("s", "Mono SA · Marketing", "mono-sa", "marketing");
+  const companies = [
+    svc("c1", "Fictive SA · Commercial", "fictive-sa", "commercial"),
+    isolee,
+    svc("c2", "Fictive SA · Marketing", "fictive-sa", "marketing"),
+    svc("c3", "Fictive SA · Direction", "fictive-sa", "direction"),
+    seule,
+  ];
+
+  it("une entrée par client, à la place de son premier membre, au nom du client", () => {
+    const entries = grouperEntreprises(companies);
+    expect(entries.map((e) => e.label)).toEqual(["Fictive SA", "Boulangerie · Atelier", "Mono SA · Marketing"]);
+    const client = entries[0]!;
+    expect(client.grouped).toBe(true);
+    expect(client.members.map((m) => m.id)).toEqual(["c1", "c2", "c3"]);
+    // L'entrée ouvre le service Marketing.
+    expect(client.primary.id).toBe("c2");
+    expect(client.key).toBe("c2");
+  });
+
+  it("une entreprise sans marqueur et un client à un seul service restent des entrées normales", () => {
+    const entries = grouperEntreprises(companies);
+    expect(entries[1]).toMatchObject({ grouped: false, label: "Boulangerie · Atelier", members: [isolee] });
+    expect(entries[2]).toMatchObject({ grouped: false, label: "Mono SA · Marketing", members: [seule] });
+  });
+
+  it("ne regroupe jamais sur le nom seul", () => {
+    const memesNoms = [
+      { id: "a", name: "Café · Bar", description: null },
+      { id: "b", name: "Café · Salle", description: null },
+    ];
+    expect(grouperEntreprises(memesNoms).map((e) => e.grouped)).toEqual([false, false]);
+  });
+
+  it("Direction faute de Marketing, sinon le premier ; slug faute de préfixe commun", () => {
+    const sansMarketing = [svc("j", "Juridique", "x-y", "juridique"), svc("d", "Direction", "x-y", "direction")];
+    const [e] = grouperEntreprises(sansMarketing);
+    expect(e!.primary.id).toBe("d");
+    expect(e!.label).toBe("x-y");
+  });
+
+  it("retrouve l'entrée d'une entreprise et déplie l'ordre", () => {
+    const entries = grouperEntreprises(companies);
+    expect(entreeDe(entries, "c3")?.label).toBe("Fictive SA");
+    expect(entreeDe(entries, "inconnue")).toBeNull();
+    expect(deplierOrdre([entries[1]!, entries[0]!, entries[2]!])).toEqual(["i", "c1", "c2", "c3", "s"]);
+  });
+});

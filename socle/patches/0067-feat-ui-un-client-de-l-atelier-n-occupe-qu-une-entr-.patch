@@ -0,0 +1,108 @@
+/**
+ * Atelier marketing (local) : regroupement des entreprises d'un même client dans le sélecteur
+ * d'organisations. Un client de l'atelier est une entreprise par service (« Client · Marketing »,
+ * « Client · Direction », …) ; le sélecteur n'en montre qu'une entrée, au nom du client.
+ *
+ * Source du regroupement : le marqueur de périmètre que l'atelier écrit dans la description de chaque
+ * entreprise (`atelier-client:<client>` ou `atelier-client:<client>:<service>`,
+ * scripts/bootstrap-organisation.py). Il survit à un renommage dans l'interface, contrairement au nom.
+ * Il ne sert qu'à l'affichage : le plugin garde la déclaration de référence des services. Aucun repli
+ * sur le nom (« X · Y » est un nom banal) : une entreprise sans marqueur reste une entrée normale, et
+ * un client à un seul service aussi.
+ */
+
+export interface MarqueurClient {
+  client: string;
+  service: string | null;
+}
+
+/** Même règle de mot entier que `porte_marqueur` (bootstrap-organisation.py). */
+const MOTIF_MARQUEUR = /(?<![A-Za-z0-9_-])atelier-client:([a-z0-9][a-z0-9-]*)(?::([a-z0-9][a-z0-9-]*))?(?![A-Za-z0-9_:-])/u;
+
+export function lireMarqueurClient(description: string | null | undefined): MarqueurClient | null {
+  const m = MOTIF_MARQUEUR.exec(description ?? "");
+  if (!m) return null;
+  return { client: m[1]!, service: m[2] ?? null };
+}
+
+export interface CompanyLike {
+  id: string;
+  name: string;
+  description?: string | null;
+}
+
+export interface CompanyGroupEntry<C extends CompanyLike> {
+  /** Identifiant stable de l'entrée : celui de l'entreprise principale (sert au glisser-déposer). */
+  key: string;
+  /** Nom affiché : celui du client pour un groupe, celui de l'entreprise sinon. */
+  label: string;
+  /** Entreprise ouverte quand on choisit l'entrée (Marketing, sinon Direction, sinon la première). */
+  primary: C;
+  members: C[];
+  grouped: boolean;
+}
+
+const SEPARATEUR = " · ";
+
+function nomClient(members: CompanyLike[], slug: string): string {
+  const prefixes = members.map((c) => {
+    const i = c.name.indexOf(SEPARATEUR);
+    return i > 0 ? c.name.slice(0, i).trim() : null;
+  });
+  const premier = prefixes[0];
+  if (premier && prefixes.every((p) => p === premier)) return premier;
+  const majoritaire = prefixes.find((p): p is string => Boolean(p));
+  return majoritaire ?? slug;
+}
+
+/**
+ * Entrées du sélecteur, dans l'ordre reçu : un groupe prend la place de son premier membre.
+ * Un groupe n'existe qu'à partir de deux entreprises du même client.
+ */
+export function grouperEntreprises<C extends CompanyLike>(companies: readonly C[]): CompanyGroupEntry<C>[] {
+  const parClient = new Map<string, Array<{ company: C; service: string | null }>>();
+  for (const company of companies) {
+    const marqueur = lireMarqueurClient(company.description);
+    if (!marqueur) continue;
+    const liste = parClient.get(marqueur.client) ?? [];
+    liste.push({ company, service: marqueur.service });
+    parClient.set(marqueur.client, liste);
+  }
+
+  const entries: CompanyGroupEntry<C>[] = [];
+  const vus = new Set<string>();
+  for (const company of companies) {
+    const marqueur = lireMarqueurClient(company.description);
+    const membres = marqueur ? parClient.get(marqueur.client) ?? [] : [];
+    if (!marqueur || membres.length < 2) {
+      entries.push({ key: company.id, label: company.name, primary: company, members: [company], grouped: false });
+      continue;
+    }
+    if (vus.has(marqueur.client)) continue;
+    vus.add(marqueur.client);
+    const primaire =
+      membres.find((m) => m.service === "marketing" || m.service === null)
+      ?? membres.find((m) => m.service === "direction")
+      ?? membres[0]!;
+    const liste = membres.map((m) => m.company);
+    entries.push({
+      key: primaire.company.id,
+      label: nomClient(liste, marqueur.client),
+      primary: primaire.company,
+      members: liste,
+      grouped: true,
+    });
+  }
+  return entries;
+}
+
+/** Entrée qui contient cette entreprise. */
+export function entreeDe<C extends CompanyLike>(entries: readonly CompanyGroupEntry<C>[], companyId: string | null | undefined) {
+  if (!companyId) return null;
+  return entries.find((e) => e.members.some((m) => m.id === companyId)) ?? null;
+}
+
+/** Ordre complet (identifiants d'entreprises) à persister après avoir réordonné des entrées. */
+export function deplierOrdre(entries: readonly CompanyGroupEntry<CompanyLike>[]): string[] {
+  return entries.flatMap((e) => e.members.map((m) => m.id));
+}

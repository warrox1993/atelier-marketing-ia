 server/src/embedded-postgres-owner.test.ts | 13 ++++++++++++-
 server/src/embedded-postgres-owner.ts      | 17 +++++++++++++++++
 server/src/index.ts                        |  4 ++--
 3 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/server/src/embedded-postgres-owner.test.ts b/server/src/embedded-postgres-owner.test.ts
index 3c4858f30..530396c2c 100644
--- a/server/src/embedded-postgres-owner.test.ts
+++ b/server/src/embedded-postgres-owner.test.ts
@@ -1,8 +1,19 @@
 import { expect, it } from "vitest";
-import { embeddedPostgresOwnerPort } from "./embedded-postgres-owner.js";
+import { embeddedPostgresOwnerPort, pidOwnsDataDir } from "./embedded-postgres-owner.js";
 it("uses the running cluster's selected port after a collision", () => {
   expect(embeddedPostgresOwnerPort("123\n/data/qa\n123456\n54330\n", "/data/qa", 123)).toBe(54330);
 });
 it.each(["124\n/data/qa\n123456\n54330\n", "123\n/data/other\n123456\n54330\n", "123\n/data/qa\n123456\n0\n", "123\n/data/qa\n"])("rejects inconsistent ownership %j", contents => {
   expect(() => embeddedPostgresOwnerPort(contents, "/data/qa", 123)).toThrow("does not match");
 });
+it("does not trust a postmaster.pid whose PID was reused by an unrelated process after a reboot", () => {
+  const cmdlines: Record<number, string> = {
+    9752: "/usr/libexec/gnome-session-init-worker\0ubuntu\0",
+    4242: "/opt/pg/bin/postgres\0-D\0/data/qa\0-p\x0054329\0",
+  };
+  const read = (pid: number) => cmdlines[pid] ?? (() => { throw new Error("ENOENT"); })();
+  expect(pidOwnsDataDir(9752, "/data/qa", read)).toBe(false);
+  expect(pidOwnsDataDir(4242, "/data/qa", read)).toBe(true);
+  expect(pidOwnsDataDir(4242, "/data/other", read)).toBe(false);
+  expect(pidOwnsDataDir(1, "/data/qa", read)).toBe(true);
+});
diff --git a/server/src/embedded-postgres-owner.ts b/server/src/embedded-postgres-owner.ts
index 8f9a75078..b96e4cf19 100644
--- a/server/src/embedded-postgres-owner.ts
+++ b/server/src/embedded-postgres-owner.ts
@@ -1,3 +1,4 @@
+import { readFileSync } from "node:fs";
 import { resolve } from "node:path";
 
 /** postmaster.pid records the actual listening port, which can differ from the
@@ -10,3 +11,19 @@ export function embeddedPostgresOwnerPort(contents: string, dataDir: string, exp
     throw new Error("The running embedded PostgreSQL identity does not match this instance. Startup stopped before connecting.");
   return port;
 }
+
+/** After a reboot, a stale postmaster.pid can name a PID reused by an unrelated process.
+ * Trust it only if that process's command line names this data directory. */
+export function pidOwnsDataDir(
+  pid: number,
+  dataDir: string,
+  readCmdline = (p: number) => readFileSync(`/proc/${p}/cmdline`, "utf8"),
+): boolean {
+  let cmdline: string;
+  try {
+    cmdline = readCmdline(pid);
+  } catch {
+    return true; // shortcut: no /proc (macOS), keep the liveness check alone; upgrade with `ps -o args=` if needed
+  }
+  return cmdline.split("\0").some((arg) => arg !== "" && resolve(arg) === resolve(dataDir));
+}

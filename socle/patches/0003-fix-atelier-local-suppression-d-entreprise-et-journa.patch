+/**
+ * Atelier Marketing IA (patch local, non amont) : journal lisible des
+ * compétences transmises à un run et contrôle des compétences OBLIGATOIRES.
+ *
+ * Cahier §5 : « Pour toute compétence obligatoire, implémente un chargement
+ * explicite vérifiable […] Journalise l'identifiant et la version effectivement
+ * transmis. » Le journal natif ne garde que la clé du paquet de compétences ;
+ * ce module consigne, pour chaque compétence désirée : clé, nom d'exécution,
+ * version demandée et courante, statut de la source et SHA-256 du SKILL.md
+ * matérialisé. Les compétences obligatoires d'un agent sont déclarées dans
+ * `agents.metadata.atelier.competencesObligatoires` (organisation du lot B) ;
+ * si l'une manque ou n'est pas disponible, le run échoue AVANT l'appel de
+ * l'adaptateur (configuration incomplète), au lieu de s'exécuter sans elle.
+ */
+import { createHash } from "node:crypto";
+import { readFile, stat } from "node:fs/promises";
+import path from "node:path";
+
+export interface EntreeCompetenceRun {
+  key: string;
+  runtimeName: string;
+  source: string;
+  versionId?: string | null;
+  currentVersionId?: string | null;
+  sourceStatus?: "available" | "missing";
+}
+
+export interface CompetenceTransmise {
+  cle: string;
+  nomExecution: string | null;
+  versionDemandee: string | null;
+  versionCourante: string | null;
+  statutSource: string;
+  sha256: string | null;
+}
+
+export interface InventaireCompetences {
+  transmises: CompetenceTransmise[];
+  obligatoires: string[];
+  manquantes: string[];
+}
+
+/** Clés obligatoires déclarées dans les métadonnées de l'agent. Fonction pure. */
+export function competencesObligatoires(metadata: unknown): string[] {
+  const atelier = (metadata as { atelier?: { competencesObligatoires?: unknown } } | null | undefined)?.atelier;
+  const liste = atelier?.competencesObligatoires;
+  return Array.isArray(liste) ? [...new Set(liste.filter((x): x is string => typeof x === "string" && x.trim().length > 0))] : [];
+}
+
+/** SHA-256 du SKILL.md matérialisé (dossier ou fichier), ou null s'il est illisible. */
+export async function empreinteCompetence(source: string): Promise<string | null> {
+  if (!source) return null;
+  try {
+    const infos = await stat(source);
+    const fichier = infos.isDirectory() ? path.join(source, "SKILL.md") : source;
+    const contenu = await readFile(fichier);
+    return createHash("sha256").update(contenu).digest("hex");
+  } catch {
+    return null;
+  }
+}
+
+/** Une clé désirée correspond-elle à une entrée (clé exacte ou nom d'exécution) ? */
+function correspond(entree: EntreeCompetenceRun, cle: string): boolean {
+  return entree.key === cle || entree.runtimeName === cle || entree.key.endsWith(`/${cle}`);
+}
+
+export async function inventaireCompetencesRun(input: {
+  entrees: EntreeCompetenceRun[];
+  desirees: ReadonlyArray<{ key: string; versionId?: string | null }>;
+  metadata: unknown;
+}): Promise<InventaireCompetences> {
+  const obligatoires = competencesObligatoires(input.metadata);
+  const cles = [...new Set([...input.desirees.map((d) => d.key), ...obligatoires])];
+  const transmises: CompetenceTransmise[] = [];
+  for (const cle of cles) {
+    const entree = input.entrees.find((e) => correspond(e, cle));
+    const demandee = input.desirees.find((d) => d.key === cle)?.versionId ?? null;
+    transmises.push({
+      cle,
+      nomExecution: entree?.runtimeName ?? null,
+      versionDemandee: demandee ?? entree?.versionId ?? null,
+      versionCourante: entree?.currentVersionId ?? null,
+      statutSource: entree ? (entree.sourceStatus ?? "available") : "absente",
+      sha256: entree && entree.sourceStatus !== "missing" ? await empreinteCompetence(entree.source) : null,
+    });
+  }
+  const manquantes = obligatoires.filter((cle) => {
+    const t = transmises.find((x) => x.cle === cle);
+    const desiree = input.desirees.some((d) => d.key === cle);
+    return !t || !desiree || t.statutSource !== "available" || !t.sha256;
+  });
+  return { transmises, obligatoires, manquantes };
+}

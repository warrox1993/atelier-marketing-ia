+/**
+ * Atelier Marketing IA (patch local) : inventaire des compétences d'un run et
+ * contrôle des compétences obligatoires.
+ */
+import { createHash } from "node:crypto";
+import { mkdtemp, mkdir, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { competencesObligatoires, inventaireCompetencesRun } from "../atelier/competences-run.js";
+
+describe("atelier : compétences transmises à un run", () => {
+  let dossier = "";
+  beforeAll(async () => {
+    dossier = await mkdtemp(path.join(os.tmpdir(), "atelier-competences-"));
+    await mkdir(path.join(dossier, "cadrage"), { recursive: true });
+    await writeFile(path.join(dossier, "cadrage", "SKILL.md"), "# Cadrage\n");
+  });
+  afterAll(async () => {
+    await rm(dossier, { recursive: true, force: true });
+  });
+
+  it("lit les compétences obligatoires des métadonnées de l'agent", () => {
+    expect(competencesObligatoires({ atelier: { competencesObligatoires: ["a", "a", "b", 3, ""] } })).toEqual(["a", "b"]);
+    expect(competencesObligatoires(null)).toEqual([]);
+  });
+
+  it("journalise clé, versions et SHA-256 du SKILL.md matérialisé", async () => {
+    const inv = await inventaireCompetencesRun({
+      entrees: [{ key: "atelier/cadrage", runtimeName: "cadrage", source: path.join(dossier, "cadrage"), versionId: "v1", currentVersionId: "v2", sourceStatus: "available" }],
+      desirees: [{ key: "atelier/cadrage", versionId: null }],
+      metadata: { atelier: { competencesObligatoires: ["atelier/cadrage"] } },
+    });
+    expect(inv.manquantes).toEqual([]);
+    expect(inv.transmises[0]).toMatchObject({ cle: "atelier/cadrage", nomExecution: "cadrage", versionCourante: "v2", statutSource: "available" });
+    expect(inv.transmises[0]?.sha256).toBe(createHash("sha256").update("# Cadrage\n").digest("hex"));
+  });
+
+  it("signale une compétence obligatoire non désirée, absente ou indisponible", async () => {
+    const base = { key: "atelier/cadrage", runtimeName: "cadrage", source: path.join(dossier, "cadrage"), sourceStatus: "available" as const };
+    const nonDesiree = await inventaireCompetencesRun({ entrees: [base], desirees: [], metadata: { atelier: { competencesObligatoires: ["atelier/cadrage"] } } });
+    expect(nonDesiree.manquantes).toEqual(["atelier/cadrage"]);
+    const absente = await inventaireCompetencesRun({ entrees: [], desirees: [{ key: "atelier/revue", versionId: null }], metadata: { atelier: { competencesObligatoires: ["atelier/revue"] } } });
+    expect(absente.manquantes).toEqual(["atelier/revue"]);
+    const indisponible = await inventaireCompetencesRun({ entrees: [{ ...base, sourceStatus: "missing" }], desirees: [{ key: "atelier/cadrage", versionId: null }], metadata: { atelier: { competencesObligatoires: ["atelier/cadrage"] } } });
+    expect(indisponible.manquantes).toEqual(["atelier/cadrage"]);
+  });
+});

+/**
+ * Atelier Marketing IA (patch local) : suppression d'une entreprise dont un
+ * projet est lié à un objectif (constat du lot B : 500 avant correction).
+ */
+import { randomUUID } from "node:crypto";
+import { eq } from "drizzle-orm";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { companies, createDb, goals, projects } from "@paperclipai/db";
+import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
+import { companyService } from "../services/companies.js";
+
+const support = await getEmbeddedPostgresTestSupport();
+const decrire = support.supported ? describe : describe.skip;
+
+decrire("atelier : suppression d'entreprise avec projet lié à un objectif", () => {
+  let db!: ReturnType<typeof createDb>;
+  let base: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>> | null = null;
+
+  beforeAll(async () => {
+    base = await startEmbeddedPostgresTestDatabase("paperclip-atelier-suppression-");
+    db = createDb(base.connectionString);
+  }, 30_000);
+
+  afterAll(async () => {
+    await base?.cleanup();
+  });
+
+  it("supprime l'entreprise, ses projets et ses objectifs sans violer la clé étrangère", async () => {
+    const companyId = randomUUID();
+    await db.insert(companies).values({ id: companyId, name: "Suppression", issuePrefix: `S${companyId.slice(0, 6).toUpperCase().replace(/-/g, "")}`, requireBoardApprovalForNewAgents: false });
+    const goalId = randomUUID();
+    await db.insert(goals).values({ id: goalId, companyId, title: "Objectif" });
+    await db.insert(projects).values({ id: randomUUID(), companyId, name: "Projet lié", goalId });
+    const supprimee = await companyService(db).remove(companyId);
+    expect(supprimee?.id).toBe(companyId);
+    expect(await db.select().from(goals).where(eq(goals.companyId, companyId))).toEqual([]);
+    expect(await db.select().from(projects).where(eq(projects.companyId, companyId))).toEqual([]);
+  });
+});

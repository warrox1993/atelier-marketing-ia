 /** Tableau des départements d'un client à plusieurs services (vue « departements » du plugin). */
 export const CHEMIN_DEPARTEMENTS_ATELIER = `${CHEMIN_PAGE_ATELIER}/departements`;
 
-/** Vrai si un plugin prêt déclare la page principale de l'atelier. */
+/** Page « Agents » du plugin : tous les agents de tous les départements (remplace la liste native d'un seul département). */
+export const CHEMIN_AGENTS_ATELIER = `${CHEMIN_PAGE_ATELIER}/agents`;
+
 /**
  * Vues de l'atelier SANS colonne de navigation d'un service (patch local de l'Atelier) : vues de groupe
  * (départements, organigramme), chat du Coordinateur général (adresse nue, `discussion`, ancienne `accueil`)
@@ -25,6 +28,7 @@ export function estVueGroupeAtelier(pathname: string): boolean {
   return new RegExp(`/${CHEMIN_PAGE_ATELIER}(/?$|/(${VUES_SANS_COLONNE.join("|")})(/|$))`, "u").test(pathname);
 }
 
+/** Vrai si un plugin prêt déclare la page principale de l'atelier. */
 export function atelierDisponible(contributions: PluginUiContribution[] | undefined): boolean {
   return (contributions ?? []).some((contribution) =>
     contribution.slots.some((slot) => slot.type === "page" && slot.routePath === CHEMIN_PAGE_ATELIER),
@@ -45,3 +49,26 @@ export function CompanyHomeRedirect() {
   if (isLoading) return <PaperclipLoading />;
   return <Navigate to={atelierDisponible(data) ? CHEMIN_PAGE_ATELIER : "dashboard"} replace />;
 }
+
+/**
+ * Destination de la liste des agents : la page du plugin quand l'atelier est prêt, sinon la liste native.
+ * Même requête que l'accueil d'entreprise (cache partagé).
+ */
+export function useCheminListeAgents(cheminNatif: string): string {
+  const { data } = useQuery({
+    queryKey: queryKeys.plugins.uiContributions,
+    queryFn: () => pluginsApi.listUiContributions(),
+  });
+  return atelierDisponible(data) ? `/${CHEMIN_AGENTS_ATELIER}` : cheminNatif;
+}
+
+/** Liste native des agents : redirige vers la page du plugin quand l'atelier est prêt, sinon affiche `natif`. */
+export function ListeAgentsOuAtelier({ natif }: { natif: ReactNode }) {
+  const { data, isLoading } = useQuery({
+    queryKey: queryKeys.plugins.uiContributions,
+    queryFn: () => pluginsApi.listUiContributions(),
+  });
+
+  if (isLoading) return <PaperclipLoading />;
+  return atelierDisponible(data) ? <Navigate to={`/${CHEMIN_AGENTS_ATELIER}`} replace /> : <>{natif}</>;
+}

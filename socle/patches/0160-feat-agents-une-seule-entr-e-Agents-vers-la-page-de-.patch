+    mockPluginsApi.listUiContributions.mockRejectedValue(new Error("hors service"));
+    const { container } = await rendre(<ListeAgentsOuAtelier natif={natif} />);
+    await vi.waitFor(() => expect(container.textContent).toBe("Liste native"));
+  });
+});

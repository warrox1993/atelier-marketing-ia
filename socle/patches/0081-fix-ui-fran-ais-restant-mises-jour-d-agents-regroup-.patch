+
+describe("sousTitreAgent", () => {
+  it("affiche le titre seul pour le rôle générique", () => {
+    expect(sousTitreAgent("general", "Direction · Revue contradictoire")).toBe("Direction · Revue contradictoire");
+  });
+
+  it("garde le libellé du rôle quand il n'y a pas de titre", () => {
+    expect(sousTitreAgent("general", null)).toBe("Généraliste");
+    expect(sousTitreAgent("qa", "  ")).toBe("Contrôle qualité");
+  });
+
+  it("sépare le rôle précis et le titre par un point médian, jamais par un tiret", () => {
+    expect(sousTitreAgent("engineer", "Front")).toBe("Développement · Front");
+  });
+
+  it("laisse un rôle inconnu tel quel", () => {
+    expect(sousTitreAgent("autre", "X")).toBe("autre · X");
+  });
+});
diff --git a/ui/src/lib/agent-role-labels.ts b/ui/src/lib/agent-role-labels.ts
index a46eaeb27..5f952cb67 100644
--- a/ui/src/lib/agent-role-labels.ts
+++ b/ui/src/lib/agent-role-labels.ts
@@ -19,3 +19,16 @@ export const LIBELLES_ROLES_AGENT: Record<AgentRole, string> = {
   researcher: "Recherche",
   general: "Généraliste",
 };
+
+/**
+ * Sous-titre d'un agent dans les listes : « rôle · titre ». Le rôle générique
+ * « Généraliste » n'apprend rien : on affiche alors le titre seul. Un seul séparateur
+ * (le point médian) est utilisé, comme dans les titres d'agents eux-mêmes.
+ */
+export function sousTitreAgent(role: string, titre: string | null | undefined): string {
+  const libelleRole = (LIBELLES_ROLES_AGENT as Record<string, string>)[role] ?? role;
+  const titreNet = titre?.trim() ?? "";
+  if (!titreNet) return libelleRole;
+  if (role === "general") return titreNet;
+  return `${libelleRole} · ${titreNet}`;
+}

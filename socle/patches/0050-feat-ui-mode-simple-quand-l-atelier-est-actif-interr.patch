+        <InterrupteurModeExpert
+          expert={modeExpert}
+          onChange={definirModeExpert}
+          rail={rail}
+        />
+      ) : null}
     </aside>
   );
 }
+
+/**
+ * Interrupteur « Mode expert » en bas de la barre latérale : discret, libellé
+ * clair, cible tactile d'au moins 44 px, état annoncé aux lecteurs d'écran.
+ */
+function InterrupteurModeExpert({
+  expert,
+  onChange,
+  rail,
+}: {
+  expert: boolean;
+  onChange: (expert: boolean) => void;
+  rail: boolean;
+}) {
+  const aide = expert
+    ? "Mode expert actif : toutes les entrées du menu sont affichées. Désactiver pour revenir au menu simple."
+    : "Mode simple : seul l'atelier est affiché. Activer pour afficher tout le menu.";
+  const bouton = (
+    <button
+      type="button"
+      role="switch"
+      aria-checked={expert}
+      aria-label="Mode expert"
+      title={aide}
+      onClick={() => onChange(!expert)}
+      className="flex w-full min-h-9 pointer-coarse:min-h-11 items-center gap-2.5 rounded-lg px-2 py-1.5 text-(length:--text-compact) font-medium text-muted-foreground transition-colors hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
+    >
+      <SlidersHorizontal className="h-4 w-4 shrink-0" aria-hidden="true" />
+      <span className={cn("flex-1 text-left", rail ? SIDEBAR_RAIL_HIDDEN_LABEL : "truncate")}>Mode expert</span>
+      {rail ? null : (
+        <span
+          aria-hidden="true"
+          data-slot="mode-expert-piste"
+          className={cn(
+            "relative h-5 w-9 shrink-0 rounded-full border border-border transition-colors",
+            expert ? "bg-foreground/80" : "bg-muted",
+          )}
+        >
+          <span
+            className={cn(
+              "absolute top-0.5 h-3.5 w-3.5 rounded-full bg-background shadow-sm transition-[left] motion-reduce:transition-none",
+              expert ? "left-[1.125rem]" : "left-0.5",
+            )}
+          />
+        </span>
+      )}
+    </button>
+  );
+  return (
+    <div className="shrink-0 border-t border-border/60 px-2 py-1.5" data-slot="mode-expert">
+      {rail ? (
+        <Tooltip>
+          <TooltipTrigger asChild>{bouton}</TooltipTrigger>
+          <TooltipContent side="right">{aide}</TooltipContent>
+        </Tooltip>
+      ) : (
+        bouton
+      )}
+    </div>
+  );
+}

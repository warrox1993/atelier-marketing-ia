+  describe("mode simple de l'atelier", () => {
+    const libellesNav = () =>
+      [...container.querySelectorAll("nav a")].map((a) => a.textContent?.trim());
+    const interrupteur = () =>
+      container.querySelector('button[role="switch"][aria-label="Mode expert"]') as HTMLButtonElement | null;
+    const masques = ["Tableau de bord", "Boîte de réception", "Tâches", "Projets", "Agents", "Routines", "Compétences", "Connecteurs", "Journal d'audit", "Rechercher"];
+
+    it("masque les entrées du socle et garde le plugin et Nouvelle tâche", async () => {
+      mockPluginsApi.listUiContributions.mockResolvedValue([contributionAtelier]);
+      mockInstanceSettingsApi.getExperimental.mockResolvedValue({ enableStreamlinedUi: true });
+      const root = await renderSidebar();
+
+      const visibles = libellesNav();
+      for (const libelle of masques) expect(visibles).not.toContain(libelle);
+      expect(container.querySelector('[data-plugin-slot-types="sidebar"]')).not.toBeNull();
+      expect(boutonNouvelleTache()).toBeTruthy();
+      expect(interrupteur()?.getAttribute("aria-checked")).toBe("false");
+      flushSync(() => root.unmount());
+    });
+
+    it("l'interrupteur révèle tout le menu et la préférence persiste", async () => {
+      mockPluginsApi.listUiContributions.mockResolvedValue([contributionAtelier]);
+      mockInstanceSettingsApi.getExperimental.mockResolvedValue({ enableStreamlinedUi: true });
+      const root = await renderSidebar();
+
+      flushSync(() => interrupteur()!.click());
+      const visibles = libellesNav();
+      for (const libelle of masques) expect(visibles).toContain(libelle);
+      expect(interrupteur()?.getAttribute("aria-checked")).toBe("true");
+      expect(window.localStorage.getItem("atelier.mode-expert.company-1")).toBe("1");
+      flushSync(() => root.unmount());
+
+      // Nouveau montage : la préférence est relue.
+      const root2 = await renderSidebar();
+      expect(libellesNav()).toContain("Tâches");
+      // Retour au mode simple.
+      flushSync(() => interrupteur()!.click());
+      expect(libellesNav()).not.toContain("Tâches");
+      expect(window.localStorage.getItem("atelier.mode-expert.company-1")).toBe("0");
+      flushSync(() => root2.unmount());
+    });
+
+    it("sans l'atelier : menu d'origine inchangé, aucun interrupteur", async () => {
+      mockInstanceSettingsApi.getExperimental.mockResolvedValue({ enableStreamlinedUi: true });
+      const root = await renderSidebar();
+
+      const visibles = libellesNav();
+      for (const libelle of masques) expect(visibles).toContain(libelle);
+      expect(interrupteur()).toBeNull();
+      flushSync(() => root.unmount());
+    });
+
+    it("fonctionne même si le stockage local est inaccessible", async () => {
+      mockPluginsApi.listUiContributions.mockResolvedValue([contributionAtelier]);
+      mockInstanceSettingsApi.getExperimental.mockResolvedValue({ enableStreamlinedUi: true });
+      const lecture = vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => { throw new Error("bloqué"); });
+      const ecriture = vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => { throw new Error("bloqué"); });
+      const root = await renderSidebar();
+
+      expect(libellesNav()).not.toContain("Tâches");
+      flushSync(() => interrupteur()!.click());
+      expect(libellesNav()).toContain("Tâches");
+      flushSync(() => root.unmount());
+      lecture.mockRestore();
+      ecriture.mockRestore();
+    });
+  });
+

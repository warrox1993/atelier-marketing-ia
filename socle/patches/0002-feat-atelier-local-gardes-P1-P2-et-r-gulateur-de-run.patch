new file mode 100644
index 000000000..4e330670c
--- /dev/null
+++ b/server/src/atelier/regulateur-runs.ts
@@ -0,0 +1,131 @@
+/**
+ * Atelier Marketing IA (patch local, non amont) : régulateur des runs
+ * actifs par entreprise (cahier §4 : « plafond configurable de trois agents
+ * actifs au départ »). Paperclip ne plafonne que par agent
+ * (`maxConcurrentRuns`) ; ce module ajoute un plafond par entreprise.
+ *
+ * Plafond retenu, dans l'ordre :
+ *  1. `reglages_entreprise.max_runs_actifs` du plugin pour cette entreprise ;
+ *  2. sinon la variable `ATELIER_MAX_RUNS_ACTIFS_PAR_ENTREPRISE` de l'instance ;
+ *  3. sinon aucun plafond (comportement natif).
+ *
+ * Admission : sous un verrou court par entreprise (requêtes de comptage
+ * seulement), on compte les runs `running` en base PLUS les réservations en
+ * cours dans ce processus ; s'il reste une place, on la réserve, on relâche
+ * le verrou, puis on réclame le run. La réservation est rendue après la
+ * réclamation (le run est alors compté en base). Le verrou n'englobe jamais
+ * la réclamation : celle-ci peut annuler un run et relancer des files, ce
+ * qui provoquerait sinon un interblocage. Un run non admis reste `queued` ;
+ * il est relancé à la fin d'un run de l'entreprise ou par le passage
+ * périodique natif (`resumeQueuedRuns`).
+ */
+import { sql } from "drizzle-orm";
+import { lignes, schemaAtelier, tableAtelier, type ExecuteurSql } from "./espace-atelier.js";
+
+export const VARIABLE_PLAFOND = "ATELIER_MAX_RUNS_ACTIFS_PAR_ENTREPRISE";
+const PLAFOND_MIN = 1;
+const PLAFOND_MAX = 20;
+
+export function lirePlafondEnvironnement(env: NodeJS.ProcessEnv = process.env): number | null {
+  const brut = env[VARIABLE_PLAFOND]?.trim();
+  if (!brut) return null;
+  const n = Number(brut);
+  if (!Number.isInteger(n) || n < PLAFOND_MIN || n > PLAFOND_MAX) return null;
+  return n;
+}
+
+/** Nombre de places restantes ; null = pas de plafond. Fonction pure. */
+export function placesRestantes(plafond: number | null, runsActifs: number): number | null {
+  if (plafond === null) return null;
+  return Math.max(0, plafond - runsActifs);
+}
+
+/**
+ * Verrous par entreprise PARTAGÉS par tout le processus : plusieurs instances
+ * de `heartbeatService` peuvent coexister ; elles doivent toutes se sérialiser.
+ */
+const verrous = new Map<string, Promise<unknown>>();
+/** Places réservées (réclamation en cours) par entreprise, dans ce processus. */
+const reservations = new Map<string, number>();
+
+export function creerRegulateurRuns(executeur: ExecuteurSql, env: NodeJS.ProcessEnv = process.env) {
+
+  async function sousVerrou<T>(companyId: string, fn: () => Promise<T>): Promise<T> {
+    const precedent = verrous.get(companyId) ?? Promise.resolve();
+    let liberer!: () => void;
+    const courant = new Promise<void>((resolve) => {
+      liberer = resolve;
+    });
+    const chaine = precedent.then(() => courant);
+    verrous.set(companyId, chaine);
+    await precedent.catch(() => undefined);
+    try {
+      return await fn();
+    } finally {
+      liberer();
+      if (verrous.get(companyId) === chaine) verrous.delete(companyId);
+    }
+  }
+
+  async function plafondEntreprise(companyId: string): Promise<number | null> {
+    const schema = await schemaAtelier(executeur);
+    if (schema) {
+      const reglages = tableAtelier(schema, "reglages_entreprise");
+      const rangs = lignes<{ max_runs_actifs: number }>(
+        await executeur.execute(sql`select max_runs_actifs from ${reglages} where company_id = ${companyId} limit 1`),
+      );
+      const valeur = rangs[0]?.max_runs_actifs;
+      if (typeof valeur === "number" && valeur >= PLAFOND_MIN && valeur <= PLAFOND_MAX) return valeur;
+    }
+    return lirePlafondEnvironnement(env);
+  }
+
+  async function compterRunsActifs(companyId: string): Promise<number> {
+    const rangs = lignes<{ n: number | string }>(
+      await executeur.execute(sql`select count(*) as n from heartbeat_runs where company_id = ${companyId} and status = 'running'`),
+    );
+    return Number(rangs[0]?.n ?? 0);
+  }
+
+  /**
+   * Exécute `reclamer` seulement s'il reste une place dans l'entreprise.
+   * Retourne `{ admis: false }` sans appeler `reclamer` sinon.
+   */
+  async function admettre<T>(
+    companyId: string,
+    reclamer: () => Promise<T>,
+  ): Promise<{ admis: true; resultat: T } | { admis: false; plafond: number; actifs: number }> {
+    const decision = await sousVerrou(companyId, async () => {
+      const plafond = await plafondEntreprise(companyId);
+      if (plafond === null) return { reserve: false as const, refuse: false as const };
+      const actifs = (await compterRunsActifs(companyId)) + (reservations.get(companyId) ?? 0);
+      if (placesRestantes(plafond, actifs) === 0) return { reserve: false as const, refuse: true as const, plafond, actifs };
+      reservations.set(companyId, (reservations.get(companyId) ?? 0) + 1);
+      return { reserve: true as const, refuse: false as const };
+    });
+    if (decision.refuse) return { admis: false, plafond: decision.plafond, actifs: decision.actifs };
+    try {
+      return { admis: true, resultat: await reclamer() };
+    } finally {
+      if (decision.reserve) {
+        const restant = (reservations.get(companyId) ?? 1) - 1;
+        if (restant <= 0) reservations.delete(companyId);
+        else reservations.set(companyId, restant);
+      }
+    }
+  }
+
+  /** Agents de l'entreprise (autres que `exclure`) qui ont des runs en file. */
+  async function agentsEnFile(companyId: string, exclure: string | null): Promise<string[]> {
+    const rangs = lignes<{ agent_id: string }>(
+      await executeur.execute(
+        sql`select distinct agent_id from heartbeat_runs where company_id = ${companyId} and status = 'queued'`,
+      ),
+    );
+    return rangs.map((r) => r.agent_id).filter((id) => id && id !== exclure);
+  }
+
+  return { admettre, plafondEntreprise, compterRunsActifs, agentsEnFile };
+}
+
+export type RegulateurRuns = ReturnType<typeof creerRegulateurRuns>;

+/**
+ * Atelier Marketing IA (patch local, non amont) : accès en lecture à
+ * l'espace de base du plugin `atelier.marketing-ia` depuis le serveur.
+ *
+ * Le plugin écrit ses tables dans un schéma dérivé par l'hôte ; le serveur
+ * patché les LIT seulement (porte P2, régulateur). Le nom du schéma est lu
+ * dans `plugin_database_namespaces` puis validé avant toute interpolation.
+ */
+import { sql, type SQL } from "drizzle-orm";
+
+export const CLE_PLUGIN_ATELIER = "atelier.marketing-ia";
+const IDENTIFIANT_SUR = /^[a-z_][a-z0-9_]{0,62}$/;
+
+/** Client minimal accepté : base racine ou transaction Drizzle. */
+export interface ExecuteurSql {
+  execute(query: SQL): Promise<unknown>;
+}
+
+export function lignes<T>(resultat: unknown): T[] {
+  if (Array.isArray(resultat)) return resultat as T[];
+  if (resultat && typeof resultat === "object" && Array.isArray((resultat as { rows?: unknown }).rows)) {
+    return (resultat as { rows: T[] }).rows;
+  }
+  return Array.from((resultat ?? []) as Iterable<T>);
+}
+
+/**
+ * Nom du schéma actif du plugin, ou null si le plugin n'a jamais été
+ * installé (aucune garde ne s'applique alors : comportement natif).
+ */
+export async function schemaAtelier(executeur: ExecuteurSql): Promise<string | null> {
+  const rangs = lignes<{ namespace_name: string }>(
+    await executeur.execute(
+      sql`select namespace_name from plugin_database_namespaces where plugin_key = ${CLE_PLUGIN_ATELIER} and status = 'active' limit 1`,
+    ),
+  );
+  const nom = rangs[0]?.namespace_name;
+  if (!nom) return null;
+  if (!IDENTIFIANT_SUR.test(nom)) {
+    throw new Error(`Nom de schéma de l'atelier refusé : ${nom}`);
+  }
+  return nom;
+}
+
+/** Référence SQL sûre à une table du schéma de l'atelier. */
+export function tableAtelier(schema: string, table: string): SQL {
+  if (!IDENTIFIANT_SUR.test(schema) || !IDENTIFIANT_SUR.test(table)) {
+    throw new Error("Identifiant SQL de l'atelier refusé");
+  }
+  return sql.raw(`"${schema}"."${table}"`);
+}
diff --git a/server/src/atelier/gardes-atelier.ts b/server/src/atelier/gardes-atelier.ts
new file mode 100644
index 000000000..ef3e9edfe
--- /dev/null
+++ b/server/src/atelier/gardes-atelier.ts
@@ -0,0 +1,228 @@
+/**
+ * Atelier Marketing IA (patch local, non amont) : gardes serveur que le
+ * plugin ne peut pas assurer seul, appelées sous le verrou de ligne de
+ * `issueService.update()`.
+ *
+ * P1 — politique de relecture verrouillée : un acteur AGENT ne peut ni
+ *      retirer, ni vider, ni modifier la partie « relecture » (étapes,
+ *      participants, mode, préréglage, autorisation, limite de tours) d'une
+ *      `executionPolicy` qui comporte au moins une étape. Les humains (board)
+ *      gardent ce droit. Corrige le contournement prouvé en phase 1
+ *      (`PATCH executionPolicy: null` puis `done`).
+ *
+ * P2 — porte déterministe : une tâche placée sous la porte de l'atelier ne
+ *      peut entrer dans une étape d'approbation humaine ni passer à `done`
+ *      (quel que soit l'acteur, board compris) que si la DERNIÈRE évaluation
+ *      calculée par le plugin est `PASS`, non périmée, porte sur la révision
+ *      courante du livrable et a été calculée après la dernière modification
+ *      de ses entrées (couverture, verdicts, constats, exigences, porte).
+ *      Une sortie de modèle disant « PASS » ne suffit donc jamais.
+ *      Levée possible seulement par un humain, via le plugin (tracée).
+ */
+import { sql } from "drizzle-orm";
+import type { IssueExecutionPolicy } from "@paperclipai/shared";
+import { forbidden, unprocessable } from "../errors.js";
+import { normalizeIssueExecutionPolicy } from "../services/issue-execution-policy.js";
+import { lignes, schemaAtelier, tableAtelier, type ExecuteurSql } from "./espace-atelier.js";
+
+/* ------------------------------------------------------------------ */
+/* P1                                                                  */
+/* ------------------------------------------------------------------ */
+
+/** Signature de la partie « relecture » d'une politique (sans identifiants régénérés ni moniteur). */
+export function signaturePolitiqueRelecture(politique: IssueExecutionPolicy | null): string | null {
+  if (!politique || !Array.isArray(politique.stages) || politique.stages.length === 0) return null;
+  return JSON.stringify({
+    mode: politique.mode ?? "normal",
+    stages: politique.stages.map((etape) => ({
+      type: etape.type,
+      participants: etape.participants.map((p) => ({ type: p.type, agentId: p.agentId ?? null, userId: p.userId ?? null })),
+    })),
+    reviewPreset: politique.reviewPreset ?? null,
+    authorizationPolicy: politique.authorizationPolicy ?? null,
+    maxReviewRounds: politique.maxReviewRounds ?? null,
+  });
+}
+
+export interface EntreeP1 {
+  actorAgentId: string | null | undefined;
+  politiqueActuelle: unknown;
+  /** undefined = la requête ne touche pas à la politique. */
+  politiqueDemandee: unknown;
+}
+
+/** Lève 403 si un agent retire ou modifie une politique de relecture à étapes. Fonction pure. */
+export function verifierPolitiqueNonAffaiblie(entree: EntreeP1): void {
+  if (!entree.actorAgentId) return;
+  if (entree.politiqueDemandee === undefined) return;
+  const actuelle = signaturePolitiqueRelecture(normalizeIssueExecutionPolicy(entree.politiqueActuelle ?? null));
+  if (actuelle === null) return;
+  const demandee = signaturePolitiqueRelecture(normalizeIssueExecutionPolicy(entree.politiqueDemandee ?? null));
+  if (demandee !== actuelle) {
+    throw forbidden(
+      "Atelier (P1) : un agent ne peut ni retirer ni modifier la politique de relecture de cette tâche ; seul un humain le peut.",
+      { code: "atelier_politique_verrouillee" },
+    );
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* P2                                                                  */
+/* ------------------------------------------------------------------ */
+
+interface EtatExecutionLike {
+  status?: string | null;
+  currentStageType?: string | null;
+}
+
+function estEtapeApprobationEnAttente(etat: unknown): boolean {
+  if (!etat || typeof etat !== "object") return false;
+  const e = etat as EtatExecutionLike;
+  return e.status === "pending" && e.currentStageType === "approval";
+}
+
+/** La transition demandée doit-elle franchir la porte ? Fonction pure. */
+export function transitionSoumiseALaPorte(
+  existant: { status: string; executionState?: unknown },
+  patch: { status?: unknown; executionState?: unknown },
+): "vers_done" | "vers_approbation" | null {
+  if (patch.status === "done" && existant.status !== "done") return "vers_done";
+  if (
+    patch.executionState !== undefined &&
+    estEtapeApprobationEnAttente(patch.executionState) &&
+    !estEtapeApprobationEnAttente(existant.executionState)
+  ) {
+    return "vers_approbation";
+  }
+  return null;
+}
+
+export interface FaitsPorte {
+  porteActive: boolean;
+  evaluation: {
+    decision: string;
+    perimee: boolean;
+    revisionId: string | null;
+    /** Une entrée (couverture, verdict, constat, exigence, porte) a changé après l'évaluation (comparé en SQL, à la microseconde). */
+    entreesPlusRecentes: boolean;
+  } | null;
+  revisionCourante: string | null;
+}
+
+export interface DecisionGarde {
+  autorise: boolean;
+  motifs: string[];
+}
+
+/** Décision du serveur à partir des faits lus en base. Fonction pure, testée. */
+export function deciderPorteServeur(faits: FaitsPorte): DecisionGarde {
+  if (!faits.porteActive) return { autorise: true, motifs: [] };
+  const motifs: string[] = [];
+  const ev = faits.evaluation;
+  if (!ev) {
+    motifs.push("aucune évaluation de porte");
+  } else {
+    if (ev.decision !== "PASS") motifs.push(`dernière évaluation : ${ev.decision}`);
+    if (ev.perimee) motifs.push("évaluation périmée");
+    if (!faits.revisionCourante) motifs.push("aucun livrable");
+    else if (ev.revisionId !== faits.revisionCourante) motifs.push("évaluation portant sur une autre révision que la révision courante");
+    if (ev.entreesPlusRecentes) motifs.push("entrées modifiées après l'évaluation");
+  }
+  return { autorise: motifs.length === 0, motifs };
+}
+
+/** Lit les faits de la porte pour une tâche (null si la tâche n'est pas sous porte). */
+export async function lireFaitsPorte(executeur: ExecuteurSql, issueId: string): Promise<FaitsPorte | null> {
+  const schema = await schemaAtelier(executeur);
+  if (!schema) return null;
+  const portes = tableAtelier(schema, "portes");
+  const porteRangs = lignes<{ actif: boolean; cle_livrable: string; campagne_id: string }>(
+    await executeur.execute(sql`select actif, cle_livrable, campagne_id from ${portes} where issue_id = ${issueId} limit 1`),
+  );
+  const porte = porteRangs[0];
+  if (!porte) return null;
+  if (!porte.actif) return { porteActive: false, evaluation: null, revisionCourante: null };
+
+  const evaluations = tableAtelier(schema, "evaluations_porte");
+  const couvertures = tableAtelier(schema, "couvertures");
+  const verdicts = tableAtelier(schema, "verdicts");
+  const constats = tableAtelier(schema, "constats");
+  const exigences = tableAtelier(schema, "exigences");
+  // Fraîcheur comparée par PostgreSQL (précision microseconde) : une entrée
+  // modifiée après l'évaluation la rend inutilisable.
+  const evRangs = lignes<{ decision: string; perimee: boolean; revision_id: string | null; entrees_plus_recentes: boolean | null }>(
+    await executeur.execute(sql`select ev.decision, ev.perimee, ev.revision_id,
+        coalesce(greatest(
+          (select max(modifie_le) from ${couvertures} where issue_id = ${issueId}),
+          (select max(modifie_le) from ${verdicts} where issue_id = ${issueId}),
+          (select max(modifie_le) from ${constats} where issue_id = ${issueId}),
+          (select max(modifie_le) from ${exigences} where campagne_id = ${porte.campagne_id}),
+          (select modifie_le from ${portes} where issue_id = ${issueId})
+        ) > ev.entrees_jusqu_a, false) as entrees_plus_recentes
+      from ${evaluations} ev where ev.issue_id = ${issueId} order by ev.cree_le desc limit 1`),
+  );
+  const ev = evRangs[0];
+
+  const revRangs = lignes<{ latest_revision_id: string | null }>(
+    await executeur.execute(
+      sql`select d.latest_revision_id from issue_documents idoc join documents d on d.id = idoc.document_id where idoc.issue_id = ${issueId} and idoc.key = ${porte.cle_livrable} limit 1`,
+    ),
+  );
+
+  return {
+    porteActive: true,
+    evaluation: ev
+      ? { decision: ev.decision, perimee: Boolean(ev.perimee), revisionId: ev.revision_id, entreesPlusRecentes: Boolean(ev.entrees_plus_recentes) }
+      : null,
+    revisionCourante: revRangs[0]?.latest_revision_id ?? null,
+  };
+}
+
+export interface ContexteGardes {
+  existant: { id: string; companyId: string; status: string; executionPolicy?: unknown; executionState?: unknown };
+  patch: { status?: unknown; executionState?: unknown; executionPolicy?: unknown };
+  actorAgentId?: string | null;
+  actorUserId?: string | null;
+}
+
+export type SignalerRefus = (refus: { companyId: string; issueId: string; garde: "P1" | "P2"; motifs: string[]; actorAgentId: string | null; actorUserId: string | null }) => void;
+
+/**
+ * Point d'entrée appelé par `issueService.update()` sous verrou de ligne.
+ * `signaler` est appelé SANS attente (journal d'activité écrit hors de la
+ * transaction refusée).
+ */
+export async function appliquerGardesAtelier(executeur: ExecuteurSql, contexte: ContexteGardes, signaler?: SignalerRefus): Promise<void> {
+  const { existant, patch } = contexte;
+  const base = {
+    companyId: existant.companyId,
+    issueId: existant.id,
+    actorAgentId: contexte.actorAgentId ?? null,
+    actorUserId: contexte.actorUserId ?? null,
+  };
+
+  try {
+    verifierPolitiqueNonAffaiblie({
+      actorAgentId: contexte.actorAgentId,
+      politiqueActuelle: existant.executionPolicy ?? null,
+      politiqueDemandee: patch.executionPolicy,
+    });
+  } catch (err) {
+    signaler?.({ ...base, garde: "P1", motifs: ["modification de la politique de relecture par un agent"] });
+    throw err;
+  }
+
+  const transition = transitionSoumiseALaPorte(existant, patch);
+  if (!transition) return;
+  const faits = await lireFaitsPorte(executeur, existant.id);
+  if (!faits) return;
+  const decision = deciderPorteServeur(faits);
+  if (!decision.autorise) {
+    signaler?.({ ...base, garde: "P2", motifs: decision.motifs });
+    throw unprocessable(
+      `Atelier (P2) : la porte déterministe n'est pas franchie (${decision.motifs.join(" ; ")}). ` +
+        "Évaluez la porte sur la révision courante : POST /api/plugins/atelier.marketing-ia/api/taches/:issueId/porte/evaluer.",
+      { code: "atelier_porte_refusee", transition, motifs: decision.motifs },
+    );
+  }
+}

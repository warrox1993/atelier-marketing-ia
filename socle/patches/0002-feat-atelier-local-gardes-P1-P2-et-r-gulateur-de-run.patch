+/**
+ * Atelier Marketing IA (patch local) : gardes P1 et P2 et régulateur de runs,
+ * testés contre une vraie base PostgreSQL embarquée et le vrai
+ * `issueService.update()`.
+ */
+import { randomUUID } from "node:crypto";
+import { sql } from "drizzle-orm";
+import { afterAll, afterEach, beforeAll, describe, expect, it } from "vitest";
+import {
+  activityLog,
+  agents,
+  companies,
+  createDb,
+  documents,
+  heartbeatRuns,
+  issueDocuments,
+  issues,
+  pluginDatabaseNamespaces,
+  plugins,
+} from "@paperclipai/db";
+import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
+import { issueService } from "../services/issues.js";
+import {
+  deciderPorteServeur,
+  signaturePolitiqueRelecture,
+  transitionSoumiseALaPorte,
+  verifierPolitiqueNonAffaiblie,
+} from "../atelier/gardes-atelier.js";
+import { creerRegulateurRuns, lirePlafondEnvironnement, placesRestantes } from "../atelier/regulateur-runs.js";
+import { normalizeIssueExecutionPolicy } from "../services/issue-execution-policy.js";
+
+const NS = "plugin_atelier_f0322cc62c";
+const support = await getEmbeddedPostgresTestSupport();
+const decrireAvecBase = support.supported ? describe : describe.skip;
+
+describe("atelier : fonctions pures des gardes", () => {
+  const relecteur = "11111111-1111-4111-8111-111111111111";
+  const autre = "22222222-2222-4222-8222-222222222222";
+  const politique = (agentId: string, extra: Record<string, unknown> = {}) => ({
+    stages: [{ type: "review", participants: [{ type: "agent", agentId }] }],
+    ...extra,
+  });
+
+  it("P1 : un agent ne peut ni retirer ni modifier une politique à étapes", () => {
+    expect(() => verifierPolitiqueNonAffaiblie({ actorAgentId: autre, politiqueActuelle: politique(relecteur), politiqueDemandee: null })).toThrow(/P1/);
+    expect(() => verifierPolitiqueNonAffaiblie({ actorAgentId: autre, politiqueActuelle: politique(relecteur), politiqueDemandee: politique(autre) })).toThrow(/P1/);
+    expect(() =>
+      verifierPolitiqueNonAffaiblie({ actorAgentId: autre, politiqueActuelle: politique(relecteur), politiqueDemandee: politique(relecteur, { maxReviewRounds: 50 }) }),
+    ).toThrow(/P1/);
+    expect(() =>
+      verifierPolitiqueNonAffaiblie({ actorAgentId: autre, politiqueActuelle: politique(relecteur), politiqueDemandee: { stages: [] } }),
+    ).toThrow(/P1/);
+  });
+
+  it("P1 : un humain peut modifier ; un agent peut renvoyer la même politique ou en ajouter une", () => {
+    expect(() => verifierPolitiqueNonAffaiblie({ actorAgentId: null, politiqueActuelle: politique(relecteur), politiqueDemandee: null })).not.toThrow();
+    expect(() => verifierPolitiqueNonAffaiblie({ actorAgentId: autre, politiqueActuelle: politique(relecteur), politiqueDemandee: politique(relecteur) })).not.toThrow();
+    expect(() => verifierPolitiqueNonAffaiblie({ actorAgentId: autre, politiqueActuelle: null, politiqueDemandee: politique(relecteur) })).not.toThrow();
+    expect(() => verifierPolitiqueNonAffaiblie({ actorAgentId: autre, politiqueActuelle: politique(relecteur), politiqueDemandee: undefined })).not.toThrow();
+  });
+
+  it("P1 : la signature ignore les identifiants régénérés", () => {
+    const a = normalizeIssueExecutionPolicy(politique(relecteur));
+    const b = normalizeIssueExecutionPolicy(politique(relecteur));
+    expect(a?.stages[0]?.id).not.toBe(b?.stages[0]?.id);
+    expect(signaturePolitiqueRelecture(a)).toBe(signaturePolitiqueRelecture(b));
+  });
+
+  it("P2 : transitions soumises à la porte", () => {
+    expect(transitionSoumiseALaPorte({ status: "in_review" }, { status: "done" })).toBe("vers_done");
+    expect(transitionSoumiseALaPorte({ status: "done" }, { status: "done" })).toBeNull();
+    expect(
+      transitionSoumiseALaPorte(
+        { status: "in_review", executionState: { status: "pending", currentStageType: "review" } },
+        { executionState: { status: "pending", currentStageType: "approval" } },
+      ),
+    ).toBe("vers_approbation");
+    expect(
+      transitionSoumiseALaPorte(
+        { status: "in_review", executionState: { status: "pending", currentStageType: "approval" } },
+        { executionState: { status: "pending", currentStageType: "approval" } },
+      ),
+    ).toBeNull();
+    expect(transitionSoumiseALaPorte({ status: "in_review" }, { status: "in_progress" })).toBeNull();
+  });
+
+  it("P2 : décision serveur", () => {
+    const ok = { decision: "PASS", perimee: false, revisionId: "r2", entreesPlusRecentes: false };
+    const base = { porteActive: true, revisionCourante: "r2" };
+    expect(deciderPorteServeur({ ...base, evaluation: ok }).autorise).toBe(true);
+    expect(deciderPorteServeur({ ...base, evaluation: null }).autorise).toBe(false);
+    expect(deciderPorteServeur({ ...base, evaluation: { ...ok, decision: "REFUS" } }).autorise).toBe(false);
+    expect(deciderPorteServeur({ ...base, evaluation: { ...ok, perimee: true } }).autorise).toBe(false);
+    expect(deciderPorteServeur({ ...base, evaluation: { ...ok, revisionId: "r1" } }).autorise).toBe(false);
+    expect(deciderPorteServeur({ ...base, revisionCourante: null, evaluation: ok }).autorise).toBe(false);
+    expect(deciderPorteServeur({ ...base, evaluation: { ...ok, entreesPlusRecentes: true } }).autorise).toBe(false);
+    expect(deciderPorteServeur({ porteActive: false, evaluation: null, revisionCourante: null }).autorise).toBe(true);
+  });
+
+  it("régulateur : plafond par variable et places restantes", () => {
+    expect(lirePlafondEnvironnement({ ATELIER_MAX_RUNS_ACTIFS_PAR_ENTREPRISE: "3" })).toBe(3);
+    expect(lirePlafondEnvironnement({ ATELIER_MAX_RUNS_ACTIFS_PAR_ENTREPRISE: "0" })).toBeNull();
+    expect(lirePlafondEnvironnement({ ATELIER_MAX_RUNS_ACTIFS_PAR_ENTREPRISE: "abc" })).toBeNull();
+    expect(lirePlafondEnvironnement({})).toBeNull();
+    expect(placesRestantes(3, 2)).toBe(1);
+    expect(placesRestantes(3, 5)).toBe(0);
+    expect(placesRestantes(null, 99)).toBeNull();
+  });
+});
+
+decrireAvecBase("atelier : gardes et régulateur contre PostgreSQL", () => {
+  let db!: ReturnType<typeof createDb>;
+  let base: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>> | null = null;
+
+  beforeAll(async () => {
+    base = await startEmbeddedPostgresTestDatabase("paperclip-atelier-gardes-");
+    db = createDb(base.connectionString);
+  }, 30_000);
+
+  afterEach(async () => {
+    await db.execute(sql.raw(`drop schema if exists ${NS} cascade`));
+    await db.delete(activityLog);
+    await db.delete(issueDocuments);
+    await db.delete(documents);
+    await db.delete(heartbeatRuns);
+    await db.delete(issues);
+    await db.delete(agents);
+    await db.delete(pluginDatabaseNamespaces);
+    await db.delete(plugins);
+    await db.delete(companies);
+  });
+
+  afterAll(async () => {
+    await base?.cleanup();
+  });
+
+  /** Reproduit les colonnes gelées du contrat (docs/contrats.md §3) lues par le serveur. */
+  async function installerEspaceAtelier() {
+    const pluginId = randomUUID();
+    await db.insert(plugins).values({
+      id: pluginId,
+      pluginKey: "atelier.marketing-ia",
+      packageName: "@atelier/plugin-atelier",
+      version: "0.1.0",
+      manifestJson: {} as never,
+      status: "ready",
+    });
+    await db.insert(pluginDatabaseNamespaces).values({ pluginId, pluginKey: "atelier.marketing-ia", namespaceName: NS, status: "active" });
+    for (const ddl of [
+      `create schema ${NS}`,
+      `create table ${NS}.reglages_entreprise (company_id uuid primary key, max_runs_actifs integer not null default 3, modifie_le timestamptz not null default now())`,
+      `create table ${NS}.portes (issue_id uuid primary key, company_id uuid not null, campagne_id uuid not null, cle_livrable text not null default 'livrable', actif boolean not null default true, modifie_le timestamptz not null default now())`,
+      `create table ${NS}.evaluations_porte (id uuid primary key, issue_id uuid not null, revision_id uuid, decision text not null, perimee boolean not null default false, entrees_jusqu_a timestamptz not null, cree_le timestamptz not null default clock_timestamp())`,
+      `create table ${NS}.couvertures (id uuid primary key, issue_id uuid not null, modifie_le timestamptz not null default now())`,
+      `create table ${NS}.verdicts (id uuid primary key, issue_id uuid not null, modifie_le timestamptz not null default now())`,
+      `create table ${NS}.constats (finding_id text primary key, issue_id uuid not null, modifie_le timestamptz not null default now())`,
+      `create table ${NS}.exigences (id uuid primary key, campagne_id uuid not null, modifie_le timestamptz not null default now())`,
+    ]) {
+      await db.execute(sql.raw(ddl));
+    }
+  }
+
+  async function creerEntreprise() {
+    const companyId = randomUUID();
+    await db.insert(companies).values({
+      id: companyId,
+      name: "Atelier test",
+      issuePrefix: `A${companyId.replace(/-/g, "").slice(0, 6).toUpperCase()}`,
+      requireBoardApprovalForNewAgents: false,
+    });
+    const producteur = randomUUID();
+    const relecteur = randomUUID();
+    for (const [id, name] of [[producteur, "Producteur"], [relecteur, "Relecteur"]] as const) {
+      await db.insert(agents).values({ id, companyId, name, role: "general", status: "active", adapterType: "process", adapterConfig: {}, runtimeConfig: {}, permissions: {} });
+    }
+    return { companyId, producteur, relecteur };
+  }
+
+  async function creerTache(companyId: string, relecteur: string, champs: Partial<typeof issues.$inferInsert> = {}) {
+    const issueId = randomUUID();
+    await db.insert(issues).values({
+      id: issueId,
+      companyId,
+      title: "Livrable sous porte",
+      status: "in_review",
+      priority: "medium",
+      executionPolicy: normalizeIssueExecutionPolicy({ stages: [{ type: "review", participants: [{ type: "agent", agentId: relecteur }] }] }),
+      ...champs,
+    });
+    return issueId;
+  }
+
+  async function poserLivrable(companyId: string, issueId: string, revisionId: string) {
+    const documentId = randomUUID();
+    await db.insert(documents).values({ id: documentId, companyId, latestBody: "corps", latestRevisionId: revisionId, latestRevisionNumber: 1 });
+    await db.insert(issueDocuments).values({ companyId, issueId, documentId, key: "livrable" });
+    return documentId;
+  }
+
+  async function mettreSousPorte(companyId: string, issueId: string) {
+    const campagneId = randomUUID();
+    await db.execute(sql.raw(`insert into ${NS}.portes (issue_id, company_id, campagne_id) values ('${issueId}', '${companyId}', '${campagneId}')`));
+    return campagneId;
+  }
+
+  async function evaluation(issueId: string, revisionId: string, decision = "PASS", perimee = false) {
+    await db.execute(
+      sql.raw(`insert into ${NS}.evaluations_porte (id, issue_id, revision_id, decision, perimee, entrees_jusqu_a) values ('${randomUUID()}', '${issueId}', '${revisionId}', '${decision}', ${perimee}, clock_timestamp())`),
+    );
+  }
+
+  async function attendreActivite(action: string) {
+    for (let i = 0; i < 40; i++) {
+      const rangs = await db.select().from(activityLog);
+      const trouve = rangs.find((r) => r.action === action);
+      if (trouve) return trouve;
+      await new Promise((r) => setTimeout(r, 50));
+    }
+    return null;
+  }
+
+  it("P1 : le contournement de phase 1 (retrait de la politique par l'agent) est refusé et tracé", async () => {
+    await installerEspaceAtelier();
+    const { companyId, producteur, relecteur } = await creerEntreprise();
+    const issueId = await creerTache(companyId, relecteur, { status: "in_progress", assigneeAgentId: producteur });
+    await expect(issueService(db).update(issueId, { executionPolicy: null, actorAgentId: producteur })).rejects.toMatchObject({ status: 403 });
+    const apres = await db.select().from(issues).where(sql`${issues.id} = ${issueId}`);
+    expect(apres[0]?.executionPolicy).not.toBeNull();
+    const trace = await attendreActivite("atelier.politique_verrouillee");
+    expect(trace?.entityId).toBe(issueId);
+  });
+
+  it("P1 : un humain peut retirer la politique", async () => {
+    const { companyId, relecteur } = await creerEntreprise();
+    const issueId = await creerTache(companyId, relecteur, { status: "todo" });
+    const maj = await issueService(db).update(issueId, { executionPolicy: null, actorUserId: "local-board" });
+    expect(maj?.executionPolicy ?? null).toBeNull();
+  });
+
+  it("P2 : sans évaluation PASS, done est refusé même au board, et le refus est tracé", async () => {
+    await installerEspaceAtelier();
+    const { companyId, relecteur } = await creerEntreprise();
+    const issueId = await creerTache(companyId, relecteur);
+    await poserLivrable(companyId, issueId, randomUUID());
+    await mettreSousPorte(companyId, issueId);
+    await expect(issueService(db).update(issueId, { status: "done", actorUserId: "local-board" })).rejects.toMatchObject({ status: 422 });
+    const apres = await db.select().from(issues).where(sql`${issues.id} = ${issueId}`);
+    expect(apres[0]?.status).toBe("in_review");
+    const trace = await attendreActivite("atelier.porte_refusee");
+    expect(trace?.details).toMatchObject({ garde: "P2" });
+  });
+
+  it("P2 : PASS sur la révision courante et fraîche autorise done", async () => {
+    await installerEspaceAtelier();
+    const { companyId, relecteur } = await creerEntreprise();
+    const issueId = await creerTache(companyId, relecteur);
+    const revision = randomUUID();
+    await poserLivrable(companyId, issueId, revision);
+    await mettreSousPorte(companyId, issueId);
+    await evaluation(issueId, revision, "PASS");
+    const maj = await issueService(db).update(issueId, { status: "done", actorUserId: "local-board" });
+    expect(maj?.status).toBe("done");
+  });
+
+  it("P2 : PASS sur une ancienne révision, PASS périmé, REFUS ou entrée plus récente sont refusés", async () => {
+    await installerEspaceAtelier();
+    const { companyId, relecteur } = await creerEntreprise();
+    const svc = issueService(db);
+
+    const t1 = await creerTache(companyId, relecteur);
+    await poserLivrable(companyId, t1, randomUUID());
+    await mettreSousPorte(companyId, t1);
+    await evaluation(t1, randomUUID(), "PASS");
+    await expect(svc.update(t1, { status: "done", actorUserId: "local-board" })).rejects.toMatchObject({ status: 422 });
+
+    const t2 = await creerTache(companyId, relecteur);
+    const r2 = randomUUID();
+    await poserLivrable(companyId, t2, r2);
+    await mettreSousPorte(companyId, t2);
+    await evaluation(t2, r2, "PASS", true);
+    await expect(svc.update(t2, { status: "done", actorUserId: "local-board" })).rejects.toMatchObject({ status: 422 });
+
+    const t3 = await creerTache(companyId, relecteur);
+    const r3 = randomUUID();
+    await poserLivrable(companyId, t3, r3);
+    await mettreSousPorte(companyId, t3);
+    await evaluation(t3, r3, "REFUS");
+    await expect(svc.update(t3, { status: "done", actorUserId: "local-board" })).rejects.toMatchObject({ status: 422 });
+
+    const t4 = await creerTache(companyId, relecteur);
+    const r4 = randomUUID();
+    await poserLivrable(companyId, t4, r4);
+    await mettreSousPorte(companyId, t4);
+    await evaluation(t4, r4, "PASS");
+    await db.execute(sql.raw(`insert into ${NS}.verdicts (id, issue_id, modifie_le) values ('${randomUUID()}', '${t4}', clock_timestamp())`));
+    await expect(svc.update(t4, { status: "done", actorUserId: "local-board" })).rejects.toMatchObject({ status: 422 });
+  });
+
+  it("P2 : l'entrée dans l'étape d'approbation humaine exige la porte", async () => {
+    await installerEspaceAtelier();
+    const { companyId, relecteur } = await creerEntreprise();
+    const issueId = await creerTache(companyId, relecteur, {
+      executionState: { status: "pending", currentStageType: "review", currentStageId: null, currentStageIndex: 0, currentParticipant: null, returnAssignee: null, completedStageIds: [], lastDecisionId: null, lastDecisionOutcome: null },
+    });
+    const revision = randomUUID();
+    await poserLivrable(companyId, issueId, revision);
+    await mettreSousPorte(companyId, issueId);
+    const etatApprobation = { status: "pending", currentStageType: "approval", currentStageId: null, currentStageIndex: 1, currentParticipant: { type: "user", userId: "local-board", agentId: null }, returnAssignee: null, completedStageIds: [], lastDecisionId: null, lastDecisionOutcome: null };
+    await expect(
+      issueService(db).update(issueId, { executionState: etatApprobation as never, actorAgentId: relecteur }),
+    ).rejects.toMatchObject({ status: 422 });
+    await evaluation(issueId, revision, "PASS");
+    const maj = await issueService(db).update(issueId, { executionState: etatApprobation as never, actorAgentId: relecteur });
+    expect((maj?.executionState as { currentStageType?: string } | null)?.currentStageType).toBe("approval");
+  });
+
+  it("P2 : porte levée par un humain ou plugin absent = comportement natif", async () => {
+    const { companyId, relecteur } = await creerEntreprise();
+    const sansPlugin = await creerTache(companyId, relecteur);
+    expect((await issueService(db).update(sansPlugin, { status: "done", actorUserId: "local-board" }))?.status).toBe("done");
+
+    await installerEspaceAtelier();
+    const levee = await creerTache(companyId, relecteur);
+    await mettreSousPorte(companyId, levee);
+    await db.execute(sql.raw(`update ${NS}.portes set actif = false where issue_id = '${levee}'`));
+    expect((await issueService(db).update(levee, { status: "done", actorUserId: "local-board" }))?.status).toBe("done");
+  });
+
+  it("régulateur : jamais plus de N runs admis en parallèle dans une entreprise", async () => {
+    await installerEspaceAtelier();
+    const { companyId, producteur } = await creerEntreprise();
+    await db.execute(sql.raw(`insert into ${NS}.reglages_entreprise (company_id, max_runs_actifs) values ('${companyId}', 3)`));
+    const regulateur = creerRegulateurRuns(db, {});
+    const files = Array.from({ length: 6 }, () => randomUUID());
+    for (const id of files) {
+      await db.insert(heartbeatRuns).values({ id, companyId, agentId: producteur, status: "queued" });
+    }
+    // Réclamation simulée : passe le run à running après un délai (fenêtre de concurrence).
+    const reclamer = (id: string) => async () => {
+      await new Promise((r) => setTimeout(r, 20));
+      await db.update(heartbeatRuns).set({ status: "running" }).where(sql`${heartbeatRuns.id} = ${id}`);
+      return id;
+    };
+    const resultats = await Promise.all(files.map((id) => regulateur.admettre(companyId, reclamer(id))));
+    expect(resultats.filter((r) => r.admis)).toHaveLength(3);
+    expect(await regulateur.compterRunsActifs(companyId)).toBe(3);
+    expect(await regulateur.plafondEntreprise(companyId)).toBe(3);
+  });
+
+  it("régulateur : sans réglage ni variable, aucun plafond (natif) ; la variable sert de défaut", async () => {
+    const { companyId, producteur } = await creerEntreprise();
+    for (let i = 0; i < 4; i++) {
+      await db.insert(heartbeatRuns).values({ id: randomUUID(), companyId, agentId: producteur, status: "running" });
+    }
+    expect((await creerRegulateurRuns(db, {}).admettre(companyId, async () => "ok")).admis).toBe(true);
+    const avecVariable = await creerRegulateurRuns(db, { ATELIER_MAX_RUNS_ACTIFS_PAR_ENTREPRISE: "3" }).admettre(companyId, async () => "ok");
+    expect(avecVariable.admis).toBe(false);
+  });
+});

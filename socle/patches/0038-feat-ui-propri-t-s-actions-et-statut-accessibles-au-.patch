+  describe("accès mobile aux propriétés et aux actions (sous md)", () => {
+    // Ces tests appellent l'API de mise à jour : on isole les appels pour ne pas
+    // fausser les tests voisins qui lisent invocationCallOrder[0].
+    beforeEach(() => { mockIssuesApi.update.mockClear(); });
+    afterEach(() => { mockIssuesApi.update.mockClear(); });
+    const renderPage = async () => {
+      mockIssuesApi.get.mockResolvedValue(createIssue());
+      await act(async () => {
+        root.render(
+          <QueryClientProvider client={queryClient}>
+            <IssueDetail />
+          </QueryClientProvider>,
+        );
+      });
+      await flushReact();
+      await flushReact();
+    };
+    const propsButton = () =>
+      container.querySelector<HTMLButtonElement>(
+        '[data-testid="issue-detail-header"] button[aria-label="Propriétés"]',
+      );
+
+    it("le bouton Propriétés de la tête ouvre le panneau en feuille et se ferme avec un bouton de 44 px", async () => {
+      mockSidebarState.isMobile = true;
+      await renderPage();
+
+      expect(propsButton()).not.toBeNull();
+      // Visible seulement sous md, avec une cible tactile de 44 px (h-11).
+      expect(propsButton()!.className).toContain("md:hidden");
+      expect(propsButton()!.className).toContain("h-11");
+      expect(document.querySelector('[data-testid="mobile-task-side-panel"]')).toBeNull();
+
+      await act(async () => propsButton()!.click());
+      await waitForAssertion(() => {
+        const panel = document.querySelector('[data-testid="mobile-task-side-panel"]');
+        expect(panel).not.toBeNull();
+        expect(panel?.textContent).toContain("Task side panel");
+      });
+
+      // Le bouton « Fermer » du panneau (onRequestClose) referme la feuille.
+      const props = mockTaskSidePanelRender.mock.calls.at(-1)?.[0];
+      expect(props.mobile).toBe(true);
+      await act(async () => { props.onRequestClose(); });
+      await waitForAssertion(() => {
+        expect(document.querySelector('[data-testid="mobile-task-side-panel"]')).toBeNull();
+      });
+    });
+
+    it("le statut se modifie depuis le panneau ouvert sur mobile", async () => {
+      mockSidebarState.isMobile = true;
+      mockIssuesApi.update.mockResolvedValueOnce(createIssue({ status: "done" }));
+      await renderPage();
+
+      await act(async () => propsButton()!.click());
+      await waitForAssertion(() => {
+        expect(document.querySelector('[data-testid="mobile-task-side-panel"]')).not.toBeNull();
+      });
+      const props = mockTaskSidePanelRender.mock.calls.at(-1)?.[0];
+      await act(async () => { props.onUpdate({ status: "done" }); });
+      await waitForAssertion(() => {
+        expect(mockIssuesApi.update).toHaveBeenCalledWith(
+          "PAP-1",
+          expect.objectContaining({ status: "done" }),
+        );
+      });
+    });
+
+    it("le menu « Autres actions » est présent, de 44 px, et son contenu est atteignable", async () => {
+      mockSidebarState.isMobile = true;
+      await renderPage();
+
+      const titleActions = container.querySelector('[data-slot="task-title-actions"]');
+      // Plus de h-7 seul : 44 px sous md, 28 px au-delà.
+      expect(titleActions?.className).toContain("h-11");
+      expect(titleActions?.className).toContain("md:h-7");
+      // Le conteneur des actions n'est plus masqué sous md.
+      const wrapper = titleActions?.parentElement;
+      expect(wrapper?.className).not.toContain("hidden");
+
+      const moreButton = titleActions?.querySelector<HTMLButtonElement>(
+        'button[aria-label="Autres actions sur la tâche"]',
+      );
+      expect(moreButton).not.toBeNull();
+      expect(moreButton!.className).toContain("max-md:size-11");
+
+      await act(async () => moreButton!.click());
+      const hide = Array.from(document.body.querySelectorAll<HTMLButtonElement>("button"))
+        .find((button) => button.textContent?.trim() === "Masquer cette tâche");
+      expect(hide).toBeDefined();
+    });
+
+    it("les boutons réservés au bureau restent masqués sous md", async () => {
+      mockSidebarState.isMobile = true;
+      await renderPage();
+      const desktopOnly = container.querySelector('[data-slot="task-title-actions"]')
+        ?.parentElement?.querySelector(":scope > .hidden.md\\:contents");
+      expect(desktopOnly).not.toBeNull();
+    });
+  });
+

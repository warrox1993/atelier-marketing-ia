+  it("donne une zone tactile de 44 px sous md au bouton de statut, sans changer l'icône", () => {
+    const html = renderToStaticMarkup(<StatusIcon status="todo" onChange={() => {}} />);
+    expect(html).toContain("max-md:after:size-(--sz-44px)");
+    expect(html).toContain("max-md:after:absolute");
+    // La taille de l'icône reste celle de la prop size.
+    const sans = renderToStaticMarkup(<StatusIcon status="todo" />);
+    const svg = (h: string) => /<svg[^>]*class="([^"]*)"/.exec(h)?.[1]?.replace(" cursor-pointer", "");
+    expect(svg(html)).toBe(svg(sans));
+  });
+
+  it("garde 44 px de haut sous md pour le bouton de statut avec libellé", () => {
+    const html = renderToStaticMarkup(<StatusIcon status="todo" showLabel onChange={() => {}} />);
+    expect(html).toContain("max-md:min-h-(--sz-44px)");
+  });
 });

 }
 
+const LOCAL_WORKSPACE_SOURCE_TYPES = new Set(["local_path", "non_git_path"]);
+
+/** Champs d'un projet qui pointent l'hôte (dossier local, secrets, politique d'exécution) : réservés au board. */
+export function collectProjectHostFieldPaths(
+  input: { env?: unknown; executionWorkspacePolicy?: unknown },
+  workspace?: unknown,
+  workspacePrefix = "workspace",
+): string[] {
+  const paths: string[] = [];
+  if (input.env != null) paths.push("env");
+  if (input.executionWorkspacePolicy != null) paths.push("executionWorkspacePolicy");
+  if (isRecord(workspace)) {
+    if (workspace.cwd != null) paths.push(prefixPath(workspacePrefix, "cwd"));
+    if (typeof workspace.sourceType === "string" && LOCAL_WORKSPACE_SOURCE_TYPES.has(workspace.sourceType)) {
+      paths.push(prefixPath(workspacePrefix, "sourceType"));
+    }
+  }
+  return paths;
+}
+
+export function assertNoAgentProjectHostFields(req: Request, paths: string[]) {
+  if (req.actor.type !== "agent" || paths.length === 0) return;
+  throw forbidden(
+    `Agent keys cannot set local workspace folders, env or execution policy on projects (${paths.join(", ")}).`,
+  );
+}

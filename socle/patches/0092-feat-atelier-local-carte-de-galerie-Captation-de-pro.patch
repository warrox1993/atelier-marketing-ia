+{
+  "schemaVersion": 1,
+  "slug": "atelier-captation",
+  "name": "Captation de prospects (pages de destination)",
+  "description": "Pages de destination locales à formulaire de rappel ; chaque envoi crée un prospect avec sa preuve de consentement.",

@@ -0,0 +1,66 @@
+import { execFile as execFileCallback } from "node:child_process";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { promisify } from "node:util";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { probeGitWorktreeBase } from "../services/heartbeat/workspaces.js";
+
+const execFile = promisify(execFileCallback);
+
+describe("probeGitWorktreeBase : décision « pas un dépôt »", () => {
+  const dirs: string[] = [];
+  afterEach(async () => {
+    vi.unstubAllEnvs();
+    while (dirs.length) await fs.rm(dirs.pop()!, { recursive: true, force: true });
+  });
+
+  async function tempDir() {
+    const dir = await fs.mkdtemp(path.join(os.tmpdir(), "paperclip-git-probe-"));
+    dirs.push(dir);
+    return dir;
+  }
+  // Le patch 0164 rend les autres tests indépendants du poste ; ici le processus testé reste tel quel.
+  function frenchHostAcrossMounts() {
+    vi.stubEnv("LC_ALL", "fr_BE.UTF-8");
+    vi.stubEnv("LANG", "fr_BE.UTF-8");
+    vi.stubEnv("LANGUAGE", "fr");
+    delete process.env.GIT_DISCOVERY_ACROSS_FILESYSTEM; // vi.unstubAllEnvs restaure l'ancienne valeur
+  }
+
+  it("AC1 : dossier sans git, git en français (langue seule, sans limite de système de fichiers)", async () => {
+    const dir = await tempDir();
+    frenchHostAcrossMounts();
+    vi.stubEnv("GIT_DISCOVERY_ACROSS_FILESYSTEM", "1");
+    expect(await probeGitWorktreeBase(dir)).toEqual({ isCheckout: false, notRepository: true });
+  });
+
+  it("AC2 : dossier sans git sous un autre point de montage (limite de système de fichiers)", async () => {
+    const dir = await tempDir();
+    frenchHostAcrossMounts();
+    vi.stubEnv("LC_ALL", "C");
+    vi.stubEnv("LANGUAGE", "");
+    expect(await probeGitWorktreeBase(dir)).toEqual({ isCheckout: false, notRepository: true });
+  });
+
+  it("AC1 et AC2 : dossier sans git, git en français ET limite de système de fichiers (poste de l'opérateur)", async () => {
+    const dir = await tempDir();
+    frenchHostAcrossMounts();
+    expect(await probeGitWorktreeBase(dir)).toEqual({ isCheckout: false, notRepository: true });
+  });
+
+  it("AC3 : un .git présent mais vide reste une panne", async () => {
+    const dir = await tempDir();
+    await fs.mkdir(path.join(dir, ".git"));
+    frenchHostAcrossMounts();
+    expect(await probeGitWorktreeBase(dir)).toEqual({ isCheckout: false, notRepository: false });
+  });
+
+  it("AC3 : une configuration git corrompue reste une panne", async () => {
+    const dir = await tempDir();
+    await execFile("git", ["init", "-q"], { cwd: dir });
+    await fs.writeFile(path.join(dir, ".git", "config"), "[core\n garbage\n");
+    frenchHostAcrossMounts();
+    expect(await probeGitWorktreeBase(dir)).toEqual({ isCheckout: false, notRepository: false });
+  });
+});

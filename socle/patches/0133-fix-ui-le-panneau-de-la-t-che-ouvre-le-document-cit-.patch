index 0000000000..6b3fcbe6a4
--- /dev/null
+++ b/ui/src/lib/pending-card-document.ts
@@ -0,0 +1,19 @@
+import type { IssueThreadInteraction } from "@paperclipai/shared";
+
+const DOCUMENT_ANCHOR = /#document-([a-z0-9][a-z0-9_-]*)/;
+
+/**
+ * Clé du document qu'une carte en attente (confirmation, cases, verdicts, questions) soumet à l'humain :
+ * sa cible `issue_document`, sinon le premier lien `#document-<clé>` de son texte. Le panneau ouvre ce
+ * document au lieu du plan, souvent déjà approuvé.
+ */
+export function pendingCardDocumentKey(interactions: IssueThreadInteraction[] | undefined): string | null {
+  for (const interaction of interactions ?? []) {
+    if (interaction.status !== "pending" || interaction.kind === "suggest_tasks" || interaction.kind === "connection_intent") continue;
+    const target = "target" in interaction.payload ? interaction.payload.target : null;
+    if (target?.type === "issue_document" && target.key) return target.key;
+    const anchor = DOCUMENT_ANCHOR.exec(JSON.stringify(interaction.payload));
+    if (anchor) return anchor[1];
+  }
+  return null;
+}

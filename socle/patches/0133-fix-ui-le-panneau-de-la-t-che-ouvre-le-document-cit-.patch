+import type { IssueThreadInteraction } from "@paperclipai/shared";
+import { describe, expect, it } from "vitest";
+import { pendingCardDocumentKey } from "./pending-card-document";
+
+function interaction(overrides: Record<string, unknown>): IssueThreadInteraction {
+  return { id: "i-1", kind: "request_confirmation", status: "pending", payload: { version: 1, prompt: "" }, ...overrides } as unknown as IssueThreadInteraction;
+}
+
+describe("pendingCardDocumentKey", () => {
+  it("prend la cible issue_document de la carte en attente", () => {
+    expect(pendingCardDocumentKey([
+      interaction({ payload: { version: 1, prompt: "Valider ?", target: { type: "issue_document", key: "liste", revisionId: "r-1" } } }),
+    ])).toBe("liste");
+  });
+
+  it("à défaut, le premier lien #document-<clé> du texte, questions comprises", () => {
+    expect(pendingCardDocumentKey([
+      interaction({ kind: "ask_user_questions", payload: { version: 1, questions: [{ id: "q", prompt: "Voir [la liste](#document-liste-finale)", selectionMode: "single", options: [] }] } }),
+    ])).toBe("liste-finale");
+  });
+
+  it("ignore les cartes résolues, les suggestions de tâches et les cartes sans document", () => {
+    expect(pendingCardDocumentKey([
+      interaction({ status: "accepted", payload: { version: 1, prompt: "#document-liste" } }),
+      interaction({ kind: "suggest_tasks", payload: { version: 1, tasks: [{ title: "#document-autre" }] } }),
+      interaction({ payload: { version: 1, prompt: "Sans document" } }),
+    ])).toBeNull();
+    expect(pendingCardDocumentKey(undefined)).toBeNull();
+  });
+});
diff --git a/ui/src/lib/pending-card-document.ts b/ui/src/lib/pending-card-document.ts

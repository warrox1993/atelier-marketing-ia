+/**
+ * Atelier HUM-C2 : pendant la pause d'un agent, le réveil d'une carte résolue
+ * est refusé (409) et seulement journalisé. À la reprise, on rejoue le réveil
+ * de continuation des cartes résolues depuis la pause, sur ses tâches ouvertes.
+ */
+export async function replayInteractionWakesAfterResume(input: {
+  db: Db;
+  heartbeat: ReturnType<typeof heartbeatService>;
+  agentId: string;
+  companyId: string;
+  pausedAt: Date | null;
+}): Promise<number> {
+  if (!input.pausedAt) return 0;
+  const rows = await input.db
+    .select({ interaction: issueThreadInteractions, issue: issueRows })
+    .from(issueThreadInteractions)
+    .innerJoin(issueRows, and(eq(issueRows.id, issueThreadInteractions.issueId), eq(issueRows.companyId, issueThreadInteractions.companyId)))
+    .where(and(
+      eq(issueThreadInteractions.companyId, input.companyId),
+      eq(issueRows.assigneeAgentId, input.agentId),
+      notInArray(issueRows.status, ["done", "cancelled"]),
+      notInArray(issueThreadInteractions.status, ["pending"]),
+      sql`${issueThreadInteractions.resolvedAt} >= ${input.pausedAt.toISOString()}::timestamptz`,
+    ))
+    .orderBy(asc(issueThreadInteractions.resolvedAt))
+    .limit(20);
+  for (const { interaction, issue } of rows) {
+    await queueResolvedInteractionContinuationWakeup({
+      db: input.db,
+      heartbeat: input.heartbeat,
+      issue,
+      interaction,
+      actor: { actorType: "user", actorId: interaction.resolvedByUserId ?? "board" },
+      source: "agent.resumed",
+    });
+  }
+  return rows.length;
+}

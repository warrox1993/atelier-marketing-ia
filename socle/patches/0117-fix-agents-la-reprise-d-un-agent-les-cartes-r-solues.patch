+// Atelier HUM-C2 : une réponse donnée pendant la pause d'un agent était perdue (réveil refusé en 409, avalé).
+// À la reprise, les cartes résolues pendant la pause relancent leur réveil de continuation.
+import type { Db } from "@paperclipai/db";
+import { agents, companies, createDb, EMBEDDED_POSTGRES_TEST_TIMEOUT_MS, issues, issueThreadInteractions } from "@paperclipai/db";
+import { sql } from "drizzle-orm";
+import { afterAll, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
+import { replayInteractionWakesAfterResume } from "../routes/issues.js";
+
+const support = await getEmbeddedPostgresTestSupport();
+describe.skipIf(!support.supported)("reprise d'un agent : réveils des cartes résolues pendant la pause", () => {
+  let database: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>>;
+  let db: Db;
+  beforeAll(async () => {
+    database = await startEmbeddedPostgresTestDatabase("paperclip-resume-interaction-replay");
+    db = createDb(database.connectionString);
+  }, EMBEDDED_POSTGRES_TEST_TIMEOUT_MS);
+  afterAll(async () => {
+    await db?.$client.end();
+    await database?.cleanup();
+  });
+  beforeEach(async () => {
+    await db.execute(sql`truncate table companies restart identity cascade`);
+  });
+
+  async function carte(companyId: string, issueId: string, champs: Partial<typeof issueThreadInteractions.$inferInsert>) {
+    const [ligne] = await db.insert(issueThreadInteractions).values({
+      companyId, issueId, kind: "request_confirmation", status: "accepted", continuationPolicy: "wake_assignee",
+      payload: { version: 1, prompt: "Valider ?" } as never, result: { version: 1, outcome: "accepted" } as never,
+      resolvedByUserId: "local-board", ...champs,
+    }).returning();
+    return ligne!;
+  }
+
+  it("relance la carte résolue pendant la pause, pas celles d'avant ni les cartes ouvertes", async () => {
+    const [company] = await db.insert(companies).values({ name: "Reprise", issuePrefix: "RP" }).returning();
+    const pausedAt = new Date(Date.now() - 60 * 60 * 1000);
+    const [agent] = await db.insert(agents).values({ companyId: company!.id, name: "Coordinateur", role: "general", status: "idle", adapterType: "process", adapterConfig: {}, pausedAt }).returning();
+    const [issue] = await db.insert(issues).values({ companyId: company!.id, title: "Liste finale", status: "blocked", assigneeAgentId: agent!.id }).returning();
+    const [close] = await db.insert(issues).values({ companyId: company!.id, title: "Close", status: "done", assigneeAgentId: agent!.id }).returning();
+    const pendant = await carte(company!.id, issue!.id, { resolvedAt: new Date() });
+    await carte(company!.id, issue!.id, { resolvedAt: new Date(pausedAt.getTime() - 60_000) });
+    await carte(company!.id, issue!.id, { status: "pending", resolvedAt: null, result: null });
+    await carte(company!.id, close!.id, { resolvedAt: new Date() });
+    const heartbeat = { wakeup: vi.fn(async () => null) };
+
+    const n = await replayInteractionWakesAfterResume({ db, heartbeat: heartbeat as never, agentId: agent!.id, companyId: company!.id, pausedAt });
+
+    expect(n).toBe(1);
+    expect(heartbeat.wakeup).toHaveBeenCalledTimes(1);
+    expect(heartbeat.wakeup).toHaveBeenCalledWith(agent!.id, expect.objectContaining({
+      reason: "issue_commented",
+      payload: expect.objectContaining({ issueId: issue!.id, interactionId: pendant.id }),
+      idempotencyKey: `interaction:${pendant.id}:accepted`,
+    }));
+  });
+
+  it("sans date de pause, ne relance rien", async () => {
+    const heartbeat = { wakeup: vi.fn(async () => null) };
+    expect(await replayInteractionWakesAfterResume({ db, heartbeat: heartbeat as never, agentId: "00000000-0000-4000-8000-000000000000", companyId: "00000000-0000-4000-8000-000000000001", pausedAt: null })).toBe(0);
+    expect(heartbeat.wakeup).not.toHaveBeenCalled();
+  });
+});

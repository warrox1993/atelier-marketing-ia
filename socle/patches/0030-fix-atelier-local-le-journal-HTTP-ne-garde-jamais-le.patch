 server/src/__tests__/http-log-redaction.test.ts | 15 +++++++++++++++
 server/src/middleware/logger.ts                 |  8 ++++++++
 2 files changed, 23 insertions(+)

diff --git a/server/src/__tests__/http-log-redaction.test.ts b/server/src/__tests__/http-log-redaction.test.ts
index 483d0802a..b5bd476ea 100644
--- a/server/src/__tests__/http-log-redaction.test.ts
+++ b/server/src/__tests__/http-log-redaction.test.ts
@@ -12,6 +12,21 @@ import { testAdapterEnvironmentSchema } from "@paperclipai/shared";
 import { createHttpLogger } from "../middleware/logger.js";
 
 describe("HTTP logger redaction", () => {
+  it("ne journalise jamais le corps d'une requête d'API de plugin en erreur (audio de dictée, texte de discussion)", async () => {
+    const chunks: string[] = [];
+    const stream = new Writable({ write(chunk, _encoding, callback) { chunks.push(chunk.toString()); callback(); } });
+    const app = express();
+    app.use(express.json());
+    app.use(createHttpLogger(pino({ redact: [...HTTP_LOG_REDACT_PATHS] }, stream)));
+    app.post("/api/plugins/:pluginId/api/*splat", (_req, res) => res.status(503).json({ error: "dictee_indisponible" }));
+    await request(app).post("/api/plugins/atelier.marketing-ia/api/dictee/transcrire").send({ companyId: "c", audioBase64: "audio-canary", type: "audio/webm" });
+    await request(app).post("/api/plugins/atelier.marketing-ia/api/discussion/message").send({ companyId: "c", texte: "texte-canary" });
+    const sortie = chunks.join("");
+    expect(sortie).not.toMatch(/audio-canary|texte-canary/);
+    expect(sortie).toContain("/api/plugins/atelier.marketing-ia/api/dictee/transcrire");
+    expect(sortie).toContain("[REDACTED]");
+  });
+
   it.each([200, 400, 500])("keeps Slack setup credentials and provider echoes out of %i logs", async status => {
     const canaries = ["configuration-canary", "signing-canary", "client-canary", "bot-canary", "oauth-code-canary", "provider-echo-canary"];
     const chunks: string[] = [];
diff --git a/server/src/middleware/logger.ts b/server/src/middleware/logger.ts
index 775e30c1d..be4712f44 100644
--- a/server/src/middleware/logger.ts
+++ b/server/src/middleware/logger.ts
@@ -172,6 +172,14 @@ export function createHttpLogger(baseLogger: Logger) {
         if (/^\/mcp\/(?:oauth|paperclip)(?:\/|$)/.test(requestClassificationUrl(req) ?? "")) {
           return { reqBody: "[REDACTED]", ...(ctx ? { errorContext: { name: "Error" } } : {}) };
         }
+        if (/^\/api\/plugins\/[^/]+\/api\//.test(requestClassificationUrl(req) ?? "")) {
+          // Routes d'API des plugins : le corps peut contenir de l'audio de dictée ou le texte d'une
+          // discussion. On ne le journalise jamais, même en erreur ; le statut et la route restent.
+          return {
+            reqBody: "[REDACTED]",
+            ...(ctx ? { errorContext: redactSensitive(ctx.error) } : {}),
+          };
+        }
         if (isPrivateWebhook(req) || isPrivateAgentCommentaryHttpRequest(requestClassificationUrl(req))) {
           // Omit, rather than recursively redact, the entire provider payload.
           // This applies equally before/after parsing and with/without context.

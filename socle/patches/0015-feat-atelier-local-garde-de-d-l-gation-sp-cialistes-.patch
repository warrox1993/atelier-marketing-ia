diff --git a/server/src/atelier/garde-delegation.ts b/server/src/atelier/garde-delegation.ts
new file mode 100644
index 000000000..bc33ee236
--- /dev/null
+++ b/server/src/atelier/garde-delegation.ts
@@ -0,0 +1,154 @@
+/**
+ * Atelier Marketing IA (patch local 0015, non amont) : garde de délégation des agents.
+ *
+ * Règles voulues par l'opérateur, valables en démonstration comme chez un client réel (aucune
+ * condition de mode) et limitées aux acteurs `agent` ; le board (humains) n'est pas limité :
+ *  1. un spécialiste ne délègue jamais : un agent sans subordonné ne crée aucune tâche
+ *     (création, création d'enfant, décomposition de plan accepté) ni ne rattache une tâche
+ *     à un parent par PATCH (403) ;
+ *  2. deux niveaux au plus : le parent d'une sous-tâche créée ou rattachée par un agent doit
+ *     être une tâche racine (403) ;
+ *  3. au plus {@link MAX_SOUS_TACHES_OUVERTES} sous-tâches ouvertes (ni `done` ni `cancelled`)
+ *     par mission (409).
+ *
+ * Est subordonné d'un agent tout agent de la même entreprise, ni `terminated` ni
+ * `pending_approval`, dont `reportsTo` vaut l'id de cet agent.
+ *
+ * Exception « Gardien des connexions » : examinée, aucune exception nécessaire. C'est un agent
+ * déterministe (adaptateur `process`, battement natif) qui lance `assurer-connexions` ; ce
+ * script ne crée aucune tâche (aucun appel aux routes de tâches), il n'est donc jamais touché.
+ */
+import { and, eq } from "drizzle-orm";
+import type { Db } from "@paperclipai/db";
+import { agents, issues } from "@paperclipai/db";
+import { conflict, forbidden } from "../errors.js";
+
+/** Nombre maximal de sous-tâches ouvertes sous une même mission. */
+export const MAX_SOUS_TACHES_OUVERTES = 4;
+
+export const CODE_SPECIALISTE_NE_DELEGUE_PAS = "atelier_specialiste_ne_delegue_pas";
+export const CODE_DEUX_NIVEAUX_AU_PLUS = "atelier_deux_niveaux_au_plus";
+export const CODE_MISSION_TROP_LARGE = "atelier_mission_trop_large";
+
+export const MESSAGE_SPECIALISTE_NE_DELEGUE_PAS =
+  "Un spécialiste ne délègue pas : demandez au Coordinateur de répartir le travail.";
+export const MESSAGE_DEUX_NIVEAUX_AU_PLUS =
+  "Deux niveaux au plus : une sous-tâche ne peut pas avoir de sous-tâche.";
+export const MESSAGE_MISSION_TROP_LARGE =
+  `Mission trop large : ${MAX_SOUS_TACHES_OUVERTES} sous-tâches ouvertes au plus. Découpez-la en plusieurs demandes.`;
+
+/** Statuts d'agent qui ne comptent pas comme subordonné. */
+const STATUTS_AGENT_NON_SUBORDONNES = ["terminated", "pending_approval"];
+/** Statuts de tâche qui ne comptent pas comme « ouverte ». */
+const STATUTS_TACHE_CLOS = ["done", "cancelled"];
+
+export type DonneesDelegation = {
+  /** L'acteur est-il un agent ? Sinon aucune règle ne s'applique. */
+  acteurAgent: boolean;
+  /** Nombre de subordonnés actifs de l'acteur. */
+  nbSubordonnes: number;
+  /** Création ou rattachement sous un parent ? */
+  aParent: boolean;
+  /** `parentId` du parent visé (nul si le parent est une tâche racine). */
+  parentDuParent: string | null;
+  /** Sous-tâches ouvertes du parent avant l'opération. */
+  nbOuvertes: number;
+  /** Nombre de sous-tâches que l'opération ajoute (1 sauf décomposition). */
+  nbAjoutees: number;
+  /** Rattachement (PATCH) d'une tâche qui a déjà des sous-tâches : créerait un 3e niveau. */
+  deplaceeADesEnfants?: boolean;
+};
+
+export type DecisionDelegation =
+  | { autorise: true }
+  | { autorise: false; statut: 403 | 409; code: string; message: string };
+
+/** Nombre de tâches ouvertes (statut ni `done` ni `cancelled`). Fonction pure. */
+export function compterOuvertes(statuts: readonly string[]): number {
+  return statuts.filter((s) => !STATUTS_TACHE_CLOS.includes(s)).length;
+}
+
+/** Nombre de subordonnés actifs parmi des agents `{ status }` déjà filtrés sur `reportsTo`. Fonction pure. */
+export function compterSubordonnesActifs(statuts: readonly string[]): number {
+  return statuts.filter((s) => !STATUTS_AGENT_NON_SUBORDONNES.includes(s)).length;
+}
+
+/** Décision à partir des données lues. Fonction pure. */
+export function decider(d: DonneesDelegation): DecisionDelegation {
+  if (!d.acteurAgent) return { autorise: true };
+  if (d.nbSubordonnes <= 0) {
+    return { autorise: false, statut: 403, code: CODE_SPECIALISTE_NE_DELEGUE_PAS, message: MESSAGE_SPECIALISTE_NE_DELEGUE_PAS };
+  }
+  if (!d.aParent) return { autorise: true };
+  if (d.parentDuParent !== null || d.deplaceeADesEnfants) {
+    return { autorise: false, statut: 403, code: CODE_DEUX_NIVEAUX_AU_PLUS, message: MESSAGE_DEUX_NIVEAUX_AU_PLUS };
+  }
+  if (d.nbOuvertes + d.nbAjoutees > MAX_SOUS_TACHES_OUVERTES) {
+    return { autorise: false, statut: 409, code: CODE_MISSION_TROP_LARGE, message: MESSAGE_MISSION_TROP_LARGE };
+  }
+  return { autorise: true };
+}
+
+/** Lève l'erreur HTTP correspondant à une décision de refus ; sans effet si autorisé. */
+export function appliquerDecision(decision: DecisionDelegation): void {
+  if (decision.autorise) return;
+  const details = { code: decision.code };
+  throw decision.statut === 409 ? conflict(decision.message, details) : forbidden(decision.message, details);
+}
+
+type ActeurRequete = { actor: { type: string; agentId?: string | null; companyId?: string | null } };
+
+/**
+ * Lit en base ce qu'il faut puis applique les règles. Sans effet pour un humain (aucune lecture).
+ * `parentId` : parent visé (création d'enfant, rattachement) ; absent pour une création à la racine.
+ * `nbAjoutees` : nombre de sous-tâches créées d'un coup (décomposition de plan accepté).
+ */
+export async function refuserDelegationParAgent(
+  db: Db,
+  req: ActeurRequete,
+  options: { companyId: string; parentId?: string | null; nbAjoutees?: number; issueDeplaceeId?: string },
+): Promise<void> {
+  if (req.actor.type !== "agent") return;
+  const agentId = req.actor.agentId ?? "";
+  const lignesSubordonnes = agentId
+    ? await db
+        .select({ status: agents.status })
+        .from(agents)
+        .where(and(eq(agents.companyId, options.companyId), eq(agents.reportsTo, agentId)))
+    : [];
+  const aParent = Boolean(options.parentId);
+  let parentDuParent: string | null = null;
+  let nbOuvertes = 0;
+  if (aParent && options.parentId) {
+    const parents = await db
+      .select({ parentId: issues.parentId })
+      .from(issues)
+      .where(and(eq(issues.companyId, options.companyId), eq(issues.id, options.parentId)));
+    parentDuParent = parents[0]?.parentId ?? null;
+    const enfants = await db
+      .select({ status: issues.status })
+      .from(issues)
+      .where(and(eq(issues.companyId, options.companyId), eq(issues.parentId, options.parentId)));
+    nbOuvertes = compterOuvertes(enfants.map((e) => e.status));
+  }

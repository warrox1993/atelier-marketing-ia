+import { describe, expect, it } from "vitest";
+import {
+  MAX_SOUS_TACHES_OUVERTES,
+  MESSAGE_DEUX_NIVEAUX_AU_PLUS,
+  MESSAGE_MISSION_TROP_LARGE,
+  MESSAGE_SPECIALISTE_NE_DELEGUE_PAS,
+  appliquerDecision,
+  compterOuvertes,
+  compterSubordonnesActifs,
+  decider,
+  refuserDelegationParAgent,
+  type DonneesDelegation,
+} from "../atelier/garde-delegation.js";
+
+const base: DonneesDelegation = {
+  acteurAgent: true,
+  nbSubordonnes: 3,
+  aParent: true,
+  parentDuParent: null,
+  nbOuvertes: 0,
+  nbAjoutees: 1,
+};
+
+describe("atelier (patch local 0015) : garde de délégation, fonctions pures", () => {
+  it("la limite est une constante nommée valant 4", () => {
+    expect(MAX_SOUS_TACHES_OUVERTES).toBe(4);
+  });
+
+  it("refuse (403) un spécialiste, sans subordonné, même pour une création à la racine", () => {
+    const d = decider({ ...base, nbSubordonnes: 0, aParent: false });
+    expect(d).toMatchObject({ autorise: false, statut: 403, message: MESSAGE_SPECIALISTE_NE_DELEGUE_PAS });
+  });
+
+  it("accepte le coordinateur (des subordonnés), à la racine comme sous un parent racine", () => {
+    expect(decider({ ...base, aParent: false })).toEqual({ autorise: true });
+    expect(decider(base)).toEqual({ autorise: true });
+  });
+
+  it("refuse (403) un parent qui n'est pas une tâche racine", () => {
+    const d = decider({ ...base, parentDuParent: "tache-mere" });
+    expect(d).toMatchObject({ autorise: false, statut: 403, message: MESSAGE_DEUX_NIVEAUX_AU_PLUS });
+  });
+
+  it("refuse (403) le rattachement d'une tâche qui a déjà des sous-tâches (3e niveau)", () => {
+    const d = decider({ ...base, deplaceeADesEnfants: true });
+    expect(d).toMatchObject({ autorise: false, statut: 403, message: MESSAGE_DEUX_NIVEAUX_AU_PLUS });
+    expect(decider({ ...base, deplaceeADesEnfants: false })).toEqual({ autorise: true });
+  });
+
+  it("refuse (409) un 5e enfant ouvert, accepte le 4e", () => {
+    expect(decider({ ...base, nbOuvertes: 4 })).toMatchObject({ autorise: false, statut: 409, message: MESSAGE_MISSION_TROP_LARGE });
+    expect(decider({ ...base, nbOuvertes: 3 })).toEqual({ autorise: true });
+  });
+
+  it("une décomposition de plusieurs enfants compte tous les enfants ajoutés", () => {
+    expect(decider({ ...base, nbOuvertes: 2, nbAjoutees: 2 })).toEqual({ autorise: true });
+    expect(decider({ ...base, nbOuvertes: 2, nbAjoutees: 3 })).toMatchObject({ autorise: false, statut: 409 });
+  });
+
+  it("les enfants done ou cancelled ne sont pas comptés", () => {
+    expect(compterOuvertes(["done", "cancelled", "todo", "blocked", "in_progress", "in_review", "backlog"])).toBe(5);
+    expect(compterOuvertes(["done", "cancelled", "done", "cancelled", "todo"])).toBe(1);
+    expect(decider({ ...base, nbOuvertes: compterOuvertes(["done", "done", "cancelled", "cancelled", "todo", "todo", "todo"]) })).toEqual({ autorise: true });
+  });
+
+  it("les agents terminés ou en attente d'approbation ne sont pas des subordonnés", () => {
+    expect(compterSubordonnesActifs(["terminated", "pending_approval"])).toBe(0);
+    expect(compterSubordonnesActifs(["terminated", "idle", "paused"])).toBe(2);
+  });
+
+  it("un humain n'est jamais limité", () => {
+    expect(decider({ ...base, acteurAgent: false, nbSubordonnes: 0, parentDuParent: "x", nbOuvertes: 9 })).toEqual({ autorise: true });
+  });
+
+  it("appliquerDecision lève 403 ou 409 avec un code, et ne lève rien si autorisé", () => {
+    expect(() => appliquerDecision({ autorise: true })).not.toThrow();
+    const e403 = (() => { try { appliquerDecision(decider({ ...base, nbSubordonnes: 0 })); } catch (e) { return e as any; } })();
+    expect(e403.status).toBe(403);
+    expect(e403.details.code).toBe("atelier_specialiste_ne_delegue_pas");
+    const e409 = (() => { try { appliquerDecision(decider({ ...base, nbOuvertes: 4 })); } catch (e) { return e as any; } })();
+    expect(e409.status).toBe(409);
+    expect(e409.details.code).toBe("atelier_mission_trop_large");
+  });
+
+  it("refuserDelegationParAgent ne lit rien en base pour un humain", async () => {
+    const db = { select: () => { throw new Error("lecture inattendue"); } };
+    await expect(refuserDelegationParAgent(db as any, { actor: { type: "board" } }, { companyId: "c", parentId: "p" })).resolves.toBeUndefined();
+  });
+});

+import { open, readdir, stat } from "node:fs/promises";
+import path from "node:path";
+import { lastCostStateTotals, type ClaudeSessionTotals } from "./parse.js";
+
+const MAX_TRANSCRIPT_BYTES = 64 * 1024 * 1024;
+const FIRST_CHUNK_BYTES = 256 * 1024;
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+/** Find `<configDir>/projects/<encoded cwd>/<sessionId>.jsonl`; the newest one when several exist. */
+async function findTranscript(configDir: string, sessionId: string): Promise<string | null> {
+  const projectsDir = path.join(configDir, "projects");
+  let best: { file: string; mtimeMs: number } | null = null;
+  for (const entry of await readdir(projectsDir)) {
+    const file = path.join(projectsDir, entry, `${sessionId}.jsonl`);
+    const info = await stat(file).catch(() => null);
+    if (info?.isFile() && (!best || info.mtimeMs > best.mtimeMs)) best = { file, mtimeMs: info.mtimeMs };
+  }
+  return best?.file ?? null;
+}
+
+/**
+ * Last cost-state of a session transcript, read from the end of the file. Null when the
+ * session id is not a UUID, the file is missing, unreadable, larger than `maxBytes` or has
+ * no valid cost-state: the caller then falls back to another reference.
+ */
+export async function readTranscriptCostState(
+  configDir: string,
+  sessionId: string,
+  maxBytes = MAX_TRANSCRIPT_BYTES,
+): Promise<ClaudeSessionTotals | null> {
+  if (!configDir || !UUID_RE.test(sessionId)) return null;
+  try {
+    const file = await findTranscript(configDir, sessionId);
+    if (!file) return null;
+    const handle = await open(file, "r");
+    try {
+      const { size } = await handle.stat();
+      if (size > maxBytes) return null;
+      for (let chunk = FIRST_CHUNK_BYTES; ; chunk *= 4) {
+        const length = Math.min(chunk, size);
+        const buffer = Buffer.alloc(length);
+        await handle.read(buffer, 0, length, size - length);
+        // The first line of a partial chunk may be cut: drop it.
+        const text = buffer.toString("utf8");
+        const usable = length < size ? text.slice(text.indexOf("\n") + 1) : text;
+        const totals = lastCostStateTotals(usable, sessionId);
+        if (totals || length >= size) return totals;
+      }
+    } finally {
+      await handle.close();
+    }
+  } catch {
+    return null;
+  }
+}

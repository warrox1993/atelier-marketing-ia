+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { readTranscriptCostState } from "./session-cost.js";
+
+const SESSION = "11111111-1111-4111-8111-111111111111";
+const costState = (costUSD: number) =>
+  JSON.stringify({
+    type: "cost-state",
+    sessionId: SESSION,
+    totalCostUSD: costUSD,
+    modelUsage: { m: { inputTokens: 1, outputTokens: 2, cacheReadInputTokens: 3, cacheCreationInputTokens: 4, costUSD } },
+  });
+
+describe("readTranscriptCostState", () => {
+  let configDir: string;
+  let file: string;
+
+  beforeEach(async () => {
+    configDir = await mkdtemp(path.join(os.tmpdir(), "claude-session-cost-"));
+    await mkdir(path.join(configDir, "projects", "-a"), { recursive: true });
+    await mkdir(path.join(configDir, "projects", "-b"), { recursive: true });
+    file = path.join(configDir, "projects", "-b", `${SESSION}.jsonl`);
+  });
+
+  afterEach(async () => {
+    await rm(configDir, { recursive: true, force: true });
+  });
+
+  it("finds the transcript by session id under any project directory and reads the last cost-state", async () => {
+    await writeFile(file, `${costState(0.1)}\n{"type":"user"}\n${costState(0.2)}\n{"type":"assistant"}\n`);
+    expect((await readTranscriptCostState(configDir, SESSION))?.costUsd).toBe(0.2);
+  });
+
+  it("reads a cost-state far from the end of a large file by growing the tail window", async () => {
+    const filler = `${JSON.stringify({ type: "user", text: "x".repeat(1000) })}\n`.repeat(600);
+    await writeFile(file, `${costState(0.3)}\n${filler}`);
+    expect((await readTranscriptCostState(configDir, SESSION))?.costUsd).toBe(0.3);
+  });
+
+  it("returns null for a missing file, a non-UUID id, no cost-state or a file over the size cap", async () => {
+    expect(await readTranscriptCostState(configDir, SESSION)).toBeNull();
+    await writeFile(file, `${costState(0.1)}\n`);
+    expect(await readTranscriptCostState(configDir, "../etc/passwd")).toBeNull();
+    expect(await readTranscriptCostState(configDir, SESSION, 10)).toBeNull();
+    await writeFile(file, '{"type":"user"}\n');
+    expect(await readTranscriptCostState(configDir, SESSION)).toBeNull();
+    expect(await readTranscriptCostState(path.join(configDir, "absent"), SESSION)).toBeNull();
+  });
+});

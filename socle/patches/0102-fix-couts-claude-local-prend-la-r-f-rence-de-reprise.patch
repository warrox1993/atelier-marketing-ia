@@ -0,0 +1,233 @@
+import { mkdir, mkdtemp, rm, appendFile, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+// A scripted fake `claude` process: each call appends cost-state lines to the
+// session transcript (as Claude Code 2.1.308 does on exit, even on SIGTERM) and
+// returns the stdout the CLI would have printed.
+type FakeRun = {
+  stdout: string;
+  transcript?: string[];
+  exitCode?: number;
+  timedOut?: boolean;
+};
+const { script, seenEnvs, runAdapterExecutionTargetProcess } = vi.hoisted(() => {
+  const script: { runs: Array<() => Promise<FakeRun>> } = { runs: [] };
+  const seenEnvs: Array<Record<string, string>> = [];
+  return {
+    script,
+    seenEnvs,
+    runAdapterExecutionTargetProcess: vi.fn(
+      async (_runId: string, _target: unknown, _command: string, _args: string[], opts: { env: Record<string, string> }) => {
+        seenEnvs.push(opts.env);
+        const next = script.runs.shift();
+        if (!next) throw new Error("no scripted run left");
+        const run = await next();
+        return {
+          exitCode: run.exitCode ?? 0,
+          signal: null,
+          timedOut: run.timedOut ?? false,
+          stdout: run.stdout,
+          stderr: "",
+          pid: 123,
+          startedAt: new Date().toISOString(),
+        };
+      },
+    ),
+  };
+});
+
+vi.mock("./acp.js", () => ({
+  createClaudeAcpExecutor: () => vi.fn(),
+  resolveClaudeExecutionEngineForRun: async () => ({ engine: "cli", explicit: true }),
+}));
+
+vi.mock("@paperclipai/adapter-utils/execution-target", async () => {
+  const actual = await vi.importActual<typeof import("@paperclipai/adapter-utils/execution-target")>(
+    "@paperclipai/adapter-utils/execution-target",
+  );
+  return {
+    ...actual,
+    ensureAdapterExecutionTargetCommandResolvable: vi.fn(async () => undefined),
+    ensureAdapterExecutionTargetRuntimeCommandInstalled: vi.fn(async () => undefined),
+    resolveAdapterExecutionTargetCommandForLogs: vi.fn(async () => "claude"),
+    runAdapterExecutionTargetProcess,
+  };
+});
+
+import { execute } from "./execute.js";
+
+const SESSION = "11111111-1111-4111-8111-111111111111";
+const MODEL = "claude-haiku-5-5";
+const OTHER_MODEL = "claude-opus-5-5";
+type Usage = { inputTokens: number; outputTokens: number; cacheReadInputTokens: number; cacheCreationInputTokens: number; costUSD: number };
+const usage = (outputTokens: number, costUSD: number): Usage => ({
+  inputTokens: 2,
+  outputTokens,
+  cacheReadInputTokens: 1000,
+  cacheCreationInputTokens: 500,
+  costUSD,
+});
+const totalsOf = (modelUsage: Record<string, Usage>) => ({
+  modelUsage,
+  costUsd: Object.values(modelUsage).reduce((sum, u) => sum + u.costUSD, 0),
+});
+const R1 = { [MODEL]: usage(100, 0.1) };
+const R2 = { [MODEL]: usage(130, 0.13) };
+const R3 = { [MODEL]: usage(170, 0.17) };
+
+const costState = (modelUsage: Record<string, Usage>) =>
+  JSON.stringify({
+    type: "cost-state",
+    sessionId: SESSION,
+    totalCostUSD: totalsOf(modelUsage).costUsd,
+    modelUsage: Object.fromEntries(Object.entries(modelUsage).map(([m, u]) => [m, { ...u, thinkingTokens: 0, webSearchRequests: 0 }])),
+  });
+const resultStdout = (modelUsage: Record<string, Usage>, extra: Record<string, unknown> = {}) =>
+  [
+    JSON.stringify({ type: "system", subtype: "init", session_id: SESSION, model: MODEL }),
+    JSON.stringify({
+      type: "result",
+      subtype: "success",
+      session_id: SESSION,
+      result: "ok",
+      total_cost_usd: totalsOf(modelUsage).costUsd,
+      modelUsage,
+      ...extra,
+    }),
+  ].join("\n");
+const noResultStdout = () =>
+  [
+    JSON.stringify({ type: "system", subtype: "init", session_id: SESSION, model: MODEL }),
+    JSON.stringify({ type: "assistant", session_id: SESSION, message: { content: [{ type: "text", text: "..." }] } }),
+  ].join("\n");
+
+describe("claude_local resumed session accounting (execute wiring)", () => {
+  let root: string;
+  let configDir: string;
+  let transcript: string;
+
+  const appendTranscript = (lines: string[] = []) =>
+    appendFile(transcript, lines.map((line) => `${line}\n`).join(""), "utf8");
+
+  const buildContext = (sessionTotals: unknown, env: Record<string, string> = {}) => ({
+    runId: "run-1",
+    agent: { id: "agent-1", companyId: "company-1", name: "Claude Coder", adapterType: "claude_local", adapterConfig: {} },
+    runtime: {
+      sessionId: SESSION,
+      sessionParams: { sessionId: SESSION, cwd: root, ...(sessionTotals ? { sessionTotals } : {}) },
+      sessionDisplayId: SESSION,
+      taskKey: null,
+    },
+    config: { engine: "cli", cwd: root, env: { CLAUDE_CONFIG_DIR: configDir, ...env } },
+    context: {},
+    onLog: vi.fn(async () => {}),
+  });
+
+  beforeEach(async () => {
+    root = await mkdtemp(path.join(os.tmpdir(), "claude-resume-accounting-"));
+    configDir = path.join(root, "config");
+    const projectDir = path.join(configDir, "projects", "-some-encoded-cwd");
+    await mkdir(projectDir, { recursive: true });
+    transcript = path.join(projectDir, `${SESSION}.jsonl`);
+    await writeFile(transcript, [JSON.stringify({ type: "user" }), costState(R1)].map((l) => `${l}\n`).join(""), "utf8");
+    script.runs.length = 0;
+    seenEnvs.length = 0;
+    runAdapterExecutionTargetProcess.mockClear();
+  });
+
+  afterEach(async () => {
+    await rm(root, { recursive: true, force: true });
+  });
+
+  it("takes the reference from the transcript, not from the stale stored sessionTotals", async () => {
+    const stale = totalsOf({ [MODEL]: usage(10, 0.01) });
+    script.runs.push(async () => {
+      await appendTranscript([costState(R2)]);
+      return { stdout: resultStdout(R2) };
+    });
+    const result = await execute(buildContext(stale) as never);
+    expect(result.costUsd).toBeCloseTo(0.03, 9);
+    expect(result.usage?.outputTokens).toBe(30);
+    expect(result.usageByModel?.[0]?.costUsd).toBeCloseTo(0.03, 9);
+    expect(result.sessionParams?.sessionTotals).toEqual(totalsOf(R2));
+  });
+
+  it("falls back to the stored sessionTotals when the transcript cannot be read", async () => {
+    await rm(transcript);
+    script.runs.push(async () => ({ stdout: resultStdout(R2) }));
+    const result = await execute(buildContext(totalsOf(R1)) as never);
+    expect(result.costUsd).toBeCloseTo(0.03, 9);
+    expect(result.usage?.outputTokens).toBe(30);
+  });
+
+  it.each([
+    ["the process is cut without a result event", { exitCode: 1 }],
+    ["the run times out", { exitCode: null, timedOut: true }],
+  ])("counts a run without result by the new cost-state when %s", async (_label, outcome) => {
+    script.runs.push(async () => {
+      await appendTranscript([costState(R2)]);
+      return { stdout: noResultStdout(), ...outcome } as FakeRun;
+    });
+    const result = await execute(buildContext(totalsOf({ [MODEL]: usage(1, 0.001) })) as never);
+    expect(result.usageComplete).toBe(false);
+    expect(result.costUsd).toBeCloseTo(0.03, 9);
+    expect(result.usage?.outputTokens).toBe(30);
+    expect(result.usageByModel).toHaveLength(1);
+    expect(result.usageByModel?.[0]?.costUsd).toBeCloseTo(0.03, 9);
+  });
+
+  it("does not invent a cost for a run without result that wrote no new cost-state", async () => {
+    script.runs.push(async () => ({ stdout: noResultStdout(), exitCode: 1 }));
+    const result = await execute(buildContext(null) as never);
+    expect(result.costUsd ?? null).toBeNull();
+  });
+
+  it("does not count the first attempt again when the API key fails and the subscription retries", async () => {
+    script.runs.push(
+      async () => {
+        await appendTranscript([costState(R2)]);
+        return {
+          exitCode: 1,
+          stdout: resultStdout(R2, { is_error: true, subtype: "error_during_execution", result: "authentication_failed" }),
+        };
+      },
+      async () => {
+        await appendTranscript([costState(R3)]);
+        return { stdout: resultStdout(R3) };
+      },
+    );
+    const result = await execute(buildContext(totalsOf(R1), { ANTHROPIC_API_KEY: "sk-ant-test-key" }) as never);
+    expect(runAdapterExecutionTargetProcess).toHaveBeenCalledTimes(2);
+    expect(seenEnvs[0].ANTHROPIC_API_KEY).toBe("sk-ant-test-key");
+    expect(seenEnvs[1].ANTHROPIC_API_KEY).toBeUndefined();
+    expect(result.costUsd).toBeCloseTo(0.04, 9);
+    expect(result.usage?.outputTokens).toBe(40);
+  });
+
+  it("labels the run with its single active model and drops models whose difference is zero", async () => {
+    const before = { ...R1, [OTHER_MODEL]: usage(50, 0.5) };
+    await appendTranscript([costState(before)]);
+    const after = { ...R2, [OTHER_MODEL]: usage(50, 0.5) };
+    script.runs.push(async () => {
+      await appendTranscript([costState(after)]);
+      return { stdout: resultStdout(after) };
+    });
+    const result = await execute(buildContext(null) as never);
+    expect(result.model).toBe(MODEL);
+    expect(result.usageByModel?.map((r) => r.model)).toEqual([MODEL]);
+    expect(result.costUsd).toBeCloseTo(0.03, 9);
+  });
+
+  it("keeps the label mixed when two models really worked in the run", async () => {
+    const after = { [MODEL]: usage(130, 0.13), [OTHER_MODEL]: usage(20, 0.2) };
+    script.runs.push(async () => {
+      await appendTranscript([costState(after)]);
+      return { stdout: resultStdout(after) };
+    });
+    const result = await execute(buildContext(null) as never);
+    expect(result.model).toBe("mixed");
+    expect(result.usageByModel?.map((r) => r.model).sort()).toEqual([MODEL, OTHER_MODEL].sort());
+  });
+});

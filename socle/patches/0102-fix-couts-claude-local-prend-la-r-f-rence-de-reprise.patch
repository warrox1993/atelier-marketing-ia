+describe("cost-state transcript lines and run accounting from totals", () => {
+  const SESSION = "11111111-1111-4111-8111-111111111111";
+  const entry = (outputTokens: number, costUSD: number) => ({ inputTokens: 1, outputTokens, cacheReadInputTokens: 2, cacheCreationInputTokens: 3, costUSD, thinkingTokens: 9, webSearchRequests: 0 });
+  const line = (outputTokens: number, costUSD: number, sessionId = SESSION) =>
+    JSON.stringify({ type: "cost-state", sessionId, totalCostUSD: costUSD, modelUsage: { m: entry(outputTokens, costUSD) } });

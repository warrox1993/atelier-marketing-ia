@@ -0,0 +1,17 @@
+import { describe, expect, it } from "vitest";
+import { estVueGroupeAtelier } from "./CompanyHomeRedirect";
+
+describe("estVueGroupeAtelier", () => {
+  it("reconnaît les vues de groupe de l'atelier, pour tout préfixe d'entreprise", () => {
+    expect(estVueGroupeAtelier("/CLIA/atelier/departements")).toBe(true);
+    expect(estVueGroupeAtelier("/CLIA/atelier/organigramme")).toBe(true);
+    expect(estVueGroupeAtelier("/CLIAAAA/atelier/organigramme/")).toBe(true);
+  });
+
+  it("garde la colonne du service partout ailleurs", () => {
+    expect(estVueGroupeAtelier("/CLIA/atelier")).toBe(false);
+    expect(estVueGroupeAtelier("/CLIA/atelier/accueil")).toBe(false);
+    expect(estVueGroupeAtelier("/CLIA/atelier/departements-archives")).toBe(false);
+    expect(estVueGroupeAtelier("/CLIA/agents/organigramme")).toBe(false);
+  });
+});

+
+describe("claude execute : historique du réveil avec passation (Atelier PARC-9)", () => {
+  const message = (n: number) => ({
+    id: `hist-${String(n).padStart(2, "0")}`,
+    authorType: "user",
+    authorId: "user-1",
+    body: `Message historique numero ${String(n).padStart(2, "0")}.`,
+    createdAt: "2026-10-27T00:00:00.000Z",
+    updatedAt: "2026-10-27T00:00:00.000Z",
+    deleted: false,
+    sourceTrust: "human",
+  });
+  const wake = () => ({
+    reason: "issue_commented",
+    issue: { id: "issue-1", identifier: "PAP-902", title: "Discussion", description: null, status: "in_progress" },
+    comments: [],
+    commentWindow: { requestedCount: 0, includedCount: 0, missingCount: 0 },
+    fallbackFetchNeeded: false,
+    executionContinuation: {
+      version: 1,
+      companyId: "company-1",
+      issueId: "issue-1",
+      trigger: { reason: "issue_commented", interactionId: null, sourceRunId: null },
+      originCommentIds: [],
+      objective: "Continuer la discussion.",
+      messages: Array.from({ length: 22 }, (_v, i) => message(i + 1)),
+      interactionOutcomes: [],
+      completedWork: null,
+      unresolvedInteractionIds: [],
+      coverage: { kind: "full_task_history", throughCommentId: null, summaryThroughCommentId: null },
+    },
+  });
+
+  async function promptAvec(contexte: Record<string, unknown>): Promise<string> {
+    const root = await fs.mkdtemp(path.join(os.tmpdir(), "paperclip-claude-parc9-"));
+    const { workspace, commandPath, capturePath, restore } = await setupExecuteEnv(root);
+    try {
+      await execute({
+        runId: "run-parc9",
+        agent: { id: "agent-1", companyId: "company-1", name: "Claude", adapterType: "claude_local", adapterConfig: {} },
+        runtime: { sessionId: null, sessionParams: null, sessionDisplayId: null, taskKey: null },
+        config: { engine: "cli", command: commandPath, cwd: workspace, env: { PAPERCLIP_TEST_CAPTURE_PATH: capturePath }, promptTemplate: "Do work." },
+        context: { issueId: "issue-1", paperclipWake: wake(), ...contexte },
+        onLog: async () => {},
+      });
+      return (JSON.parse(await fs.readFile(capturePath, "utf8")) as CapturePayload).prompt;
+    } finally {
+      restore();
+      await fs.rm(root, { recursive: true, force: true });
+    }
+  }
+
+  it("22 messages et une passation : seuls les 8 derniers sont rendus, le nombre omis est dit", async () => {
+    const prompt = await promptAvec({ paperclipSessionHandoffMarkdown: "## Passation\n\nRésumé des échanges précédents." });
+    const rendus = Array.from({ length: 22 }, (_v, i) => prompt.includes(`numero ${String(i + 1).padStart(2, "0")}.`));
+    expect(rendus.filter(Boolean)).toHaveLength(8);
+    expect(rendus.slice(14).every(Boolean)).toBe(true);
+    expect(prompt).toContain("Only the latest 8 messages are listed; 14 earlier messages are omitted");
+    expect(prompt).toContain("Résumé des échanges précédents.");
+  });
+
+  it("sans passation, l'historique reste complet", async () => {
+    const prompt = await promptAvec({});
+    for (let n = 1; n <= 22; n++) expect(prompt).toContain(`numero ${String(n).padStart(2, "0")}.`);
+    expect(prompt).not.toContain("earlier messages are omitted");
+  });
+});

+
+/**
+ * H2 (revue indépendante) : conditions propres à `done` sous porte, en plus de la
+ * porte elle-même. Une tâche sous porte ne se termine que par une approbation
+ * humaine réelle : un humain authentifié, dans l'étape d'approbation native, après
+ * une décision « approuver » enregistrée dans l'atelier sur la révision courante.
+ * Fonction pure, testée.
+ */
+export function deciderClotureHumaine(faits: FaitsPorte, contexte: ContexteCloture): DecisionGarde {
+  if (!faits.porteActive) return { autorise: true, motifs: [] };
+  const motifs: string[] = [];
+  if (contexte.actorAgentId) motifs.push("un agent ne peut pas clore une tâche sous porte : l'approbation est humaine");
+  else if (!contexte.actorUserId) motifs.push("clôture sans humain authentifié");
+  if (!estEtapeApprobationEnAttente(contexte.etatExecution)) motifs.push("clôture hors de l'étape d'approbation humaine");
+  if (faits.decisionCourante?.action !== "approuver") {
+    motifs.push("aucune décision humaine « approuver » valide sur la révision courante (atelier.decision)");
+  }
+  return { autorise: motifs.length === 0, motifs };
+}

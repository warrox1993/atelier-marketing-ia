+/** Acteur et état natif de la tâche au moment d'une demande de clôture. */
+export interface ContexteCloture {
+  actorAgentId: string | null;
+  actorUserId: string | null;
+  /** État d'exécution AVANT la demande (lu sous verrou de ligne). */
+  etatExecution: unknown;

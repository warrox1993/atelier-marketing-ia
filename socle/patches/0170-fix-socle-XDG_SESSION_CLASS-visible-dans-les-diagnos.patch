diff --git a/packages/adapter-utils/src/acpx-engine/terminal-session-failure.test.ts b/packages/adapter-utils/src/acpx-engine/terminal-session-failure.test.ts
index e1fdad45b7..9daba94225 100644
--- a/packages/adapter-utils/src/acpx-engine/terminal-session-failure.test.ts
+++ b/packages/adapter-utils/src/acpx-engine/terminal-session-failure.test.ts
@@ -14,6 +14,10 @@ describe("terminal session failure diagnostics", () => {
     // Classification precedes arbitrary short-secret redaction.
     expect(sanitizeTerminalSessionFailure(failure, { SECRET: "128" }).details).not.toContain("128");
   });
+  it("AC4 : XDG_SESSION_CLASS=user reste visible dans le diagnostic", () => {
+    const details = "environnement : XDG_SESSION_CLASS=user";
+    expect(sanitizeTerminalSessionFailure({ category: "service", details }, { XDG_SESSION_CLASS: "user" }).details).toBe(details);
+  });
   it.each([
     "HTTP 503 service unavailable",
     "tool call arguments are invalid: name must be a string",

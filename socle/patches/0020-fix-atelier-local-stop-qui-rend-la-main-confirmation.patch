+import { randomUUID } from "node:crypto";
+import { eq } from "drizzle-orm";
+import { afterAll, afterEach, beforeAll, describe, expect, it } from "vitest";
+import {
+  activityLog,
+  agents,
+  companies,
+  createDb,
+  heartbeatRuns,
+  issueComments,
+  issues,
+} from "@paperclipai/db";
+import {
+  getEmbeddedPostgresTestSupport,
+  startEmbeddedPostgresTestDatabase,
+} from "./helpers/embedded-postgres.js";
+import { restoreIssueAfterOperatorRunStop } from "../services/operator-run-stop.js";
+
+const embeddedPostgresSupport = await getEmbeddedPostgresTestSupport();
+const describeEmbeddedPostgres = embeddedPostgresSupport.supported ? describe : describe.skip;
+
+describeEmbeddedPostgres("stop humain d'un passage : reprise du statut de la tâche", () => {
+  let db!: ReturnType<typeof createDb>;
+  let tempDb: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>> | null = null;
+
+  beforeAll(async () => {
+    tempDb = await startEmbeddedPostgresTestDatabase("paperclip-operator-run-stop-");
+    db = createDb(tempDb.connectionString);
+  }, 30_000);
+
+  afterEach(async () => {
+    await db.delete(issueComments);
+    await db.delete(activityLog);
+    await db.delete(heartbeatRuns);
+    await db.delete(issues);
+    await db.delete(agents);
+    await db.delete(companies);
+  });
+
+  afterAll(async () => {
+    await tempDb?.cleanup();
+  });
+
+  async function seed(options: { issueStatus?: string; previous?: string | null; otherActiveRun?: boolean }) {
+    const companyId = randomUUID();
+    const agentId = randomUUID();
+    const issueId = randomUUID();
+    const runId = randomUUID();
+    await db.insert(companies).values({
+      id: companyId,
+      name: "Stop Co",
+      issuePrefix: `S${companyId.replace(/-/g, "").slice(0, 6).toUpperCase()}`,
+      requireBoardApprovalForNewAgents: false,
+    });
+    await db.insert(agents).values({
+      id: agentId, companyId, name: "Agent", role: "engineer", status: "idle",
+      adapterType: "codex_local", adapterConfig: {}, runtimeConfig: {}, permissions: {},
+    });
+    await db.insert(issues).values({
+      id: issueId, companyId, identifier: "STP-1", title: "Tâche", status: options.issueStatus ?? "in_progress", priority: "medium",
+    });
+    await db.insert(heartbeatRuns).values({
+      id: runId, companyId, agentId, invocationSource: "assignment", triggerDetail: "system",
+      status: "cancelled", contextSnapshot: { issueId },
+    });
+    if (options.otherActiveRun) {
+      await db.insert(heartbeatRuns).values({
+        id: randomUUID(), companyId, agentId, invocationSource: "assignment", triggerDetail: "system",
+        status: "running", contextSnapshot: { issueId },
+      });
+    }
+    if (options.previous) {
+      await db.insert(activityLog).values({
+        companyId, actorType: "agent", actorId: agentId, agentId, runId,
+        action: "issue.checked_out", entityType: "issue", entityId: issueId,
+        details: { status: "in_progress", _previous: { status: options.previous } },
+      });
+    }
+    return { companyId, issueId, runId };
+  }
+
+  const statusOf = async (issueId: string) =>
+    (await db.select({ status: issues.status }).from(issues).where(eq(issues.id, issueId)))[0]?.status;
+
+  it("rend à la tâche son statut précédent et laisse un commentaire système en français", async () => {
+    const { companyId, issueId, runId } = await seed({ previous: "in_review" });
+    const result = await restoreIssueAfterOperatorRunStop(db, { id: runId, companyId, contextSnapshot: { issueId } });
+    expect(result).toEqual({ restoredStatus: "in_review" });
+    expect(await statusOf(issueId)).toBe("in_review");
+    const comments = await db.select().from(issueComments).where(eq(issueComments.issueId, issueId));
+    expect(comments).toHaveLength(1);
+    expect(comments[0]?.body).toBe("Passage arrêté par un humain : la tâche reprend son statut précédent (in_review).");
+    expect(comments[0]?.authorType).toBe("system");
+  });
+
+  it("passe en todo quand le statut précédent est inconnu", async () => {
+    const { companyId, issueId, runId } = await seed({ previous: null });
+    const result = await restoreIssueAfterOperatorRunStop(db, { id: runId, companyId, contextSnapshot: { issueId } });
+    expect(result).toEqual({ restoredStatus: "todo" });
+    expect(await statusOf(issueId)).toBe("todo");
+  });
+
+  it("ne touche pas la tâche si un autre passage est actif", async () => {
+    const { companyId, issueId, runId } = await seed({ previous: "todo", otherActiveRun: true });
+    expect(await restoreIssueAfterOperatorRunStop(db, { id: runId, companyId, contextSnapshot: { issueId } })).toBeNull();
+    expect(await statusOf(issueId)).toBe("in_progress");
+  });
+
+  it("ne touche pas une tâche qui n'est pas en cours", async () => {
+    const { companyId, issueId, runId } = await seed({ issueStatus: "done", previous: "todo" });
+    expect(await restoreIssueAfterOperatorRunStop(db, { id: runId, companyId, contextSnapshot: { issueId } })).toBeNull();
+    expect(await statusOf(issueId)).toBe("done");
+  });
+});

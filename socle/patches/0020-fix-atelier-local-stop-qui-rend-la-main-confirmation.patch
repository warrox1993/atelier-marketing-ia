@@ -0,0 +1,87 @@
+import { and, desc, eq, inArray, ne, sql } from "drizzle-orm";
+import type { Db } from "@paperclipai/db";
+import { activityLog, heartbeatRuns, issues } from "@paperclipai/db";
+import { issueService } from "./issues.js";
+
+const ACTIVE_RUN_STATUSES = ["queued", "running", "scheduled_retry"] as const;
+// Statuts qu'une tâche peut retrouver : jamais un statut terminal ni « en cours ».
+const RESTORABLE_STATUSES = new Set(["backlog", "todo", "in_review", "blocked"]);
+
+function readIssueId(context: unknown): string | null {
+  if (!context || typeof context !== "object") return null;
+  const direct = (context as Record<string, unknown>).issueId;
+  return typeof direct === "string" && direct ? direct : null;
+}
+
+// Statut qu'avait la tâche juste avant de passer « en cours », lu dans le
+// journal d'activité (champ `_previous.status` posé au checkout ou à la mise à jour).
+// On préfère l'entrée écrite par le passage arrêté, sinon la plus récente de la tâche.
+async function findStatusBeforeInProgress(db: Db, input: { companyId: string; issueId: string; runId: string }) {
+  const rows = await db
+    .select({ runId: activityLog.runId, previous: sql<string | null>`${activityLog.details} -> '_previous' ->> 'status'` })
+    .from(activityLog)
+    .where(and(
+      eq(activityLog.companyId, input.companyId),
+      eq(activityLog.entityType, "issue"),
+      eq(activityLog.entityId, input.issueId),
+      sql`${activityLog.details} ->> 'status' = 'in_progress'`,
+      sql`${activityLog.details} -> '_previous' ->> 'status' is not null`,
+      sql`${activityLog.details} -> '_previous' ->> 'status' <> 'in_progress'`,
+    ))
+    .orderBy(desc(activityLog.createdAt))
+    .limit(20);
+  const own = rows.find((row) => row.runId === input.runId && row.previous && RESTORABLE_STATUSES.has(row.previous));
+  const any = rows.find((row) => row.previous && RESTORABLE_STATUSES.has(row.previous));
+  return (own ?? any)?.previous ?? null;
+}
+
+/**
+ * Quand un humain arrête un passage, la tâche liée ne doit pas rester « en cours »
+ * sans passage actif : elle reprend son statut précédent (à défaut, `todo`).
+ * Ne fait rien si la tâche n'est pas `in_progress` ou si un autre passage est actif.
+ */
+export async function restoreIssueAfterOperatorRunStop(
+  db: Db,
+  run: { id: string; companyId: string; contextSnapshot?: unknown },
+): Promise<{ restoredStatus: string } | null> {
+  const issueId = readIssueId(run.contextSnapshot);
+  if (!issueId) return null;
+  const issue = await db
+    .select({ id: issues.id, status: issues.status })
+    .from(issues)
+    .where(and(eq(issues.id, issueId), eq(issues.companyId, run.companyId)))
+    .then((rows) => rows[0] ?? null);
+  if (!issue || issue.status !== "in_progress") return null;
+
+  const otherActive = await db
+    .select({ id: heartbeatRuns.id })
+    .from(heartbeatRuns)
+    .where(and(
+      eq(heartbeatRuns.companyId, run.companyId),
+      ne(heartbeatRuns.id, run.id),
+      inArray(heartbeatRuns.status, [...ACTIVE_RUN_STATUSES]),
+      sql`${heartbeatRuns.contextSnapshot} ->> 'issueId' = ${issueId}`,
+    ))
+    .limit(1);
+  if (otherActive.length > 0) return null;
+
+  const restoredStatus =
+    (await findStatusBeforeInProgress(db, { companyId: run.companyId, issueId, runId: run.id })) ?? "todo";
+  const updated = await db
+    .update(issues)
+    .set({ status: restoredStatus, updatedAt: new Date() })
+    .where(and(eq(issues.id, issueId), eq(issues.status, "in_progress")))
+    .returning({ id: issues.id });
+  if (updated.length === 0) return null;
+
+  await issueService(db).addComment(
+    issueId,
+    `Passage arrêté par un humain : la tâche reprend son statut précédent (${restoredStatus}).`,
+    {},
+    {
+      authorType: "system",
+      presentation: { kind: "system_notice", tone: "info", title: "Passage arrêté", density: "compact", detailsDefaultOpen: false },
+    },
+  );
+  return { restoredStatus };
+}

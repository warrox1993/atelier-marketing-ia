+// @vitest-environment jsdom
+
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ImportedPausedAgentsBanner } from "./Dashboard";
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+(globalThis as any).IS_REACT_ACT_ENVIRONMENT = true;
+
+const banner = {
+  kind: "imported" as const,
+  pausedImportedAgentIds: ["imp-0", "imp-1", "imp-2"],
+  pausedCount: 17,
+  pausedByReason: { import: 3, manual: 12, budget: 2 },
+};
+
+describe("ImportedPausedAgentsBanner", () => {
+  let container: HTMLDivElement;
+  let root: Root;
+
+  beforeEach(() => {
+    container = document.createElement("div");
+    document.body.appendChild(container);
+    root = createRoot(container);
+  });
+
+  afterEach(() => {
+    act(() => root.unmount());
+    container.remove();
+    document.body.innerHTML = "";
+  });
+
+  it("titre : tous les agents en pause avec leur motif, et pas seulement les importés", () => {
+    act(() => root.render(<ImportedPausedAgentsBanner banner={banner} resuming={false} onResume={() => {}} />));
+    expect(container.textContent).toContain(
+      "17 agents en pause (3 à l'import, 12 manuellement, 2 par le budget) : ils ne s'exécuteront pas.",
+    );
+    expect(container.textContent).not.toContain("3 agents importés sont en pause");
+    expect(container.textContent).not.toContain("Tout reprendre");
+  });
+
+  it("le bouton ouvre une confirmation : aucune reprise sans le second clic", () => {
+    const onResume = vi.fn();
+    act(() => root.render(<ImportedPausedAgentsBanner banner={banner} resuming={false} onResume={onResume} />));
+    const button = container.querySelector<HTMLButtonElement>('[data-testid="dashboard-resume-imported-agents"]');
+    expect(button?.textContent).toBe("Reprendre les 3 agents importés");
+    act(() => button!.click());
+    expect(onResume).not.toHaveBeenCalled();
+    expect(document.body.textContent).toContain("Reprendre les 3 agents importés ?");
+    expect(document.body.textContent).toContain(
+      "3 agents vont reprendre et peuvent démarrer des runs aussitôt, avec leur coût. Les agents en pause pour un autre motif restent en pause.",
+    );
+    const confirm = document.body.querySelector<HTMLButtonElement>('[data-testid="dashboard-resume-imported-agents-confirm"]');
+    expect(confirm?.textContent).toBe("Reprendre 3 agents");
+    act(() => confirm!.click());
+    expect(onResume).toHaveBeenCalledTimes(1);
+  });
+
+  it("Annuler ferme la confirmation sans rien reprendre", () => {
+    const onResume = vi.fn();
+    act(() => root.render(<ImportedPausedAgentsBanner banner={banner} resuming={false} onResume={onResume} />));
+    act(() => container.querySelector<HTMLButtonElement>('[data-testid="dashboard-resume-imported-agents"]')!.click());
+    const cancel = Array.from(document.body.querySelectorAll("button")).find((b) => b.textContent === "Annuler");
+    act(() => cancel!.click());
+    expect(onResume).not.toHaveBeenCalled();
+    expect(document.body.textContent).not.toContain("Reprendre les 3 agents importés ?");
+  });
+});

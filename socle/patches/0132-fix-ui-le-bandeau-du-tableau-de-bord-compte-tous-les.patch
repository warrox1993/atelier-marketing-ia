+/**
+ * Bandeau des agents en pause quand des agents importés attendent : le titre compte TOUS les agents en pause
+ * avec leur motif, et la reprise des agents importés passe par une confirmation (elle peut lancer des runs).
+ */
+export function ImportedPausedAgentsBanner({
+  banner,
+  resuming,
+  onResume,
+}: {
+  banner: Extract<PausedAgentBanner, { kind: "imported" }>;
+  resuming: boolean;
+  onResume: () => void;
+}) {
+  const [confirmOpen, setConfirmOpen] = useState(false);
+  const importedCount = banner.pausedImportedAgentIds.length;
+  const importedLabel = importedCount === 1 ? "l'agent importé" : `les ${importedCount} agents importés`;
+  return (
+    <>
+      <InlineBanner
+        tone="warning"
+        icon={PauseCircle}
+        title={`${banner.pausedCount} ${banner.pausedCount === 1 ? "agent en pause" : "agents en pause"} (${describePauseBreakdown(banner.pausedByReason)}) : ${banner.pausedCount === 1 ? "il ne s'exécutera pas" : "ils ne s'exécuteront pas"}.`}
+        actions={
+          <Button
+            size="sm"
+            onClick={() => setConfirmOpen(true)}
+            disabled={resuming}
+            data-testid="dashboard-resume-imported-agents"
+          >
+            {resuming ? "Reprise en cours…" : `Reprendre ${importedLabel}`}
+          </Button>
+        }
+      >
+        Les agents issus d'un import d'organisation arrivent en pause par sécurité. Reprenez-les pour que les tâches assignées puissent démarrer.
+      </InlineBanner>
+      <AlertDialog open={confirmOpen} onOpenChange={setConfirmOpen}>
+        <AlertDialogContent>
+          <AlertDialogHeader>
+            <AlertDialogTitle>{`Reprendre ${importedLabel} ?`}</AlertDialogTitle>
+            <AlertDialogDescription>
+              {importedCount === 1
+                ? "1 agent va reprendre et peut démarrer des runs aussitôt, avec leur coût. Les agents en pause pour un autre motif restent en pause."
+                : `${importedCount} agents vont reprendre et peuvent démarrer des runs aussitôt, avec leur coût. Les agents en pause pour un autre motif restent en pause.`}
+            </AlertDialogDescription>
+          </AlertDialogHeader>
+          <AlertDialogFooter>
+            <AlertDialogCancel>Annuler</AlertDialogCancel>
+            <AlertDialogAction onClick={onResume} data-testid="dashboard-resume-imported-agents-confirm">
+              {`Reprendre ${importedCount === 1 ? "1 agent" : `${importedCount} agents`}`}
+            </AlertDialogAction>
+          </AlertDialogFooter>
+        </AlertDialogContent>
+      </AlertDialog>
+    </>
+  );
+}

+vi.mock("@paperclipai/shared", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("@paperclipai/shared")>();
+  const amont = (slug: string) => !slug.startsWith(actual.ATELIER_APP_SLUG_PREFIX);
+  return {
+    ...actual,
+    CONNECTABLE_APP_DEFINITIONS: actual.CONNECTABLE_APP_DEFINITIONS.filter((app) => amont(app.slug)),
+    APP_STORE_DEFINITIONS: actual.APP_STORE_DEFINITIONS.filter((app) => amont(app.slug)),
+    getAppStoreDefinition: (slug: string) => (amont(slug) ? actual.getAppStoreDefinition(slug) : null),
+  };
+});

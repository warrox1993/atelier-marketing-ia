 =?UTF-8?q?ltat=20d'un=20outil=20de=20plugin=20et=20ne=20jamais=20renvoyer?=
 =?UTF-8?q?=20structuredContent=20null?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

La passerelle MCP lisait content et data une enveloppe trop haut : l'exécution d'un outil de plugin
rend { pluginId, toolName, result: ToolResult }. content/data valaient donc undefined et
structuredContent partait à null, que le client MCP de Claude rejette (l'agent ne recevait pas
l'identifiant du travail). Le résultat est désormais désenveloppé, structuredContent est l'objet data
ou absent, jamais null (y compris pour les outils de contexte).
---
 .../tool-gateway-structured-content.test.ts   | 54 +++++++++++++++++++
 server/src/routes/tool-gateway.ts             | 51 ++++++++++++------
 2 files changed, 89 insertions(+), 16 deletions(-)
 create mode 100644 server/src/__tests__/tool-gateway-structured-content.test.ts

diff --git a/server/src/__tests__/tool-gateway-structured-content.test.ts b/server/src/__tests__/tool-gateway-structured-content.test.ts
new file mode 100644
index 000000000..418c967ec
--- /dev/null
+++ b/server/src/__tests__/tool-gateway-structured-content.test.ts
@@ -0,0 +1,54 @@
+import express from "express";
+import request from "supertest";
+import { describe, expect, it } from "vitest";
+import { buildMcpToolCallResult, mcpGatewayProtocolRoutes } from "../routes/tool-gateway.js";
+
+describe("résultat MCP d'un outil de plugin", () => {
+  it("renvoie structuredContent objet égal à data pour un outil de plugin", () => {
+    const resultat = buildMcpToolCallResult({
+      pluginId: "atelier",
+      toolName: "fabriquer_document",
+      result: { content: "{\"travail\":\"t1\"}", data: { travail: "t1" } },
+    });
+    expect(resultat.content).toEqual([{ type: "text", text: "{\"travail\":\"t1\"}" }]);
+    expect(resultat.structuredContent).toEqual({ travail: "t1" });
+    expect(resultat.isError).toBe(false);
+  });
+
+  it("omet structuredContent quand data est absent (jamais null)", () => {
+    const resultat = buildMcpToolCallResult({
+      pluginId: "atelier",
+      toolName: "ping",
+      result: { content: "ok" },
+    });
+    expect("structuredContent" in resultat).toBe(false);
+    expect(resultat.content).toEqual([{ type: "text", text: "ok" }]);
+  });
+
+  it("omet structuredContent quand data n'est pas un objet", () => {
+    const resultat = buildMcpToolCallResult({ pluginId: "a", toolName: "b", result: { content: "x", data: [1] } });
+    expect("structuredContent" in resultat).toBe(false);
+  });
+
+  it("garde le comportement des outils d'application MCP (data objet conservé)", () => {
+    const data = { content: [], structuredContent: null, isError: false, transport: "mcp_http" };
+    const resultat = buildMcpToolCallResult({ content: "texte", data });
+    expect(resultat.structuredContent).toEqual(data);
+  });
+
+  it("de bout en bout par la route tools/call : pas de structuredContent null", async () => {
+    const passerelle = {
+      executeTool: async () => ({
+        result: { pluginId: "atelier", toolName: "x", result: { content: "ok" } },
+      }),
+    };
+    const app = express().use(express.json()).use(mcpGatewayProtocolRoutes(passerelle as never));
+    const reponse = await request(app)
+      .post("/mcp/gateways/pub")
+      .set("Authorization", "Bearer jeton")
+      .send({ jsonrpc: "2.0", id: 1, method: "tools/call", params: { name: "x", arguments: {} } });
+    expect(reponse.status).toBe(200);
+    expect(reponse.body.result.structuredContent).toBeUndefined();
+    expect(reponse.body.result.content[0].text).toBe("ok");
+  });
+});

@@ -70,6 +70,39 @@ async function discoveryRequest<T>(req: Request, res: Response, work: (signal: A
   }
 }
 
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+/**
+ * `structuredContent` MCP : objet ou absent, jamais `null` (le client MCP de Claude rejette `null`).
+ */
+function structuredContentField(value: unknown): { structuredContent?: Record<string, unknown> } {
+  return isPlainRecord(value) ? { structuredContent: value } : {};
+}
+
+/**
+ * Construit le résultat MCP d'un `tools/call` à partir du résultat brut de la passerelle.
+ * Un outil de plugin arrive enveloppé dans `{ pluginId, toolName, result: ToolResult }` :
+ * on le désenveloppe pour lire `content` et `data` du plugin.
+ */
+export function buildMcpToolCallResult(raw: unknown) {
+  let record = isPlainRecord(raw) ? raw : null;
+  const pluginEnvelope = record !== null
+    && typeof record.pluginId === "string"
+    && typeof record.toolName === "string"
+    && isPlainRecord(record.result);
+  if (pluginEnvelope) record = record!.result as Record<string, unknown>;
+  const contentText = typeof record?.content === "string"
+    ? record.content
+    : JSON.stringify(record?.data ?? raw ?? null);
+  return {
+    content: [{ type: "text", text: contentText }],
+    ...structuredContentField(record?.data),
+    isError: pluginEnvelope && typeof record?.error === "string",
+  };
+}
+
 async function handleMcpGatewayProtocol(
   req: Request,
   res: Response,
@@ -177,7 +210,7 @@ async function handleMcpGatewayProtocol(
             : {},
           callerHeaders: headers,
         });
-        res.json({ jsonrpc: "2.0", id, result: { content: [{ type: "text", text: JSON.stringify(result) }], structuredContent: result, isError: false } });
+        res.json({ jsonrpc: "2.0", id, result: { content: [{ type: "text", text: JSON.stringify(result) }], ...structuredContentField(result), isError: false } });
         return;
       }
       const result = await toolGateway.executeTool({
@@ -188,21 +221,7 @@ async function handleMcpGatewayProtocol(
         parameters: params.arguments ?? {},
         callerHeaders: req.headers,
       });
-      const resultRecord = result.result && typeof result.result === "object" && !Array.isArray(result.result)
-        ? result.result as Record<string, unknown>
-        : null;
-      const contentText = typeof resultRecord?.content === "string"

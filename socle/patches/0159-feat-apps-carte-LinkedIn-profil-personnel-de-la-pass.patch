+  "urlPatterns": [
+    "http://127.0.0.1:3190/mcp/linkedinprofil"
+  ],
+  "docsUrl": "https://learn.microsoft.com/en-us/linkedin/consumer/integrations/self-serve/share-on-linkedin",
+  "agentInstructions": {
+    "id": "atelier.linkedinprofil",
+    "version": 1,
+    "text": "Use the LinkedIn (personal profile) tool of the marketing gateway only to publish an approved post on the human's own profile. Call atelier_identite first. The gateway cannot read profile posts or statistics: never invent a figure. Publishing requires the human approval of the atelier."
+  },
+  "methods": [
+    {
+      "key": "lecture",
+      "label": "Lecture seule",
+      "transport": "mcp_remote",
+      "auth": "oauth",
+      "ownershipModes": [
+        "dcr",
+        "customer"
+      ],
+      "capabilityProfile": {
+        "key": "lecture",
+        "label": "Lecture seule",
+        "description": "Relie le profil (identité seulement) ; les agents ne publient rien."
+      },
+      "whenToUse": "Relier le profil sans permettre de publier.",
+      "defaults": {
+        "serverUrl": "http://127.0.0.1:3190/mcp/linkedinprofil",
+        "scopesHint": [
+          "openid",
+          "profile"
+        ]
+      },
+      "guidanceMd": "Connexion par la passerelle marketing de l'atelier, avec l'application LinkedIn du profil (produits Share on LinkedIn et Sign In with LinkedIn). Le jeton dure 60 jours : reconnectez ensuite.",

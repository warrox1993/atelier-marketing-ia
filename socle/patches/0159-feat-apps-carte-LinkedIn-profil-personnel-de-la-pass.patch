+        "docs": "https://learn.microsoft.com/en-us/linkedin/consumer/integrations/self-serve/share-on-linkedin"
+      },
+      "riskTier": "S2"
+    },
+    {
+      "key": "publication",
+      "label": "Publication",
+      "transport": "mcp_remote",
+      "auth": "oauth",
+      "ownershipModes": [
+        "dcr",
+        "customer"
+      ],

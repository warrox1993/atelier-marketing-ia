+        "description": "Les agents peuvent publier sur le profil, après validation humaine dans l'atelier."
+      },
+      "whenToUse": "Publier des posts sur le profil, à valider dans l'atelier.",
+      "defaults": {
+        "serverUrl": "http://127.0.0.1:3190/mcp/linkedinprofil",
+        "scopesHint": [
+          "openid",
+          "profile",
+          "w_member_social"
+        ]
+      },

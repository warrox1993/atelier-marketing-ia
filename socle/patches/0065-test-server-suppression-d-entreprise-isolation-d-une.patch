+  it("supprimer A ne modifie aucune ligne d'une entreprise B remplie de la même façon", async () => {
+    const a = await creerEntreprise("Isolation A", "A");
+    const b = await creerEntreprise("Isolation B", "B");
+    const tablesA = await remplirEntreprise(a);
+    const tablesB = await remplirEntreprise(b);
+    expect(tablesB).toEqual(tablesA);
+    const avant = await empreinte(b, tablesB);
+    // Garde-fou : l'empreinte n'est pas vide (B a bien des lignes dans chaque table).

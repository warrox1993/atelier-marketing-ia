+    await remplirEntreprise(b);
+    const ligneB = (await lignes(`select id from company_skills where company_id = '${b}' limit 1`))[0]!;
+    await lignes(`update company_skills set forked_from_company_id = '${a}' where id = '${ligneB.id}'`);
+
+    await companyService(db).remove(a);
+
+    const apres = await lignes(`select id, company_id, forked_from_company_id from company_skills where id = '${ligneB.id}'`);

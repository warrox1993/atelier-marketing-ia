+  /** Empreinte d'une entreprise : pour chaque table, nombre de lignes et md5 des lignes triées. */
+  const empreinte = async (companyId: string, tables: string[]): Promise<Record<string, string>> => {
+    const res: Record<string, string> = {};
+    for (const table of [...tables, "companies"]) {
+      const colonne = table === "companies" ? "id" : "company_id";
+      const r = await lignes(`select count(*)::int as n, coalesce(md5(string_agg(t::text, '|' order by t::text)), '') as h
+        from "${table}" t where t."${colonne}" = '${companyId}'`);
+      res[table] = `${r[0]!.n}:${r[0]!.h}`;
+    }
+    return res;
+  };

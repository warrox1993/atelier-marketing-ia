diff --git a/server/src/services/heartbeat.ts b/server/src/services/heartbeat.ts
index f879cdcad..06270a822 100644
--- a/server/src/services/heartbeat.ts
+++ b/server/src/services/heartbeat.ts
@@ -2,7 +2,7 @@ import { retryIdempotentDatabaseOperation } from "../database-retry.js";
 import { prepareConnectionInstructionDelivery } from "./connection-instructions.js";
 import { resolveAssignedConnectionInstructionsForRun } from "./native-runtime/assigned-mcp-tools.js";
 import { externalObjectService } from "./external-objects.js";
-import { isAiAuthenticationBlocked } from "./ai-auth-failure.js";
+import { aiBindingForAuthRecovery, isAiAuthenticationBlocked } from "./ai-auth-failure.js";
 import { CHAT_COMPLETION_WAKE_REASON, prepareChatCompletionTurn, chatCompletionInstruction, isCompletedOnboardingHandoffWake } from "./chat-completion-delivery.js";
 import { AgentDirectoryReuseInvalidatedError, isAgentDirectoryCopy } from "./agent-directory-working-copies.js";
 
@@ -18507,8 +18507,17 @@ export function heartbeatService(
     // A succeeded run, or one stopped by its turn limit, made authenticated
     // provider calls: earlier AI reconnection cards of this agent are stale.
     if (run.status === "succeeded" || run.errorCode === "max_turns_exhausted") {
-      await issueThreadInteractionService(db).expireAiConnectionIntentsAfterHealthyRun({
-        companyId: run.companyId, agentId: run.agentId, healthySince: run.startedAt ?? run.createdAt,
+      // Only a card for the provider this run really used is stale; when the
+      // provider cannot be determined, nothing is expired.
+      const usedProvider = await (async () => {
+        const saved = parseObject(run.contextSnapshot?.aiConnection);
+        if (typeof saved.provider === "string" && saved.provider) return saved.provider;
+        const [agent] = await db.select({ adapterType: agents.adapterType, adapterConfig: agents.adapterConfig })
+          .from(agents).where(eq(agents.id, run.agentId)).limit(1);
+        return agent ? aiBindingForAuthRecovery(agent.adapterType, parseObject(agent.adapterConfig))?.provider ?? null : null;
+      })().catch(() => null);
+      if (usedProvider) await issueThreadInteractionService(db).expireAiConnectionIntentsAfterHealthyRun({
+        companyId: run.companyId, agentId: run.agentId, healthySince: run.startedAt ?? run.createdAt, provider: usedProvider,
       }).catch(() => {
         logger.warn({ runId: run.id }, "Could not expire stale AI connection requests after a healthy run");
       });
diff --git a/server/src/services/issue-thread-interactions.ts b/server/src/services/issue-thread-interactions.ts

     expect(expired.map((row) => row.id)).toEqual([card!.interactionId]);
     const [row] = await db.select().from(issueThreadInteractions).where(eq(issueThreadInteractions.id, card!.interactionId!));
     expect(row).toMatchObject({ status: "expired", result: { version: 1, outcome: "expired", reason: expect.stringContaining("Connexion rétablie") } });
@@ -222,6 +222,22 @@ describe("managed AI connections", () => {
     const [other] = await db.select().from(issueThreadInteractions).where(eq(issueThreadInteractions.id, otherCard.id));
     expect(other.status).toBe("pending");
   });
+
+  it.each([
+    ["même fournisseur et phase requested : la carte expire", "anthropic", "requested", "anthropic", "expired"],
+    ["autre fournisseur : la carte reste", "openai", "requested", "anthropic", "pending"],
+    ["phase authorizing : la carte reste", "anthropic", "authorizing", "anthropic", "pending"],
+  ])("expiration après passage sain : %s", async (_libelle, serviceSlug, phase, provider, attendu) => {
+    const id = randomUUID();
+    const issueId = randomUUID();
+    await db.insert(agents).values({ id, companyId, name: "Filtre carte", adapterType: "claude_local" });
+    await db.insert(issues).values({ id: issueId, companyId, title: "Filtre carte", status: "in_progress", assigneeAgentId: id });
+    const [card] = await db.insert(issueThreadInteractions).values({ companyId, issueId, kind: "connection_intent", status: "pending",
+      createdByAgentId: id, addresseeUserId: "alice", payload: { version: 1, purpose: "ai", phase, serviceSlug, serviceName: serviceSlug } }).returning();
+    await issueThreadInteractionService(db).expireAiConnectionIntentsAfterHealthyRun({ companyId, agentId: id, healthySince: new Date(Date.now() + 1000), provider });
+    const [row] = await db.select().from(issueThreadInteractions).where(eq(issueThreadInteractions.id, card.id));
+    expect(row.status).toBe(attendu);
+  });
   it.each([
     ["anthropic", "claude_local", "CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY"],

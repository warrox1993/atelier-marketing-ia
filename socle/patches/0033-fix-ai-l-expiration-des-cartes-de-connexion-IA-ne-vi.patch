     const interactions = issueThreadInteractionService(db);
     // A run that started before the card was raised proves nothing about it.
-    expect(await interactions.expireAiConnectionIntentsAfterHealthyRun({ companyId, agentId: id, healthySince: new Date(Date.now() - 60_000) })).toEqual([]);
-    const expired = await interactions.expireAiConnectionIntentsAfterHealthyRun({ companyId, agentId: id, healthySince: new Date(Date.now() + 1000) });

@@ -4726,7 +4726,11 @@ export function issueThreadInteractionService(
     // A later run of the same agent completed with a working AI connection, so
     // its pending AI reconnection cards are stale. Only cards created before
     // that run started are expired: a card raised during or after it stays.
-    expireAiConnectionIntentsAfterHealthyRun: async (input: { companyId: string; agentId: string; healthySince: Date }) => {
+    // Only a card of the provider the healthy run used, still in phase
+    // "requested", is stale: another provider's card is a real outage, and an
+    // "authorizing" card is a human mid-way through OAuth.
+    expireAiConnectionIntentsAfterHealthyRun: async (input: { companyId: string; agentId: string; healthySince: Date; provider: string }) => {
+      if (!input.provider) return [];
       const resolvedAt = now();
       const expired = await db.update(issueThreadInteractions).set({
         status: "expired",
@@ -4738,6 +4742,8 @@ export function issueThreadInteractionService(
         eq(issueThreadInteractions.kind, "connection_intent"),
         eq(issueThreadInteractions.status, "pending"),
         sql`${issueThreadInteractions.payload}->>'purpose' = 'ai'`,
+        sql`${issueThreadInteractions.payload}->>'phase' = 'requested'`,
+        sql`${issueThreadInteractions.payload}->>'serviceSlug' = ${input.provider}`,
         sql`${issueThreadInteractions.createdAt} < ${input.healthySince.toISOString()}::timestamptz`,
       )).returning();
       if (expired.length) {

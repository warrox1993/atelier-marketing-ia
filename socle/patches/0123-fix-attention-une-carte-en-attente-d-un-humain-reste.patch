+      // Atelier Marketing IA (HUM-C3) : les cartes en attente d'un humain comptent dans la boîte, quel que soit leur âge.
+      // shortcut: une carte adressée à un agent en pause n'est pas comptée ici (elle l'est dans /attention), à aligner si besoin.
+      const currentUserId = extra?.currentUserId ?? null;
+      const pendingHumanCards = await db
+        .select({ id: issueThreadInteractions.id })

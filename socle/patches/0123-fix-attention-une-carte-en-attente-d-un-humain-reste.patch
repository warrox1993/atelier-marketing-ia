+/**
+ * Atelier Marketing IA (HUM-C3) : une carte en attente d'un humain reste dans les badges
+ * après le jour de sa pose (badge du bureau /attention et total de la boîte de réception).
+ */
+import { randomUUID } from "node:crypto";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { agents, companies, createDb, issues, issueThreadInteractions } from "@paperclipai/db";
+import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
+import { attentionService } from "../services/attention.js";
+import { sidebarBadgeService } from "../services/sidebar-badges.js";
+
+const support = await getEmbeddedPostgresTestSupport();
+
+(support.supported ? describe : describe.skip)("badges : cartes en attente (Atelier HUM-C3)", () => {
+  let base: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>>;
+  let db: ReturnType<typeof createDb>;
+
+  beforeAll(async () => {
+    base = await startEmbeddedPostgresTestDatabase("paperclip-atelier-badges-");
+    db = createDb(base.connectionString);
+  }, 30_000);
+
+  afterAll(async () => {
+    await base?.cleanup();
+  });
+
+  it("compte une carte posée la veille dans deskBadgeCount et dans la boîte", async () => {
+    const companyId = randomUUID();
+    const agentId = randomUUID();
+    const issueId = randomUUID();
+    const hier = new Date(Date.now() - 36 * 60 * 60_000);
+    await db.insert(companies).values({ id: companyId, name: "Badges", issuePrefix: `B${companyId.replace(/-/g, "").slice(0, 6).toUpperCase()}` });
+    await db.insert(agents).values({ id: agentId, companyId, name: "Redacteur", role: "engineer", status: "idle", adapterType: "claude_local", adapterConfig: {}, runtimeConfig: {} });
+    await db.insert(issues).values({ id: issueId, companyId, title: "Liste finale", status: "in_review", priority: "medium", assigneeAgentId: agentId, createdAt: hier, updatedAt: hier });
+    await db.insert(issueThreadInteractions).values([
+      { companyId, issueId, kind: "request_confirmation", status: "pending", title: "Valider la liste", payload: { version: 1, prompt: "Valider ?" }, createdAt: hier, updatedAt: hier },
+      // Adressée à un agent actif ou déjà tranchée : jamais comptée.
+      { companyId, issueId, kind: "ask_user_questions", status: "pending", addresseeAgentId: agentId, title: "Question à l'agent", payload: { version: 1, questions: [] }, createdAt: hier, updatedAt: hier },
+      { companyId, issueId, kind: "request_confirmation", status: "accepted", title: "Déjà tranchée", payload: { version: 1, prompt: "Ok ?" }, createdAt: hier, updatedAt: hier },
+    ]);
+
+    const feed = await attentionService(db).list(companyId, { userId: "board-user", sort: "decide", limit: 20 });
+    const cartes = feed.items.filter((item) => item.sourceKind === "issue_thread_interaction");
+    expect(cartes).toHaveLength(1);
+    expect(feed.deskBadgeCount).toBeGreaterThanOrEqual(1);
+    expect(feed.deskBadgeCount).toBe(feed.items.filter((item) => item.sourceKind === "issue_thread_interaction" || Date.parse(item.createdAt) >= new Date().setUTCHours(0, 0, 0, 0)).length);
+
+    const badges = await sidebarBadgeService(db).get(companyId, { currentUserId: "board-user" });
+    expect(badges.inbox).toBe(1);
+    expect(badges.approvals).toBe(0);
+  }, 30_000);
+});

+/**
+ * Atelier Marketing IA (patch local 0014) : escalier d'effort au dispatch.
+ * Décision pure (crans, plafond, modèle jamais touché) et lecture des refus
+ * contre une vraie base PostgreSQL embarquée.
+ */
+import { randomUUID } from "node:crypto";
+import { sql } from "drizzle-orm";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { createDb, pluginDatabaseNamespaces, plugins } from "@paperclipai/db";
+import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
+import {
+  appliquerEffortRun,
+  compterRefusDepuisAcceptation,
+  compterRevisionsRefusees,
+  decideEffortRun,
+  messageEffortReleve,
+  type EntreeDecisionEffort,
+} from "../atelier/effort-run.js";
+
+function entree(champs: Partial<EntreeDecisionEffort> & { config?: Record<string, unknown> } = {}): EntreeDecisionEffort {
+  const { config, ...reste } = champs;
+  return {
+    adapterType: "claude_local",
+    adapterConfig: config ?? { model: "claude-sonnet-5-5", effort: "medium" },
+    refus: 1,
+    estProducteur: true,
+    ...reste,
+  };
+}
+
+function effortApres(e: EntreeDecisionEffort): unknown {
+  return appliquerEffortRun(e.adapterConfig, decideEffortRun(e)).effort;
+}
+
+describe("escalier d'effort : décision", () => {
+  it("monte d'un cran par refus et plafonne à max", () => {
+    const attendu = ["medium", "high", "xhigh", "max", "max", "max"];
+    for (let refus = 0; refus < attendu.length; refus++) {
+      expect(effortApres(entree({ refus })), `refus=${refus}`).toBe(attendu[refus]);
+    }
+  });
+
+  it("part d'une base high : high → xhigh → max", () => {
+    const config = { model: "claude-opus-5-5", effort: "high" };
+    expect(effortApres(entree({ config, refus: 0 }))).toBe("high");
+    expect(effortApres(entree({ config, refus: 1 }))).toBe("xhigh");
+    expect(effortApres(entree({ config, refus: 2 }))).toBe("max");
+    expect(effortApres(entree({ config, refus: 7 }))).toBe("max");
+    const auPlafond = decideEffortRun(entree({ config: { model: "claude-opus-5-5", effort: "max" }, refus: 3 }));
+    expect(auPlafond).toMatchObject({ applique: true, effort: "max", releve: false });
+  });
+
+  it("base absente = medium", () => {
+    const d = decideEffortRun(entree({ config: { model: "claude-sonnet-5-5" }, refus: 1 }));
+    expect(d).toMatchObject({ applique: true, base: "medium", baseExplicite: false, effort: "high", releve: true });
+  });
+
+  it("revient à la base quand aucun refus ne suit la dernière acceptation", () => {
+    const config = { model: "claude-sonnet-5-5", effort: "medium" };
+    const d = decideEffortRun(entree({ config, refus: 0 }));
+    expect(d.applique).toBe(false);
+    expect(appliquerEffortRun(config, d)).toBe(config);
+  });
+
+  it("ne change jamais le modèle et ne produit jamais fable", () => {
+    for (const modele of ["claude-sonnet-5-5", "claude-opus-5-5", "claude-opus-4-6", "claude-sonnet-4-5", ""]) {
+      for (let refus = 0; refus <= 6; refus++) {
+        const config: Record<string, unknown> = modele ? { model: modele, effort: "medium", maxTurnsPerRun: 30 } : { effort: "medium" };
+        const decision = decideEffortRun(entree({ config, refus }));
+        expect(Object.keys(decision)).not.toContain("model");
+        const resultat = appliquerEffortRun(config, decision);
+        expect(resultat.model).toBe(config.model);
+        expect({ ...resultat, effort: undefined }).toEqual({ ...config, effort: undefined });
+        expect(JSON.stringify(resultat)).not.toMatch(/fable/i);
+      }
+    }
+  });
+
+  it("respecte l'échelle propre au modèle (pas de xhigh sur un modèle qui ne l'a pas)", () => {
+    const config = { model: "claude-opus-4-6", effort: "high" };
+    expect(effortApres(entree({ config, refus: 1 }))).toBe("max");
+    expect(effortApres(entree({ config: { model: "claude-sonnet-4-5", effort: "medium" }, refus: 5 }))).toBe("high");
+  });
+
+  it("ignore Haiku, l'adaptateur process, les autres adaptateurs, les tâches hors porte et les non-producteurs", () => {
+    expect(decideEffortRun(entree({ config: { model: "claude-haiku-4-5", effort: "low" }, refus: 3 })).applique).toBe(false);
+    expect(decideEffortRun(entree({ adapterType: "process", config: { effort: "medium" }, refus: 3 })).applique).toBe(false);
+    expect(decideEffortRun(entree({ adapterType: "codex_local", refus: 3 })).applique).toBe(false);
+    expect(decideEffortRun(entree({ refus: null })).applique).toBe(false);
+    expect(decideEffortRun(entree({ estProducteur: false, refus: 3 })).applique).toBe(false);
+    expect(decideEffortRun(entree({ config: { model: "claude-sonnet-5-5", effort: "turbo" }, refus: 3 })).applique).toBe(false);
+  });
+
+  it("compte les révisions distinctes refusées, comme les cycles du plugin", () => {
+    const r1 = randomUUID();
+    const r2 = randomUUID();
+    const r3 = randomUUID();
+    expect(compterRevisionsRefusees([
+      { origine: "verdict", revisionId: r1, motifs: null },
+      { origine: "porte", revisionId: r1, motifs: [{ code: "exigence_non_couverte" }] },
+      { origine: "porte", revisionId: r2, motifs: [{ code: "revue_requise_absente" }] },
+      { origine: "porte", revisionId: r3, motifs: [{ code: "revue_sur_ancienne_version" }, { code: "preuve_absente" }] },
+      { origine: "porte", revisionId: null, motifs: [{ code: "preuve_absente" }] },
+    ])).toBe(2);
+  });
+
+  it("annonce le relèvement sans parler de modèle choisi", () => {
+    expect(messageEffortReleve("high")).toBe("Effort relevé à high après refus de la porte ou de la revue (modèle inchangé).");
+  });
+});
+
+const support = await getEmbeddedPostgresTestSupport();
+const NS = "plugin_atelier_effort_test";
+
+(support.supported ? describe : describe.skip)("escalier d'effort : lecture des refus en base", () => {
+  let base: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>>;
+  let db: ReturnType<typeof createDb>;
+
+  beforeAll(async () => {
+    base = await startEmbeddedPostgresTestDatabase("paperclip-atelier-effort-");
+    db = createDb(base.connectionString);
+  }, 30_000);
+
+  afterAll(async () => {
+    await base?.cleanup();
+  });
+
+  it("renvoie null sans plugin, puis compte les refus depuis le dernier PASS", async () => {
+    const issueId = randomUUID();
+    expect(await compterRefusDepuisAcceptation(db, issueId)).toBeNull();
+
+    const pluginId = randomUUID();
+    await db.insert(plugins).values({ id: pluginId, pluginKey: "atelier.marketing-ia", packageName: "@atelier/plugin-atelier", version: "0.1.0", manifestJson: {} as never, status: "ready" });
+    await db.insert(pluginDatabaseNamespaces).values({ pluginId, pluginKey: "atelier.marketing-ia", namespaceName: NS, status: "active" });
+    for (const ddl of [
+      `create schema ${NS}`,
+      `create table ${NS}.portes (issue_id uuid primary key, actif boolean not null default true)`,
+      `create table ${NS}.evaluations_porte (id uuid primary key, issue_id uuid not null, revision_id uuid, decision text not null, motifs jsonb not null default '[]'::jsonb, cree_le timestamptz not null default clock_timestamp())`,
+      `create table ${NS}.verdicts (id uuid primary key, issue_id uuid not null, revision_id uuid not null, verdict text not null, cree_le timestamptz not null default clock_timestamp())`,
+    ]) await db.execute(sql.raw(ddl));
+
+    // Tâche hors porte : aucun escalier.
+    expect(await compterRefusDepuisAcceptation(db, issueId)).toBeNull();
+    await db.execute(sql.raw(`insert into ${NS}.portes (issue_id) values ('${issueId}')`));
+    expect(await compterRefusDepuisAcceptation(db, issueId)).toBe(0);
+
+    const [v1, v2, v3, v4] = [randomUUID(), randomUUID(), randomUUID(), randomUUID()];
+    const refusPorte = (rev: string, code: string) =>
+      db.execute(sql.raw(`insert into ${NS}.evaluations_porte (id, issue_id, revision_id, decision, motifs) values ('${randomUUID()}', '${issueId}', '${rev}', 'REFUS', '[{"code":"${code}"}]')`));
+    const verdict = (rev: string, v: string) =>
+      db.execute(sql.raw(`insert into ${NS}.verdicts (id, issue_id, revision_id, verdict) values ('${randomUUID()}', '${issueId}', '${rev}', '${v}')`));
+
+    await verdict(v1, "CHANGES_REQUESTED");
+    await refusPorte(v1, "exigence_non_couverte"); // même révision : un seul cran
+    await refusPorte(v2, "revue_requise_absente"); // motif sans cycle : ne compte pas
+    await verdict(v2, "PASS");
+    expect(await compterRefusDepuisAcceptation(db, issueId)).toBe(1);
+    await refusPorte(v2, "preuve_absente");
+    expect(await compterRefusDepuisAcceptation(db, issueId)).toBe(2);
+
+    // Acceptation : retour à la base.
+    await db.execute(sql.raw(`insert into ${NS}.evaluations_porte (id, issue_id, revision_id, decision) values ('${randomUUID()}', '${issueId}', '${v3}', 'PASS')`));
+    expect(await compterRefusDepuisAcceptation(db, issueId)).toBe(0);
+    await verdict(v4, "CHANGES_REQUESTED");
+    expect(await compterRefusDepuisAcceptation(db, issueId)).toBe(1);
+
+    // Porte désactivée : plus d'escalier.
+    await db.execute(sql.raw(`update ${NS}.portes set actif = false where issue_id = '${issueId}'`));
+    expect(await compterRefusDepuisAcceptation(db, issueId)).toBeNull();
+  }, 30_000);
+});

diff --git a/server/src/atelier/effort-run.ts b/server/src/atelier/effort-run.ts
new file mode 100644
index 000000000..6d0a001d2
--- /dev/null
+++ b/server/src/atelier/effort-run.ts
@@ -0,0 +1,144 @@
+/**
+ * Atelier Marketing IA (patch local 0014, non amont) : escalier d'effort au dispatch.
+ *
+ * Quand le livrable d'une tâche sous porte est refusé (revue CHANGES_REQUESTED ou refus
+ * de porte sur le fond), le run suivant du producteur travaille un cran plus fort :
+ *   effort effectif = effort de base de l'agent + 1 cran par révision refusée
+ *   depuis la dernière évaluation PASS de la tâche, plafonné au dernier niveau du modèle.
+ * Base absente = `medium`. Après un PASS, le compteur repart de zéro : retour à la base.
+ *
+ * Règles fixes :
+ *  - seul l'effort change, JAMAIS le modèle (aucune clé `model` n'est produite) ;
+ *  - seulement l'adaptateur `claude_local`, seulement l'agent assigné à la tâche ;
+ *  - Haiku (pas de niveau d'effort) et l'adaptateur `process` sont ignorés ;
+ *  - l'effort relevé vit dans la configuration du run, jamais dans `agents.adapter_config`.
+ *
+ * Les refus comptés sont ceux qui consomment un cycle de correction dans le plugin
+ * (plugin-atelier/src/serveur/services.ts `revisionsRefusees`, porte.ts `refusDeFond`) :
+ * révisions DISTINCTES ayant reçu un verdict CHANGES_REQUESTED ou un REFUS de porte
+ * portant au moins un motif de fond.
+ */
+import { sql } from "drizzle-orm";
+import { claudeLocalReasoningEffortsForModel } from "@paperclipai/adapter-claude-local";
+import { lignes, schemaAtelier, tableAtelier, type ExecuteurSql } from "./espace-atelier.js";
+
+export const ECHELLE_EFFORT = ["low", "medium", "high", "xhigh", "max"] as const;
+export type NiveauEffort = (typeof ECHELLE_EFFORT)[number];
+export const EFFORT_BASE_PAR_DEFAUT: NiveauEffort = "medium";
+
+/** Copie de `MOTIFS_SANS_CYCLE` du plugin (porte.ts) : motifs qui ne disent rien du fond. */
+export const MOTIFS_SANS_CYCLE: ReadonlySet<string> = new Set(["revue_requise_absente", "revue_sur_ancienne_version", "cycles_epuises"]);
+
+export interface RefusLu {
+  origine: "verdict" | "porte";
+  revisionId: string | null;
+  /** Motifs de l'évaluation de porte (null pour un verdict de revue). */
+  motifs: unknown;
+}
+
+/** Un refus de porte consomme-t-il un cycle ? Même règle que `refusDeFond` du plugin. */
+export function refusDeFond(motifs: unknown): boolean {
+  if (!Array.isArray(motifs)) return false;
+  return motifs.some((m) => {
+    const code = m && typeof m === "object" ? (m as { code?: unknown }).code : undefined;
+    return !MOTIFS_SANS_CYCLE.has(typeof code === "string" ? code : "");
+  });
+}
+
+/** Nombre de révisions distinctes refusées parmi les refus lus. Fonction pure. */
+export function compterRevisionsRefusees(refus: readonly RefusLu[]): number {
+  const revisions = new Set<string>();
+  for (const r of refus) {
+    if (!r.revisionId) continue;
+    if (r.origine === "verdict" || refusDeFond(r.motifs)) revisions.add(r.revisionId);
+  }
+  return revisions.size;
+}
+
+/**
+ * Révisions refusées depuis la dernière évaluation PASS de la tâche.
+ * null : plugin absent, tâche hors porte ou porte inactive (aucun escalier).
+ * La comparaison des dates est faite par PostgreSQL (précision microseconde).
+ */
+export async function compterRefusDepuisAcceptation(executeur: ExecuteurSql, issueId: string): Promise<number | null> {
+  const schema = await schemaAtelier(executeur);
+  if (!schema) return null;
+  const portes = tableAtelier(schema, "portes");
+  const porte = lignes<{ actif: boolean }>(
+    await executeur.execute(sql`select actif from ${portes} where issue_id = ${issueId} limit 1`),
+  )[0];
+  if (!porte?.actif) return null;
+  const evaluations = tableAtelier(schema, "evaluations_porte");
+  const verdicts = tableAtelier(schema, "verdicts");
+  const rangs = lignes<{ origine: "verdict" | "porte"; revision_id: string | null; motifs: unknown }>(
+    await executeur.execute(sql`with dernier_pass as (
+        select max(cree_le) as le from ${evaluations} where issue_id = ${issueId} and decision = 'PASS'
+      )
+      select 'verdict' as origine, v.revision_id::text as revision_id, null::jsonb as motifs
+        from ${verdicts} v, dernier_pass p
+        where v.issue_id = ${issueId} and v.verdict = 'CHANGES_REQUESTED' and (p.le is null or v.cree_le > p.le)
+      union all
+      select 'porte' as origine, e.revision_id::text as revision_id, e.motifs
+        from ${evaluations} e, dernier_pass p
+        where e.issue_id = ${issueId} and e.decision = 'REFUS' and e.revision_id is not null and (p.le is null or e.cree_le > p.le)`),
+  );
+  return compterRevisionsRefusees(rangs.map((r) => ({ origine: r.origine, revisionId: r.revision_id, motifs: r.motifs })));
+}
+
+export interface EntreeDecisionEffort {
+  adapterType: string;
+  /** Configuration effective du run (après surcharges de la tâche). */
+  adapterConfig: Record<string, unknown>;
+  /** Révisions refusées depuis la dernière acceptation ; null = tâche hors porte. */
+  refus: number | null;
+  /** L'agent du run est-il l'assigné (le producteur) de la tâche ? */
+  estProducteur: boolean;
+}
+
+export type DecisionEffort =
+  | { applique: false; raison: string }
+  | {
+      applique: true;
+      effort: NiveauEffort;
+      base: NiveauEffort;
+      baseExplicite: boolean;
+      refus: number;
+      plafond: NiveauEffort;
+      /** L'effort transmis diffère de l'effort configuré. */
+      releve: boolean;
+    };
+
+function niveauxDuModele(modele: string): NiveauEffort[] | null {
+  if (!modele) return [...ECHELLE_EFFORT];
+  const niveaux = claudeLocalReasoningEffortsForModel(modele);
+  return ECHELLE_EFFORT.filter((n) => niveaux.includes(n));
+}
+
+/** Décide l'effort du run. Ne produit jamais de modèle. Fonction pure. */
+export function decideEffortRun(entree: EntreeDecisionEffort): DecisionEffort {
+  if (entree.adapterType !== "claude_local") return { applique: false, raison: `adaptateur ${entree.adapterType} non concerné` };
+  if (!entree.estProducteur) return { applique: false, raison: "l'agent n'est pas le producteur de la tâche" };
+  if (entree.refus === null) return { applique: false, raison: "tâche hors porte" };
+  if (!Number.isInteger(entree.refus) || entree.refus <= 0) return { applique: false, raison: "aucun refus depuis la dernière acceptation" };
+  const modele = typeof entree.adapterConfig.model === "string" ? entree.adapterConfig.model.trim() : "";
+  if (/haiku/i.test(modele)) return { applique: false, raison: "modèle Haiku : pas de niveau d'effort" };
+  const niveaux = niveauxDuModele(modele);
+  if (!niveaux || niveaux.length === 0) return { applique: false, raison: `modèle ${modele} : pas de niveau d'effort` };
+  const brut = typeof entree.adapterConfig.effort === "string" ? entree.adapterConfig.effort.trim() : "";
+  const base = (brut || EFFORT_BASE_PAR_DEFAUT) as NiveauEffort;
+  const indexBase = niveaux.indexOf(base);
+  if (indexBase < 0) return { applique: false, raison: `effort de base « ${brut} » hors de l'échelle du modèle` };
+  const plafond = niveaux[niveaux.length - 1]!;
+  const effort = niveaux[Math.min(indexBase + entree.refus, niveaux.length - 1)]!;
+  return { applique: true, effort, base, baseExplicite: brut !== "", refus: entree.refus, plafond, releve: effort !== brut };
+}
+
+/** Configuration du run avec l'effort décidé : seule la clé `effort` change. */
+export function appliquerEffortRun(config: Record<string, unknown>, decision: DecisionEffort): Record<string, unknown> {
+  if (!decision.applique) return config;
+  return { ...config, effort: decision.effort };
+}
+
+export function messageEffortReleve(effort: NiveauEffort): string {
+  return `Effort relevé à ${effort} après refus de la porte ou de la revue (modèle inchangé).`;
+}
diff --git a/server/src/atelier/garde-modele-agent.ts b/server/src/atelier/garde-modele-agent.ts
new file mode 100644
index 000000000..a4fa349f3
--- /dev/null
+++ b/server/src/atelier/garde-modele-agent.ts
@@ -0,0 +1,62 @@
+/**
+ * Atelier Marketing IA (patch local 0014, non amont) : un agent ne choisit ni son modèle
+ * ni son effort, ni ceux d'un autre agent.
+ *
+ * Paperclip laisse un agent modifier SA propre configuration sans autorisation
+ * (authorization.ts « allow_self ») et celle des autres avec `agents:configure` ;
+ * essai réel du 15/10 : un agent a changé l'effort d'un autre agent et le sien (HTTP 200).
+ * Le modèle et l'effort sont des décisions humaines (le board) ; l'escalier d'effort
+ * automatique du socle (effort-run.ts) ne passe pas par ces routes.
+ *
+ * Surfaces gardées (acteur `agent` seulement, les humains gardent le droit) :
+ *  - PATCH /agents/:id, comparé sur la configuration FINALE (fusion, remplacement,
+ *    changement d'adaptateur compris) ;
+ *  - POST /agents/:id/config-revisions/:revisionId/rollback ;
+ *  - `assigneeAdapterOverrides.adapterConfig` des routes de tâches (création, enfant,
+ *    décomposition de plan accepté, PATCH).
+ */
+import { forbidden } from "../errors.js";
+
+/**
+ * Clés qui choisissent le modèle ou son niveau de raisonnement, tous adaptateurs :
+ * `model`, `effort` (claude_local), `modelReasoningEffort` (codex_local),
+ * `reasoningEffort`, `thinking`, `variant` (grok, pi, kimi, opencode).
+ */
+export const CLES_MODELE_EFFORT = ["model", "effort", "modelReasoningEffort", "reasoningEffort", "thinking", "variant"] as const;
+
+function enregistrement(valeur: unknown): Record<string, unknown> {
+  return valeur && typeof valeur === "object" && !Array.isArray(valeur) ? (valeur as Record<string, unknown>) : {};
+}
+
+function normaliser(valeur: unknown): string {
+  if (valeur === undefined || valeur === null || valeur === "") return "";
+  return JSON.stringify(valeur);
+}
+
+/** Clés de modèle ou d'effort dont la valeur diffère entre deux configurations. Fonction pure. */
+export function clesModeleEffortModifiees(avant: unknown, apres: unknown): string[] {
+  const a = enregistrement(avant);
+  const b = enregistrement(apres);
+  return CLES_MODELE_EFFORT.filter((cle) => normaliser(a[cle]) !== normaliser(b[cle]));
+}
+
+/**
+ * Chemins de modèle ou d'effort que modifie un corps de tâche portant
+ * `assigneeAdapterOverrides`. `existant` : surcharges actuelles de la tâche (PATCH),
+ * absent pour une création. Corps sans le champ : aucune modification. Fonction pure.
+ */
+export function cheminsSurchargeModeleEffort(corps: unknown, existant?: unknown): string[] {
+  const c = enregistrement(corps);
+  if (!Object.prototype.hasOwnProperty.call(c, "assigneeAdapterOverrides") || c.assigneeAdapterOverrides === undefined) return [];
+  const apres = enregistrement(enregistrement(c.assigneeAdapterOverrides).adapterConfig);
+  const avant = enregistrement(enregistrement(existant).adapterConfig);
+  return clesModeleEffortModifiees(avant, apres).map((cle) => `assigneeAdapterOverrides.adapterConfig.${cle}`);
+}
+
+/** 403 si un acteur agent modifie un modèle ou un effort ; sans effet pour un humain. */
+export function refuserModeleEffortParAgent(req: { actor: { type: string } }, chemins: readonly string[]): void {
+  if (req.actor.type !== "agent" || chemins.length === 0) return;
+  throw forbidden(
+    `Un agent ne peut pas changer de modèle ni d'effort (${chemins.join(", ")}) : décision humaine (atelier).`,
+  );
+}

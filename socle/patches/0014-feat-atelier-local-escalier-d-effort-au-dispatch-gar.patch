+/**
+ * Atelier Marketing IA (patch local 0014) : fonctions pures de la garde
+ * « un agent ne change ni modèle ni effort ». Les routes sont testées dans
+ * agent-permissions-routes.test.ts et issue-workspace-command-authz.test.ts.
+ */
+import { describe, expect, it } from "vitest";
+import { cheminsSurchargeModeleEffort, clesModeleEffortModifiees, refuserModeleEffortParAgent } from "../atelier/garde-modele-agent.js";
+
+describe("garde modèle et effort", () => {
+  it("repère les clés de modèle et d'effort modifiées, ajoutées ou retirées", () => {
+    expect(clesModeleEffortModifiees({ model: "a", effort: "medium" }, { model: "a", effort: "medium", maxTurnsPerRun: 3 })).toEqual([]);
+    expect(clesModeleEffortModifiees({ model: "a", effort: "medium" }, { model: "b", effort: "high" })).toEqual(["model", "effort"]);
+    expect(clesModeleEffortModifiees({ model: "a" }, {})).toEqual(["model"]);
+    expect(clesModeleEffortModifiees({}, { modelReasoningEffort: "high", variant: "x" })).toEqual(["modelReasoningEffort", "variant"]);
+    expect(clesModeleEffortModifiees({ effort: "" }, {})).toEqual([]);
+    expect(clesModeleEffortModifiees(null, undefined)).toEqual([]);
+  });
+
+  it("lit les surcharges de tâche (création, enfant de décomposition, PATCH)", () => {
+    expect(cheminsSurchargeModeleEffort({ title: "x" })).toEqual([]);
+    expect(cheminsSurchargeModeleEffort({ assigneeAdapterOverrides: { useProjectWorkspace: true } })).toEqual([]);
+    expect(cheminsSurchargeModeleEffort({ assigneeAdapterOverrides: { adapterConfig: { effort: "max" } } }))
+      .toEqual(["assigneeAdapterOverrides.adapterConfig.effort"]);
+    const existant = { adapterConfig: { model: "claude-opus-5-5" } };
+    expect(cheminsSurchargeModeleEffort({ assigneeAdapterOverrides: { adapterConfig: { model: "claude-opus-5-5" } } }, existant)).toEqual([]);
+    expect(cheminsSurchargeModeleEffort({ assigneeAdapterOverrides: null }, existant)).toEqual(["assigneeAdapterOverrides.adapterConfig.model"]);
+    expect(cheminsSurchargeModeleEffort({}, existant)).toEqual([]);
+  });
+
+  it("refuse un agent (403) et laisse passer un humain", () => {
+    expect(() => refuserModeleEffortParAgent({ actor: { type: "agent" } }, ["adapterConfig.effort"])).toThrow(/modèle ni d'effort/);
+    try {
+      refuserModeleEffortParAgent({ actor: { type: "agent" } }, ["adapterConfig.effort"]);
+    } catch (err) {
+      expect((err as { status?: number }).status).toBe(403);
+    }
+    expect(() => refuserModeleEffortParAgent({ actor: { type: "board" } }, ["adapterConfig.effort"])).not.toThrow();
+    expect(() => refuserModeleEffortParAgent({ actor: { type: "agent" } }, [])).not.toThrow();
+  });

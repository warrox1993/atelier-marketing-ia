+/**
+ * Libellés français des statuts bruts d'exécution (`lastRun.status`, statut
+ * d'une exécution d'agent). Les clés sont les valeurs stockées : on ne traduit
+ * que l'affichage. Table à part de `LIBELLES_VALEURS`, car « cancelled » et
+ * « running » s'accordent ici avec « exécution » (féminin).
+ */
+export const LIBELLES_STATUTS_EXECUTION: Record<string, string> = {
+  queued: "en file",
+  running: "en cours",
+  succeeded: "réussie",
+  failed: "échouée",
+  cancelled: "annulée",
+  canceled: "annulée",
+  timed_out: "expirée",
+  scheduled_retry: "nouvel essai planifié",
+  paused: "en pause",
+  skipped: "ignorée",
+  coalesced: "regroupée",
+  received: "reçue",
+  issue_created: "tâche créée",
+  completed: "terminée",
+  error: "en erreur",
+};
+
+/** Affichage d'un statut brut d'exécution ; repli lisible pour une valeur inconnue. */
+export function humanizeRunStatus(value: unknown): string {
+  if (typeof value !== "string" || value.length === 0) return "inconnu";
+  return LIBELLES_STATUTS_EXECUTION[value] ?? humanizeValue(value);
+}
+
 export function humanizeValue(value: unknown): string {
   if (typeof value !== "string") return String(value ?? "aucun");
   return LIBELLES_VALEURS[value] ?? value.replace(/_/g, " ");

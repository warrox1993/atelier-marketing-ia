+// @vitest-environment jsdom
+
+import { type ReactNode } from "react";
+import { flushSync } from "react-dom";
+import { createRoot } from "react-dom/client";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { MobileBottomNav } from "./MobileBottomNav";
+
+const mockNavigate = vi.hoisted(() => vi.fn());
+const mockOpenNewIssue = vi.hoisted(() => vi.fn());
+const mockPluginsApi = vi.hoisted(() => ({ listUiContributions: vi.fn() }));
+const mockInboxBadge = vi.hoisted(() => ({ inbox: 0, failedRuns: 0 }));
+
+vi.mock("../api/plugins", () => ({ pluginsApi: mockPluginsApi }));
+
+vi.mock("@/lib/router", () => ({
+  useNavigate: () => mockNavigate,
+  useLocation: () => ({ pathname: "/" }),
+  NavLink: ({ to, children, className, ...props }: {
+    to: string;
+    children: ReactNode | ((state: { isActive: boolean }) => ReactNode);
+    className?: string | ((state: { isActive: boolean }) => string);
+  }) => (
+    <a
+      href={to}
+      className={typeof className === "function" ? className({ isActive: false }) : className}
+      {...props}
+    >
+      {typeof children === "function" ? children({ isActive: false }) : children}
+    </a>
+  ),
+}));
+
+vi.mock("../context/DialogContext", () => ({
+  useDialogActions: () => ({ openNewIssue: mockOpenNewIssue }),
+}));
+
+vi.mock("../context/CompanyContext", () => ({
+  useCompany: () => ({ selectedCompanyId: "company-1" }),
+}));
+
+vi.mock("../hooks/useInboxBadge", () => ({ useInboxBadge: () => mockInboxBadge }));
+vi.mock("@/hooks/useAgentChatEnabled", () => ({ useAgentChatEnabled: () => ({ enabled: false }) }));
+vi.mock("@/hooks/useCombinedInboxTasksEnabled", () => ({
+  useCombinedInboxTasksEnabled: () => ({ enabled: false }),
+}));
+
+const contributionAtelier = {
+  pluginId: "p1",
+  pluginKey: "atelier.marketing-ia",
+  displayName: "Atelier marketing",
+  version: "1.0.0",
+  uiEntryFile: "index.js",
+  slots: [{ type: "page", id: "atelier-page", displayName: "Atelier marketing", exportName: "Page", routePath: "atelier" }],
+  launchers: [],
+};
+
+async function flushReact() {
+  for (let index = 0; index < 5; index += 1) {
+    await Promise.resolve();
+    await new Promise((resolve) => window.setTimeout(resolve, 0));
+  }
+  flushSync(() => {});
+}
+
+describe("MobileBottomNav", () => {
+  let container: HTMLDivElement;
+
+  async function rendre(visible = true) {
+    const root = createRoot(container);
+    const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+    flushSync(() => {
+      root.render(
+        <QueryClientProvider client={queryClient}>
+          <MobileBottomNav visible={visible} />
+        </QueryClientProvider>,
+      );
+    });
+    await flushReact();
+    return root;
+  }
+
+  const libelles = () =>
+    [...container.querySelectorAll("nav span.leading-tight")].map((el) => el.textContent?.trim());
+  const boutonNouvelleTache = () =>
+    [...container.querySelectorAll("button")].find((b) => b.textContent?.trim() === "Nouvelle tâche") as HTMLButtonElement;
+
+  beforeEach(() => {
+    container = document.createElement("div");
+    document.body.appendChild(container);
+    mockPluginsApi.listUiContributions.mockResolvedValue([]);
+  });
+
+  afterEach(() => {
+    document.body.innerHTML = "";
+    vi.clearAllMocks();
+  });
+
+  it("sans l'atelier : Accueil mène au tableau de bord et Nouvelle tâche ouvre le dialogue", async () => {
+    const root = await rendre();
+    expect(libelles()).toEqual(["Accueil", "Tâches", "Nouvelle tâche", "Agents", "Boîte"]);
+    expect(container.querySelector('a[href="/dashboard"]')).not.toBeNull();
+    expect(container.querySelector('a[href="/atelier"]')).toBeNull();
+    boutonNouvelleTache().click();
+    expect(mockOpenNewIssue).toHaveBeenCalledTimes(1);
+    expect(mockNavigate).not.toHaveBeenCalled();
+    flushSync(() => root.unmount());
+  });
+
+  it("avec l'atelier : Atelier remplace Accueil et Nouvelle tâche ouvre la Discussion", async () => {
+    mockPluginsApi.listUiContributions.mockResolvedValue([contributionAtelier]);
+    const root = await rendre();
+    expect(libelles()).toEqual(["Atelier", "Tâches", "Nouvelle tâche", "Agents", "Boîte"]);
+    expect(container.querySelector('a[href="/atelier"]')).not.toBeNull();
+    expect(container.querySelector('a[href="/dashboard"]')).toBeNull();
+    boutonNouvelleTache().click();
+    expect(mockNavigate).toHaveBeenCalledWith("/atelier/discussion");
+    expect(mockOpenNewIssue).not.toHaveBeenCalled();
+    flushSync(() => root.unmount());
+  });
+
+  it("garde le libellé complet de la boîte de réception pour les lecteurs d'écran", async () => {
+    const root = await rendre();
+    expect(container.querySelector('a[aria-label="Boîte de réception"]')).not.toBeNull();
+    flushSync(() => root.unmount());
+  });
+
+  it("étiquettes à 12 px minimum (text-xs, plus de text-nano)", async () => {
+    const root = await rendre();
+    const nav = container.querySelector("nav") as HTMLElement;
+    expect(nav.innerHTML).not.toContain("text-nano");
+    expect(nav.querySelectorAll("a.text-xs, button.text-xs").length).toBe(5);
+    flushSync(() => root.unmount());
+  });
+
+  it("barre masquée (data-visible=false) et inerte quand visible est faux", async () => {
+    const root = await rendre(false);
+    const nav = container.querySelector("nav") as HTMLElement;
+    expect(nav.getAttribute("data-visible")).toBe("false");
+    expect(nav.hasAttribute("inert")).toBe(true);
+    flushSync(() => root.unmount());
+  });
+});

diff --git a/server/src/__tests__/atelier-reservation-connexions.test.ts b/server/src/__tests__/atelier-reservation-connexions.test.ts
new file mode 100644
index 0000000000..2187f9e0b1
--- /dev/null
+++ b/server/src/__tests__/atelier-reservation-connexions.test.ts
@@ -0,0 +1,121 @@
+/**
+ * Atelier Marketing IA (patch local 0153, DOC-A1 et AFA-SEC-3) : la réservation d'une connexion aux rôles qui la
+ * déclarent (profil `app:<connexion>` lié aux agents, installations) doit tenir à l'exécution. Le grant large
+ * tools:use, posé sans portée sur chaque agent standard (agent-hiring), ne rouvre pas un outil de connexion
+ * qu'aucun profil effectif ne permet, ni par la passerelle du run (`paperclip-assigned`) ni par une session.
+ * Les outils sans connexion (plugins, Paperclip) gardent le grant ; un grant qui nomme la connexion aussi.
+ */
+import { randomUUID } from "node:crypto";
+import { and, eq } from "drizzle-orm";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import {
+  agents, companies, createDb, heartbeatRuns, principalPermissionGrants, toolApplications, toolCatalogEntries,
+  toolConnectionInstalls, toolConnections, toolMcpGateways, toolPolicies, toolProfileBindings, toolProfileEntries,
+  toolProfiles,
+} from "@paperclipai/db";
+import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "./helpers/embedded-postgres.js";
+import { buildPaperclipRuntimeMcpServers } from "../services/heartbeat.js";
+import { toolAccessPolicyService } from "../services/tool-access-policy.js";
+
+const support = await getEmbeddedPostgresTestSupport();
+const decrireAvecBase = support.supported ? describe : describe.skip;
+
+decrireAvecBase("atelier : réservation des connexions par rôle à l'exécution", () => {
+  let db!: ReturnType<typeof createDb>;
+  let cleanup: (() => Promise<void>) | undefined;
+  const apiAvant = process.env.PAPERCLIP_API_URL;
+  const companyId = randomUUID();
+  let lecteur!: typeof agents.$inferSelect, redacteur!: typeof agents.$inferSelect;
+  let runLecteur!: string, passerelleLecteur!: string;
+  let xLire!: typeof toolCatalogEntries.$inferSelect, yLire!: typeof toolCatalogEntries.$inferSelect;
+  let yEcrire!: typeof toolCatalogEntries.$inferSelect;
+
+  beforeAll(async () => {
+    process.env.PAPERCLIP_API_URL = "https://paperclip.example.test";
+    const started = await startEmbeddedPostgresTestDatabase("atelier-reservation-connexions");
+    db = createDb(started.connectionString);
+    cleanup = started.cleanup;
+    await db.insert(companies).values({ id: companyId, name: "Atelier connexions", issuePrefix: `AC${companyId.slice(0, 6).toUpperCase()}` });
+    [lecteur, redacteur] = await db.insert(agents).values([
+      { companyId, name: "Veille", role: "researcher", adapterType: "claude_local", adapterConfig: {} },
+      { companyId, name: "Contenus", role: "general", adapterType: "claude_local", adapterConfig: {} },
+    ]).returning() as [typeof agents.$inferSelect, typeof agents.$inferSelect];
+    // Comme agent-hiring (NEW_STANDARD_AGENT_DEFAULT_GRANT_KEYS) : tools:use sans portée.
+    await db.insert(principalPermissionGrants).values([lecteur, redacteur].map(agent => ({
+      companyId, principalType: "agent" as const, principalId: agent.id, permissionKey: "tools:use", scope: null,
+    })));
+    const [application] = await db.insert(toolApplications).values({
+      companyId, applicationKey: "atelier-passerelle", name: "Passerelle", type: "mcp_http", status: "active",
+    }).returning();
+    const [x, y] = await db.insert(toolConnections).values(["x", "y"].map(nom => ({
+      companyId, applicationId: application!.id, name: `atelier-${nom}`, uid: `test/${randomUUID()}`,
+      transport: "mcp_remote" as const, status: "active" as const, enabled: true, config: { url: `https://${nom}.example.test/mcp` },
+    }))).returning();
+    const entree = (connexion: typeof x, nom: string) => ({
+      companyId, applicationId: application!.id, connectionId: connexion!.id, name: nom, toolName: nom, versionHash: "fixture", status: "active" as const,
+    });
+    [xLire, yLire, yEcrire] = await db.insert(toolCatalogEntries).values([entree(x, "x_lire"), entree(y, "y_lire"), entree(y, "y_ecrire")]).returning() as
+      [typeof toolCatalogEntries.$inferSelect, typeof toolCatalogEntries.$inferSelect, typeof toolCatalogEntries.$inferSelect];
+    // Réservation posée par bootstrap-organisation.py assurer_connexions : profil app:<connexion> lié aux seuls
+    // agents des rôles déclarés, installations identiques. Ici : X au lecteur, Y au rédacteur.
+    for (const [connexion, agent] of [[x, lecteur], [y, redacteur]] as const) {
+      const [profil] = await db.insert(toolProfiles).values({
+        companyId, profileKey: `app:${connexion!.id}`, name: connexion!.name, defaultAction: "deny",
+        metadata: { source: "app_gallery_finish", connectionId: connexion!.id },
+      }).returning();
+      await db.insert(toolProfileEntries).values({
+        companyId, profileId: profil!.id, selectorType: "connection", effect: "include", applicationId: application!.id, connectionId: connexion!.id,
+      });
+      await db.insert(toolProfileBindings).values({ companyId, profileId: profil!.id, targetType: "agent", targetId: agent.id });
+      await db.insert(toolConnectionInstalls).values({ companyId, connectionId: connexion!.id, targetType: "agent", targetId: agent.id });
+    }
+    // « Ask first » d'une écriture de Y, comme le finish de la galerie (sans condition d'acteur).
+    await db.insert(toolPolicies).values({
+      companyId, name: "Ask first y_ecrire", policyType: "require_approval", selectors: { catalogEntryId: yEcrire.id },
+      config: { source: "app_gallery_finish" },
+    });
+    const [run] = await db.insert(heartbeatRuns).values({ companyId, agentId: lecteur.id, invocationSource: "assignment", status: "running", contextSnapshot: {} }).returning();
+    runLecteur = run!.id;
+    expect(await buildPaperclipRuntimeMcpServers({ db, agent: lecteur, runId: runLecteur })).toHaveLength(1);
+    const [passerelle] = await db.select().from(toolMcpGateways).where(eq(toolMcpGateways.agentId, lecteur.id));
+    passerelleLecteur = passerelle!.id;
+  }, 60_000);
+
+  afterAll(async () => {
+    if (apiAvant === undefined) delete process.env.PAPERCLIP_API_URL; else process.env.PAPERCLIP_API_URL = apiAvant;
+    await cleanup?.();
+  });
+
+  const decider = (agent: typeof agents.$inferSelect, outil: { connectionId: string | null; id?: string; toolName: string },
+    contexte: { runId?: string; passerelle?: string } = {}, providerType?: string) =>
+    toolAccessPolicyService(db).decide({
+      companyId,
+      actor: { actorType: "agent", actorId: agent.id, agentId: agent.id },
+      runContext: { heartbeatRunId: contexte.runId ?? null, gatewayId: contexte.passerelle ?? null },
+      request: { connectionId: outil.connectionId, catalogEntryId: outil.id ?? null, toolName: outil.toolName, providerType: providerType ?? null, arguments: {} },
+    });
+  const parPasserelle = () => ({ runId: runLecteur, passerelle: passerelleLecteur });
+
+  it("refuse au rôle non réservé l'outil d'une autre connexion, par sa passerelle de run comme par une session", async () => {
+    await expect(decider(lecteur, yLire, parPasserelle())).resolves.toMatchObject({ allowed: false, decision: "deny" });
+    await expect(decider(lecteur, yLire, { runId: runLecteur })).resolves.toMatchObject({ allowed: false, decision: "deny" });
+  });
+
+  it("refuse aussi l'écriture « Ask first » d'une connexion non réservée au lieu de l'exécuter sans accord", async () => {
+    await expect(decider(lecteur, yEcrire, parPasserelle())).resolves.toMatchObject({ allowed: false, decision: "deny" });
+    await expect(decider(redacteur, yEcrire)).resolves.toMatchObject({ allowed: false, decision: "require_approval" });
+  });
+
+  it("laisse passer la connexion réservée et les outils sans connexion (plugins, Paperclip)", async () => {
+    await expect(decider(lecteur, xLire, parPasserelle())).resolves.toMatchObject({ allowed: true });
+    await expect(decider(redacteur, yLire)).resolves.toMatchObject({ allowed: true });
+    await expect(decider(lecteur, { connectionId: null, toolName: "atelier_marketing-ia:fabriquer_document" }, parPasserelle(), "paperclip_plugin"))
+      .resolves.toMatchObject({ allowed: true, reasonCode: "allow_explicit_grant" });
+  });
+
+  it("un grant qui nomme la connexion reste une décision humaine explicite et l'ouvre", async () => {
+    await db.update(principalPermissionGrants).set({ scope: { connectionId: yLire.connectionId } })
+      .where(and(eq(principalPermissionGrants.principalId, lecteur.id), eq(principalPermissionGrants.permissionKey, "tools:use")));
+    await expect(decider(lecteur, yLire, { runId: runLecteur })).resolves.toMatchObject({ allowed: true, reasonCode: "allow_explicit_grant" });
+  });
+});

     expect(getWorkspaceRestoreDiagnostic(error)).toEqual({ phase: "workspace", step: "index_reset", errorCode: "unknown", exitCode: 128 });
   });
 
+  describe("sondes « pas un dépôt » indépendantes de la langue de l'hôte", () => {
+    async function plainDirectory() {
+      const rootDir = await mkdtemp(path.join(os.tmpdir(), "paperclip-git-locale-"));
+      cleanupDirs.push(rootDir);
+      const plainDir = path.join(rootDir, "plain");
+      await mkdir(plainDir, { recursive: true });
+      return plainDir;
+    }
+    // Annule l'indépendance de l'hôte posée ailleurs : le processus testé tourne en français.
+    function frenchHost() {
+      vi.stubEnv("LC_ALL", "fr_BE.UTF-8");
+      vi.stubEnv("LANG", "fr_BE.UTF-8");
+      vi.stubEnv("LANGUAGE", "fr");
+    }
+    afterEach(() => { vi.unstubAllEnvs(); });
+
+    it("AC1 : le scan d'un dossier sans git conclut « pas un dépôt » même avec git en français", async () => {
+      const plainDir = await plainDirectory();
+      frenchHost();
+      await expect(readRawSnapshot(plainDir, false)).resolves.toBeNull();
+    });
+
+    it("AC1 : la lecture des chemins ignorés d'un dossier sans git conclut « pas un dépôt » même avec git en français", async () => {
+      const plainDir = await plainDirectory();
+      frenchHost();
+      await expect(readReferencedSourceGitIgnoredPaths(plainDir)).resolves.toBeNull();
+    });
+
+    it("AC3 : une configuration git corrompue reste une panne dans les deux sondes", async () => {
+      const rootDir = await mkdtemp(path.join(os.tmpdir(), "paperclip-git-corrupt-"));
+      cleanupDirs.push(rootDir);
+      const repo = path.join(rootDir, "repo");
+      await mkdir(repo, { recursive: true });
+      await git(repo, ["init"]);
+      await writeFile(path.join(repo, ".git", "config"), "[core\n garbage\n", "utf8");
+      frenchHost();
+      await expect(readRawSnapshot(repo, false)).rejects.toBeDefined();
+      await expect(readReferencedSourceGitIgnoredPaths(repo)).rejects.toBeDefined();
+    });
+  });
+
   describe("readReferencedSourceGitIgnoredPaths", () => {

@@ -94,6 +94,14 @@ function shellQuote(value: string) {
   return `'${value.replace(/'/g, `'\"'\"'`)}'`;
 }
 
+/**
+ * Environment for Git calls whose stderr decides "not a repository" versus a
+ * real failure: Git's messages are translated, so force the stable English ones.
+ */
+function withStableGitLocale(env: NodeJS.ProcessEnv): NodeJS.ProcessEnv {
+  return { ...env, LC_ALL: "C", LANGUAGE: "" };
+}
+
 export async function runLocalGit(
   localDir: string,
   args: string[],
@@ -177,6 +185,7 @@ export async function readGitWorkspaceSnapshot(localDir: string, includeReposito
     insideWorkTree = await runLocalGit(localDir, ["rev-parse", "--is-inside-work-tree"], {
       timeout: 10_000,
       maxBuffer: 16 * 1024,
+      env: withStableGitLocale(process.env),
     });
   } catch (error) {
     if (repositories.length === 0 && isNotAGitRepositoryError(error)) return null;
@@ -314,7 +323,7 @@ function buildHardenedGitEnv(): NodeJS.ProcessEnv {
   }
   env.GIT_CONFIG_NOSYSTEM = "1";
   env.GIT_CONFIG_GLOBAL = "/dev/null";
-  return env;
+  return withStableGitLocale(env);
 }
 

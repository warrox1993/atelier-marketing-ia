+  it("ne compte pas un renvoi en attente d'information comme un tour (atelier)", () => {
+    const result = applyIssueExecutionPolicyTransition({
+      issue: reviewPendingIssue({}, { changesRequestedCount: 2 }),
+      policy,
+      requestedStatus: "in_progress",
+      requestedAssigneePatch: {},
+      actor: { agentId: qaAgentId },
+      commentBody: "Contrôle impossible : outil indisponible",
+      awaitingInformation: true,
+    });
+
+    // Au plafond moins un : un vrai renvoi escaladerait ; celui-ci retourne au producteur.
+    expect(result.decision).toMatchObject({ outcome: "changes_requested" });
+    expect(result.patch.status).toBe("in_progress");
+    expect(result.patch.assigneeAgentId).toBe(coderAgentId);
+    expect(result.patch.executionState).toMatchObject({
+      status: "changes_requested",
+      changesRequestedCount: 2,
+    });
+  });
+
+  it("compte toujours un vrai renvoi quand le drapeau est absent ou faux (atelier)", () => {
+    const result = applyIssueExecutionPolicyTransition({
+      issue: reviewPendingIssue({}, { changesRequestedCount: 1 }),
+      policy,
+      requestedStatus: "in_progress",
+      requestedAssigneePatch: {},
+      actor: { agentId: qaAgentId },
+      commentBody: "Défaut de qualité",
+      awaitingInformation: false,
+    });
+
+    expect(result.patch.executionState).toMatchObject({
+      status: "changes_requested",
+      changesRequestedCount: 2,
+    });
+  });
+

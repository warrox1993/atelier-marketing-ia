diff --git a/ui/src/components/MobileBottomNav.test.tsx b/ui/src/components/MobileBottomNav.test.tsx
index f30938ab8..deb5375eb 100644
--- a/ui/src/components/MobileBottomNav.test.tsx
+++ b/ui/src/components/MobileBottomNav.test.tsx
@@ -118,15 +118,15 @@ describe("MobileBottomNav", () => {
     flushSync(() => root.unmount());
   });
 
-  it("avec l'atelier : une seule barre, Atelier, Tâches, Coordinateur, Boîte, Menu", async () => {
+  it("avec l'atelier : une seule barre, Atelier, Tâches, Discuter, Boîte, Menu", async () => {
     mockPluginsApi.listUiContributions.mockResolvedValue([contributionAtelier]);
     const root = await rendre();
-    expect(libelles()).toEqual(["Atelier", "Tâches", "Coordinateur", "Boîte", "Menu"]);
+    expect(libelles()).toEqual(["Atelier", "Tâches", "Discuter", "Boîte", "Menu"]);
     const hrefs = [...container.querySelectorAll("nav a")].map((a) => a.getAttribute("href"));
     expect(hrefs).toEqual(["/atelier", "/issues", "/inbox", "/dashboard"]);
     expect(new Set(hrefs).size).toBe(hrefs.length);
     expect(container.querySelector('a[aria-label="Menu : tableau de bord"]')).not.toBeNull();
-    ([...container.querySelectorAll("button")].find((b) => b.textContent?.trim() === "Coordinateur") as HTMLButtonElement).click();
+    ([...container.querySelectorAll("button")].find((b) => b.textContent?.trim() === "Discuter") as HTMLButtonElement).click();
     expect(mockNavigate).toHaveBeenCalledWith("/atelier/discussion");
     expect(mockOpenNewIssue).not.toHaveBeenCalled();
     flushSync(() => root.unmount());
diff --git a/ui/src/components/MobileBottomNav.tsx b/ui/src/components/MobileBottomNav.tsx

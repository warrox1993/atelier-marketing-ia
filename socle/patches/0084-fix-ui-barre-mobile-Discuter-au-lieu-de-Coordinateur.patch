-  // « Nouvelle tâche » ouvre la Discussion de l'atelier quand il est prêt, sous le nom « Coordinateur » (comme la barre latérale).
+  // « Nouvelle tâche » ouvre la Discussion de l'atelier quand il est prêt, sous le nom « Discuter » (« Coordinateur » se coupait sur deux lignes à 390 px) (comme la barre latérale).
   const nouvelleTache = useMemo<MobileNavActionItem>(
     () => ({
       type: "action",
-      label: atelierPret ? "Coordinateur" : "Nouvelle tâche",
+      label: atelierPret ? "Discuter" : "Nouvelle tâche",
       icon: atelierPret ? MessagesSquare : SquarePen,
       onClick: () => (atelierPret ? navigate(`/${CHEMIN_PAGE_ATELIER}/discussion`) : openNewIssue()),
     }),

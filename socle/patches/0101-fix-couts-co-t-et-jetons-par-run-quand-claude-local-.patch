+    expect(readClaudeSessionTotals(bad((t) => { t.modelUsage.m.inputTokens = "3"; }))).toBeNull();
+    expect(readClaudeSessionTotals({ modelUsage: totals.modelUsage, costUsd: Number.POSITIVE_INFINITY })).toBeNull();
+    expect(readClaudeSessionTotals(null)).toBeNull();

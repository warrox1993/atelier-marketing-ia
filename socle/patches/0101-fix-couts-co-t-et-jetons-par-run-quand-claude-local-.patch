+const USAGE_FIELDS = ["inputTokens", "outputTokens", "cacheReadInputTokens", "cacheCreationInputTokens", "costUSD"] as const;
+const MAX_SESSION_TOTALS_MODELS = 20;
+const MAX_MODEL_KEY_LENGTH = 200;
+
+/** Raw cumulative totals of a Claude Code session, as reported by the last result event. */
+export interface ClaudeSessionTotals {
+  modelUsage: Record<string, Record<(typeof USAGE_FIELDS)[number], number>>;
+  costUsd: number;
+}
+
+/** The totals of the session a run resumes; only valid for a result of that same session. */
+export interface ClaudeSessionBaseline {
+  sessionId: string;
+  totals: ClaudeSessionTotals;
+}
+
+const isNonNegativeFinite = (value: unknown): value is number =>
+  typeof value === "number" && Number.isFinite(value) && value >= 0;
+
+/** Validate untrusted session params; null when anything is missing, negative or oversized. */
+export function readClaudeSessionTotals(raw: unknown): ClaudeSessionTotals | null {
+  const record = parseObject(raw);
+  if (!isNonNegativeFinite(record.costUsd)) return null;
+  const models = Object.entries(parseObject(record.modelUsage));
+  if (models.length === 0 || models.length > MAX_SESSION_TOTALS_MODELS) return null;
+  const modelUsage: ClaudeSessionTotals["modelUsage"] = {};
+  for (const [model, value] of models) {
+    if (model.length > MAX_MODEL_KEY_LENGTH) return null;
+    const entry = parseObject(value);
+    const copy = {} as ClaudeSessionTotals["modelUsage"][string];
+    for (const field of USAGE_FIELDS) {
+      if (!isNonNegativeFinite(entry[field])) return null;
+      copy[field] = entry[field];
+    }
+    modelUsage[model] = copy;
+  }
+  return { modelUsage, costUsd: record.costUsd };
+}
+
+/**
+ * Per-run view of a cumulative result: subtract the reference totals field by
+ * field and model by model (a model absent from the reference keeps its values).
+ * A negative difference means the session was reset: keep the raw values.
+ */
+function subtractSessionTotals(
+  modelUsage: Record<string, unknown>,
+  costUsd: number | null,
+  reference: ClaudeSessionTotals,
+): { modelUsage: Record<string, unknown>; costUsd: number | null } | null {
+  const delta: Record<string, unknown> = {};
+  for (const [model, raw] of Object.entries(modelUsage)) {
+    const entry = parseObject(raw);
+    const before = reference.modelUsage[model];
+    if (!before) {
+      delta[model] = entry;
+      continue;
+    }
+    const next: Record<string, unknown> = { ...entry };
+    for (const field of USAGE_FIELDS) {
+      if (typeof entry[field] !== "number") continue;
+      const diff = entry[field] - before[field];
+      if (diff < 0) return null;
+      next[field] = diff;
+    }
+    delta[model] = next;
+  }
+  if (costUsd === null) return { modelUsage: delta, costUsd };
+  const costDiff = costUsd - reference.costUsd;
+  return costDiff < 0 ? null : { modelUsage: delta, costUsd: costDiff };
+}
+
+export function parseClaudeStreamJson(stdout: string, baseline?: ClaudeSessionBaseline | null) {
+  return createClaudeStreamParser(baseline)(stdout);
 }
 
 /** Consume complete JSONL records once, retaining protocol accounting state. */

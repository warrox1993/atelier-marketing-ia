+{
+  "schemaVersion": 1,
+  "slug": "atelier-statbel",
+  "name": "Statbel (statistiques des communes belges)",
+  "description": "Statistiques ouvertes de Statbel par commune : population, âges, revenus, entreprises TVA.",
+  "categories": [
+    "marketing",
+    "data"
+  ],
+  "featured": false,
+  "branding": {
+    "logoUrl": "/brands/apps/atelier-page.svg",
+    "darkLogoUrl": "/brands/apps/atelier-page-dark.svg"
+  },
+  "urlPatterns": [
+    "http://127.0.0.1:3190/mcp/statbel"
+  ],
+  "docsUrl": "https://statbel.fgov.be/fr/open-data",
+  "agentInstructions": {
+    "id": "atelier.statbel",
+    "version": 1,
+    "text": "Use the Statbel tools of the marketing gateway (profil_commune, comparer_communes) to size a local market. Call atelier_identite first. Give a municipality by its French or Dutch name, postal code or INS code; when the answer lists several candidates, ask or pick explicitly, never guess. Every figure carries its year and source: quote both, never mix years silently, and say when a value is null (statistical secrecy or merged municipality). These are public aggregate statistics about municipalities, never data about a person."
+  },
+  "methods": [
+    {
+      "key": "lecture",
+      "label": "Lecture seule",
+      "transport": "mcp_remote",
+      "auth": "oauth",
+      "ownershipModes": [
+        "dcr",
+        "customer"
+      ],
+      "capabilityProfile": {
+        "key": "lecture",
+        "label": "Lecture seule",
+        "description": "Les agents lisent les statistiques publiques par commune, sans rien modifier."
+      },
+      "whenToUse": "Taille de marché, segmentation locale, comparaison de communes ; seul mode proposé.",
+      "defaults": {
+        "serverUrl": "http://127.0.0.1:3190/mcp/statbel"
+      },
+      "guidanceMd": "Connexion par la passerelle marketing de l'atelier, vers l'index local des données ouvertes de Statbel (licence CC BY 4.0, mise à jour par scripts/statbel-mise-a-jour.sh). Aucun compte Statbel n'est nécessaire.",
+      "consoleLinks": {
+        "docs": "https://statbel.fgov.be/fr/open-data"
+      },
+      "riskTier": "S2"
+    }
+  ]

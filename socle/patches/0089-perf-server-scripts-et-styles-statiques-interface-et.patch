+/**
+ * Compression gzip des fichiers statiques (scripts, styles) : patch local de l'Atelier.
+ *
+ * Le serveur ne compresse que l'API (`api-compression.ts`) ; les scripts de l'interface (plusieurs Mo) partaient
+ * bruts, ce qui ralentit le premier chargement à distance (tunnel Tailscale). Chaque fichier est compressé une
+ * seule fois puis gardé en mémoire (clé : chemin, taille, date de modification) ; les fichiers sont immuables
+ * une fois construits, le cache ne grossit donc qu'au fil des versions déployées.
+ */
+import type { Request, RequestHandler, Response } from "express";
+import fs from "node:fs";
+import path from "node:path";
+import { promisify } from "node:util";
+import { gzip } from "node:zlib";
+
+const gzipAsync = promisify(gzip);
+
+/** Types compressibles (les images et polices déjà compressées sont laissées telles quelles). */
+const TYPES_COMPRESSIBLES: Record<string, string> = {
+  ".js": "application/javascript; charset=utf-8",
+  ".mjs": "application/javascript; charset=utf-8",
+  ".css": "text/css; charset=utf-8",
+  ".svg": "image/svg+xml",
+  ".json": "application/json; charset=utf-8",
+  ".map": "application/json; charset=utf-8",
+};
+
+const SEUIL_OCTETS = 1024;
+const PLAFOND_CACHE = 64;
+const cache = new Map<string, Buffer>();
+
+export function accepteGzip(valeur: string | string[] | undefined): boolean {
+  const brut = Array.isArray(valeur) ? valeur.join(",") : valeur ?? "";
+  return brut.split(",").some((partie) => {
+    const [nom, ...params] = partie.trim().toLowerCase().split(";");
+    if (nom !== "gzip" && nom !== "*") return false;
+    const q = params.map((p) => p.trim()).find((p) => p.startsWith("q="));
+    return !q || Number(q.slice(2)) > 0;
+  });
+}
+
+/**
+ * Envoie `chemin` compressé si le client accepte gzip et que le type s'y prête ; sinon ne fait rien et rend faux
+ * (l'appelant envoie alors le fichier normalement). Les en-têtes de cache déjà posés par l'appelant sont conservés.
+ */
+export async function envoyerCompresse(req: Request, res: Response, chemin: string, stat: fs.Stats): Promise<boolean> {
+  const type = TYPES_COMPRESSIBLES[path.extname(chemin).toLowerCase()];
+  if (!type || stat.size < SEUIL_OCTETS || !accepteGzip(req.headers["accept-encoding"])) return false;
+  const cle = `${chemin}:${stat.size}:${stat.mtimeMs}`;
+  let corps = cache.get(cle);
+  if (!corps) {
+    corps = await gzipAsync(await fs.promises.readFile(chemin), { level: 9 });
+    if (cache.size >= PLAFOND_CACHE) cache.delete(cache.keys().next().value as string);
+    cache.set(cle, corps);
+  }
+  res.vary("Accept-Encoding");
+  res.set("Content-Type", type);
+  res.set("Content-Encoding", "gzip");
+  res.set("Content-Length", String(corps.length));
+  res.status(200).end(req.method === "HEAD" ? undefined : corps);
+  return true;
+}
+
+/** Intergiciel pour un dossier de fichiers statiques : compresse ce qui s'y prête, passe la main sinon. */
+export function staticGzip(racine: string, entetes?: (res: Response, chemin: string) => void): RequestHandler {
+  const racineReelle = path.resolve(racine);
+  return (req, res, next) => {
+    if (req.method !== "GET" && req.method !== "HEAD") return next();
+    let relatif: string;
+    try {
+      relatif = decodeURIComponent(req.path);
+    } catch {
+      return next();
+    }
+    const chemin = path.resolve(racineReelle, `.${relatif}`);
+    if (!chemin.startsWith(racineReelle + path.sep)) return next();
+    fs.promises
+      .stat(chemin)
+      .then(async (stat) => {
+        if (!stat.isFile()) return next();
+        entetes?.(res, chemin);
+        if (!(await envoyerCompresse(req, res, chemin, stat))) next();
+      })
+      .catch(() => next());
+  };
+}

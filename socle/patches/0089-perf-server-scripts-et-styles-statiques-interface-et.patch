+import express from "express";
+import fs from "node:fs";
+import { createServer, request as httpRequest } from "node:http";
+import type { AddressInfo } from "node:net";
+import os from "node:os";
+import path from "node:path";
+import { gunzipSync } from "node:zlib";
+import { afterEach, describe, expect, it } from "vitest";
+import { accepteGzip, staticGzip } from "../middleware/static-gzip.js";
+
+// Patch local de l'Atelier : compression gzip des scripts et styles servis en fichiers statiques.
+
+const serveurs: Array<ReturnType<typeof createServer>> = [];
+afterEach(async () => {
+  await Promise.all(serveurs.splice(0).map((s) => new Promise<void>((r) => s.close(() => r()))));
+});
+
+function dossier(): string {
+  const d = fs.mkdtempSync(path.join(os.tmpdir(), "static-gzip-"));
+  fs.writeFileSync(path.join(d, "app-abc123.js"), "console.log('atelier');\n".repeat(400));
+  fs.writeFileSync(path.join(d, "petit.js"), "x");
+  fs.writeFileSync(path.join(d, "image.png"), Buffer.alloc(4096, 7));
+  return d;
+}
+
+async function demarrer(racine: string): Promise<number> {
+  const app = express();
+  app.use("/assets", staticGzip(racine, (res) => res.set("Cache-Control", "public, max-age=31536000, immutable")));
+  app.use("/assets", express.static(racine));
+  const serveur = createServer(app);
+  serveurs.push(serveur);
+  await new Promise<void>((r) => serveur.listen(0, "127.0.0.1", r));
+  return (serveur.address() as AddressInfo).port;
+}
+
+function obtenir(port: number, chemin: string, encodage?: string) {
+  return new Promise<{ code: number; entetes: Record<string, unknown>; corps: Buffer }>((resolve, reject) => {
+    const req = httpRequest({ host: "127.0.0.1", port, path: chemin, headers: encodage ? { "accept-encoding": encodage } : {} }, (res) => {
+      const morceaux: Buffer[] = [];
+      res.on("data", (m: Buffer) => morceaux.push(m));
+      res.on("end", () => resolve({ code: res.statusCode ?? 0, entetes: res.headers, corps: Buffer.concat(morceaux) }));
+    });
+    req.on("error", reject);
+    req.end();
+  });
+}
+
+describe("staticGzip", () => {
+  it("compresse un script quand le client accepte gzip, avec le cache immuable et Vary", async () => {
+    const d = dossier();
+    const port = await demarrer(d);
+    const r = await obtenir(port, "/assets/app-abc123.js", "gzip, deflate, br");
+    expect(r.code).toBe(200);
+    expect(r.entetes["content-encoding"]).toBe("gzip");
+    expect(String(r.entetes.vary)).toMatch(/Accept-Encoding/i);
+    expect(r.entetes["cache-control"]).toBe("public, max-age=31536000, immutable");
+    expect(gunzipSync(r.corps).toString()).toBe(fs.readFileSync(path.join(d, "app-abc123.js"), "utf8"));
+    expect(r.corps.length).toBeLessThan(fs.statSync(path.join(d, "app-abc123.js")).size / 4);
+  });
+
+  it("laisse le fichier brut sans gzip accepté, pour un petit fichier ou une image", async () => {
+    const d = dossier();
+    const port = await demarrer(d);
+    for (const [chemin, enc] of [["/assets/app-abc123.js", undefined], ["/assets/petit.js", "gzip"], ["/assets/image.png", "gzip"]] as const) {
+      const r = await obtenir(port, chemin, enc);
+      expect(r.code).toBe(200);
+      expect(r.entetes["content-encoding"]).toBeUndefined();
+    }
+  });
+
+  it("refuse de sortir du dossier et laisse le 404 au service suivant", async () => {
+    const port = await demarrer(dossier());
+    expect((await obtenir(port, "/assets/../../etc/passwd", "gzip")).code).toBe(404);
+    expect((await obtenir(port, "/assets/absent.js", "gzip")).code).toBe(404);
+  });
+
+  it("lit Accept-Encoding avec ses poids", () => {
+    expect(accepteGzip("gzip")).toBe(true);
+    expect(accepteGzip("br, gzip;q=0.5")).toBe(true);
+    expect(accepteGzip("gzip;q=0")).toBe(false);
+    expect(accepteGzip("br")).toBe(false);
+    expect(accepteGzip(undefined)).toBe(false);
+  });
+});

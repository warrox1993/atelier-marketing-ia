@@ -173,6 +181,52 @@ describe("Sidebar", () => {
     vi.clearAllMocks();
   });
 
+  const pageAtelier = { type: "page", id: "atelier-page", displayName: "Atelier marketing", exportName: "Page", routePath: "atelier" };
+  const contributionAtelier = {
+    pluginId: "p1",
+    pluginKey: "atelier.marketing-ia",
+    displayName: "Atelier marketing",
+    version: "1.0.0",
+    uiEntryFile: "index.js",
+    slots: [pageAtelier],
+    launchers: [],
+  };
+
+  function boutonNouvelleTache() {
+    return [...container.querySelectorAll("button")].find((b) => b.textContent?.trim() === "Nouvelle tâche") as HTMLButtonElement;
+  }
+
+  it("ouvre la Discussion de l'atelier quand le plugin est prêt", async () => {
+    mockPluginsApi.listUiContributions.mockResolvedValue([contributionAtelier]);
+    const root = await renderSidebar();
+
+    const bouton = boutonNouvelleTache();
+    expect(bouton.getAttribute("aria-label")).toBe("Discuter avec le Coordinateur (nouvelle demande, question, action)");
+    flushSync(() => {
+      bouton.click();
+    });
+
+    expect(mockNavigate).toHaveBeenCalledWith("/atelier/discussion");
+    expect(mockOpenNewIssue).not.toHaveBeenCalled();
+    flushSync(() => {
+      root.unmount();
+    });
+  });
+
+  it("ouvre le dialogue de création sans l'atelier", async () => {
+    const root = await renderSidebar();
+
+    flushSync(() => {
+      boutonNouvelleTache().click();
+    });
+
+    expect(mockOpenNewIssue).toHaveBeenCalledTimes(1);
+    expect(mockNavigate).not.toHaveBeenCalled();
+    flushSync(() => {
+      root.unmount();
+    });
+  });
+
   it("keeps the default sidebar edge borderless", async () => {
     mockInstanceSettingsApi.getExperimental.mockResolvedValue({ enableIsolatedWorkspaces: false });
     const root = await renderSidebar();

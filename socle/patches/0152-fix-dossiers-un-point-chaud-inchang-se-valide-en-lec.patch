diff --git a/server/src/__tests__/agent-directory-working-copies.test.ts b/server/src/__tests__/agent-directory-working-copies.test.ts
index d2a7500631..5a04dfab9e 100644
--- a/server/src/__tests__/agent-directory-working-copies.test.ts
+++ b/server/src/__tests__/agent-directory-working-copies.test.ts
@@ -768,10 +768,11 @@ describe("persistent agent directories", () => {
     await fs.writeFile(path.join(first.localRoot, "last-write.txt"), "saved after failed handoff");
     // The stale collector cannot touch the successor; the attached collector
     // still saves and cleans the actual owner after process retirement.
+    // Atelier (AFD-C1, patch 0108) : ce collecteur attaché refuse l'enregistrement de l'agent, mais nettoie quand même.
     await copies.collectStopped({ companyId, runId: first.runId });
     expect((await fs.stat(first.localRoot)).isDirectory()).toBe(true);
-    expect((await copies.collectStopped({ companyId, runId: collectorRunId }))?.state).toBe("saved");
-    expect(await fs.readFile(path.join(root, "last-write.txt"), "utf8")).toBe("saved after failed handoff");
+    expect(await copies.collectStopped({ companyId, runId: collectorRunId })).toMatchObject({ runId, ...refusCollecteChaude });
+    await absent("last-write.txt");
     await expect(fs.stat(first.localRoot)).rejects.toMatchObject({ code: "ENOENT" });
   }, 10_000);
   it("refuses loaded instruction edits at the warm checkpoint and retires the copy", async () => {
@@ -817,11 +818,33 @@ describe("persistent agent directories", () => {
     await expect(fs.stat(copy.localRoot)).rejects.toMatchObject({ code: "ENOENT" });
     expect(await run({ warm: true })).toBeTruthy();
   });
+  it("Atelier (patch local 0152) : un point chaud inchangé se valide en lecture, la réutilisation reprend et l'agent n'écrit toujours rien", async () => {
+    const copy = await run({ warm: true });
+    const saved = await copies.checkpointWarm({ companyId, runId: copy.runId });
+    expect(saved).toMatchObject({ state: "warm_saved", errorCode: null });
+    expect(saved?.receipt?.checkpointState).toBe("unchanged");
+    expect(await copies.canReuseWarm(companyId, agentId, copy.runId)).toBe(true);
+    // Même identité que le point chaud : l'écriture directe reste refusée (0108).
+    const agent = { type: "agent" as const, companyId, agentId, runId: copy.runId, onBehalfOfUserId: userId };
+    await expect(agentFileStore(db).write({ ...target(), path: "intrus.txt", bytes: Buffer.from("x"), baseHash: null }, agent))
+      .rejects.toMatchObject({ status: 403 });
+    await absent("intrus.txt");
+    // Un changement au tour suivant reste refusé et ferme la réutilisation.
+    await fs.writeFile(path.join(copy.localRoot, "apres.txt"), "tour 2");
+    expect(await copies.checkpointWarm({ companyId, runId: copy.runId }))
+      .toMatchObject({ errorCode: refusPointChaud.errorCode, errorMessage: refusPointChaud.errorMessage });
+    expect(await copies.canReuseWarm(companyId, agentId, copy.runId)).toBe(false);
+    // Le candidat reste le point inchangé déjà validé : le changement refusé n'est jamais revendiqué.
+    expect(await copies.collectStopped({ companyId, runId: copy.runId })).toMatchObject({ ...refusCollecteChaude, candidateHash: saved!.baseHash });
+    await absent("apres.txt");
+  });
   it("rechecks authorization even for an unchanged warm checkpoint", async () => {
     const copy = await run({ warm: true });
-    await copies.checkpointWarm({ companyId, runId: copy.runId });
+    expect(await copies.checkpointWarm({ companyId, runId: copy.runId })).toMatchObject({ state: "warm_saved", errorCode: null });
+    // Atelier (patch local 0152) : le point inchangé se valide en lecture ; aucun agent n'a le droit d'écriture (0108),
+    // donc l'autorisation revérifiée est l'identité liée au run : on retire le responsable de l'entreprise.
     await db.delete(principalPermissionGrants).where(eq(principalPermissionGrants.companyId, companyId));
-    await db.update(companyMemberships).set({ membershipRole: "member" }).where(eq(companyMemberships.companyId, companyId));
+    await db.delete(companyMemberships).where(eq(companyMemberships.principalId, userId));
     expect((await copies.checkpointWarm({ companyId, runId: copy.runId }))?.errorCode).toBe("AGENT_FILES_CHECKPOINT_UNSTABLE");
     expect(await copies.canReuseWarm(companyId, agentId, copy.runId)).toBe(false);
     expect((await copies.collectStopped({ companyId, runId: copy.runId }))?.state).toBe("unavailable");
